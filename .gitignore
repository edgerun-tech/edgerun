# Python cache/build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Packaging
build/
dist/
target/
*.egg-info/

# OS/editor
.DS_Store
.vscode/
.idea/

# Local build outputs
var/bin/
var/ci/
var/go-build-cache/
var/coverage/

# Compiled binaries and archives
*.tar.gz
runtimetest
**/runtimetest

# Large spec archives and generated docs (keep html_spec.html/md, exclude w3c_specs/)
docs/w3c_specs/

# Embedded git repos (cloned test/spec repos)
specs/h1spec/
specs/hpack-test-case/
specs/http2-frame-test-case/

# Generated protobuf code — regenerated by `make proto` or `buf generate`
**/src/gen/

# Large spec archives — keep .md sources, exclude downloaded HTML
docs/*_spec.html
docs/*.pdf
edgerun-cli

# Node.js dependencies and prerender output
node_modules/
prerendered/
