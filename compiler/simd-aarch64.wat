    (call $emit_aarch64_bneon_add_4s (global.get $REG_V0) (global.get $REG_V0) (global.get $REG_V1))
    (call $emit_aarch64_binstr_addi_64 (global.get $REG_SP) (global.get $REG_SP) (i32.const 16))
    (call $emit_aarch64_binstr_str_q_off (global.get $REG_V0) (global.get $REG_SP) (i32.const 0))
  )
  (func $template_aarch64_i64x2_add (param $dec_ptr i32)
    (call $emit_aarch64_binstr_ldr_q_off (global.get $REG_V1) (global.get $REG_SP) (i32.const 0))
