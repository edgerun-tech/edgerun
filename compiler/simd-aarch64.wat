;; ═════════════════════════════════════════════════════════════════════
  ;; WASM SIMD (0xFD prefix) — AArch64 NEON implementations
  ;; ═════════════════════════════════════════════════════════════════════

  ;; ── v128.const (0xFD 0x0C): load 16-byte constant from decoded op ──
  (func $template_aarch64_v128_const (param $dec_ptr i32)
    (local $addr i32)
    (local.set $addr (i32.add (local.get $dec_ptr) (i32.const 16)))
    (call $emit_aarch64_bload_addr_x1 (local.get $addr))
    (call $emit_aarch64_bv128_load_reg)
    (call $emit_aarch64_bv128_push)
  )

  ;; ── v128.load (0xFD 0x00): pop addr, load 16 bytes from mem ─────────
  (func $template_aarch64_v128_load (param $dec_ptr i32)
    (call $emit_aarch64_bpop_x0)
    (call $emit_aarch64_bldr_mem_ptr)
    (call $emit_aarch64_binstr_add_64 (global.get $REG_X1) (global.get $REG_X2) (global.get $REG_X0))
    (call $emit_aarch64_bv128_load_reg)
    (call $emit_aarch64_bv128_push)
  )

  ;; ── v128.store (0xFD 0x1B): pop value, pop addr, store 16 bytes ─────
  (func $template_aarch64_v128_store (param $dec_ptr i32)
    (call $emit_aarch64_bv128_pop)
    (call $emit_aarch64_bpop_x0)
    (call $emit_aarch64_bldr_mem_ptr)
    (call $emit_aarch64_binstr_add_64 (global.get $REG_X1) (global.get $REG_X2) (global.get $REG_X0))
    (call $emit_aarch64_bv128_store_reg)
  )

  ;; ── Splat templates ───────────────────────────────────────────────
  (func $template_aarch64_i8x16_splat (param $dec_ptr i32)
    (call $emit_aarch64_bpop_x0)
    (call $emit_aarch64_binstr (i32.const 0x4E000800))
    (call $emit_aarch64_bv128_push)
  )
  (func $template_aarch64_i16x8_splat (param $dec_ptr i32)
    (call $emit_aarch64_bpop_x0)
    (call $emit_aarch64_binstr (i32.const 0x4E001000))
    (call $emit_aarch64_bv128_push)
  )
  (func $template_aarch64_i32x4_splat (param $dec_ptr i32)
    (call $emit_aarch64_bpop_x0)
    (call $emit_aarch64_binstr (i32.const 0x4E002000))
    (call $emit_aarch64_bv128_push)
  )
  (func $template_aarch64_i64x2_splat (param $dec_ptr i32)
    (call $emit_aarch64_bpop_x0)
    (call $emit_aarch64_binstr (i32.const 0x4E004000))
    (call $emit_aarch64_bv128_push)
  )
  (func $template_aarch64_f32x4_splat (param $dec_ptr i32)
    (call $emit_aarch64_bpop_x0)
    (call $emit_aarch64_binstr (i32.const 0x4E002000))
    (call $emit_aarch64_bv128_push)
  )
  (func $template_aarch64_f64x2_splat (param $dec_ptr i32)
    (call $emit_aarch64_bpop_x0)
    (call $emit_aarch64_binstr (i32.const 0x4E004000))
    (call $emit_aarch64_bv128_push)
  )

  ;; ── Integer binary ops ────────────────────────────────────────────
  (func $template_aarch64_i8x16_add (param $dec_ptr i32)
    (call $emit_aarch64_binstr_ldr_q_off (global.get $REG_V1) (global.get $REG_SP) (i32.const 0))
    (call $emit_aarch64_binstr_ldr_q_off (global.get $REG_V0) (global.get $REG_SP) (i32.const 1))
    (call $emit_aarch64_bneon_add_16b (global.get $REG_V0) (global.get $REG_V0) (global.get $REG_V1))
    (call $emit_aarch64_binstr_addi_64 (global.get $REG_SP) (global.get $REG_SP) (i32.const 16))
    (call $emit_aarch64_binstr_str_q_off (global.get $REG_V0) (global.get $REG_SP) (i32.const 0))
  )
  (func $template_aarch64_i16x8_add (param $dec_ptr i32)
    (call $emit_aarch64_binstr_ldr_q_off (global.get $REG_V1) (global.get $REG_SP) (i32.const 0))
    (call $emit_aarch64_binstr_ldr_q_off (global.get $REG_V0) (global.get $REG_SP) (i32.const 1))
    (call $emit_aarch64_bneon_add_8h (global.get $REG_V0) (global.get $REG_V0) (global.get $REG_V1))
    (call $emit_aarch64_binstr_addi_64 (global.get $REG_SP) (global.get $REG_SP) (i32.const 16))
    (call $emit_aarch64_binstr_str_q_off (global.get $REG_V0) (global.get $REG_SP) (i32.const 0))
