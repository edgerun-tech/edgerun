  ;; v128.bitselect: pop mask(V1), pop b(V0), pop a(V2); BSL V1, V0, V2
  ;; V1 = (V1 & V0) | (~V1 & V2) = (mask & b) | (~mask & a)
  ;; Stack: [SP]=mask, [SP+16]=b, [SP+32]=a (deepest)
  ;; Result replaces 'a' position: SP += 32, str_q at new SP
  ;; BSL V1.16B, V0.16B, V2.16B = 0x4E021C01
  (func $template_aarch64_v128_bitselect (param $dec_ptr i32)
    (call $emit_aarch64_binstr_ldr_q_off (global.get $REG_V1) (global.get $REG_SP) (i32.const 0))
    (call $emit_aarch64_binstr_ldr_q_off (global.get $REG_V0) (global.get $REG_SP) (i32.const 1))
    (call $emit_aarch64_binstr_ldr_q_off (global.get $REG_V2) (global.get $REG_SP) (i32.const 2))
    (call $emit_aarch64_binstr (i32.const 0x4E021C01))
    (call $emit_aarch64_binstr_addi_64 (global.get $REG_SP) (global.get $REG_SP) (i32.const 32))
    (call $emit_aarch64_binstr_str_q_off (global.get $REG_V1) (global.get $REG_SP) (i32.const 0))
  )
