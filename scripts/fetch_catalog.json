  ],
  "fetch_states": [
    {
      "name": "NetworkError",
      "description": "The fetch encountered a network error"
    },
    {
      "name": "Aborted",
      "description": "The fetch was aborted"
    },
    {
      "name": "Done",
      "description": "The fetch completed successfully"
    }
  ]
}