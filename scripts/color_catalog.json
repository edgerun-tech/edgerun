{
  "spec": "CSS Color Level 4",
  "spec_date": "2026-04-10",
  "color_functions": [
    {
      "name": "rgb",
      "syntax": "rgb(R G B [/ A]) or rgb(R, G, B, A)",
      "description": "Red Green Blue"
    },
    {
      "name": "rgba",
      "syntax": "rgba(R, G, B, A)",
      "description": "RGB with alpha (legacy)"
    },
    {
      "name": "hsl",
      "syntax": "hsl(H S L [/ A]) or hsl(H, S, L, A)",
      "description": "Hue Saturation Lightness"
    },
    {
      "name": "hsla",
      "syntax": "hsla(H, S, L, A)",
      "description": "HSL with alpha (legacy)"
    },
    {
      "name": "hwb",
      "syntax": "hwb(H W B [/ A])",
      "description": "Hue Whiteness Blackness"
    },
    {
      "name": "lab",
      "syntax": "lab(L a b [/ A])",
      "description": "CIE Lab perceptual"
    },
    {
      "name": "lch",
      "syntax": "lch(L C H [/ A])",
      "description": "CIE LCh cylindrical"
    },
    {
      "name": "oklab",
      "syntax": "oklab(L a b [/ A])",
      "description": "OK Lab perceptual"
    },
    {
      "name": "oklch",
      "syntax": "oklch(L C H [/ A])",
      "description": "OK LCh cylindrical"
    },
    {
      "name": "color",
      "syntax": "color(id c1 c2 c3 [/ A])",
      "description": "Generic color space"
    },
    {
      "name": "color-mix",
      "syntax": "color-mix(in id, color1 p%, color2)",
      "description": "Mix two colors"
    },
    {
      "name": "contrast-color",
      "syntax": "contrast-color(bg, dark: c1, light: c2)",
      "description": "Contrast-dependent color"
    },
    {
      "name": "from",
      "syntax": "from color s c1 c2 c3",
      "description": "Convert color to another space"
    }
  ],
