{
  "spec": "URL Living Standard",
  "spec_date": "2026-04-10",
  "url_parser_states": [
    "SchemeStart",
    "Scheme",
    "NoScheme",
    "SpecialRelativeOrAuthority",
    "PathOrAuthority",
    "Relative",
    "RelativeSlash",
    "SpecialAuthoritySlashes",
    "SpecialAuthorityIgnoreSlashes",
    "Query",
    "Host",
    "Hostname",
    "Port",
    "PathStart",
    "Path",
    "CannotBeABaseUrlPath",
    "File",
    "FileHost",
    "FileSlash",
    "Fragment"
  ],
  "url_properties": [
    {
      "name": "href",
      "type": "String",
      "description": "The full URL"
    },
    {
      "name": "origin",
      "type": "String",
      "description": "The origin (read-only)"
    },
    {
      "name": "protocol",
      "type": "String",
      "description": "Scheme with trailing ':'"
    },
    {
      "name": "username",
      "type": "String",
      "description": "Username component"
    },
    {
      "name": "password",
      "type": "String",
      "description": "Password component"
    },
    {
      "name": "host",
      "type": "String",
      "description": "Host with port"
    },
    {
      "name": "hostname",
      "type": "String",
      "description": "Host without port"
    },
    {
      "name": "port",
      "type": "Option<String>",
      "description": "Port number"
    },
    {
      "name": "pathname",
      "type": "String",
      "description": "Path component"
    },
    {
      "name": "search",
      "type": "String",
      "description": "Query string with '?'"
    },
    {
      "name": "hash",
      "type": "String",
      "description": "Fragment with '#'"
    }
  ],
  "urlsearchparams_methods": [
    {
      "name": "append",
      "return_type": "void",
      "parameters": "name: &str, value: &str"
    },
    {
      "name": "delete",
      "return_type": "void",
      "parameters": "name: &str"
    },
    {
      "name": "delete_with_value",
      "return_type": "void",
      "parameters": "name: &str, value: &str"
    },
    {
      "name": "get",
      "return_type": "Option<String>",
      "parameters": "name: &str"
    },
    {
      "name": "get_all",
      "return_type": "Vec<String>",
      "parameters": "name: &str"
    },
    {
      "name": "has",
      "return_type": "bool",
      "parameters": "name: &str"
    },
    {
      "name": "has_with_value",
      "return_type": "bool",
      "parameters": "name: &str, value: &str"
    },
    {
      "name": "set",
      "return_type": "void",
      "parameters": "name: &str, value: &str"
    },
    {
      "name": "sort",
      "return_type": "void",
      "parameters": ""
    },
    {
      "name": "to_string",
      "return_type": "String",
      "parameters": ""
    }
  ],
  "special_schemes": [
    "ftp",
    "file",
    "http",
    "https",
    "ws",
    "wss"
  ],
  "default_ports": {
    "ftp": 21,
    "file": null,
    "http": 80,
    "https": 443,
    "ws": 80,
    "wss": 443
  }
}