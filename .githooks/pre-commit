#!/usr/bin/env sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"
FRONTEND="$ROOT/frontend"

if [ ! -d "$FRONTEND" ]; then
  echo "Frontend directory not found: $FRONTEND" >&2
  exit 1
fi

cd "$FRONTEND"

if ! command -v bun >/dev/null 2>&1; then
  echo "bun is required for frontend pre-commit checks." >&2
  exit 1
fi

bun install --frozen-lockfile

if node -e "const s=require('./package.json').scripts||{}; process.exit(s['format:check'] ? 0 : 1)"; then
  bun run format:check
else
  echo "format:check script not configured; skipping formatting check."
fi

bun run lint
bun run typecheck
bun run build
if node -e "const s=require('./package.json').scripts||{}; process.exit(s.test && s.test !== 'echo \"No frontend tests configured\"' ? 0 : 1)"; then
  bun run test
fi
