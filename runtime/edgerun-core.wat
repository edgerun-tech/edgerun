  (global $LINUX_SYS_X64_RECVMSG                 (export "LINUX_SYS_X64_RECVMSG") i32 (i32.const 47))
  (global $LINUX_SYS_X64_SHUTDOWN                (export "LINUX_SYS_X64_SHUTDOWN") i32 (i32.const 48))
