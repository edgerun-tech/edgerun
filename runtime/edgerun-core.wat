            (if (i32.ne (i32.load8_u (i32.add (local.get $ptr) (local.get $i)))
                        (i32.load8_u (i32.add (local.get $prefix) (local.get $i))))
              (then (return (i32.const 0))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
