  (global $LINUX_SYS_X64_SEMGET                  (export "LINUX_SYS_X64_SEMGET") i32 (i32.const 64))
  (global $LINUX_SYS_X64_SEMOP                   (export "LINUX_SYS_X64_SEMOP") i32 (i32.const 65))
