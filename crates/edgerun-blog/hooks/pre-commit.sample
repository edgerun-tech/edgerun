#!/bin/sh
set -eu

BLOG_REPO=${BLOG_REPO:-$(git rev-parse --show-toplevel)}
BLOG_CONTENT_DIR=${BLOG_CONTENT_DIR:-docs/blog}
BLOG_PUBLIC=${BLOG_PUBLIC:-$BLOG_REPO/$BLOG_CONTENT_DIR/.generated}
BLOG_BINARY=${BLOG_BINARY:-edgerun-blog}

"$BLOG_BINARY" generate \
  --root "$BLOG_REPO" \
  --content-dir "$BLOG_CONTENT_DIR" \
  --out "$BLOG_PUBLIC" \
  --title "EdgeRun Build Log" \
  --description "Feature-by-feature notes on building Edgerun from its source tree." \
  --base-url https://blog.edgerun.tech

BLOG_PUBLIC_REL=$(realpath --relative-to "$BLOG_REPO" "$BLOG_PUBLIC")
git -C "$BLOG_REPO" add "$BLOG_PUBLIC_REL"

"$BLOG_BINARY" generate \
  --root "$BLOG_REPO" \
  --content-dir "$BLOG_CONTENT_DIR" \
  --out "$BLOG_PUBLIC" \
  --title "EdgeRun Build Log" \
  --description "Feature-by-feature notes on building Edgerun from its source tree." \
  --base-url https://blog.edgerun.tech \
  --check
