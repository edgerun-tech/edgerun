#!/bin/sh
set -eu

BLOG_REPO=${BLOG_REPO:-$(git rev-parse --show-toplevel)}
BLOG_PUBLIC=${BLOG_PUBLIC:-$BLOG_REPO/.generated}
BLOG_BINARY=${BLOG_BINARY:-edgerun-blog}

"$BLOG_BINARY" generate \
  --root "$BLOG_REPO" \
  --out "$BLOG_PUBLIC" \
  --title "Edgerun Blog" \
  --description "Notes from the Edgerun project." \
  --base-url https://blog.edgerun.tech

git -C "$BLOG_REPO" add .generated

"$BLOG_BINARY" generate \
  --root "$BLOG_REPO" \
  --out "$BLOG_PUBLIC" \
  --title "Edgerun Blog" \
  --description "Notes from the Edgerun project." \
  --base-url https://blog.edgerun.tech \
  --check
