call hmac.hmac_sha256 const:1024 len:prk const:4096 add:1+len:info const:2048
copy hmac const:2048 hmac const:30000 const:32
copy hmac const:2048 hmac const:4096 const:32
copy-input info hmac const:4128 len:info
write-byte hmac add:4128+len:info 2
call hmac.hmac_sha256 const:1024 len:prk const:4096 add:33+len:info const:2048
copy hmac const:2048 hmac const:30032 const:10
publish hmac const:30000 const:42
