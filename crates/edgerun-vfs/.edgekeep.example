# Example .edgekeep file
# List untracked files/directories that should be persisted to disk
# 
# Format:
# - One pattern per line
# - Comments start with #
# - Supports glob patterns (*, ?, [])
# - Directory patterns end with /
#
# Examples:

# Persist environment files
.env
.env.local
*.env

# Persist local configs
config.local.toml
settings.local.json
*.local.*

# Persist secrets directory
secrets/

# Persist IDE settings (if not in git)
.vscode/settings.json
.idea/workspace.xml

# Persist database files
*.db
*.sqlite
