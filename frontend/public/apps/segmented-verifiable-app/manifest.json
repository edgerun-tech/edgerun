{
  "format": "edgerun-app-v1",
  "id": "segmented-verifiable-browser",
  "name": "Segmented Verifiable Execution",
  "version": "0.1.0",
  "abi": "browser-iframe-v1",
  "entry": {
    "kind": "browser-iframe",
    "path": "index.html"
  },
  "developer": {
    "name": "EdgeRun SDK"
  },
  "runtime": {
    "execution": "segmented-deterministic",
    "identity": "webcrypto-p256",
    "event_log": "hash-linked-signed",
    "verification": "same-input-replay"
  },
  "segments": [
    {
      "id": "ingest-public-edge-v1",
      "role": "public-edge",
      "composition": "sha256(input)"
    },
    {
      "id": "policy-private-node-v1",
      "role": "private-policy-node",
      "composition": "sha256(previous-output, policy-salt)"
    },
    {
      "id": "commit-audit-node-v1",
      "role": "audit-node",
      "composition": "sha256(previous-output, append-only-head)"
    },
    {
      "id": "replica-check-node-v1",
      "role": "replica-check-node",
      "composition": "sha256(previous-output, user-node-anchor)"
    },
    {
      "id": "final-witness-node-v1",
      "role": "final-witness-node",
      "composition": "sha256(previous-output, full-proof-envelope)"
    }
  ],
  "capabilities": {
    "required": [
      "identity",
      "node_connection"
    ],
    "optional": [
      "browser.storage.local"
    ]
  }
}
