# OpenCode Zen API - Get your key at https://opencode.ai/auth
# The free tier includes MiniMax M2.5 Free model
OPENCODE_API_KEY=your-api-key-here

# Gmail OAuth - Create app at https://console.cloud.google.com/apis/credentials
# Scopes: Gmail read/write, user email
# Redirect URI must match: http://localhost:3000/api/gmail/callback
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback