{
  "name": "edgerun-bench-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.2.4",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "astro:check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "test:run": "vitest run --passWithNoTests",
    "precommit": "bun run test:run && bun run lint && bun run astro:check && bun run build",
    "cf:check": "bun run precommit",
    "cf:preview": "wrangler dev",
    "cf:deploy": "bun run cf:check && wrangler deploy",
    "setup:hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/solid-js": "^6.0.1",
    "@astrojs/tailwind": "^6.0.2",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^22.19.17",
    "astro": "^5.18.1",
    "clsx": "^2.1.1",
    "nanostores": "^0.11.4",
    "solid-js": "^1.9.12",
    "tailwindcss": "^4.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^6.3.11",
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.87.0"
  }
}
