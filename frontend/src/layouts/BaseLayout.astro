---
import type { Locale } from "@/data/i18n"
import "../styles/global.css"

const {
  title = "EdgeRun Benchmarks",
  description = "Technical benchmark publication site",
  lang = "en",
  path = "/",
} = Astro.props as {
  title?: string
  description?: string
  lang?: Locale
  path?: string
}

const site = import.meta.env.SITE || "https://benchmarks.edgerun.local"
const canonical = new URL(path, site).toString()
const alternateLocales = [
  { locale: "en", href: new URL(`/en`, site).toString() },
  { locale: "et", href: new URL(`/et`, site).toString() },
  { locale: "th", href: new URL(`/th`, site).toString() },
]
---
<!doctype html>
<html lang={lang} class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternateLocales.map((item) => (
      <link rel="alternate" hreflang={item.locale} href={item.href} />
    ))}
    <link rel="icon" href="/icon.svg" />
  </head>
  <body class="min-h-full antialiased text-slate-100">
    <slot />
  </body>
</html>
