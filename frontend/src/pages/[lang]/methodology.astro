---
import BaseLayout from "@/layouts/BaseLayout.astro"
import { SiteHeader, LocaleSwitcher } from "@/components/site/SiteHeader"
import { SiteFooter } from "@/components/site/SiteFooter"
import { MethodologyTemplate } from "@/components/blocks/MethodologyTemplate"
import { locales, getLocaleCopy, type Locale } from "@/data/i18n"
import { PageHeader, PageHeaderDescription, PageHeaderHeading } from "@/components/site/PageHeader"

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale } }))
}

const params = Astro.params.lang
const isSupported = (locale: string | undefined): locale is Locale =>
  locales.includes(locale as Locale)
const copy = getLocaleCopy(params)
const slug = isSupported(params) ? params : "en"
---
<BaseLayout
  title={`${copy.methodologyTitle} | EdgeRun`}
  description={copy.methodologyIntro}
  lang={slug}
  path={`/${slug}/methodology`}
>
  <SiteHeader
    locale={slug}
    homeLabel={copy.navHome}
    methodologyLabel={copy.navMethodology}
    benchmarksLabel={copy.navBenchmarks}
  />
  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <PageHeader>
      <PageHeaderHeading>{copy.methodologyTitle}</PageHeaderHeading>
      <PageHeaderDescription>{copy.methodologyIntro}</PageHeaderDescription>
      <LocaleSwitcher current={slug} />
    </PageHeader>

    <section class="mt-6 space-y-6">
      <MethodologyTemplate copy={copy} />
      <section class="rounded-2xl border border-white/10 bg-slate-900/40 p-5">
        <h3 class="text-xl font-semibold text-white">Template fields</h3>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <div class="rounded-lg border border-white/10 p-3">
            <p class="text-sm text-slate-400">{copy.fairnessColumns.metric}</p>
            <p class="mt-1 text-sm text-slate-100">Throughput / Latency / Memory / CPU</p>
          </div>
          <div class="rounded-lg border border-white/10 p-3">
            <p class="text-sm text-slate-400">{copy.fairnessColumns.weight}</p>
            <p class="mt-1 text-sm text-slate-100">40/30/20/10 default policy</p>
          </div>
          <div class="rounded-lg border border-white/10 p-3">
            <p class="text-sm text-slate-400">{copy.fairnessColumns.score}</p>
            <p class="mt-1 text-sm text-slate-100">Normalized 0-100 with MAD guardrails</p>
          </div>
          <div class="rounded-lg border border-white/10 p-3">
            <p class="text-sm text-slate-400">{copy.fairnessColumns.confidence}</p>
            <p class="mt-1 text-sm text-slate-100">high / medium / low confidence bands</p>
          </div>
          <div class="rounded-lg border border-white/10 p-3 md:col-span-2">
            <p class="text-sm text-slate-400">{copy.fairnessColumns.notes}</p>
            <p class="mt-1 text-sm text-slate-100">Include seed, duration, machine IDs, and manifest hash.</p>
          </div>
        </div>
      </section>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
