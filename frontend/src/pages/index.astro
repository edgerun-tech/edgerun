---
import BaseLayout from "@/layouts/BaseLayout.astro"
import { SiteHeader, LocaleSwitcher } from "@/components/site/SiteHeader"
import { SiteFooter } from "@/components/site/SiteFooter"
import { PageHeader, PageHeaderDescription, PageHeaderHeading } from "@/components/site/PageHeader"
import { Callout } from "@/components/site/Callout"
import { Button } from "@/components/ui/button"
import { MethodologyTemplate } from "@/components/blocks/MethodologyTemplate"
import { localeDictionary, localeDefault } from "@/data/i18n"
import { benchmarkResults } from "@/data/benchmarks"

const copy = localeDictionary[localeDefault]
---
<BaseLayout
  title={`${copy.homeTitle} | EdgeRun`}
  description={copy.methodologyIntro}
  lang="en"
  path="/"
>
  <SiteHeader
    locale={localeDefault}
    homeLabel={copy.navHome}
    methodologyLabel={copy.navMethodology}
    benchmarksLabel={copy.navBenchmarks}
  />
  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <PageHeader>
      <PageHeaderHeading>{copy.homeTitle}</PageHeaderHeading>
      <PageHeaderDescription>{copy.homeLead}</PageHeaderDescription>
      <p class="max-w-3xl text-sm text-slate-200">
        Latest signal: {benchmarkResults[0]?.run.suite} —{" "}
        {benchmarkResults[0]?.run.throughputOpsPerSec.toLocaleString()} ops/s, {benchmarkResults[0]?.run.latencyP99Ms}ms p99
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a href={`/${localeDefault}/methodology`}>
          <Button>{copy.homePrimaryCta}</Button>
        </a>
        <a href={`/${localeDefault}/benchmarks`}>
          <Button variant="secondary">{copy.homeSecondaryCta}</Button>
        </a>
      </div>
    </PageHeader>

    <section class="mt-8 grid gap-4 md:grid-cols-[1fr_auto]">
      <Callout class="reveal">
        {copy.methodologyIntro}
      </Callout>
      <LocaleSwitcher current="en" class="rounded-lg border border-white/10 bg-slate-900/60 px-4 py-3 text-xs" />
    </section>

    <MethodologyTemplate copy={copy} />
  </main>
  <SiteFooter />
</BaseLayout>
