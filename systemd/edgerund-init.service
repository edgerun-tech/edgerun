[Unit]
Description=edgerun Init Daemon (PID 1)
Documentation=file:///home/ken/edgerun_reference_core/docs/machine_daemon.md
Documentation=file:///home/ken/edgerun_reference_core/docs/production.md
After=
DefaultDependencies=no

[Service]
Type=idle
ExecStart=/usr/local/bin/edgerund run --config /etc/edgerun/node.yaml --init --listen 0.0.0.0:8080 --health-port 8888

# As PID 1, we handle signals ourselves (SIGTERM, SIGINT, SIGHUP, SIGCHLD)
# The daemon mounts proc, sysfs, devtmpfs, tmpfs automatically

Restart=on-failure
RestartSec=5

# Less restrictive than systemd mode since we're PID 1
# but still apply reasonable security
NoNewPrivileges=true
ProtectSystem=false  # PID 1 may need to write to /etc, /var
ProtectHome=false
PrivateTmp=false

# Device access
DeviceAllow=/dev/tpmrm0 rw
DeviceAllow=/dev/hidraw* rw
DeviceAllow=char-alsa rw
DeviceAllow=/dev/snd/* rw
DeviceAllow=/dev/video* rw
DeviceAllow=/dev/input/* rw

# Logging (PID 1 writes directly to console)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edgerund-init

[Install]
WantedBy=sysinit.target
