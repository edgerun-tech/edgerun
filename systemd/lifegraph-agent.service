[Unit]
Description=Lifegraph agent daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/lifegraph-agent
Environment=LIFEGRAPH_AGENT_DATA_ROOT=/data/lifegraph-agent
ExecStartPre=/usr/bin/mkdir -p /data/lifegraph-agent
ExecStart=/usr/local/bin/lifegraph-agent
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
