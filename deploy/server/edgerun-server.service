[Unit]
Description=Edgerun multi-protocol server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edgerun-server
Group=edgerun-server
ExecStart=/usr/local/bin/edgerun-server --config /etc/edgerun/server/server.yaml --blog-host blog.edgerun.tech --blog-root /srv/blog --blog-static-root /srv/blog/.generated --blog-title "Edgerun Blog" --blog-base-url https://blog.edgerun.tech
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
UMask=0077
RemoveIPC=true
ProtectSystem=strict
ReadWritePaths=/etc/edgerun/server /var/lib/edgerun/server /var/lib/edgerun/mail
ReadOnlyPaths=/srv/blog
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
