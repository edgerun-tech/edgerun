// Sample a single pixel from a glyph bitmap
// Returns 1.0 if the pixel is set, 0.0 otherwise
fn glyph_pixel(glyph_index: u32, row: u32, col: u32) -> f32 {
    if (glyph_index >= 128u || row >= 8u || col >= 8u) { return 0.0; }
    let byte_idx = glyph_index * 8u + row;
    let bits = GLYPH_DATA[byte_idx];
    let mask = 0x80u >> col;
    return select(0.0, 1.0, (bits & mask) != 0u);
}


// --- Border Rendering ---
// Generated from css_box.proto + border_lut.rs

// Returns the border width at a given pixel position on the rect edge
// Returns > 0 if in border region, 0 if in content area
fn border_width_at(px: f32, py: f32, r: RectStyle) -> f32 {
    let rel_x = px - r.x;
    let rel_y = py - r.y;
    // Distance from each edge
    let dist_left = rel_x;
    let dist_right = r.w - rel_x;
    let dist_top = rel_y;
    let dist_bottom = r.h - rel_y;

    // Determine which border segment we're on
    // Top/bottom borders span full width, left/right span between top and bottom border
    var bw: f32 = 0.0;

    // Check if in corner regions (use max of adjacent border widths)
    let in_top_left = rel_x < r.border_radius_tl && rel_y < r.border_radius_tl;
    let in_top_right = (r.w - rel_x) < r.border_radius_tr && rel_y < r.border_radius_tr;
    let in_bottom_right = (r.w - rel_x) < r.border_radius_br && (r.h - rel_y) < r.border_radius_br;
    let in_bottom_left = rel_x < r.border_radius_bl && (r.h - rel_y) < r.border_radius_bl;

    if (in_top_left || in_top_right || in_bottom_right || in_bottom_left) {
        // Corner: use the max border width of adjacent edges
        bw = max(max(r.border_width_top, r.border_width_bottom),
                 max(r.border_width_left, r.border_width_right));
    } else if (dist_top <= r.border_width_top) {
        bw = r.border_width_top;
    } else if (dist_bottom <= r.border_width_bottom) {
        bw = r.border_width_bottom;
    } else if (dist_left <= r.border_width_left) {
        bw = r.border_width_left;
    } else if (dist_right <= r.border_width_right) {
        bw = r.border_width_right;
    }

    return bw;
}

// Compute a dash pattern pixel offset for border dashing
fn border_pixel_offset(px: f32, py: f32, r: RectStyle) -> u32 {
    let rel_x = u32(px - r.x);
    let rel_y = u32(py - r.y);
    // Simple: use Manhattan distance as pattern offset
    return (rel_x + rel_y) % 8u;
}


// --- SDF Box Shadow Rendering ---
// Generated from css_box.proto box-shadow properties

// Compute signed distance from rounded rect edge
// Returns negative distance inside, positive outside
fn sdf_rounded_rect(px: f32, py: f32, x: f32, y: f32, w: f32, h: f32, tl: f32, tr: f32, br: f32, bl: f32) -> f32 {
    // Simple box SDF (corners handled separately for rounded rects)
    let cx = x + w * 0.5;
    let cy = y + h * 0.5;
    let hx = abs(px - cx) - w * 0.5;
    let hy = abs(py - cy) - h * 0.5;
    let d = min(max(hx, hy), 0.0);
    let dx = max(hx, 0.0);
    let dy = max(hy, 0.0);
    return sqrt(dx * dx + dy * dy) + d;
}

// Render drop shadow for a rect
fn render_drop_shadow(px: f32, py: f32, r: RectStyle) -> vec4<f32> {
    if (r.shadow_active == 0u) { return vec4<f32>(0.0, 0.0, 0.0, 0.0); }
    if (r.shadow_type != 0u) { return vec4<f32>(0.0, 0.0, 0.0, 0.0); } // drop only

    // Shadow rect: expanded by spread+blur, offset
    let expand = r.shadow_spread + r.shadow_blur;
    let sx = r.x + r.shadow_offset_x - expand;
    let sy = r.y + r.shadow_offset_y - expand;
    let sw = r.w + expand * 2.0;
    let sh = r.h + expand * 2.0;

    // Compute SDF distance from shadow rect edge
    let dist = sdf_rounded_rect(px, py, sx, sy, sw, sh,
        r.border_radius_tl + expand, r.border_radius_tr + expand,
        r.border_radius_br + expand, r.border_radius_bl + expand);

    // Convert distance to alpha (smooth falloff)
    var alpha = 0.0;
    if (dist < 0.0) {
        // Inside shadow rect: full opacity at edge
        alpha = 1.0;
    } else {
        // Outside: fade over blur distance
        if (r.shadow_blur > 0.001) {
            alpha = 1.0 - clamp(dist / r.shadow_blur, 0.0, 1.0);
        }
    }

    return vec4<f32>(r.shadow_color.rgb, alpha * r.shadow_color.a);
}

// Render inset shadow for a rect
fn render_inset_shadow(px: f32, py: f32, r: RectStyle) -> vec4<f32> {
    if (r.shadow_active == 0u) { return vec4<f32>(0.0, 0.0, 0.0, 0.0); }
    if (r.shadow_type != 1u) { return vec4<f32>(0.0, 0.0, 0.0, 0.0); } // inset only

    // Inset shadow: contracts from rect edge
    let expand = r.shadow_spread + r.shadow_blur;
    let ix = r.x + expand - r.shadow_offset_x;
    let iy = r.y + expand - r.shadow_offset_y;
    let iw = r.w - expand * 2.0;
    let ih = r.h - expand * 2.0;

    if (iw <= 0.0 || ih <= 0.0) { return vec4<f32>(0.0, 0.0, 0.0, 0.0); }

    // Compute SDF distance from inner rect edge
    let dist = -sdf_rounded_rect(px, py, ix, iy, iw, ih,
        max(r.border_radius_tl - expand, 0.0), max(r.border_radius_tr - expand, 0.0),
        max(r.border_radius_br - expand, 0.0), max(r.border_radius_bl - expand, 0.0));

    // Convert distance to alpha
    var alpha = 0.0;
    if (dist >= 0.0) {
        alpha = 1.0;
    } else {
        if (r.shadow_blur > 0.001) {
            alpha = clamp(-dist / r.shadow_blur, 0.0, 1.0);
        }
    }

    return vec4<f32>(r.shadow_color.rgb, alpha * r.shadow_color.a);
}


// --- Gradient T-Parameter Functions ---
// Generated from css_images.proto + gradient.rs

// Linear gradient: projects pixel onto the gradient line
fn linear_gradient_t(px: f32, py: f32, r: RectStyle) -> f32 {
    let rel_x = (px - r.x) / r.w;
    let rel_y = (py - r.y) / r.h;
    let cos_a = cos(r.gradient_angle);
    let sin_a = sin(r.gradient_angle);
    let t = (rel_x * cos_a + rel_y * sin_a) / (r.w + r.h) * 2.0;
    return clamp(t, 0.0, 1.0);
}

// Radial gradient: distance from center, normalized
fn radial_gradient_t(px: f32, py: f32, r: RectStyle) -> f32 {
    let center_x = r.x + r.w * r.gradient_cx;
    let center_y = r.y + r.h * r.gradient_cy;
    let dx = px - center_x;
    let dy = py - center_y;
    let max_dist = sqrt(r.w * r.w + r.h * r.h) * 0.5;
    let dist = sqrt(dx * dx + dy * dy) / max_dist;
    return clamp(dist, 0.0, 1.0);
}

// Conic gradient: angle from center, with from_angle offset
fn conic_gradient_t(px: f32, py: f32, r: RectStyle) -> f32 {
    let center_x = r.x + r.w * r.gradient_cx;
    let center_y = r.y + r.h * r.gradient_cy;
    let dx = px - center_x;
    let dy = py - center_y;
    var angle: f32 = atan2(dy, dx) + 3.141592653589793 - r.gradient_angle;
    if (angle < 0.0) { angle = angle + 6.283185307179586; }
    return angle / 6.283185307179586;
}

// Sample color stops with linear interpolation
// Generated from gradient.rs lerp_stops + find_stops
fn sample_stops(r: RectStyle, t: f32) -> vec4<f32> {
    if (r.gradient_stop_count == 0u) {
        return vec4<f32>(1.0, 0.0, 0.0, 1.0);  // Error: red
    }
    if (r.gradient_stop_count == 1u) {
        return r.gradient_stops[0].color;
    }

    // Find bracketing stops
    var prev = r.gradient_stops[0];
    var next = r.gradient_stops[1];
    var i: u32 = 1u;
    loop {
        if (i >= r.gradient_stop_count) { break; }
        if (r.gradient_stops[i].position >= t) {
            next = r.gradient_stops[i];
            break;
        }
        prev = r.gradient_stops[i];
        next = r.gradient_stops[i];
        i = i + 1u;
    }

    let span = next.position - prev.position;
    var local_t: f32 = 0.0;
    if (span > 0.0001) {
        local_t = clamp((t - prev.position) / span, 0.0, 1.0);
    }
    return mix(prev.color, next.color, local_t);
}


// --- Rounded Rectangle SDF ---
// Generated from css_box.proto border-radius

// Returns true if point (px, py) is inside the rounded rect
fn contains_rounded_rect(px: f32, py: f32, r: RectStyle) -> bool {
    // Quick AABB test
    if (px < r.x || px >= r.x + r.w || py < r.y || py >= r.y + r.h) {
        return false;
    }

    // Corner radii
    let tl = r.border_radius_tl;
    let tr = r.border_radius_tr;
    let br = r.border_radius_br;
    let bl = r.border_radius_bl;

    // Determine which corner region we're in
    let in_left = px < r.x + tl;
    let in_right = px > r.x + r.w - tr;
    let in_top = py < r.y + tl;
    let in_bottom = py > r.y + r.h - bl;

    // Top-left corner
    if (in_left && in_top) {
        let dx = px - (r.x + tl);
        let dy = py - (r.y + tl);
        return dx * dx + dy * dy <= tl * tl;
    }
    // Top-right corner
    if (in_right && in_top) {
        let dx = px - (r.x + r.w - tr);
        let dy = py - (r.y + tr);
        return dx * dx + dy * dy <= tr * tr;
    }
    // Bottom-right corner
    if (in_right && in_bottom) {
        let dx = px - (r.x + r.w - br);
        let dy = py - (r.y + r.h - bl);
        return dx * dx + dy * dy <= br * br;
    }
    // Bottom-left corner
    if (in_left && in_bottom) {
        let dx = px - (r.x + bl);
        let dy = py - (r.y + r.h - bl);
        return dx * dx + dy * dy <= bl * bl;
    }

    return true;  // Inside the non-corner region
}


// --- Fragment Shader: Painter's Algorithm ---
// Every pixel iterates all rectangles back-to-front

@fragment
fn fs_main(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
    let px = pos.x;
    let py = pos.y;

    // Default canvas background (from Framebuffer::clear)
    var color = vec4<f32>(0.10196, 0.10196, 0.18039, 1.0);  // #1a1a2e

    // Painter's algorithm: iterate back-to-front
    for (var i: u32 = 0u; i < u.rect_count; i = i + 1u) {
        let r = rects[i];

        // Containment test (rounded rect SDF)
        if (!contains_rounded_rect(px, py, r)) { continue; }

        // --- Drop Shadow Pass ---
        // Render shadows BEFORE rect content (painter's algorithm)
        // Check if this pixel falls within the shadow area of ANY preceding rect
        // For efficiency, we render the shadow of THIS rect if the pixel
        // falls within its shadow bounding box but not the rect itself

        // Shadow rect containment test (expanded by spread+blur+offset)
        let expand = r.shadow_spread + r.shadow_blur;
        let shadow_x = r.x + r.shadow_offset_x - expand;
        let shadow_y = r.y + r.shadow_offset_y - expand;
        let shadow_w = r.w + expand * 2.0;
        let shadow_h = r.h + expand * 2.0;
        let in_shadow = px >= shadow_x && px < shadow_x + shadow_w &&
                        py >= shadow_y && py < shadow_y + shadow_h;
        let in_rect = contains_rounded_rect(px, py, r);

        // Drop shadow: render if in shadow area but not in rect
        if (r.shadow_active != 0u && r.shadow_type == 0u && in_shadow && !in_rect) {
            let shadow = render_drop_shadow(px, py, r);
            if (shadow.a > 0.001) {
                color = mix(color, vec4<f32>(shadow.rgb, 1.0), shadow.a);
            }
        }

        var pixel_color: vec4<f32>;

        // Gradient dispatch (from css_images.proto GradientKind)
        switch r.gradient_type {
            case 0u: {  // None — solid bg_color
                pixel_color = r.bg_color;
            }
            case 1u: {  // LinearGradient
                let t = linear_gradient_t(px, py, r);
                pixel_color = sample_stops(r, t);
            }
            case 2u: {  // RadialGradient
                let t = radial_gradient_t(px, py, r);
                pixel_color = sample_stops(r, t);
            }
            case 3u: {  // ConicGradient
                let t = conic_gradient_t(px, py, r);
                pixel_color = sample_stops(r, t);
            }
            default: {
                pixel_color = r.bg_color;
            }
        }

        // --- Border Rendering Pass ---
        let bw = border_width_at(px, py, r);
        if (bw > 0.0 && r.border_style != 0u) {
            // Check dash pattern
            let dash_offset = border_pixel_offset(px, py, r);
            let dash_visible = border_dash_test(dash_offset, r.border_style);
            if (dash_visible) {
                pixel_color = r.border_color;
            }
        }

        // Blend mode application (from blend_lut)
        pixel_color = apply_blend_mode(pixel_color, color, r.blend_mode);

        // Opacity compositing
        color = mix(color, pixel_color, r.opacity);
    }

    // --- Text Rendering Pass ---
    // For each text command, check if this pixel falls within any glyph
    for (var ti: u32 = 0u; ti < u.text_cmd_count; ti = ti + 1u) {
        let tc = text_cmds[ti];
        for (var gi: u32 = 0u; gi < tc.glyph_count; gi = gi + 1u) {
            let glyph_x = tc.x + f32(gi) * 8.0;
            let glyph_y = tc.y;
            // Bounding box test
            if (px >= glyph_x && px < glyph_x + 8.0 && py >= glyph_y && py < glyph_y + 8.0) {
                let col = u32(px - glyph_x);
                let row = u32(py - glyph_y);
                let sample_val = glyph_pixel(tc.glyphs[gi], row, col);
                if (sample_val > 0.5) {
                    let text_color = vec4<f32>(tc.color_r, tc.color_g, tc.color_b, 1.0);
                    color = mix(color, text_color, 1.0);
                }
            }
        }
    }

    return color;
}
