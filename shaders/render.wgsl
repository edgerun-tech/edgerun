// --- Border Dash Patterns ---
// Generated from border_lut.rs (9 patterns, 8 bytes each)

const BORDER_PATTERN_NONE: array<u32, 8> = array<u32, 8>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u);
const BORDER_PATTERN_SOLID: array<u32, 8> = array<u32, 8>(1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u);
const BORDER_PATTERN_DASHED: array<u32, 8> = array<u32, 8>(1u, 1u, 1u, 1u, 0u, 0u, 0u, 0u);
const BORDER_PATTERN_DOTTED: array<u32, 8> = array<u32, 8>(1u, 0u, 0u, 0u, 1u, 0u, 0u, 0u);
const BORDER_PATTERN_DOUBLE: array<u32, 8> = array<u32, 8>(1u, 1u, 0u, 1u, 1u, 0u, 0u, 0u);
const BORDER_PATTERN_GROOVE: array<u32, 8> = array<u32, 8>(1u, 0u, 1u, 0u, 1u, 0u, 1u, 0u);
const BORDER_PATTERN_RIDGE: array<u32, 8> = array<u32, 8>(1u, 0u, 1u, 0u, 1u, 0u, 1u, 0u);
const BORDER_PATTERN_INSET: array<u32, 8> = array<u32, 8>(1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u);
const BORDER_PATTERN_OUTSET: array<u32, 8> = array<u32, 8>(1u, 1u, 1u, 1u, 1u, 1u, 1u, 1u);

fn border_pattern(style: u32) -> array<u32, 8> {
    switch style {
        case 0u: { return BORDER_PATTERN_NONE; }
        case 1u: { return BORDER_PATTERN_SOLID; }
        case 2u: { return BORDER_PATTERN_DASHED; }
        case 3u: { return BORDER_PATTERN_DOTTED; }
        case 4u: { return BORDER_PATTERN_DOUBLE; }
        case 5u: { return BORDER_PATTERN_GROOVE; }
        case 6u: { return BORDER_PATTERN_RIDGE; }
        case 7u: { return BORDER_PATTERN_INSET; }
        case 8u: { return BORDER_PATTERN_OUTSET; }
        default: { return BORDER_PATTERN_NONE; }
    }
}

fn border_dash_test(pixel_offset: u32, style: u32) -> bool {
    let pattern = border_pattern(style);
    return pattern[pixel_offset % 8u] == 1u;
}


// --- Blend Modes ---
// Generated from blend_lut.rs (CSS Compositing Level 1)
// 12 per-channel blend modes, converted from 0-255 integer to 0-1 float

// Per-channel blend functions (0-1 float range)
fn blend_normal(src: f32, dst: f32) -> f32 {
    return clamp(src, 0.0, 1.0);
}

fn blend_multiply(src: f32, dst: f32) -> f32 {
    return clamp(src * dst, 0.0, 1.0);
}

fn blend_screen(src: f32, dst: f32) -> f32 {
    return clamp(1.0 - (1.0 - src) * (1.0 - dst), 0.0, 1.0);
}

fn blend_overlay(src: f32, dst: f32) -> f32 {
    var result: f32;
    if (dst < 0.5) { result = 2.0 * src * dst; }
    else { result = 1.0 - 2.0 * (1.0 - src) * (1.0 - dst); }
    return clamp(result, 0.0, 1.0);
}

fn blend_darken(src: f32, dst: f32) -> f32 {
    return clamp(min(src, dst), 0.0, 1.0);
}

fn blend_lighten(src: f32, dst: f32) -> f32 {
    return clamp(max(src, dst), 0.0, 1.0);
}

fn blend_colordodge(src: f32, dst: f32) -> f32 {
    var result: f32;
    if (dst == 0.0) { result = 0.0; }
    else if (src == 1.0) { result = 1.0; }
    else { result = clamp(dst / (1.0 - src), 0.0, 1.0); }
    return clamp(result, 0.0, 1.0);
}

fn blend_colorburn(src: f32, dst: f32) -> f32 {
    var result: f32;
    if (dst == 1.0) { result = 1.0; }
    else if (src == 0.0) { result = 0.0; }
    else { result = clamp(1.0 - (1.0 - dst) / src, 0.0, 1.0); }
    return clamp(result, 0.0, 1.0);
}

fn blend_hardlight(src: f32, dst: f32) -> f32 {
    var result: f32;
    if (src < 0.5) { result = 2.0 * src * dst; }
    else { result = 1.0 - 2.0 * (1.0 - src) * (1.0 - dst); }
    return clamp(result, 0.0, 1.0);
}

fn blend_softlight(src: f32, dst: f32) -> f32 {
    var result: f32;
    if (src <= 0.5) {
        result = dst - (1.0 - dst) * dst * (0.5 - src);
    } else {
        let v = select(sqrt(dst) * 0.25, dst, dst <= 0.25);
        result = dst + dst * (1.0 - dst) * (src - 0.5) / max(v, 0.001);
    }
    return clamp(result, 0.0, 1.0);
}

fn blend_difference(src: f32, dst: f32) -> f32 {
    return clamp(abs(src - dst), 0.0, 1.0);
}

fn blend_exclusion(src: f32, dst: f32) -> f32 {
    return clamp(src + dst - 2.0 * src * dst, 0.0, 1.0);
}

// Blend mode dispatch
fn blend_channel(src: f32, dst: f32, mode: u32) -> f32 {
    switch mode {
        case 0u: { return blend_normal(src, dst); }
        case 1u: { return blend_multiply(src, dst); }
        case 2u: { return blend_screen(src, dst); }
        case 3u: { return blend_overlay(src, dst); }
        case 4u: { return blend_darken(src, dst); }
        case 5u: { return blend_lighten(src, dst); }
        case 6u: { return blend_colordodge(src, dst); }
        case 7u: { return blend_colorburn(src, dst); }
        case 8u: { return blend_hardlight(src, dst); }
        case 9u: { return blend_softlight(src, dst); }
        case 10u: { return blend_difference(src, dst); }
        case 11u: { return blend_exclusion(src, dst); }
        default: { return src; }
    }
}

fn apply_blend_mode(src: vec4<f32>, dst: vec4<f32>, mode: u32) -> vec4<f32> {
    return vec4<f32>(
        blend_channel(src.r, dst.r, mode),
        blend_channel(src.g, dst.g, mode),
        blend_channel(src.b, dst.b, mode),
        src.a,
    );
}


