              (i32.store (global.get $OFF_EXEC_CALL_DEPTH) (i32.add (local.get $p) (i32.const 1)))
              (local.set $err (call $exec_fn (local.get $type_idx) (global.get $OFF_CALL_ARGS) (local.get $val)))
              (if (local.get $err) (then (return (local.get $err))))
