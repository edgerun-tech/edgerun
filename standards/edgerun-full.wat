                      )
                    )
                  )
                  (i32.store (global.get $OFF_EXEC_RES_COUNT) (local.get $result_count))
                  (i32.store (global.get $OFF_EXEC_CTRL_LEN) (i32.const 0))  ;; reset control stack
                  (i32.store (global.get $OFF_EXEC_STACK_LEN) (global.get $FAST_STACK_LEN))
                  (br $dispatch_end)
                )
