                    (i32.wrap_i64 (i64.load (i32.add (global.get $OFF_EXEC_RESULT) (i32.shl (local.get $i) (i32.const 3)))))
                  ))
                  (if (local.get $err) (then (return (local.get $err))))
                  (local.set $i (i32.add (local.get $i) (i32.const 1)))
                  (br $ci_res_cont)
