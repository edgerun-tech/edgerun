    (call $patch_rel8 (local.get $udf_p))
    (call $emit_mov_eax_imm32 (i32.const 0x80000000))
    ;; .done
    (call $patch_rel8 (local.get $done_p))
    (call $emit_maybe_push_rax)
  )

