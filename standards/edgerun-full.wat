  ;; Helper: load 4-byte constant into xmm1 (push_imm32 + pop + movd xmm1)
  (func $load_imm32_xmm1 (param $val i32)
    (call $emit_push_imm32 (local.get $val))
    (call $emit_pop_rax)
    (call $emit_byte (i32.const 0x66))
    (call $emit_byte (i32.const 0x0F))
