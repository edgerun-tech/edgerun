    ;; Select
    (call $emit_rex_w)
    (call $emit_byte (i32.const 0x85))
    (call $emit_modrm (i32.const 3) (i32.const 2) (i32.const 2))  ;; test rdx, rdx
    (call $emit_cmovns_rax_rdx)
    (call $emit_maybe_push_rax)
  )

