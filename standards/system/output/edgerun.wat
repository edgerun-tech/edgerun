    (func $quote_span_source
      (param $interpolated i32)
      (param $quote_spanned i32)
      (result i32)
      local.get $quote_spanned
      call $bool
      if (result i32)
        i32.const 3
      else
        local.get $interpolated
        call $bool
        if (result i32)
          i32.const 2
        else
          i32.const 1
        end
      end)
