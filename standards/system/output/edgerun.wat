    ;; Memory layout:
    ;; 0-255: S-box
    ;; 256-265: Rcon
    ;; 16384-16607: round keys (224 bytes — 11 × 16 + spare)
    ;; 16608-16623: counter buffer
    ;; 16624-16639: keystream block
