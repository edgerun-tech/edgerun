                    (local.set $err (call $itp_ctrl_pop))
                    (if (local.get $err) (then (return (local.get $err))))
                    (local.set $kind (i32.load (global.get $itp_OFF_SCRATCH0)))
                    (local.set $target (i32.load (global.get $itp_OFF_SCRATCH1)))
                    ;; For loops, jump back to loop start (target is loop's own pos)
                    (if (i32.eq (local.get $kind) (i32.const 0x03))  ;; LOOP
                      (then
                        (local.set $dec_idx (local.get $target))
                        (br $dispatch_loop)
                      )
                    )
                    ;; For block/if/else: fall through to next op
                    (local.set $dec_idx (i32.add (local.get $dec_idx) (i32.const 1)))
                    (br $dispatch_loop)
                  )
                )
            )  ;; close $h12
                ;; imm0 = label depth
                (local.set $err (call $itp_ctrl_peek (local.get $imm0)))
                (if (local.get $err) (then (return (local.get $err))))
                (local.set $target (i32.load (global.get $itp_OFF_SCRATCH1)))
                (local.set $dec_idx (local.get $target))
                (br $dispatch_loop)
            )  ;; close $h13
                (local.set $err (call $itp_stack_pop))
                (if (local.get $err) (then (return (local.get $err))))
                (local.set $val (i32.load (global.get $itp_OFF_SCRATCH0)))
                (if (i32.eqz (local.get $val))
                  (then
                    ;; condition is 0: fall through
                    (local.set $dec_idx (i32.add (local.get $dec_idx) (i32.const 1)))
                    (br $dispatch_loop)
                  )
                )
                ;; condition is true: branch
                (local.set $err (call $itp_ctrl_peek (local.get $imm0)))
                (if (local.get $err) (then (return (local.get $err))))
                (local.set $target (i32.load (global.get $itp_OFF_SCRATCH1)))
                (local.set $dec_idx (local.get $target))
                (br $dispatch_loop)
            )  ;; close $h14
                ;; imm0 = number of labels (count)
                ;; imm1 = default label depth (stored by decoder)
                ;; Pop selector value (to keep stack balanced)
                (local.set $err (call $itp_stack_pop))
                (if (local.get $err) (then (return (local.get $err))))
                ;; For MVP: use default label from imm1
                (local.set $err (call $itp_ctrl_peek (local.get $imm1)))
                (if (local.get $err) (then (return (local.get $err))))
                (local.set $target (i32.load (global.get $itp_OFF_SCRATCH1)))
                (local.set $dec_idx (local.get $target))
                (br $dispatch_loop)
            )  ;; close $h15
                  ;; Pop result_count values into result buffer
                  (if (local.get $result_count)
                    (then
                      (local.set $i (i32.sub (local.get $result_count) (i32.const 1)))
                      (block $ret_res_lp
                        (loop $ret_res_cont
                          (if (i32.lt_s (local.get $i) (i32.const 0)) (then (br $ret_res_lp)))
                          (local.set $err (call $itp_stack_pop))
                          (if (local.get $err) (then (return (local.get $err))))
                          (i64.store
                            (i32.add (global.get $itp_OFF_EXEC_RESULT) (i32.shl (local.get $i) (i32.const 3)))
                            (i64.extend_i32_u (i32.load (global.get $itp_OFF_SCRATCH0)))
                          )
                          (local.set $i (i32.sub (local.get $i) (i32.const 1)))
                          (br $ret_res_cont)
                        )
                      )
                    )
                  )
                  (i32.store (global.get $itp_OFF_EXEC_RES_COUNT) (local.get $result_count))
                ;; Reset control stack
                (i32.store (global.get $itp_OFF_EXEC_CTRL_LEN) (i32.const 0))
                (i32.store (global.get $itp_OFF_EXEC_STACK_LEN) (global.get $itp_FAST_STACK_LEN))
                (br $dispatch_end)
            )  ;; close $h16
                ;; imm0 = function index
                ;; Check if it's an imported function
                (if (i32.lt_u (local.get $imm0) (i32.load (global.get $itp_OFF_IMPORT_COUNT)))
                  (then (return (global.get $itp_ERR_MISS_IMP)))
                )
                ;; Look up type to get param count (adjust for imports)
                (local.set $val (i32.load (i32.add (global.get $itp_OFF_FUNCTIONS_BUF) (i32.mul (i32.sub (local.get $imm0) (i32.load (global.get $itp_OFF_IMPORT_COUNT))) (global.get $itp_SZ_FUNC)))))
                (local.set $val (i32.add (global.get $itp_OFF_TYPES_BUF) (i32.mul (local.get $val) (global.get $itp_SZ_TYPE))))
                (local.set $val (i32.load16_u (i32.add (local.get $val) (i32.const 128))))  ;; param_count
                ;; Pop params into call args buffer (reversed order - WASM convention)
                (local.set $i (i32.sub (local.get $val) (i32.const 1)))
                (block $pop_params
                  (loop $pop_cont
                    (if (i32.lt_s (local.get $i) (i32.const 0)) (then (br $pop_params)))
                    (local.set $err (call $itp_stack_pop))
                    (if (local.get $err) (then (return (local.get $err))))
                    (i32.store
                      (i32.add (global.get $itp_OFF_CALL_ARGS) (i32.shl (local.get $i) (i32.const 2)))
                      (i32.load (global.get $itp_OFF_SCRATCH0))
                    )
                    (local.set $i (i32.sub (local.get $i) (i32.const 1)))
                    (br $pop_cont)
                  )
                )
                ;; Flush cached stack length to memory before call
                (i32.store (global.get $itp_OFF_EXEC_STACK_LEN) (global.get $itp_FAST_STACK_LEN))
                ;; Save current state to frame save area
                (local.set $p (i32.load (global.get $itp_OFF_EXEC_CALL_DEPTH)))
                (local.set $op_base (i32.add (global.get $itp_OFF_FRAME_SAVE) (i32.mul (local.get $p) (i32.const 272))))
