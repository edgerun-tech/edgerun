    ;; Prologue: push rbp; mov rbp, rsp
    (func $cmp_emit_prologue
      (call $cmp_emit_byte (i32.const 0x55))       ;; push rbp
      (call $cmp_emit_rex_w)                        ;; REX.W
      (call $cmp_emit_byte (i32.const 0x89))        ;; mov rbp, rsp
      (call $cmp_emit_modrm (i32.const 3) (i32.const 4) (i32.const 5))
    )
