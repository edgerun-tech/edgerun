    (func $cmp_emit_movq_xmm1_rax
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0x66))
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x6E))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 1) (i32.const 0))
