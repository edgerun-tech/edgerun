      (call $pack (i32.const 0) (local.get $sum)))
    ;; Insert-plan output record, little-endian:
    ;; 0:u32 new_entry_size
    ;; 4:u32 retained_size
    ;; 8:u32 evict_existing_count
    ;; 12:u32 inserted
