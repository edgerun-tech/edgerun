    ;; Init all JIT state to known values
    (func $cmp_jit_reset_state
      (i32.store (global.get $cmp_JS_CODE_PTR) (i32.const 0))
      (i32.store (global.get $cmp_JS_LABEL_DEPTH) (i32.const 0))
      (i32.store (global.get $cmp_JS_FIXUP_COUNT) (i32.const 0))
      (i32.store (global.get $cmp_JS_RETURN_EMITTED) (i32.const 0))
      (i32.store (global.get $cmp_JS_STACK_DEPTH) (i32.const 0))
      (i32.store (global.get $cmp_JS_MAX_STACK) (i32.const 0))
    )
    ;; Get word at decoded_op_ptr + offset
    (func $cmp_get_decoded_imm (param $dec_ptr i32) (param $offset i32) (result i32)
      (i32.load (i32.add (local.get $dec_ptr) (local.get $offset)))
    )
    ;; (export "get_code" signature TBD)
    (func $cmp_get_compiled_code (export "get_compiled_code") (param $func_idx i32) (result i32 i32)
      (local $slot i32) (local $base i32)
      (local.set $slot (i32.and (local.get $func_idx) (i32.const 3)))
      (local.set $base (i32.add (global.get $cmp_JIT_CACHE) (i32.mul (local.get $slot) (global.get $cmp_JIT_SLOT_SIZE))))
      (local.get $base)
      (i32.sub (i32.load (global.get $cmp_JS_CODE_PTR)) (i32.mul (local.get $slot) (global.get $cmp_JIT_SLOT_SIZE)))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Opcode templates — each emits x86_64 code for one WASM opcode
    ;; Caller sets: rdi = decoded_op_ptr before calling template
    ;; ═════════════════════════════════════════════════════════════════════
    ;; ── unreachable (0x00): ud2 ────────────────────────────────────────
    (func $cmp_template_unreachable
      (call $cmp_emit_ud2)
    )
    ;; ── nop (0x01): nothing ────────────────────────────────────────────
    (func $cmp_template_nop)
    ;; ── drop (0x1A): add rsp, 8 ───────────────────────────────────────
    (func $cmp_template_drop
      (call $cmp_emit_add_rsp_imm (i32.const 8))
    )
    ;; ── select (0x1B): pop cond, pop val2, pop val1; push val1 if cond!=0 else val2 ──
    (func $cmp_template_select
      (call $cmp_emit_pop_rax)          ;; cond
      (call $cmp_emit_test_eax)         ;; set ZF
      (call $cmp_emit_pop_reg (i32.const 1))  ;; pop rcx = val2
      (call $cmp_emit_pop_reg (i32.const 2))  ;; pop rdx = val1
      (call $cmp_emit_cmove_rdx_rcx)    ;; if ZF (cond==0), rdx = rcx (val2)
      (call $cmp_emit_push_reg (i32.const 2)) ;; push rdx
    )
    ;; ── i32.const (0x41): push imm32 ──────────────────────────────────
    (func $cmp_template_i32_const (param $dec_ptr i32)
      (call $cmp_emit_push_imm32 (i32.load (i32.add (local.get $dec_ptr) (i32.const 4))))
    )
    ;; ── i64.const (0x42): push imm64 ──────────────────────────────────
    (func $cmp_template_i64_const (param $dec_ptr i32)
      (local $val i64)
      (local.set $val (i64.load (i32.add (local.get $dec_ptr) (i32.const 4))))
      ;; mov rax, imm64 (REX.W B8 + qword); push rax
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0xB8))
      (call $cmp_emit_qword (local.get $val))
      (call $cmp_emit_maybe_push_rax)
    )
    ;; ── local.get (0x20): mov rax, [rdx + index*8]; push rax ──────────
    (func $cmp_template_local_get (param $dec_ptr i32)
      (local $idx i32) (local $disp i32)
      (local.set $idx (i32.load (i32.add (local.get $dec_ptr) (i32.const 4))))
      (if (i32.eqz (local.get $idx))
        (then (call $cmp_emit_push_r12))
        (else
          (if (i32.eq (local.get $idx) (i32.const 1))
            (then (call $cmp_emit_push_r13))
            (else
              (local.set $disp (i32.shl (local.get $idx) (i32.const 3)))
              (call $cmp_emit_load_rax_rbx_disp (local.get $disp))
              (call $cmp_emit_maybe_push_rax)
            )
          )
        )
      )
    )
    ;; ── local.set (0x21): pop rax/reg; store to locals ──────────────────
    (func $cmp_template_local_set (param $dec_ptr i32)
      (local $idx i32) (local $disp i32)
      (local.set $idx (i32.load (i32.add (local.get $dec_ptr) (i32.const 4))))
      (if (global.get $cmp_RESULT_IN_EAX)
        (then
          ;; Result already in eax — directly store (skip pop)
          (global.set $cmp_RESULT_IN_EAX (i32.const 0))
          (if (i32.eqz (local.get $idx))
            (then (call $cmp_emit_store_rax_r12))
            (else
              (if (i32.eq (local.get $idx) (i32.const 1))
                (then (call $cmp_emit_store_rax_r13))
                (else
                  (local.set $disp (i32.shl (local.get $idx) (i32.const 3)))
                  (call $cmp_emit_store_rax_rbx_disp (local.get $disp))
                )
              )
            )
          )
        )
        (else
          ;; Normal path: pop from stack
