      local.get $c
      i32.const 128
      i32.ge_u
      local.get $c
      i32.const 191
      i32.le_u
      i32.and)
    (func $write_scan (param $out i32) (param $valid i32) (param $err_len i32) (param $suffix i32) (param $expected i32)
      local.get $out
