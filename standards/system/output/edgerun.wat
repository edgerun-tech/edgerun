        (loop $again
          (if (i32.le_u (local.get $retained_size) (local.get $new_max_size))
            (then (br $done)))
          (if (i32.ge_u (local.get $evict_count) (local.get $oldest_count))
            (then (return (i32.const 7))))
          (if
            (i32.ne
              (i32.load
                (i32.add
                  (local.get $tracked_ptr)
                  (i32.mul (local.get $evict_count) (i32.const 4))))
              (i32.const 0))
