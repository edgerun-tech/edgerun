    (func $cmp_emit_sse3a_op (param $opcode i32) (param $mode i32)
      (call $cmp_emit_byte (i32.const 0x66))
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x3A))
      (call $cmp_emit_byte (local.get $opcode))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))  ;; xmm0, xmm0
      (call $cmp_emit_byte (local.get $mode))
