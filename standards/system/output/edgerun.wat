      (local $status i32)
      (local $consumed i32)
      (local $payload_len i64)
      (if
        (i32.or
          (i32.lt_u (local.get $size) (i32.const 2))
          (i32.gt_u (local.get $size) (i32.const 8)))
        (then (return (i32.const 3))))
      (local.set $prefix_bits (i32.sub (local.get $size) (i32.const 1)))
