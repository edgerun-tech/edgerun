      (call $cmp_emit_byte (i32.const 0x9B))   ;; setnp al
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
      ;; mov ah, al (88 E0)
      (call $cmp_emit_byte (i32.const 0x88))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 4) (i32.const 0))  ;; mov ah, al
    )
    ;; setp al (0F 9A C0) — mov ah, al (for NaN in ne)
    (func $cmp_emit_setp_save_ah
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x9A))   ;; setp al
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
      (call $cmp_emit_byte (i32.const 0x88))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 4) (i32.const 0))
    )
    ;; setcc (cl=opcode), and al, ah, movzx eax, al, push rax
    ;; Used for NaN-safe eq/lt/le where result must be 0 on NaN
    (func $cmp_emit_setcc_and_push (param $cl i32)
      (call $cmp_emit_setcc (local.get $cl))
      ;; and al, ah (20 E0)
      (call $cmp_emit_byte (i32.const 0x20))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 4) (i32.const 0))
      (call $cmp_emit_movzx_eax_al)
      (call $cmp_emit_maybe_push_rax)
    )
    ;; setp al, setne al, or al, ah, movzx, push (for NaN-safe ne)
    (func $cmp_emit_setcc_or_push (param $cl i32)
      (call $cmp_emit_setcc (local.get $cl))
      ;; or al, ah (08 E0)
      (call $cmp_emit_byte (i32.const 0x08))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 4) (i32.const 0))
      (call $cmp_emit_movzx_eax_al)
      (call $cmp_emit_maybe_push_rax)
    )
    ;; emit get_current_code_ptr → i32 (offset from cache base)
    (func $cmp_get_code_ptr (result i32)
