                    ;; Mark as dropped
                    (i32.store
                      (i32.add (global.get $itp_OFF_ELEM_BUF) (i32.mul (local.get $imm1) (global.get $itp_SZ_ELEM)))
                      (i32.const 1)
                    )
                    (local.set $dec_idx (i32.add (local.get $dec_idx) (i32.const 1)))
                    (br $dispatch_loop)
                  )
                )
                ;; ── table.copy (0x0E) ──
                (if (i32.eq (local.get $imm0) (i32.const 0x0E))
                  (then
                    (if (i32.eqz (i32.load8_u (global.get $itp_OFF_TABLE_HAS))) (then (return (global.get $itp_ERR_TRAP))))
                    ;; Pop n, src_idx, dst_idx
                    (local.set $err (call $itp_stack_pop))
                    (if (local.get $err) (then (return (local.get $err))))
                    (local.set $imm2 (i32.load (global.get $itp_OFF_SCRATCH0)))  ;; n
                    (local.set $err (call $itp_stack_pop))
                    (if (local.get $err) (then (return (local.get $err))))
                    (local.set $imm3 (i32.load (global.get $itp_OFF_SCRATCH0)))  ;; src_idx
                    (local.set $err (call $itp_stack_pop))
                    (if (local.get $err) (then (return (local.get $err))))
                    (local.set $val (i32.load (global.get $itp_OFF_SCRATCH0)))   ;; dst_idx
                    ;; Bounds check
                    (local.set $p (i32.load (global.get $itp_OFF_TABLE_MIN)))
                    (if (i32.or
                      (i32.gt_u (i32.add (local.get $val) (local.get $imm2)) (local.get $p))
                      (i32.gt_u (i32.add (local.get $imm3) (local.get $imm2)) (local.get $p))
                    ) (then (return (global.get $itp_ERR_TRAP))))
                    ;; Copy (with overlap handling: use forward/backward as appropriate)
                    (if (i32.lt_u (local.get $val) (local.get $imm3))
                      (then
                        ;; Forward copy
                        (local.set $i (i32.const 0))
                        (block $tcf_lp
                          (loop $tcf_cont
                            (if (i32.ge_u (local.get $i) (local.get $imm2)) (then (br $tcf_lp)))
                            (i32.store
                              (i32.add (global.get $itp_OFF_TABLE_DATA) (i32.shl (i32.add (local.get $val) (local.get $i)) (i32.const 2)))
                              (i32.load
                                (i32.add (global.get $itp_OFF_TABLE_DATA) (i32.shl (i32.add (local.get $imm3) (local.get $i)) (i32.const 2)))
                              )
                            )
                            (local.set $i (i32.add (local.get $i) (i32.const 1)))
                            (br $tcf_cont)
                          )
                        )
                      )
                      (else
                        ;; Backward copy for overlapping ranges
                        (local.set $i (local.get $imm2))
                        (block $tcb_lp
                          (loop $tcb_cont
                            (if (i32.eqz (local.get $i)) (then (br $tcb_lp)))
                            (local.set $i (i32.sub (local.get $i) (i32.const 1)))
                            (i32.store
                              (i32.add (global.get $itp_OFF_TABLE_DATA) (i32.shl (i32.add (local.get $val) (local.get $i)) (i32.const 2)))
                              (i32.load
                                (i32.add (global.get $itp_OFF_TABLE_DATA) (i32.shl (i32.add (local.get $imm3) (local.get $i)) (i32.const 2)))
                              )
                            )
                            (br $tcb_cont)
                          )
                        )
                      )
                    )
                    (local.set $dec_idx (i32.add (local.get $dec_idx) (i32.const 1)))
                    (br $dispatch_loop)
                  )
                )
                ;; ── table.grow (0x0F) ──
                (if (i32.eq (local.get $imm0) (i32.const 0x0F))
                  (then
                    (if (i32.eqz (i32.load8_u (global.get $itp_OFF_TABLE_HAS))) (then (return (global.get $itp_ERR_TRAP))))
                    ;; Pop delta (i32), then value (ref) from stack
                    (local.set $err (call $itp_stack_pop))
                    (if (local.get $err) (then (return (local.get $err))))
                    (local.set $p (i32.load (global.get $itp_OFF_SCRATCH0)))    ;; delta
                    (local.set $err (call $itp_stack_pop))
                    (if (local.get $err) (then (return (local.get $err))))
                    (local.set $val (i32.load (global.get $itp_OFF_SCRATCH0)))  ;; value
                    ;; Old size
                    (local.set $imm2 (i32.load (global.get $itp_OFF_TABLE_MIN)))
                    (local.set $imm3 (i32.load (global.get $itp_OFF_TABLE_MAX)))
                    ;; Check growth fits in max
                    (if (i32.gt_u (i32.add (local.get $imm2) (local.get $p)) (local.get $imm3))
                      (then
                        ;; Can't grow: push -1
                        (local.set $err (call $itp_stack_push (i32.const -1)))
                      )
                      (else
                        ;; Grow: update min, init new entries with value
                        (local.set $i (i32.const 0))
                        (block $tg_lp
                          (loop $tg_cont
                            (if (i32.ge_u (local.get $i) (local.get $p)) (then (br $tg_lp)))
                            (i32.store
                              (i32.add (global.get $itp_OFF_TABLE_DATA) (i32.shl (i32.add (local.get $imm2) (local.get $i)) (i32.const 2)))
                              (local.get $val)
                            )
                            (local.set $i (i32.add (local.get $i) (i32.const 1)))
                            (br $tg_cont)
                          )
                        )
                        (i32.store (global.get $itp_OFF_TABLE_MIN) (i32.add (local.get $imm2) (local.get $p)))
                        ;; Push old size
                        (local.set $err (call $itp_stack_push (local.get $imm2)))
                      )
                    )
                    (if (local.get $err) (then (return (local.get $err))))
                    (local.set $dec_idx (i32.add (local.get $dec_idx) (i32.const 1)))
                    (br $dispatch_loop)
                  )
                )
                ;; ── table.size (0x10) ──
                (if (i32.eq (local.get $imm0) (i32.const 0x10))
                  (then
                    (if (i32.eqz (i32.load8_u (global.get $itp_OFF_TABLE_HAS))) (then (return (global.get $itp_ERR_TRAP))))
                    (local.set $err (call $itp_stack_push (i32.load (global.get $itp_OFF_TABLE_MIN))))
                    (if (local.get $err) (then (return (local.get $err))))
                    (local.set $dec_idx (i32.add (local.get $dec_idx) (i32.const 1)))
                    (br $dispatch_loop)
                  )
                )
                ;; ── table.fill (0x11) ──
                (if (i32.eq (local.get $imm0) (i32.const 0x11))
                  (then
                    (if (i32.eqz (i32.load8_u (global.get $itp_OFF_TABLE_HAS))) (then (return (global.get $itp_ERR_TRAP))))
                    ;; Pop n, val, idx
                    (local.set $err (call $itp_stack_pop))
                    (if (local.get $err) (then (return (local.get $err))))
                    (local.set $imm2 (i32.load (global.get $itp_OFF_SCRATCH0)))  ;; n
                    (local.set $err (call $itp_stack_pop))
                    (if (local.get $err) (then (return (local.get $err))))
                    (local.set $val (i32.load (global.get $itp_OFF_SCRATCH0)))   ;; val
                    (local.set $err (call $itp_stack_pop))
                    (if (local.get $err) (then (return (local.get $err))))
                    (local.set $p (i32.load (global.get $itp_OFF_SCRATCH0)))     ;; idx
                    ;; Bounds check
                    (if (i32.gt_u (i32.add (local.get $p) (local.get $imm2)) (i32.load (global.get $itp_OFF_TABLE_MIN)))
                      (then (return (global.get $itp_ERR_TRAP)))
                    )
                    ;; Fill
                    (local.set $i (i32.const 0))
                    (block $tfl_lp
                      (loop $tfl_cont
                        (if (i32.ge_u (local.get $i) (local.get $imm2)) (then (br $tfl_lp)))
                        (i32.store
                          (i32.add (global.get $itp_OFF_TABLE_DATA) (i32.shl (i32.add (local.get $p) (local.get $i)) (i32.const 2)))
                          (local.get $val)
                        )
                        (local.set $i (i32.add (local.get $i) (i32.const 1)))
                        (br $tfl_cont)
                      )
                    )
                    (local.set $dec_idx (i32.add (local.get $dec_idx) (i32.const 1)))
                    (br $dispatch_loop)
                  )
                )
                (return (global.get $itp_ERR_UNSUP))
            )  ;; close $h253
          (return (global.get $itp_ERR_UNSUP))
            )  ;; close $h254
          (return (global.get $itp_ERR_UNSUP))
            )  ;; close $h255
          (return (global.get $itp_ERR_UNSUP))
          )  ;; close $unsup
          )
          ;; Fallthrough increment for ops that didn't handle dec_idx
          (local.set $dec_idx (i32.add (local.get $dec_idx) (i32.const 1)))
          (br $dispatch_loop)
        )
      )
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; call: call an exported function by index
    ;; ═════════════════════════════════════════════════════════════════════
    (func (export "call") (param $func_idx i32) (param $args_ptr i32) (param $args_len i32) (result i32)
      ;; Reset execution state
      (i32.store (global.get $itp_OFF_EXEC_STACK_LEN) (i32.const 0))
      (i32.store (global.get $itp_OFF_EXEC_CTRL_LEN) (i32.const 0))
      (i32.store (global.get $itp_OFF_EXEC_RES_COUNT) (i32.const 0))
      ;; Check module is loaded
      (if (i32.eqz (i32.load8_u (global.get $itp_OFF_EXEC_MOD_VALID)))
        (then (return (global.get $itp_ERR_BAD_ARGUMENT)))
      )
      (return (call $itp_exec_fn (local.get $func_idx) (local.get $args_ptr) (local.get $args_len)))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; load: main entry point
    ;; ═════════════════════════════════════════════════════════════════════
    (func (export "load") (param $wasm_ptr i32) (param $wasm_len i32) (result i32)
      (local $offset i32) (local $err i32) (local $start_func i32) (local $sec_id i32)
      (i32.store (global.get $itp_OFF_WASM_PTR) (local.get $wasm_ptr))
      (i32.store (global.get $itp_OFF_WASM_LEN) (local.get $wasm_len))
      ;; Reset state
      (i32.store (global.get $itp_OFF_TYPE_COUNT) (i32.const 0))
      (i32.store (global.get $itp_OFF_IMPORT_COUNT) (i32.const 0))
      (i32.store (global.get $itp_OFF_FUNCTION_COUNT) (i32.const 0))
      (i32.store (global.get $itp_OFF_CODE_COUNT) (i32.const 0))
      (i32.store (global.get $itp_OFF_EXPORT_COUNT) (i32.const 0))
      (i32.store (global.get $itp_OFF_GLOBAL_COUNT) (i32.const 0))
      (i32.store (global.get $itp_OFF_START_FUNC) (i32.const -1))
      (i32.store (global.get $itp_OFF_DATA_COUNT) (i32.const 0))
      (i32.store (global.get $itp_OFF_ELEM_COUNT) (i32.const 0))
      (i32.store (global.get $itp_OFF_MEM_MIN) (i32.const 0))
      (i32.store (global.get $itp_OFF_MEM_MAX) (i32.const 0))
      (i32.store (global.get $itp_OFF_GUEST_MEM_PAGES) (i32.const 0))
      (i32.store8 (global.get $itp_OFF_TABLE_HAS) (i32.const 0))
      (i32.store (global.get $itp_OFF_NAMES_PTR) (global.get $itp_OFF_NAMES_BUF))
      (i32.store8 (global.get $itp_OFF_EXEC_MOD_VALID) (i32.const 0))
      (i32.store (global.get $itp_OFF_DECODED_COUNT) (i32.const 0))
      (local.set $err (call $itp_parse_header))
      (if (local.get $err) (then (return (local.get $err))))
      (local.set $offset (i32.const 8))
      (block $sec_loop
        (loop $sec_cont
          (if (i32.ge_u (local.get $offset) (local.get $wasm_len)) (then (br $sec_loop)))
          (local.set $err (call $itp_read_section_header (local.get $offset)))
          (if (local.get $err) (then (return (local.get $err))))
          ;; Save section id to protect against scratch0 clobbering by parsers
          (local.set $sec_id (i32.load (global.get $itp_OFF_SCRATCH0)))
          ;; scratch0=sec_id, scratch1=sec_len, scratch2=content_offset, scratch3=end_offset
          (if (i32.eq (local.get $sec_id) (global.get $itp_SEC_TYPE))
            (then
              (local.set $err (call $itp_parse_type_section
                (i32.load (global.get $itp_OFF_SCRATCH2))
                (i32.load (global.get $itp_OFF_SCRATCH1))
              ))
              (if (local.get $err) (then (return (local.get $err))))
              (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $sec_id))
            )
          )
          (if (i32.eq (local.get $sec_id) (global.get $itp_SEC_IMPORT))
            (then
              (local.set $err (call $itp_parse_import_section
                (i32.load (global.get $itp_OFF_SCRATCH2))
                (i32.load (global.get $itp_OFF_SCRATCH1))
              ))
              (if (local.get $err) (then (return (local.get $err))))
              (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $sec_id))
            )
          )
          (if (i32.eq (local.get $sec_id) (global.get $itp_SEC_FUNCTION))
            (then
              (local.set $err (call $itp_parse_function_section
                (i32.load (global.get $itp_OFF_SCRATCH2))
                (i32.load (global.get $itp_OFF_SCRATCH1))
              ))
              (if (local.get $err) (then (return (local.get $err))))
              (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $sec_id))
            )
          )
          (if (i32.eq (local.get $sec_id) (global.get $itp_SEC_TABLE))
            (then
              (local.set $err (call $itp_parse_table_section
                (i32.load (global.get $itp_OFF_SCRATCH2))
                (i32.load (global.get $itp_OFF_SCRATCH1))
              ))
              (if (local.get $err) (then (return (local.get $err))))
              (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $sec_id))
            )
          )
          (if (i32.eq (local.get $sec_id) (global.get $itp_SEC_MEMORY))
            (then
              (local.set $err (call $itp_parse_memory_section
                (i32.load (global.get $itp_OFF_SCRATCH2))
                (i32.load (global.get $itp_OFF_SCRATCH1))
              ))
              (if (local.get $err) (then (return (local.get $err))))
              (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $sec_id))
            )
          )
          (if (i32.eq (local.get $sec_id) (global.get $itp_SEC_GLOBAL))
            (then
              (local.set $err (call $itp_parse_global_section
                (i32.load (global.get $itp_OFF_SCRATCH2))
                (i32.load (global.get $itp_OFF_SCRATCH1))
              ))
              (if (local.get $err) (then (return (local.get $err))))
              (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $sec_id))
            )
          )
          (if (i32.eq (local.get $sec_id) (global.get $itp_SEC_EXPORT))
            (then
              (local.set $err (call $itp_parse_export_section
                (i32.load (global.get $itp_OFF_SCRATCH2))
                (i32.load (global.get $itp_OFF_SCRATCH1))
              ))
              (if (local.get $err) (then (return (local.get $err))))
              (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $sec_id))
            )
          )
          (if (i32.eq (local.get $sec_id) (global.get $itp_SEC_START))
            (then
              (local.set $err (call $itp_parse_start_section
                (i32.load (global.get $itp_OFF_SCRATCH2))
                (i32.load (global.get $itp_OFF_SCRATCH1))
              ))
              (if (local.get $err) (then (return (local.get $err))))
              (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $sec_id))
            )
          )
          (if (i32.eq (local.get $sec_id) (global.get $itp_SEC_ELEMENT))
            (then
              (local.set $err (call $itp_parse_element_section
                (i32.load (global.get $itp_OFF_SCRATCH2))
                (i32.load (global.get $itp_OFF_SCRATCH1))
              ))
              (if (local.get $err) (then (return (local.get $err))))
              (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $sec_id))
            )
          )
          (if (i32.eq (local.get $sec_id) (global.get $itp_SEC_CODE))
            (then
              (local.set $err (call $itp_parse_code_section
                (i32.load (global.get $itp_OFF_SCRATCH2))
                (i32.load (global.get $itp_OFF_SCRATCH1))
              ))
              (if (local.get $err) (then (return (local.get $err))))
              (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $sec_id))
            )
          )
          (if (i32.eq (local.get $sec_id) (global.get $itp_SEC_DATA))
            (then
              (local.set $err (call $itp_parse_data_section
                (i32.load (global.get $itp_OFF_SCRATCH2))
                (i32.load (global.get $itp_OFF_SCRATCH1))
              ))
              (if (local.get $err) (then (return (local.get $err))))
            )
          )
          ;; custom (0) and data_count (12): silently skipped
          ;; Advance to next section
          (local.set $offset (i32.load (global.get $itp_OFF_SCRATCH3)))
          (br $sec_cont)
        )
      )
      ;; Execute start function if present
      (local.set $start_func (i32.load (global.get $itp_OFF_START_FUNC)))
      (if (i32.ne (local.get $start_func) (i32.const -1))
        (then
          (i32.store (global.get $itp_OFF_EXEC_STACK_LEN) (i32.const 0))
          (i32.store (global.get $itp_OFF_EXEC_CTRL_LEN) (i32.const 0))
          (i32.store (global.get $itp_OFF_EXEC_RES_COUNT) (i32.const 0))
          (local.set $err (call $itp_exec_fn (local.get $start_func) (i32.const 0) (i32.const 0)))
          (if (local.get $err) (then (return (local.get $err))))
        )
      )
      (i32.store8 (global.get $itp_OFF_EXEC_MOD_VALID) (i32.const 1))
      (return (global.get $itp_OK))
    )
    (func (export "get_result_value") (param $idx i32) (result i64)
      (i64.store (global.get $itp_OFF_SCRATCH0)
        (i64.load (i32.add (global.get $itp_OFF_EXEC_RESULT) (i32.shl (local.get $idx) (i32.const 3))))
      )
      (return (i64.load (global.get $itp_OFF_SCRATCH0)))
    )
    (func (export "get_result_count") (result i32)
      (return (i32.load (global.get $itp_OFF_EXEC_RES_COUNT)))
    )

  ;; ═════════════════════════════════════════════════════════════════════
    ;; EdgeRun WASM → x86_64 JIT Compiler
    ;;
    ;; Compiles WASM decoded ops into x86_64 machine code in a memory buffer.
    ;; The generated code can be exported and executed natively by a host.
    ;;
    ;; Uses the same linear memory as the interpreter (imported).
    ;; ═════════════════════════════════════════════════════════════════════
    ;; ── Constants: interpreter data offsets (same as interpreter.wat) ──
    (global $cmp_OFF_TYPES_BUF  i32 (i32.const 264))
    (global $cmp_OFF_CODE_BUF   i32 (i32.const 21792))
    (global $cmp_OFF_FUNCTIONS_BUF i32 (i32.const 17688))
    (global $cmp_OFF_DECODED_OPS i32 (i32.const 0xA0000))
    (global $cmp_OFF_DECODED_COUNT i32 (i32.const 89864))
    (global $cmp_FUNC_TYPE_SIZE i32 (i32.const 256))
    (global $cmp_CODE_SIZE      i32 (i32.const 64))
    (global $cmp_FUNCTION_SIZE  i32 (i32.const 16))
    (global $cmp_DEC_SZ         i32 (i32.const 16))
    ;; JIT code cache: 1MB starting at 0x100000
    (global $cmp_JIT_CACHE      i32 (i32.const 0x100000))
    (global $cmp_JIT_CACHE_SIZE i32 (i32.const 0x100000))
    (global $cmp_JIT_SLOT_SIZE  i32 (i32.const 0x40000))  ;; 256KB per function
    ;; JIT state at 0x200000 (after guest binary at 0x200000, so use 0x200000+
    ;; Actually guest binary starts at 0x200000. Let's use 0x300000 for JIT state.
    (global $cmp_JIT_STATE      i32 (i32.const 0x300000))
    ;; JIT state field offsets (relative to JIT_STATE)
    (global $cmp_JS_CODE_PTR       i32 (i32.const 0))
    (global $cmp_JS_CACHE_BASE     i32 (i32.const 4))
    (global $cmp_JS_CACHE_END      i32 (i32.const 8))
    (global $cmp_JS_FUNC_IDX       i32 (i32.const 12))
    (global $cmp_JS_RESULT_COUNT   i32 (i32.const 16))
    (global $cmp_JS_STACK_DEPTH    i32 (i32.const 20))
    (global $cmp_JS_MAX_STACK      i32 (i32.const 24))
    (global $cmp_JS_LABEL_DEPTH    i32 (i32.const 28))
    (global $cmp_JS_RETURN_EMITTED i32 (i32.const 32))
    (global $cmp_JS_LABEL_OFFSETS  i32 (i32.const 64))    ;; 256*i32 = 1024 bytes
    (global $cmp_JS_LABEL_KINDS    i32 (i32.const 1088))   ;; 256*byte = 256 bytes
    (global $cmp_JS_LABEL_IF_JZ    i32 (i32.const 1344))   ;; 256*i32 = 1024 bytes
    (global $cmp_JS_FIXUP_COUNT    i32 (i32.const 2368))
    (global $cmp_JS_FIXUP_LABEL    i32 (i32.const 2372))   ;; 256*i32 = 1024 bytes
    (global $cmp_JS_FIXUP_OFFSET   i32 (i32.const 3396))   ;; 256*i32 = 1024 bytes
    (global $cmp_JS_INITIALIZED    i32 (i32.const 4420))
    ;; Label kinds
    (global $cmp_JIT_LABEL_BLOCK   i32 (i32.const 0))
    (global $cmp_JIT_LABEL_LOOP    i32 (i32.const 1))
    (global $cmp_JIT_LABEL_IF      i32 (i32.const 2))
    ;; Error codes
    (global $cmp_OK                i32 (i32.const 0))
    (global $cmp_ERR_UNSUP         i32 (i32.const -1))
    ;; Peephole optimization flag: set to 1 when result of current op
    ;; is left in eax instead of being pushed to the x86 stack.
    ;; The next op (e.g. local.set) will read from eax directly.
    (global $cmp_RESULT_IN_EAX     (mut i32) (i32.const 0))
    ;; Current decoded op pointer (set before each compile iteration dispatch)
    ;; Used by $cmp_emit_maybe_push_rax for peephole lookahead
    (global $cmp_CURRENT_DEC_PTR   (mut i32) (i32.const 0))
    ;; ── Helper: write bytes to code cache ──────────────────────────────
    ;; Emit a single byte into the code cache, advance code_ptr
    (func $cmp_emit_byte (param $b i32)
      (local $p i32)
      (local.set $p (i32.add (global.get $cmp_JIT_CACHE) (i32.load (global.get $cmp_JS_CODE_PTR))))
      (i32.store8 (local.get $p) (local.get $b))
