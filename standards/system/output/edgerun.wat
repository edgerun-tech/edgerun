        i32.shr_u
        i32.const 63
        i32.and
        call $b64url_char
        i32.store8
        local.get $dst_i
        i32.const 1
        i32.add
        local.set $dst_i
        local.get $out
        local.get $dst_i
        i32.add
        local.get $triple
        i32.const 63
        i32.and
