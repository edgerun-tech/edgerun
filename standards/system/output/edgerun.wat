      local.get $p i32.const 2101248 i32.add local.get $v i32.const 24 i32.shr_u i32.store8
      local.get $p i32.const 1 i32.add local.get $v i32.const 2134016 i32.shr_u i32.const 2101248xFF i32.and i32.store8
