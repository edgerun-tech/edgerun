    ;; i64.load8_s: REX.W movsx rax, byte [rdx+rcx]  (48 0F BE 04 0A)
    (func $cmp_emit_mem_load8_s_64
      (call $cmp_emit_load_r15_to_rdx (i32.const 8))
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0xBE))
      (call $cmp_emit_byte (i32.const 0x04))
      (call $cmp_emit_sib (i32.const 0) (i32.const 1) (i32.const 2))
    )
    ;; i64.load16_s: REX.W movsx rax, word [rdx+rcx]  (48 0F BF 04 0A)
    (func $cmp_emit_mem_load16_s_64
      (call $cmp_emit_load_r15_to_rdx (i32.const 8))
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0xBF))
      (call $cmp_emit_byte (i32.const 0x04))
      (call $cmp_emit_sib (i32.const 0) (i32.const 1) (i32.const 2))
