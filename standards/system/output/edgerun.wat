      (call $cmp_emit_load_r15_to_rdx (i32.const 8))
      (call $cmp_emit_byte (i32.const 0x88))
      (call $cmp_emit_byte (i32.const 0x04))
      (call $cmp_emit_sib (i32.const 0) (i32.const 1) (i32.const 2))
