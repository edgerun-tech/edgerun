        i32.load8_u
        local.set $b0
        local.get $hash
        local.get $src_i
        i32.const 1
        i32.add
        i32.add
        i32.load8_u
        local.set $b1
        local.get $hash
        local.get $src_i
        i32.const 2
        i32.add
        i32.add
        i32.load8_u
        local.set $b2
        local.get $src_i
