      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x2E))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 1))
    )
    ;; ucomiss xmm0, xmm0 (4 bytes: 0F 2E C0) — self-compare for NaN check
    (func $cmp_emit_ucomiss_xmm0
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x2E))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
    )
