        (local.get $max_size)
        (local.get $current_size)
        (local.get $oldest_sizes_ptr)
        (local.get $tracked_ptr)
        (local.get $oldest_count)
        (i32.wrap_i64 (i64.shr_u (local.get $packed) (i64.const 32)))
        (local.get $out_ptr)))
