    (func $cmp_emit_f32_unop_epilogue
      (call $cmp_emit_movd_eax_xmm0)
      (call $cmp_emit_maybe_push_rax)
    )
    ;; ── f64 unary helpers ──────────────────────────────────────────────
    ;; pop rax, movq xmm0, rax
    (func $cmp_emit_f64_unop_prologue
      (call $cmp_emit_pop_reg (i32.const 0))
      (call $cmp_emit_movq_xmm0_rax)
    )
    ;; movq rax, xmm0, push rax
    (func $cmp_emit_f64_unop_epilogue
      (call $cmp_emit_movq_rax_xmm0)
      (call $cmp_emit_maybe_push_rax)
    )
    ;; ── Float comparison helpers ───────────────────────────────────────
    ;; f32 cmp prologue: pop rcx, pop rax, movd xmm1, movd xmm0, ucomiss
    (func $cmp_emit_f32_cmp_prologue
      (call $cmp_emit_pop_reg (i32.const 1))
      (call $cmp_emit_pop_reg (i32.const 0))
      (call $cmp_emit_movd_xmm1_ecx)
      (call $cmp_emit_movd_xmm0_eax)
      (call $cmp_emit_ucomiss)
    )
    ;; f64 cmp prologue: pop rcx, pop rax, movq xmm1, movq xmm0, ucomisd
    (func $cmp_emit_f64_cmp_prologue
      (call $cmp_emit_pop_reg (i32.const 1))
      (call $cmp_emit_pop_reg (i32.const 0))
      (call $cmp_emit_movq_xmm1_rcx)
      (call $cmp_emit_movq_xmm0_rax)
      (call $cmp_emit_ucomisd)
