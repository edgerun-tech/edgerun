    ;; cvtsi2ss xmm0, rax (i64→f32): F3 48 0F 2A C0
    (func $cmp_emit_cvtsi2ss_xmm0_rax
      (call $cmp_emit_byte (i32.const 0xF3))
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x2A))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
    )
    ;; cvtsi2sd xmm0, rax (i64→f64): F2 48 0F 2A C0
    (func $cmp_emit_cvtsi2sd_xmm0_rax
      (call $cmp_emit_byte (i32.const 0xF2))
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x2A))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
    )
    ;; cvttss2si eax, xmm0 (f32→i32): F3 0F 2C C0
    (func $cmp_emit_cvttss2si_eax_xmm0
      (call $cmp_emit_byte (i32.const 0xF3))
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x2C))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
    )
    ;; cvttsd2si eax, xmm0 (f64→i32): F2 0F 2C C0
    (func $cmp_emit_cvttsd2si_eax_xmm0
      (call $cmp_emit_byte (i32.const 0xF2))
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x2C))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
    )
    ;; cvttss2si rax, xmm0 (f32→i64): F3 48 0F 2C C0
    (func $cmp_emit_cvttss2si_rax_xmm0
      (call $cmp_emit_byte (i32.const 0xF3))
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x2C))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
    )
    ;; cvttsd2si rax, xmm0 (f64→i64): F2 48 0F 2C C0
    (func $cmp_emit_cvttsd2si_rax_xmm0
      (call $cmp_emit_byte (i32.const 0xF2))
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x2C))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
    )
    ;; cvtss2sd xmm0, xmm0 (f32→f64 promote): F3 0F 5A C0
    (func $cmp_emit_cvtss2sd_xmm0_xmm0
      (call $cmp_emit_byte (i32.const 0xF3))
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x5A))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
    )
    ;; cvtsd2ss xmm0, xmm0 (f64→f32 demote): F2 0F 5A C0
    (func $cmp_emit_cvtsd2ss_xmm0_xmm0
      (call $cmp_emit_byte (i32.const 0xF2))
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x5A))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
