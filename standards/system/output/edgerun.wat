      (call $cmp_emit_or32)  ;; or eax, ecx
      (call $cmp_emit_maybe_push_rax)
    )
    ;; ── f64 binary templates ──────────────────────────────────────────
    (func $cmp_template_f64_add
      (call $cmp_emit_pop2_rcx_rax)
      (call $cmp_emit_movq_xmm1_rcx)
      (call $cmp_emit_movq_xmm0_rax)
      (call $cmp_emit_sse_op (i32.const 0xF2) (i32.const 0x58))  ;; addsd
      (call $cmp_emit_movq_rax_xmm0)
      (call $cmp_emit_maybe_push_rax)
    )
    (func $cmp_template_f64_sub
      (call $cmp_emit_pop2_rcx_rax)
      (call $cmp_emit_movq_xmm1_rcx)
      (call $cmp_emit_movq_xmm0_rax)
      (call $cmp_emit_sse_op (i32.const 0xF2) (i32.const 0x5C))
      (call $cmp_emit_movq_rax_xmm0)
      (call $cmp_emit_maybe_push_rax)
    )
    (func $cmp_template_f64_mul
      (call $cmp_emit_pop2_rcx_rax)
      (call $cmp_emit_movq_xmm1_rcx)
      (call $cmp_emit_movq_xmm0_rax)
      (call $cmp_emit_sse_op (i32.const 0xF2) (i32.const 0x59))
      (call $cmp_emit_movq_rax_xmm0)
      (call $cmp_emit_maybe_push_rax)
    )
    (func $cmp_template_f64_div
      (call $cmp_emit_pop2_rcx_rax)
      (call $cmp_emit_movq_xmm1_rcx)
      (call $cmp_emit_movq_xmm0_rax)
      (call $cmp_emit_sse_op (i32.const 0xF2) (i32.const 0x5E))
      (call $cmp_emit_movq_rax_xmm0)
      (call $cmp_emit_maybe_push_rax)
    )
    ;; f64.min (0xA4): minsd + NaN fixup
    (func $cmp_template_f64_min
      (local $nan_p i32) (local $done_p i32)
      (call $cmp_emit_pop2_rcx_rax)
      (call $cmp_emit_movq_xmm1_rcx)
      (call $cmp_emit_movq_xmm0_rax)
      (call $cmp_emit_sse_op (i32.const 0xF2) (i32.const 0x5D))  ;; minsd
      (call $cmp_emit_ucomisd_xmm0)
      (call $cmp_emit_jnp_rel8 (i32.const 0))
      (local.set $done_p (call $cmp_get_code_ptr))
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0xB8))
      (call $cmp_emit_dword (i32.const 0x00000000))
      (call $cmp_emit_dword (i32.const 0x7FF80000))  ;; mov rax, 0x7FF8000000000000 (canonical NaN f64)
      (call $cmp_emit_movq_xmm0_rax)
      (call $cmp_patch_rel8 (local.get $done_p))
      (call $cmp_emit_movq_rax_xmm0)
      (call $cmp_emit_maybe_push_rax)
    )
    ;; f64.max (0xA5): maxsd + NaN fixup
    (func $cmp_template_f64_max
      (local $nan_p i32) (local $done_p i32)
      (call $cmp_emit_pop2_rcx_rax)
      (call $cmp_emit_movq_xmm1_rcx)
      (call $cmp_emit_movq_xmm0_rax)
      (call $cmp_emit_sse_op (i32.const 0xF2) (i32.const 0x5F))  ;; maxsd
      (call $cmp_emit_ucomisd_xmm0)
      (call $cmp_emit_jnp_rel8 (i32.const 0))
      (local.set $done_p (call $cmp_get_code_ptr))
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0xB8))
      (call $cmp_emit_dword (i32.const 0x00000000))
      (call $cmp_emit_dword (i32.const 0x7FF80000))
      (call $cmp_emit_movq_xmm0_rax)
      (call $cmp_patch_rel8 (local.get $done_p))
      (call $cmp_emit_movq_rax_xmm0)
      (call $cmp_emit_maybe_push_rax)
    )
    ;; f64.copysign (0xA6): result = abs(left) | signbit(right)
    (func $cmp_template_f64_copysign
      (call $cmp_emit_pop_reg (i32.const 1))  ;; pop rcx = right
      (call $cmp_emit_pop_rax)                 ;; pop rax = left
      (call $cmp_emit_btr_rax_imm8 (i32.const 63))  ;; clear sign of left for magnitude
      ;; isolate sign bit of right: shl rcx, 1; rcr rcx, 1
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0xD1))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 4) (i32.const 1))  ;; shl rcx, 1
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0xD1))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 3) (i32.const 1))  ;; rcr rcx, 1
      (call $cmp_emit_or64)  ;; or rax, rcx
      (call $cmp_emit_maybe_push_rax)
    )
    ;; ── f32 comparison templates ──────────────────────────────────────
    (func $cmp_template_f32_eq
      (call $cmp_emit_f32_cmp_prologue)
      (call $cmp_emit_setnp_save_ah)
      (call $cmp_emit_setcc_and_push (i32.const 0x94))   ;; sete
    )
    (func $cmp_template_f32_ne
      (call $cmp_emit_f32_cmp_prologue)
      (call $cmp_emit_setp_save_ah)
      (call $cmp_emit_setcc_or_push (i32.const 0x95))    ;; setne
    )
    (func $cmp_template_f32_lt
      (call $cmp_emit_f32_cmp_prologue)
      (call $cmp_emit_setnp_save_ah)
      (call $cmp_emit_setcc_and_push (i32.const 0x92))   ;; setb
    )
    (func $cmp_template_f32_gt
      (call $cmp_emit_f32_cmp_prologue)
      (call $cmp_emit_setcc (i32.const 0x97))            ;; seta (NaN-safe: CF=1 → seta=0)
      (call $cmp_emit_movzx_eax_al)
      (call $cmp_emit_maybe_push_rax)
    )
    (func $cmp_template_f32_le
      (call $cmp_emit_f32_cmp_prologue)
      (call $cmp_emit_setnp_save_ah)
      (call $cmp_emit_setcc_and_push (i32.const 0x96))   ;; setbe
    )
    (func $cmp_template_f32_ge
      (call $cmp_emit_f32_cmp_prologue)
      (call $cmp_emit_setcc (i32.const 0x93))            ;; setae
      (call $cmp_emit_movzx_eax_al)
      (call $cmp_emit_maybe_push_rax)
    )
    ;; ── f64 comparison templates ──────────────────────────────────────
    (func $cmp_template_f64_eq
      (call $cmp_emit_f64_cmp_prologue)
      (call $cmp_emit_setnp_save_ah)
      (call $cmp_emit_setcc_and_push (i32.const 0x94))
    )
    (func $cmp_template_f64_ne
      (call $cmp_emit_f64_cmp_prologue)
      (call $cmp_emit_setp_save_ah)
      (call $cmp_emit_setcc_or_push (i32.const 0x95))
    )
    (func $cmp_template_f64_lt
      (call $cmp_emit_f64_cmp_prologue)
      (call $cmp_emit_setnp_save_ah)
      (call $cmp_emit_setcc_and_push (i32.const 0x92))
    )
    (func $cmp_template_f64_gt
      (call $cmp_emit_f64_cmp_prologue)
      (call $cmp_emit_setcc (i32.const 0x97))
      (call $cmp_emit_movzx_eax_al)
      (call $cmp_emit_maybe_push_rax)
    )
    (func $cmp_template_f64_le
      (call $cmp_emit_f64_cmp_prologue)
      (call $cmp_emit_setnp_save_ah)
      (call $cmp_emit_setcc_and_push (i32.const 0x96))
    )
    (func $cmp_template_f64_ge
      (call $cmp_emit_f64_cmp_prologue)
      (call $cmp_emit_setcc (i32.const 0x93))
      (call $cmp_emit_movzx_eax_al)
      (call $cmp_emit_maybe_push_rax)
    )
    ;; ── Float unary templates ────────────────────────────────────────
    (func $cmp_template_f32_abs
      ;; and eax, 0x7FFFFFFF  (bits: clear sign bit)
      (call $cmp_emit_pop_rax)
      (call $cmp_emit_and_eax_imm32 (i32.const 0x7FFFFFFF))
      (call $cmp_emit_maybe_push_rax)
    )
    (func $cmp_template_f32_neg
      ;; xor eax, 0x80000000  (bits: flip sign bit)
      (call $cmp_emit_pop_rax)
      (call $cmp_emit_xor_eax_imm32 (i32.const 0x80000000))
      (call $cmp_emit_maybe_push_rax)
    )
    (func $cmp_template_f32_sqrt
      (call $cmp_emit_f32_unop_prologue)
      (call $cmp_emit_sse_op (i32.const 0xF3) (i32.const 0x51))  ;; sqrtss
      (call $cmp_emit_f32_unop_epilogue)
    )
    (func $cmp_template_f32_ceil
      (call $cmp_emit_f32_unop_prologue)
      (call $cmp_emit_sse3a_op (i32.const 0x0A) (i32.const 2))   ;; roundss, ceil
      (call $cmp_emit_f32_unop_epilogue)
    )
    (func $cmp_template_f32_floor
      (call $cmp_emit_f32_unop_prologue)
      (call $cmp_emit_sse3a_op (i32.const 0x0A) (i32.const 1))   ;; roundss, floor
      (call $cmp_emit_f32_unop_epilogue)
    )
    (func $cmp_template_f32_trunc
      (call $cmp_emit_f32_unop_prologue)
      (call $cmp_emit_sse3a_op (i32.const 0x0A) (i32.const 3))   ;; roundss, trunc
      (call $cmp_emit_f32_unop_epilogue)
    )
    (func $cmp_template_f32_nearest
      (call $cmp_emit_f32_unop_prologue)
      (call $cmp_emit_sse3a_op (i32.const 0x0A) (i32.const 0))   ;; roundss, nearest
      (call $cmp_emit_f32_unop_epilogue)
    )
    ;; ── f32.const (0x43): push 4-byte constant ──────────────────────────
    (func $cmp_template_f32_const (param $dec_ptr i32)
      (call $cmp_emit_push_imm32 (i32.load (i32.add (local.get $dec_ptr) (i32.const 4))))
    )
    ;; ── f64.const (0x44): push 8-byte constant ──────────────────────────
    (func $cmp_template_f64_const (param $dec_ptr i32)
      (local $val i64)
      (local.set $val (i64.load (i32.add (local.get $dec_ptr) (i32.const 4))))
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0xB8))
      (call $cmp_emit_qword (local.get $val))
      (call $cmp_emit_maybe_push_rax)
    )
    (func $cmp_template_f64_abs
      ;; btr rax, 63: clear the sign bit (5 bytes: 48 0F BA F0 3F)
      ;; ModRM /6 = BTR (bit test and reset)
      (call $cmp_emit_pop_rax)
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0xBA))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 6) (i32.const 0))
      (call $cmp_emit_byte (i32.const 0x3F))
      (call $cmp_emit_maybe_push_rax)
    )
    (func $cmp_template_f64_neg
      ;; bts rax, 63: flip the sign bit (5 bytes: 48 0F BA F8 3F)
      ;; ModRM /5 = BTS (bit test and set)
      (call $cmp_emit_pop_rax)
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0xBA))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 5) (i32.const 0))
      (call $cmp_emit_byte (i32.const 0x3F))
      (call $cmp_emit_maybe_push_rax)
    )
    (func $cmp_template_f64_sqrt
      (call $cmp_emit_f64_unop_prologue)
      (call $cmp_emit_sse_op (i32.const 0xF2) (i32.const 0x51))  ;; sqrtsd
      (call $cmp_emit_f64_unop_epilogue)
    )
    (func $cmp_template_f64_ceil
      (call $cmp_emit_f64_unop_prologue)
      (call $cmp_emit_sse3a_op (i32.const 0x0B) (i32.const 2))   ;; roundsd, ceil
      (call $cmp_emit_f64_unop_epilogue)
    )
    (func $cmp_template_f64_floor
      (call $cmp_emit_f64_unop_prologue)
      (call $cmp_emit_sse3a_op (i32.const 0x0B) (i32.const 1))   ;; roundsd, floor
      (call $cmp_emit_f64_unop_epilogue)
    )
    (func $cmp_template_f64_trunc
      (call $cmp_emit_f64_unop_prologue)
      (call $cmp_emit_sse3a_op (i32.const 0x0B) (i32.const 3))   ;; roundsd, trunc
      (call $cmp_emit_f64_unop_epilogue)
    )
    (func $cmp_template_f64_nearest
      (call $cmp_emit_f64_unop_prologue)
      (call $cmp_emit_sse3a_op (i32.const 0x0B) (i32.const 0))   ;; roundsd, nearest
      (call $cmp_emit_f64_unop_epilogue)
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Label / fixup helpers (for control flow compilation)
    ;; ═════════════════════════════════════════════════════════════════════
    (func $cmp_push_label (param $kind i32)
      (local $depth i32)
      (local.set $depth (i32.load (global.get $cmp_JS_LABEL_DEPTH)))
      (i32.store8 (i32.add (global.get $cmp_JS_LABEL_KINDS) (local.get $depth)) (local.get $kind))
      (i32.store (i32.add (global.get $cmp_JS_LABEL_IF_JZ) (i32.shl (local.get $depth) (i32.const 2))) (i32.const 0))
      (i32.store (global.get $cmp_JS_LABEL_DEPTH) (i32.add (local.get $depth) (i32.const 1)))
    )
    (func $cmp_pop_label (result i32)
      (local $depth i32)
      (local.set $depth (i32.sub (i32.load (global.get $cmp_JS_LABEL_DEPTH)) (i32.const 1)))
      (i32.store (global.get $cmp_JS_LABEL_DEPTH) (local.get $depth))
      (local.get $depth)
    )
    (func $cmp_get_label_offset (param $depth i32) (result i32)
      (i32.load (i32.add (global.get $cmp_JS_LABEL_OFFSETS) (i32.shl (local.get $depth) (i32.const 2))))
    )
    (func $cmp_set_label_offset (param $depth i32) (param $off i32)
      (i32.store (i32.add (global.get $cmp_JS_LABEL_OFFSETS) (i32.shl (local.get $depth) (i32.const 2))) (local.get $off))
    )
    (func $cmp_get_label_kind (param $depth i32) (result i32)
      (i32.load8_u (i32.add (global.get $cmp_JS_LABEL_KINDS) (local.get $depth)))
    )
    (func $cmp_get_label_if_jz (param $depth i32) (result i32)
      (i32.load (i32.add (global.get $cmp_JS_LABEL_IF_JZ) (i32.shl (local.get $depth) (i32.const 2))))
    )
    (func $cmp_set_label_if_jz (param $depth i32) (param $off i32)
      (i32.store (i32.add (global.get $cmp_JS_LABEL_IF_JZ) (i32.shl (local.get $depth) (i32.const 2))) (local.get $off))
    )
    ;; ── Fixup helpers ─────────────────────────────────────────────────
    (func $cmp_push_fixup (param $label_depth i32)
      (local $count i32) (local $off i32)
      (local.set $count (i32.load (global.get $cmp_JS_FIXUP_COUNT)))
      (local.set $off (i32.load (global.get $cmp_JS_CODE_PTR)))
      (i32.store (i32.add (global.get $cmp_JS_FIXUP_LABEL) (i32.shl (local.get $count) (i32.const 2))) (local.get $label_depth))
      (i32.store (i32.add (global.get $cmp_JS_FIXUP_OFFSET) (i32.shl (local.get $count) (i32.const 2))) (local.get $off))
      (i32.store (global.get $cmp_JS_FIXUP_COUNT) (i32.add (local.get $count) (i32.const 1)))
    )
    ;; Patch fixups at given label depth: compute forward jump displacement
    ;; and write it at each fixup offset
    (func $cmp_patch_fixups (param $depth i32)
      (local $count i32) (local $i i32) (local $cur i32) (local $fix_off i32)
      (local.set $count (i32.load (global.get $cmp_JS_FIXUP_COUNT)))
      (local.set $cur (i32.load (global.get $cmp_JS_CODE_PTR)))
      (local.set $i (i32.const 0))
      (block $pfx_end
        (loop $pfx_loop
          (if (i32.ge_u (local.get $i) (local.get $count)) (then (br $pfx_end)))
          (if (i32.eq (i32.load (i32.add (global.get $cmp_JS_FIXUP_LABEL) (i32.shl (local.get $i) (i32.const 2)))) (local.get $depth))
            (then
              (local.set $fix_off (i32.load (i32.add (global.get $cmp_JS_FIXUP_OFFSET) (i32.shl (local.get $i) (i32.const 2)))))
              ;; displacement = cur - (fix_off + 4)
              ;; fix_off is an offset from JIT_CACHE, so write to JIT_CACHE + fix_off
              (i32.store
                (i32.add (global.get $cmp_JIT_CACHE) (local.get $fix_off))
                (i32.sub (local.get $cur) (i32.add (local.get $fix_off) (i32.const 4)))
              )
              ;; Remove fixup by swapping with last
              (local.set $count (i32.sub (local.get $count) (i32.const 1)))
              (i32.store (i32.add (global.get $cmp_JS_FIXUP_LABEL) (i32.shl (local.get $i) (i32.const 2)))
                (i32.load (i32.add (global.get $cmp_JS_FIXUP_LABEL) (i32.shl (local.get $count) (i32.const 2)))))
              (i32.store (i32.add (global.get $cmp_JS_FIXUP_OFFSET) (i32.shl (local.get $i) (i32.const 2)))
                (i32.load (i32.add (global.get $cmp_JS_FIXUP_OFFSET) (i32.shl (local.get $count) (i32.const 2)))))
              (i32.store (global.get $cmp_JS_FIXUP_COUNT) (local.get $count))
            )
          )
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $pfx_loop)
        )
      )
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; JIT compile: compile a WASM function to x86_64 machine code
    ;; ═════════════════════════════════════════════════════════════════════
    (func $cmp_jit_compile (export "jit_compile") (param $func_idx i32) (result i32)
      (local $slot i32) (local $cache_base i32) (local $cache_end i32)
      (local $dec_start i32) (local $dec_end i32) (local $dec_ptr i32)
      (local $op i32) (local $imm0 i32)
      (local $result_count i32) (local $code_off i32)
      (local $i i32) (local $count i32) (local $save_off i32)
      ;; Compute slot = func_idx & 3
      (local.set $slot (i32.and (local.get $func_idx) (i32.const 3)))
      (local.set $cache_base (i32.add (global.get $cmp_JIT_CACHE) (i32.mul (local.get $slot) (global.get $cmp_JIT_SLOT_SIZE))))
      (local.set $cache_end (i32.add (local.get $cache_base) (global.get $cmp_JIT_SLOT_SIZE)))
      ;; Reset JIT state
      (call $cmp_jit_reset_state)
      (i32.store (global.get $cmp_JS_CACHE_BASE) (local.get $cache_base))
      (i32.store (global.get $cmp_JS_CACHE_END) (local.get $cache_end))
      (i32.store (global.get $cmp_JS_FUNC_IDX) (local.get $func_idx))
      ;; Get result_count from function type (16-bit at offset 136 in type entry)
      (local.set $code_off (i32.mul (local.get $func_idx) (i32.const 16)))
      (local.set $code_off (i32.shl (i32.load (i32.add (global.get $cmp_OFF_FUNCTIONS_BUF) (local.get $code_off))) (i32.const 8)))
      (local.set $result_count (i32.load16_u (i32.add (i32.add (global.get $cmp_OFF_TYPES_BUF) (local.get $code_off)) (i32.const 136))))
      (i32.store (global.get $cmp_JS_RESULT_COUNT) (local.get $result_count))
      ;; Get decoded ops range
      (local.set $code_off (i32.mul (local.get $func_idx) (global.get $cmp_CODE_SIZE)))
      (local.set $dec_start (i32.load (i32.add (i32.add (global.get $cmp_OFF_CODE_BUF) (local.get $code_off)) (i32.const 24))))
      (local.set $dec_end (i32.add (local.get $dec_start) (i32.load (i32.add (i32.add (global.get $cmp_OFF_CODE_BUF) (local.get $code_off)) (i32.const 32)))))
      (local.set $dec_ptr (i32.add (global.get $cmp_OFF_DECODED_OPS) (i32.mul (local.get $dec_start) (global.get $cmp_DEC_SZ))))
      ;; ── Emit function prologue ──
      (call $cmp_emit_prologue)
      ;; Cache JitGlobals.locals pointer (at [r15+0]) in rbx for fast local access
      (call $cmp_emit_mov_rbx_r15)
      ;; Cache first two locals in r12/r13 (register-allocated)
      (call $cmp_emit_load_r12_rbx)
      (call $cmp_emit_load_r13_rbx8)
      ;; ── Compile loop ──
      (block $compile_done
        (loop $compile_loop
          ;; Check if done
          (if (i32.ge_u (local.get $dec_start) (local.get $dec_end))
            (then (br $compile_done))
          )
          ;; Read opcode from decoded_op: opcode(1) + pad(3) + imm0(4) + imm1(4) = 12
          (local.set $op (i32.load8_u (local.get $dec_ptr)))
          (local.set $imm0 (i32.load (i32.add (local.get $dec_ptr) (i32.const 4))))
          (global.set $cmp_CURRENT_DEC_PTR (local.get $dec_ptr))
          ;; ── Control flow: handle directly ──
          ;; block (0x02)
          (if (i32.eq (local.get $op) (i32.const 0x02))
            (then
              (call $cmp_push_label (global.get $cmp_JIT_LABEL_BLOCK))
              (local.set $dec_start (i32.add (local.get $dec_start) (i32.const 1)))
              (local.set $dec_ptr (i32.add (local.get $dec_ptr) (global.get $cmp_DEC_SZ)))
              (br $compile_loop)
            )
          )
          ;; loop (0x03)
          (if (i32.eq (local.get $op) (i32.const 0x03))
            (then
              (call $cmp_push_label (global.get $cmp_JIT_LABEL_LOOP))
              (local.set $save_off (i32.load (global.get $cmp_JS_CODE_PTR)))
              (call $cmp_set_label_offset (i32.sub (i32.load (global.get $cmp_JS_LABEL_DEPTH)) (i32.const 1)) (local.get $save_off))
              (local.set $dec_start (i32.add (local.get $dec_start) (i32.const 1)))
              (local.set $dec_ptr (i32.add (local.get $dec_ptr) (global.get $cmp_DEC_SZ)))
              (br $compile_loop)
            )
          )
          ;; if (0x04)
          (if (i32.eq (local.get $op) (i32.const 0x04))
            (then
              ;; pop condition, test, jz with placeholder
              (call $cmp_emit_pop_rax)
              (call $cmp_emit_test_eax)
              (call $cmp_emit_jz_rel32 (i32.const 0))  ;; placeholder disp
              (local.set $save_off (i32.sub (i32.load (global.get $cmp_JS_CODE_PTR)) (i32.const 4)))  ;; address of disp
              (local.set $i (i32.load (global.get $cmp_JS_LABEL_DEPTH)))
              (call $cmp_set_label_if_jz (local.get $i) (local.get $save_off))
              (call $cmp_push_label (global.get $cmp_JIT_LABEL_IF))
              (local.set $dec_start (i32.add (local.get $dec_start) (i32.const 1)))
              (local.set $dec_ptr (i32.add (local.get $dec_ptr) (global.get $cmp_DEC_SZ)))
              (br $compile_loop)
            )
          )
          ;; else (0x05)
          (if (i32.eq (local.get $op) (i32.const 0x05))
            (then
              (local.set $i (i32.sub (i32.load (global.get $cmp_JS_LABEL_DEPTH)) (i32.const 1)))
              ;; Patch if's jz to jump here
              (local.set $save_off (call $cmp_get_label_if_jz (local.get $i)))
              (if (i32.ne (local.get $save_off) (i32.const 0))
                (then
                  ;; save_off is offset from JIT_CACHE
                  (i32.store
                    (i32.add (global.get $cmp_JIT_CACHE) (local.get $save_off))
                    (i32.sub (i32.load (global.get $cmp_JS_CODE_PTR)) (i32.add (local.get $save_off) (i32.const 4)))
                  )
                  (call $cmp_set_label_if_jz (local.get $i) (i32.const 0))
                )
              )
              ;; Emit jmp to end (placeholder) and record fixup
              (call $cmp_emit_jmp_rel32 (i32.const 0))
              (local.set $save_off (i32.sub (i32.load (global.get $cmp_JS_CODE_PTR)) (i32.const 4)))
              (call $cmp_push_fixup (local.get $i))
              ;; Also save the fixup offset override
              (i32.store (i32.add (global.get $cmp_JS_FIXUP_OFFSET) (i32.shl (i32.sub (i32.load (global.get $cmp_JS_FIXUP_COUNT)) (i32.const 1)) (i32.const 2))) (local.get $save_off))
              (local.set $dec_start (i32.add (local.get $dec_start) (i32.const 1)))
              (local.set $dec_ptr (i32.add (local.get $dec_ptr) (global.get $cmp_DEC_SZ)))
              (br $compile_loop)
            )
          )
          ;; end (0x0B)
          (if (i32.eq (local.get $op) (i32.const 0x0B))
            (then
              (local.set $i (call $cmp_pop_label))
              (if (i32.eq (call $cmp_get_label_kind (local.get $i)) (global.get $cmp_JIT_LABEL_LOOP))
                (then
                  ;; Loop end: jmp back to loop start
                  ;; disp = target - (code_ptr + 5)  (jmp_rel32 is 5 bytes)
                  (local.set $save_off (call $cmp_get_label_offset (local.get $i)))
                  (call $cmp_emit_jmp_rel32
                    (i32.sub (local.get $save_off) (i32.add (i32.load (global.get $cmp_JS_CODE_PTR)) (i32.const 5)))
                  )
                )
                (else
                  ;; Block/IF end: patch fixups
                  (call $cmp_patch_fixups (local.get $i))
                  ;; If IF (no else), patch jz
                  (if (i32.eq (call $cmp_get_label_kind (local.get $i)) (global.get $cmp_JIT_LABEL_IF))
                    (then
                      (local.set $save_off (call $cmp_get_label_if_jz (local.get $i)))
                      (if (i32.ne (local.get $save_off) (i32.const 0))
                        (then
                          ;; save_off is offset from JIT_CACHE
                          (i32.store
                            (i32.add (global.get $cmp_JIT_CACHE) (local.get $save_off))
                            (i32.sub (i32.load (global.get $cmp_JS_CODE_PTR)) (i32.add (local.get $save_off) (i32.const 4)))
                          )
                        )
                      )
                    )
                  )
                )
              )
              (local.set $dec_start (i32.add (local.get $dec_start) (i32.const 1)))
              (local.set $dec_ptr (i32.add (local.get $dec_ptr) (global.get $cmp_DEC_SZ)))
              (br $compile_loop)
            )
          )
          ;; br (0x0C)
          (if (i32.eq (local.get $op) (i32.const 0x0C))
            (then
              ;; imm0 = WASM label depth (0 = innermost)
              ;; Target label index = label_depth - 1 - imm0
              (local.set $i (i32.sub (i32.sub (i32.load (global.get $cmp_JS_LABEL_DEPTH)) (i32.const 1)) (local.get $imm0)))
              (if (i32.eq (call $cmp_get_label_kind (local.get $i)) (global.get $cmp_JIT_LABEL_LOOP))
                (then
                  ;; Backward branch: compute disp directly
                  ;; disp = target - (code_ptr + 5)  (jmp_rel32 is 5 bytes)
                  (local.set $save_off (call $cmp_get_label_offset (local.get $i)))
                  (call $cmp_emit_jmp_rel32
                    (i32.sub (local.get $save_off) (i32.add (i32.load (global.get $cmp_JS_CODE_PTR)) (i32.const 5)))
                  )
                )
                (else
                  ;; Forward branch: emit jmp + fixup
                  (call $cmp_emit_jmp_rel32 (i32.const 0))
                  (local.set $save_off (i32.sub (i32.load (global.get $cmp_JS_CODE_PTR)) (i32.const 4)))
                  (call $cmp_push_fixup (local.get $i))
                  (i32.store (i32.add (global.get $cmp_JS_FIXUP_OFFSET) (i32.shl (i32.sub (i32.load (global.get $cmp_JS_FIXUP_COUNT)) (i32.const 1)) (i32.const 2))) (local.get $save_off))
                )
              )
              (local.set $dec_start (i32.add (local.get $dec_start) (i32.const 1)))
              (local.set $dec_ptr (i32.add (local.get $dec_ptr) (global.get $cmp_DEC_SZ)))
              (br $compile_loop)
            )
          )
          ;; br_if (0x0D)
          (if (i32.eq (local.get $op) (i32.const 0x0D))
            (then
              (call $cmp_emit_pop_rax)
              (call $cmp_emit_test_eax)
              (local.set $i (i32.sub (i32.sub (i32.load (global.get $cmp_JS_LABEL_DEPTH)) (i32.const 1)) (local.get $imm0)))
              (if (i32.eq (call $cmp_get_label_kind (local.get $i)) (global.get $cmp_JIT_LABEL_LOOP))
                (then
                  ;; disp = target - (code_ptr + 6)  (jne_rel32 is 6 bytes)
                  (local.set $save_off (call $cmp_get_label_offset (local.get $i)))
                  (call $cmp_emit_jne_rel32
                    (i32.sub (local.get $save_off) (i32.add (i32.load (global.get $cmp_JS_CODE_PTR)) (i32.const 6)))
                  )
                )
                (else
                  (call $cmp_emit_jne_rel32 (i32.const 0))
                  (local.set $save_off (i32.sub (i32.load (global.get $cmp_JS_CODE_PTR)) (i32.const 4)))
                  (call $cmp_push_fixup (local.get $i))
                  (i32.store (i32.add (global.get $cmp_JS_FIXUP_OFFSET) (i32.shl (i32.sub (i32.load (global.get $cmp_JS_FIXUP_COUNT)) (i32.const 1)) (i32.const 2))) (local.get $save_off))
                )
              )
              (local.set $dec_start (i32.add (local.get $dec_start) (i32.const 1)))
              (local.set $dec_ptr (i32.add (local.get $dec_ptr) (global.get $cmp_DEC_SZ)))
              (br $compile_loop)
            )
          )
          ;; return (0x0F)
          (if (i32.eq (local.get $op) (i32.const 0x0F))
            (then
              (if (i32.eq (i32.load (global.get $cmp_JS_RESULT_COUNT)) (i32.const 1))
                (then
                  (call $cmp_emit_pop_rax)
                )
                (else
                  (call $cmp_emit_xor_eax_eax)
                )
              )
              (call $cmp_emit_xor_edx_edx)
              (call $cmp_emit_epilogue)
              (call $cmp_emit_ud2)
              (i32.store (global.get $cmp_JS_RETURN_EMITTED) (i32.const 1))
              (local.set $dec_start (i32.add (local.get $dec_start) (i32.const 1)))
              (local.set $dec_ptr (i32.add (local.get $dec_ptr) (global.get $cmp_DEC_SZ)))
              (br $compile_loop)
            )
          )
          ;; ── 0xFC prefixed ops (trunc_sat, memory/table) ──
          (if (i32.eq (local.get $op) (i32.const 0xFC))
            (then
              (block $fc_done
                ;; i32.trunc_sat_f32_s (0xFC, 0x00)
                (if (i32.eq (local.get $imm0) (i32.const 0x00))
                  (then (call $cmp_template_i32_trunc_sat_f32_s) (br $fc_done))
                )
                ;; i32.trunc_sat_f32_u (0xFC, 0x01)
                (if (i32.eq (local.get $imm0) (i32.const 0x01))
                  (then (call $cmp_template_i32_trunc_sat_f32_u) (br $fc_done))
                )
                ;; i32.trunc_sat_f64_s (0xFC, 0x02)
                (if (i32.eq (local.get $imm0) (i32.const 0x02))
                  (then (call $cmp_template_i32_trunc_sat_f64_s) (br $fc_done))
                )
                ;; i32.trunc_sat_f64_u (0xFC, 0x03)
                (if (i32.eq (local.get $imm0) (i32.const 0x03))
                  (then (call $cmp_template_i32_trunc_sat_f64_u) (br $fc_done))
                )
                ;; i64.trunc_sat_f32_s (0xFC, 0x04)
                (if (i32.eq (local.get $imm0) (i32.const 0x04))
                  (then (call $cmp_template_i64_trunc_sat_f32_s) (br $fc_done))
                )
                ;; i64.trunc_sat_f32_u (0xFC, 0x05)
                (if (i32.eq (local.get $imm0) (i32.const 0x05))
                  (then (call $cmp_template_i64_trunc_sat_f32_u) (br $fc_done))
                )
                ;; i64.trunc_sat_f64_s (0xFC, 0x06)
                (if (i32.eq (local.get $imm0) (i32.const 0x06))
                  (then (call $cmp_template_i64_trunc_sat_f64_s) (br $fc_done))
                )
                ;; i64.trunc_sat_f64_u (0xFC, 0x07)
                (if (i32.eq (local.get $imm0) (i32.const 0x07))
                  (then (call $cmp_template_i64_trunc_sat_f64_u) (br $fc_done))
                )
                ;; memory.init / data.drop / memory.copy / memory.fill / table.init /
                ;; table.drop / table.copy / table.fill / table.get / table.set /
                ;; table.grow / table.size (0x08-0x11) — unsupported
                (call $cmp_template_unsupported)
              )
              (local.set $dec_start (i32.add (local.get $dec_start) (i32.const 1)))
              (local.set $dec_ptr (i32.add (local.get $dec_ptr) (global.get $cmp_DEC_SZ)))
              (br $compile_loop)
            )
          )
          ;; ── All other ops: dispatch to template (if/else chain) ──
          (block $template_done
            ;; local.get (0x20)
            (if (i32.eq (local.get $op) (i32.const 0x20))
              (then (call $cmp_template_local_get (local.get $dec_ptr)) (br $template_done))
            )
            ;; local.set (0x21)
            (if (i32.eq (local.get $op) (i32.const 0x21))
              (then (call $cmp_template_local_set (local.get $dec_ptr)) (br $template_done))
            )
            ;; local.tee (0x22)
            (if (i32.eq (local.get $op) (i32.const 0x22))
              (then (call $cmp_template_local_tee (local.get $dec_ptr)) (br $template_done))
            )
            ;; global.get (0x23)
            (if (i32.eq (local.get $op) (i32.const 0x23))
              (then (call $cmp_template_global_get (local.get $dec_ptr)) (br $template_done))
            )
            ;; global.set (0x24)
            (if (i32.eq (local.get $op) (i32.const 0x24))
              (then (call $cmp_template_global_set (local.get $dec_ptr)) (br $template_done))
            )
            ;; table.get (0x25)
            (if (i32.eq (local.get $op) (i32.const 0x25))
              (then (call $cmp_template_table_get (local.get $dec_ptr)) (br $template_done))
            )
            ;; table.set (0x26)
            (if (i32.eq (local.get $op) (i32.const 0x26))
              (then (call $cmp_template_table_set (local.get $dec_ptr)) (br $template_done))
            )
            ;; drop (0x1A)
            (if (i32.eq (local.get $op) (i32.const 0x1A))
              (then (call $cmp_template_drop) (br $template_done))
            )
            ;; select (0x1B)
            (if (i32.eq (local.get $op) (i32.const 0x1B))
              (then (call $cmp_template_select) (br $template_done))
            )
            ;; select_typed (0x1C) — same behavior as select
            (if (i32.eq (local.get $op) (i32.const 0x1C))
              (then (call $cmp_template_select) (br $template_done))
            )
            ;; i32.const (0x41)
            (if (i32.eq (local.get $op) (i32.const 0x41))
              (then (call $cmp_template_i32_const (local.get $dec_ptr)) (br $template_done))
            )
            ;; i64.const (0x42)
            (if (i32.eq (local.get $op) (i32.const 0x42))
              (then (call $cmp_template_i64_const (local.get $dec_ptr)) (br $template_done))
            )
            ;; f32.const (0x43)
            (if (i32.eq (local.get $op) (i32.const 0x43))
              (then (call $cmp_template_f32_const (local.get $dec_ptr)) (br $template_done))
            )
            ;; f64.const (0x44)
            (if (i32.eq (local.get $op) (i32.const 0x44))
              (then (call $cmp_template_f64_const (local.get $dec_ptr)) (br $template_done))
            )
            ;; nop (0x01)
            (if (i32.eq (local.get $op) (i32.const 0x01))
              (then (call $cmp_template_nop) (br $template_done))
            )
            ;; unreachable (0x00)
            (if (i32.eq (local.get $op) (i32.const 0x00))
              (then (call $cmp_template_unreachable) (br $template_done))
            )
            ;; i32 eqz (0x45)
            (if (i32.eq (local.get $op) (i32.const 0x45)) (then (call $cmp_template_i32_eqz) (br $template_done)))
            ;; i32 eq/ne/lt/gt/le/ge (0x46-0x4F)
            (if (i32.eq (local.get $op) (i32.const 0x46)) (then (call $cmp_template_i32_eq) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x47)) (then (call $cmp_template_i32_ne) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x48)) (then (call $cmp_template_i32_lt_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x49)) (then (call $cmp_template_i32_lt_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x4A)) (then (call $cmp_template_i32_gt_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x4B)) (then (call $cmp_template_i32_gt_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x4C)) (then (call $cmp_template_i32_le_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x4D)) (then (call $cmp_template_i32_le_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x4E)) (then (call $cmp_template_i32_ge_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x4F)) (then (call $cmp_template_i32_ge_u) (br $template_done)))
            ;; i32 unary (0x67-0x69)
            (if (i32.eq (local.get $op) (i32.const 0x67)) (then (call $cmp_template_i32_clz) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x68)) (then (call $cmp_template_i32_ctz) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x69)) (then (call $cmp_template_i32_popcnt) (br $template_done)))
            ;; i32 binary (0x6A-0x78)
            (if (i32.eq (local.get $op) (i32.const 0x6A)) (then (call $cmp_template_i32_add) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x6B)) (then (call $cmp_template_i32_sub) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x6C)) (then (call $cmp_template_i32_mul) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x6D)) (then (call $cmp_template_i32_div_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x6E)) (then (call $cmp_template_i32_div_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x6F)) (then (call $cmp_template_i32_rem_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x70)) (then (call $cmp_template_i32_rem_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x71)) (then (call $cmp_template_i32_and) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x72)) (then (call $cmp_template_i32_or) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x73)) (then (call $cmp_template_i32_xor) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x74)) (then (call $cmp_template_i32_shl) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x75)) (then (call $cmp_template_i32_shr_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x76)) (then (call $cmp_template_i32_shr_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x77)) (then (call $cmp_template_i32_rotl) (br $template_done)))
             (if (i32.eq (local.get $op) (i32.const 0x78)) (then (call $cmp_template_i32_rotr) (br $template_done)))
            ;; i64 unary (0x79-0x7B)
            (if (i32.eq (local.get $op) (i32.const 0x79)) (then (call $cmp_template_i64_clz) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x7A)) (then (call $cmp_template_i64_ctz) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x7B)) (then (call $cmp_template_i64_popcnt) (br $template_done)))
            ;; i64 binary (0x7C-0x8A)
            (if (i32.eq (local.get $op) (i32.const 0x7C)) (then (call $cmp_template_i64_add) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x7D)) (then (call $cmp_template_i64_sub) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x7E)) (then (call $cmp_template_i64_mul) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x7F)) (then (call $cmp_template_i64_div_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x80)) (then (call $cmp_template_i64_div_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x81)) (then (call $cmp_template_i64_rem_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x82)) (then (call $cmp_template_i64_rem_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x83)) (then (call $cmp_template_i64_and) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x84)) (then (call $cmp_template_i64_or) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x85)) (then (call $cmp_template_i64_xor) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x86)) (then (call $cmp_template_i64_shl) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x87)) (then (call $cmp_template_i64_shr_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x88)) (then (call $cmp_template_i64_shr_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x89)) (then (call $cmp_template_i64_rotl) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x8A)) (then (call $cmp_template_i64_rotr) (br $template_done)))
            ;; Conversions
            (if (i32.eq (local.get $op) (i32.const 0xA7)) (then (call $cmp_template_i32_wrap_i64) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xA8)) (then (call $cmp_template_i32_trunc_f32_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xA9)) (then (call $cmp_template_i32_trunc_f32_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xAA)) (then (call $cmp_template_i32_trunc_f64_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xAB)) (then (call $cmp_template_i32_trunc_f64_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xAC)) (then (call $cmp_template_i64_extend_i32_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xAD)) (then (call $cmp_template_i64_extend_i32_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xAE)) (then (call $cmp_template_i64_trunc_f32_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xAF)) (then (call $cmp_template_i64_trunc_f32_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xB0)) (then (call $cmp_template_i64_trunc_f64_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xB1)) (then (call $cmp_template_i64_trunc_f64_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xB2)) (then (call $cmp_template_f32_convert_i32_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xB3)) (then (call $cmp_template_f32_convert_i32_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xB4)) (then (call $cmp_template_f32_convert_i64_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xB5)) (then (call $cmp_template_f32_convert_i64_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xB6)) (then (call $cmp_template_f32_demote_f64) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xB7)) (then (call $cmp_template_f64_convert_i32_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xB8)) (then (call $cmp_template_f64_convert_i32_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xB9)) (then (call $cmp_template_f64_convert_i64_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xBA)) (then (call $cmp_template_f64_convert_i64_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xBB)) (then (call $cmp_template_f64_promote_f32) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xBC)) (then (call $cmp_template_i32_reinterpret_f32) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xBD)) (then (call $cmp_template_i64_reinterpret_f64) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xBE)) (then (call $cmp_template_f32_reinterpret_i32) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xBF)) (then (call $cmp_template_f64_reinterpret_i64) (br $template_done)))
            ;; Sign extension
            (if (i32.eq (local.get $op) (i32.const 0xC0)) (then (call $cmp_template_i32_extend8_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xC1)) (then (call $cmp_template_i32_extend16_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xC2)) (then (call $cmp_template_i64_extend8_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xC3)) (then (call $cmp_template_i64_extend16_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xC4)) (then (call $cmp_template_i64_extend32_s) (br $template_done)))
            ;; Reference types (0xD0-0xD2)
            (if (i32.eq (local.get $op) (i32.const 0xD0)) (then (call $cmp_template_ref_null) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xD1)) (then (call $cmp_template_ref_is_null) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xD2)) (then (call $cmp_template_ref_func (local.get $dec_ptr)) (br $template_done)))
             ;; Memory load/store
            (if (i32.eq (local.get $op) (i32.const 0x28)) (then (call $cmp_template_i32_load) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x29)) (then (call $cmp_template_i64_load) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x2A)) (then (call $cmp_template_f32_load) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x2B)) (then (call $cmp_template_f64_load) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x2C)) (then (call $cmp_template_i32_load8_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x2D)) (then (call $cmp_template_i32_load8_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x2E)) (then (call $cmp_template_i32_load16_s) (br $template_done)))
             (if (i32.eq (local.get $op) (i32.const 0x2F)) (then (call $cmp_template_i32_load16_u) (br $template_done)))
             ;; i64 narrow loads (0x30-0x35)
             (if (i32.eq (local.get $op) (i32.const 0x30)) (then (call $cmp_template_i64_load8_s) (br $template_done)))
             (if (i32.eq (local.get $op) (i32.const 0x31)) (then (call $cmp_template_i64_load8_u) (br $template_done)))
             (if (i32.eq (local.get $op) (i32.const 0x32)) (then (call $cmp_template_i64_load16_s) (br $template_done)))
             (if (i32.eq (local.get $op) (i32.const 0x33)) (then (call $cmp_template_i64_load16_u) (br $template_done)))
             (if (i32.eq (local.get $op) (i32.const 0x34)) (then (call $cmp_template_i64_load32_s) (br $template_done)))
             (if (i32.eq (local.get $op) (i32.const 0x35)) (then (call $cmp_template_i64_load32_u) (br $template_done)))
             (if (i32.eq (local.get $op) (i32.const 0x36)) (then (call $cmp_template_i32_store) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x37)) (then (call $cmp_template_i64_store) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x38)) (then (call $cmp_template_f32_store) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x39)) (then (call $cmp_template_f64_store) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x3A)) (then (call $cmp_template_i32_store8) (br $template_done)))
             (if (i32.eq (local.get $op) (i32.const 0x3B)) (then (call $cmp_template_i32_store16) (br $template_done)))
             ;; i64 narrow stores (0x3C-0x3E)
             (if (i32.eq (local.get $op) (i32.const 0x3C)) (then (call $cmp_template_i64_store8) (br $template_done)))
             (if (i32.eq (local.get $op) (i32.const 0x3D)) (then (call $cmp_template_i64_store16) (br $template_done)))
             (if (i32.eq (local.get $op) (i32.const 0x3E)) (then (call $cmp_template_i64_store32) (br $template_done)))
              ;; memory.size / memory.grow
            (if (i32.eq (local.get $op) (i32.const 0x3F)) (then (call $cmp_template_memory_size) (br $template_done)))
             (if (i32.eq (local.get $op) (i32.const 0x40)) (then (call $cmp_template_memory_grow) (br $template_done)))
            ;; i64 comparisons (0x50-0x5A)
            (if (i32.eq (local.get $op) (i32.const 0x50)) (then (call $cmp_template_i64_eqz) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x51)) (then (call $cmp_template_i64_eq) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x52)) (then (call $cmp_template_i64_ne) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x53)) (then (call $cmp_template_i64_lt_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x54)) (then (call $cmp_template_i64_lt_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x55)) (then (call $cmp_template_i64_gt_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x56)) (then (call $cmp_template_i64_gt_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x57)) (then (call $cmp_template_i64_le_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x58)) (then (call $cmp_template_i64_le_u) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x59)) (then (call $cmp_template_i64_ge_s) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x5A)) (then (call $cmp_template_i64_ge_u) (br $template_done)))
            ;; f32 comparisons (0x5B-0x60)
            (if (i32.eq (local.get $op) (i32.const 0x5B)) (then (call $cmp_template_f32_eq) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x5C)) (then (call $cmp_template_f32_ne) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x5D)) (then (call $cmp_template_f32_lt) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x5E)) (then (call $cmp_template_f32_gt) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x5F)) (then (call $cmp_template_f32_le) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x60)) (then (call $cmp_template_f32_ge) (br $template_done)))
            ;; f64 comparisons (0x61-0x66)
            (if (i32.eq (local.get $op) (i32.const 0x61)) (then (call $cmp_template_f64_eq) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x62)) (then (call $cmp_template_f64_ne) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x63)) (then (call $cmp_template_f64_lt) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x64)) (then (call $cmp_template_f64_gt) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x65)) (then (call $cmp_template_f64_le) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x66)) (then (call $cmp_template_f64_ge) (br $template_done)))
            ;; f32 binary (0x92-0x98)
            (if (i32.eq (local.get $op) (i32.const 0x92)) (then (call $cmp_template_f32_add) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x93)) (then (call $cmp_template_f32_sub) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x94)) (then (call $cmp_template_f32_mul) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x95)) (then (call $cmp_template_f32_div) (br $template_done)))
            ;; f32 min/max/copysign (0x96-0x98)
            (if (i32.eq (local.get $op) (i32.const 0x96)) (then (call $cmp_template_f32_min) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x97)) (then (call $cmp_template_f32_max) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x98)) (then (call $cmp_template_f32_copysign) (br $template_done)))
            ;; f64 binary (0xA0-0xA3)
            (if (i32.eq (local.get $op) (i32.const 0xA0)) (then (call $cmp_template_f64_add) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xA1)) (then (call $cmp_template_f64_sub) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xA2)) (then (call $cmp_template_f64_mul) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xA3)) (then (call $cmp_template_f64_div) (br $template_done)))
            ;; f64 min/max/copysign (0xA4-0xA6)
            (if (i32.eq (local.get $op) (i32.const 0xA4)) (then (call $cmp_template_f64_min) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xA5)) (then (call $cmp_template_f64_max) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0xA6)) (then (call $cmp_template_f64_copysign) (br $template_done)))
            ;; f32 unary
            (if (i32.eq (local.get $op) (i32.const 0x8B)) (then (call $cmp_template_f32_abs) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x8C)) (then (call $cmp_template_f32_neg) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x91)) (then (call $cmp_template_f32_sqrt) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x8D)) (then (call $cmp_template_f32_ceil) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x8E)) (then (call $cmp_template_f32_floor) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x8F)) (then (call $cmp_template_f32_trunc) (br $template_done)))
             (if (i32.eq (local.get $op) (i32.const 0x90)) (then (call $cmp_template_f32_nearest) (br $template_done)))
            ;; f64 unary (0x99-0x9F)
            (if (i32.eq (local.get $op) (i32.const 0x99)) (then (call $cmp_template_f64_abs) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x9A)) (then (call $cmp_template_f64_neg) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x9B)) (then (call $cmp_template_f64_sqrt) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x9C)) (then (call $cmp_template_f64_ceil) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x9D)) (then (call $cmp_template_f64_floor) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x9E)) (then (call $cmp_template_f64_trunc) (br $template_done)))
            (if (i32.eq (local.get $op) (i32.const 0x9F)) (then (call $cmp_template_f64_nearest) (br $template_done)))
            ;; call (0x10), call_indirect (0x11), br_table (0x0E) — not JIT-compilable
            (if (i32.eq (local.get $op) (i32.const 0x10))
              (then (call $cmp_template_unsupported) (br $template_done))
            )
            (if (i32.eq (local.get $op) (i32.const 0x11))
              (then (call $cmp_template_unsupported) (br $template_done))
            )
            (if (i32.eq (local.get $op) (i32.const 0x0E))
              (then (call $cmp_template_unsupported) (br $template_done))
            )
            ;; Unsupported opcode — emit ud2
            (call $cmp_template_unsupported)
          )
          ;; Advance to next decoded op
          (local.set $dec_start (i32.add (local.get $dec_start) (i32.const 1)))
          (local.set $dec_ptr (i32.add (local.get $dec_ptr) (global.get $cmp_DEC_SZ)))
          (br $compile_loop)
        )
      )
      ;; ── Emit function epilogue ──
      (if (i32.eqz (i32.load (global.get $cmp_JS_RETURN_EMITTED)))
        (then
          (if (i32.eq (local.get $result_count) (i32.const 1))
            (then
              (call $cmp_emit_pop_rax)
            )
            (else
              (call $cmp_emit_xor_eax_eax)
            )
          )
          (call $cmp_emit_xor_edx_edx)
          (call $cmp_emit_epilogue)
        )
      )
      ;; Return code_ptr (offset from cache_base)
      (return (i32.sub (i32.load (global.get $cmp_JS_CODE_PTR)) (i32.mul (local.get $slot) (global.get $cmp_JIT_SLOT_SIZE))))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; ELF64 binary output
    ;; ═════════════════════════════════════════════════════════════════════
    (global $cmp_ELF_OUT_BUF  i32 (i32.const 0x800000))
    (global $cmp_ELF_OUT_OFF  i32 (i32.const 0x700000))  ;; ELF_OUT_BUF - JIT_CACHE
    (global $cmp_TEXT_VA      i32 (i32.const 0x400000))
    (global $cmp_BSS_VA       i32 (i32.const 0x500000))
    (global $cmp_EHDR_SIZE    i32 (i32.const 64))
    (global $cmp_PHDR_SIZE    i32 (i32.const 56))
    (global $cmp_ELF_STUB_OFF i32 (i32.const 120))       ;; after 1 phdr (64 + 56)
    (global $cmp_ELF_CODE_OFF i32 (i32.const 256))        ;; aligned after stub
    (global $cmp_BSS_SIZE     i32 (i32.const 0x40000))    ;; 256KB
    ;; BSS item VAs (relative to BSS_VA)
    (global $cmp_BSS_JITGLOBALS i32 (i32.const 0x500000))
    (global $cmp_BSS_MEM       i32 (i32.const 0x500080))
    (global $cmp_BSS_LOCALS    i32 (i32.const 0x510080))
    (global $cmp_BSS_GLOBALS   i32 (i32.const 0x520080))
    (global $cmp_BSS_TABLE     i32 (i32.const 0x530080))
    ;; ── ELF emit helpers ───────────────────────────────────────────────
    ;; MOV r64, imm32 sign-extended: REX.W + C7 /0 id
    (func $cmp_emit_mov_r64_imm32 (param $rex i32) (param $modrm i32) (param $val i32)
      (call $cmp_emit_byte (local.get $rex))
      (call $cmp_emit_byte (i32.const 0xC7))
      (call $cmp_emit_byte (local.get $modrm))
      (call $cmp_emit_dword (local.get $val))
    )
    ;; MOV [r15+off8], rax: 49 89 47 <off>
    (func $cmp_emit_mov_r15off_rax (param $off i32)
      (call $cmp_emit_byte (i32.const 0x49))
      (call $cmp_emit_byte (i32.const 0x89))
      (call $cmp_emit_byte (i32.const 0x47))
      (call $cmp_emit_byte (local.get $off))
    )
    ;; MOV dword [r15+off8], imm32: 41 C7 47 <off> <imm32>
    (func $cmp_emit_mov_dword_r15off (param $off i32) (param $val i32)
      (call $cmp_emit_byte (i32.const 0x41))
      (call $cmp_emit_byte (i32.const 0xC7))
      (call $cmp_emit_byte (i32.const 0x47))
      (call $cmp_emit_byte (local.get $off))
      (call $cmp_emit_dword (local.get $val))
    )
    ;; CALL rel32: E8 <disp32>  (target = current_va + 5 + disp)
    (func $cmp_emit_call_rel (param $target_va i32)
      (local $saved i32)
      (local.set $saved (i32.load (global.get $cmp_JS_CODE_PTR)))
      (call $cmp_emit_byte (i32.const 0xE8))
      (call $cmp_emit_dword
        (i32.sub
          (local.get $target_va)
          (i32.add
            (i32.add (global.get $cmp_TEXT_VA) (i32.sub (local.get $saved) (global.get $cmp_ELF_OUT_OFF)))
            (i32.const 5)
          )
        )
      )
    )
    ;; MOV edi, eax: 89 C7
    (func $cmp_emit_mov_edi_eax
      (call $cmp_emit_byte (i32.const 0x89))
      (call $cmp_emit_byte (i32.const 0xC7))
    )
    ;; MOV eax, imm32: B8 <dword>
    (func $cmp_emit_mov_eax_imm (param $val i32)
      (call $cmp_emit_byte (i32.const 0xB8))
      (call $cmp_emit_dword (local.get $val))
    )
    ;; SYSCALL: 0F 05
    (func $cmp_emit_syscall
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x05))
    )
    ;; ── ELF64 header ─────────────────────────────────────────────────
    (func $cmp_emit_elf64_ehdr (param $entry_va i32) (param $phoff i32) (param $phnum i32)
      (call $cmp_emit_byte (i32.const 0x7F))
      (call $cmp_emit_byte (i32.const 0x45)) (call $cmp_emit_byte (i32.const 0x4C)) (call $cmp_emit_byte (i32.const 0x46))
      (call $cmp_emit_byte (i32.const 2))     (call $cmp_emit_byte (i32.const 1))
      (call $cmp_emit_byte (i32.const 1))     (call $cmp_emit_byte (i32.const 0))
      (call $cmp_emit_qword (i64.const 0))    ;; padding bytes 8-15
      (call $cmp_emit_byte (i32.const 2)) (call $cmp_emit_byte (i32.const 0))  ;; e_type=ET_EXEC
      (call $cmp_emit_byte (i32.const 0x3E)) (call $cmp_emit_byte (i32.const 0))  ;; e_machine=x86_64
      (call $cmp_emit_dword (i32.const 1))    ;; e_version
      (call $cmp_emit_qword (i64.extend_i32_u (local.get $entry_va)))  ;; e_entry
      (call $cmp_emit_qword (i64.extend_i32_u (local.get $phoff)))     ;; e_phoff
      (call $cmp_emit_qword (i64.const 0))    ;; e_shoff
      (call $cmp_emit_dword (i32.const 0))    ;; e_flags
      (call $cmp_emit_byte (i32.const 64)) (call $cmp_emit_byte (i32.const 0))  ;; e_ehsize
      (call $cmp_emit_byte (i32.const 56)) (call $cmp_emit_byte (i32.const 0))  ;; e_phentsize
      (call $cmp_emit_byte (i32.wrap_i64 (i64.extend_i32_u (local.get $phnum)))) 
      (call $cmp_emit_byte (i32.const 0))   ;; e_phnum
      (call $cmp_emit_byte (i32.const 0)) (call $cmp_emit_byte (i32.const 0))  ;; e_shentsize=0
      (call $cmp_emit_byte (i32.const 0)) (call $cmp_emit_byte (i32.const 0))  ;; e_shnum=0
      (call $cmp_emit_byte (i32.const 0)) (call $cmp_emit_byte (i32.const 0))  ;; e_shstrndx=0
    )
    ;; ── ELF64 program header (56 bytes) ──────────────────────────────
    (func $cmp_emit_elf64_phdr (param $type i32) (param $flags i32)
                           (param $offset i32) (param $vaddr i32)
                           (param $filesz i32) (param $memsz i32)
      (call $cmp_emit_dword (local.get $type))     ;; p_type
      (call $cmp_emit_dword (local.get $flags))    ;; p_flags
      (call $cmp_emit_qword (i64.extend_i32_u (local.get $offset)))  ;; p_offset
      (call $cmp_emit_qword (i64.extend_i32_u (local.get $vaddr)))   ;; p_vaddr
      (call $cmp_emit_qword (i64.extend_i32_u (local.get $vaddr)))   ;; p_paddr = p_vaddr
      (call $cmp_emit_qword (i64.extend_i32_u (local.get $filesz)))  ;; p_filesz
      (call $cmp_emit_qword (i64.extend_i32_u (local.get $memsz)))   ;; p_memsz
      (call $cmp_emit_qword (i64.const 0x1000))    ;; p_align
    )
    ;; ── Runtime stub: _start that calls compiled code and exits ──────
    ;; $bss_va = page-aligned start of BSS (right after compiled code)
    (func $cmp_emit_elf_stub (param $bss_va i32)
      (local $jitglobs i32) (local $mem i32) (local $locals i32)
      (local $globals i32) (local $table i32)
      (local.set $jitglobs (local.get $bss_va))
      (local.set $mem     (i32.add (local.get $bss_va) (i32.const 0x80)))
      (local.set $locals  (i32.add (local.get $bss_va) (i32.const 0x10080)))
      (local.set $globals (i32.add (local.get $bss_va) (i32.const 0x20080)))
      (local.set $table   (i32.add (local.get $bss_va) (i32.const 0x30080)))
      ;; mov r15, $jitglobs
      (call $cmp_emit_mov_r64_imm32 (i32.const 0x4D) (i32.const 0xC7) (local.get $jitglobs))
      ;; mov rax, $mem; mov [r15+8], rax   (JitGlobals.mem_ptr)
      (call $cmp_emit_mov_r64_imm32 (i32.const 0x48) (i32.const 0xC0) (local.get $mem))
      (call $cmp_emit_mov_r15off_rax (i32.const 8))
      ;; mov rax, $locals; mov [r15+0], rax  (JitGlobals.locals)
      (call $cmp_emit_mov_r64_imm32 (i32.const 0x48) (i32.const 0xC0) (local.get $locals))
      (call $cmp_emit_mov_r15off_rax (i32.const 0))
      ;; mov rax, $globals; mov [r15+24], rax (JitGlobals.globals_buf)
      (call $cmp_emit_mov_r64_imm32 (i32.const 0x48) (i32.const 0xC0) (local.get $globals))
      (call $cmp_emit_mov_r15off_rax (i32.const 24))
      ;; mov rax, $table; mov [r15+48], rax  (JitGlobals.table_entries)
      (call $cmp_emit_mov_r64_imm32 (i32.const 0x48) (i32.const 0xC0) (local.get $table))
      (call $cmp_emit_mov_r15off_rax (i32.const 48))
      ;; mov dword [r15+64], 1  (JitGlobals.memory_pages)
      (call $cmp_emit_mov_dword_r15off (i32.const 64) (i32.const 1))
      ;; call compiled_code
      (call $cmp_emit_call_rel (i32.add (global.get $cmp_TEXT_VA) (global.get $cmp_ELF_CODE_OFF)))
      ;; exit(result)  — rax holds the return value from compiled code
      (call $cmp_emit_mov_edi_eax)
      (call $cmp_emit_mov_eax_imm (i32.const 60))  ;; SYS_exit
      (call $cmp_emit_syscall)
    )
    ;; ── Copy compiled code from cache into ELF output ────────────────
    (func $cmp_copy_compiled_code (param $src i32) (param $size i32)
      (local $i i32) (local $dst i32)
      (local.set $dst (i32.add (global.get $cmp_ELF_OUT_BUF) (global.get $cmp_ELF_CODE_OFF)))
      (local.set $i (i32.const 0))
      (block $done
        (loop $copy
          (if (i32.ge_u (local.get $i) (local.get $size))
            (then (br $done))
          )
          (i32.store8
            (i32.add (local.get $dst) (local.get $i))
            (i32.load8_u (i32.add (local.get $src) (local.get $i)))
          )
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $copy)
        )
      )
    )
    ;; ── compile_to_elf: compile a WASM function and emit ELF64 ───────
    ;; Returns (start_address, total_size)
    (func (export "compile_to_elf") (param $func_idx i32) (result i32 i32)
      (local $code_size i32) (local $total_size i32)
      (local $saved i32) (local $bss_va i32)
      ;; 1. Run the compiler (produces code at 0x100000)
      (local.set $code_size (call $cmp_jit_compile (local.get $func_idx)))
      ;; 2. Compute total ELF file size
      (local.set $total_size (i32.add (global.get $cmp_ELF_CODE_OFF) (local.get $code_size)))
      ;; 3. Compute BSS base: page-align TEXT_VA + total_size
      (local.set $bss_va
        (i32.add
          (i32.and (i32.add (local.get $total_size) (i32.const 0xFFF)) (i32.const -0x1000))
          (global.get $cmp_TEXT_VA)
        )
      )
      ;; 4. Save JS_CODE_PTR, redirect emit to ELF output buffer
      (local.set $saved (i32.load (global.get $cmp_JS_CODE_PTR)))
      (i32.store (global.get $cmp_JS_CODE_PTR) (global.get $cmp_ELF_OUT_OFF))
      ;; 5. Emit ELF64 header (1 program header: text + BSS combined)
      (call $cmp_emit_elf64_ehdr
        (i32.add (global.get $cmp_TEXT_VA) (global.get $cmp_ELF_STUB_OFF))  ;; entry = _start
        (i32.const 64)   ;; e_phoff
        (i32.const 1)    ;; 1 program header (text + bss)
      )
      ;; 6. Emit PH#1: text + BSS combined LOAD (R|W|X), offset=0
      ;;     filesz = total_size, memsz includes BSS
      (call $cmp_emit_elf64_phdr
        (i32.const 1)         ;; PT_LOAD
        (i32.const 7)         ;; PF_R | PF_W | PF_X
        (i32.const 0)         ;; p_offset = 0
        (global.get $cmp_TEXT_VA) ;; p_vaddr
        (local.get $total_size) ;; p_filesz
        (i32.add (i32.and (i32.add (local.get $total_size) (i32.const 0xFFF)) (i32.const -0x1000)) (global.get $cmp_BSS_SIZE)) ;; p_memsz includes BSS
      )
      ;; 7. Emit runtime stub (with BSS base address)
      (call $cmp_emit_elf_stub (local.get $bss_va))
      ;; 8. Pad with zeros from end of stub to ELF_CODE_OFF
      (block $pad_done
        (loop $pad_loop
          (if (i32.ge_u (i32.load (global.get $cmp_JS_CODE_PTR))
                         (i32.add (global.get $cmp_ELF_OUT_OFF) (global.get $cmp_ELF_CODE_OFF)))
            (then (br $pad_done))
          )
          (call $cmp_emit_byte (i32.const 0))
          (br $pad_loop)
        )
      )
      ;; 9. Copy compiled code from cache (0x100000) to ELF output
      (call $cmp_copy_compiled_code (global.get $cmp_JIT_CACHE) (local.get $code_size))
      ;; 10. Restore JS_CODE_PTR
      (i32.store (global.get $cmp_JS_CODE_PTR) (local.get $saved))
      ;; Return (buffer_address, total_size)
      (return (global.get $cmp_ELF_OUT_BUF) (local.get $total_size))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Flat binary output (bare-metal x86-64)
    ;; ═════════════════════════════════════════════════════════════════════
    (global $cmp_BIN_OUT_BUF  i32 (i32.const 0x900000))
    (global $cmp_BIN_OUT_OFF  i32 (i32.const 0x800000))  ;; BIN_OUT_BUF - JIT_CACHE
    ;; MOV moffs32, eAX: 67 A3 <addr>
    (func $cmp_emit_mov_abs32_eax (param $addr i32)
      (call $cmp_emit_byte (i32.const 0x67))
      (call $cmp_emit_byte (i32.const 0xA3))
      (call $cmp_emit_dword (local.get $addr))
    )
    ;; CALL rel32 with displacement computed relative to the binary base
    ;; target_off = offset from start of binary to the target instruction
    (func $cmp_emit_call_flat (param $target_off i32)
      (local $saved i32)
      (local.set $saved (i32.load (global.get $cmp_JS_CODE_PTR)))
      (call $cmp_emit_byte (i32.const 0xE8))
      (call $cmp_emit_dword
        (i32.sub
          (local.get $target_off)
          (i32.add (i32.sub (local.get $saved) (global.get $cmp_BIN_OUT_OFF)) (i32.const 5))
        )
      )
    )
    ;; Emit bare-metal runtime stub (no ELF headers, starts at offset 0)
    ;; The compiled code will be placed right after the stub.
    (func $cmp_emit_bare_metal_stub (result i32)
      (local $stub_size i32)
      ;; Same init as ELF: set up r15, JitGlobals
      (call $cmp_emit_mov_r64_imm32 (i32.const 0x4D) (i32.const 0xC7) (global.get $cmp_BSS_JITGLOBALS))
      (call $cmp_emit_mov_r64_imm32 (i32.const 0x48) (i32.const 0xC0) (global.get $cmp_BSS_MEM))
      (call $cmp_emit_mov_r15off_rax (i32.const 8))
      (call $cmp_emit_mov_r64_imm32 (i32.const 0x48) (i32.const 0xC0) (global.get $cmp_BSS_LOCALS))
      (call $cmp_emit_mov_r15off_rax (i32.const 0))
      (call $cmp_emit_mov_r64_imm32 (i32.const 0x48) (i32.const 0xC0) (global.get $cmp_BSS_GLOBALS))
      (call $cmp_emit_mov_r15off_rax (i32.const 24))
      (call $cmp_emit_mov_r64_imm32 (i32.const 0x48) (i32.const 0xC0) (global.get $cmp_BSS_TABLE))
      (call $cmp_emit_mov_r15off_rax (i32.const 48))
      (call $cmp_emit_mov_dword_r15off (i32.const 64) (i32.const 1))
      ;; After init, compute the eventual stub size, then emit CALL placeholder.
      ;; The CALL's target will be the start of compiled code (offset = stub_size).
      ;; We know the instructions after CALL are fixed size: 6 (mov_abs) + 1 (cli) + 1 (hlt) = 8 bytes.
      ;; So if we save current offset before CALL and add CALL = 5 + 8 = 13, we get stub_size.
      (local.set $stub_size (i32.add (i32.sub (i32.load (global.get $cmp_JS_CODE_PTR)) (global.get $cmp_BIN_OUT_OFF)) (i32.const 13)))
      ;; Emit CALL to compiled code at offset stub_size
      (call $cmp_emit_call_flat (local.get $stub_size))
      ;; Store result at 0x500 and halt
      (call $cmp_emit_mov_abs32_eax (i32.const 0x500))
      (call $cmp_emit_byte (i32.const 0xFA))   ;; CLI
      (call $cmp_emit_byte (i32.const 0xF4))   ;; HLT
      (return (local.get $stub_size))
    )
    ;; Copy compiled code from cache to output buffer at given offset
    (func $cmp_copy_code_to (param $dst_buf i32) (param $code_size i32) (param $code_off i32)
      (local $i i32) (local $dst i32)
      (local.set $dst (i32.add (local.get $dst_buf) (local.get $code_off)))
      (local.set $i (i32.const 0))
      (block $done
        (loop $copy
          (if (i32.ge_u (local.get $i) (local.get $code_size)) (then (br $done)))
          (i32.store8
            (i32.add (local.get $dst) (local.get $i))
            (i32.load8_u (i32.add (global.get $cmp_JIT_CACHE) (local.get $i)))
          )
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $copy)
        )
      )
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; compile_to_bin: emit flat binary with bare-metal runtime stub
    ;; Returns (buffer_address, total_size)
    ;; ═════════════════════════════════════════════════════════════════════
    (func (export "compile_to_bin") (param $func_idx i32) (result i32 i32)
      (local $code_size i32) (local $stub_size i32) (local $total_size i32)
      (local $saved i32)
      ;; 1. Run the compiler
      (local.set $code_size (call $cmp_jit_compile (local.get $func_idx)))
      ;; 2. Redirect emit to binary output buffer
      (local.set $saved (i32.load (global.get $cmp_JS_CODE_PTR)))
      (i32.store (global.get $cmp_JS_CODE_PTR) (global.get $cmp_BIN_OUT_OFF))
      ;; 3. Emit bare-metal stub — returns stub size (where compiled code goes)
      (local.set $stub_size (call $cmp_emit_bare_metal_stub))
      ;; 4. Copy compiled code after stub
      (call $cmp_copy_code_to (global.get $cmp_BIN_OUT_BUF) (local.get $code_size) (local.get $stub_size))
      ;; 5. Total size = stub_size + code_size
      (local.set $total_size (i32.add (local.get $stub_size) (local.get $code_size)))
      ;; 6. Restore JS_CODE_PTR
      (i32.store (global.get $cmp_JS_CODE_PTR) (local.get $saved))
      (return (global.get $cmp_BIN_OUT_BUF) (local.get $total_size))
    )

  ;; -- agent-primitives/codex-agent-core --
  ;; Agent/client/tool semantics plundered from crates/edgerun-codex.
    (func (export "codex_schema_type_code") (param $ptr i32) (param $len i32) (result i32)
      ;; string=1 number=2 boolean=3 integer=4 object=5 array=6 null=7 unknown=0.
      (if (call $eq6 (local.get $ptr) (local.get $len) (i32.const 115) (i32.const 116) (i32.const 114) (i32.const 105) (i32.const 110) (i32.const 103)) (then (return (i32.const 1))))
      (if (call $eq6 (local.get $ptr) (local.get $len) (i32.const 110) (i32.const 117) (i32.const 109) (i32.const 98) (i32.const 101) (i32.const 114)) (then (return (i32.const 2))))
      (if (call $eq7 (local.get $ptr) (local.get $len) (i32.const 98) (i32.const 111) (i32.const 111) (i32.const 108) (i32.const 101) (i32.const 97) (i32.const 110)) (then (return (i32.const 3))))
      (if (call $eq7 (local.get $ptr) (local.get $len) (i32.const 105) (i32.const 110) (i32.const 116) (i32.const 101) (i32.const 103) (i32.const 101) (i32.const 114)) (then (return (i32.const 4))))
      (if (call $eq6 (local.get $ptr) (local.get $len) (i32.const 111) (i32.const 98) (i32.const 106) (i32.const 101) (i32.const 99) (i32.const 116)) (then (return (i32.const 5))))
      (if (call $eq5 (local.get $ptr) (local.get $len) (i32.const 97) (i32.const 114) (i32.const 114) (i32.const 97) (i32.const 121)) (then (return (i32.const 6))))
      (if (call $eq4 (local.get $ptr) (local.get $len) (i32.const 110) (i32.const 117) (i32.const 108) (i32.const 108)) (then (return (i32.const 7))))
      i32.const 0)
    (func (export "codex_schema_infer_type")
      (param $has_type i32) (param $has_anyof i32) (param $has_object_keywords i32)
      (param $has_array_keywords i32) (param $has_enum_or_format i32) (param $has_number_keywords i32)
      (result i32)
      ;; mirrors sanitize_json_schema inference.
      (if (local.get $has_type) (then (return (i32.const 0))))
      (if (local.get $has_anyof) (then (return (i32.const 0))))
      (if (local.get $has_object_keywords) (then (return (i32.const 5))))
      (if (local.get $has_array_keywords) (then (return (i32.const 6))))
      (if (local.get $has_enum_or_format) (then (return (i32.const 1))))
      (if (local.get $has_number_keywords) (then (return (i32.const 2))))
      i32.const 1)
    (func (export "codex_schema_parse_result") (param $schema_type i32) (result i32)
      ;; singleton null tool input schema is rejected.
      (if (result i32) (i32.eq (local.get $schema_type) (i32.const 7))
        (then i32.const 1)
        (else i32.const 0)))
    (func (export "codex_tool_environment_mode") (param $count i32) (result i32)
      ;; none=0 single=1 multiple=2.
      (if (i32.eqz (local.get $count)) (then (return (i32.const 0))))
      (if (i32.eq (local.get $count) (i32.const 1)) (then (return (i32.const 1))))
      i32.const 2)
    (func (export "codex_tool_shell_type")
      (param $shell_tool_feature i32) (param $zsh_fork_feature i32) (param $unified_exec_feature i32)
      (param $model_shell_type i32) (param $conpty_supported i32)
      (result i32)
      ;; disabled=0 shell_command=1 unified_exec=2.
      (if (i32.eqz (local.get $shell_tool_feature)) (then (return (i32.const 0))))
      (if (local.get $zsh_fork_feature) (then (return (i32.const 1))))
      (if (i32.and (local.get $unified_exec_feature) (local.get $conpty_supported)) (then (return (i32.const 2))))
      (if (i32.and (i32.eq (local.get $model_shell_type) (i32.const 2)) (i32.eqz (local.get $unified_exec_feature))) (then (return (i32.const 1))))
      local.get $model_shell_type)
    (func (export "codex_unified_exec_mode")
      (param $is_unix i32) (param $backend_zsh_fork i32) (param $user_shell_zsh i32)
      (param $has_zsh_path i32) (param $has_wrapper_path i32) (param $paths_absolute i32)
      (result i32)
      ;; direct=0 zsh_fork=1.
      (if (result i32) (i32.and
            (i32.and (local.get $is_unix) (local.get $backend_zsh_fork))
            (i32.and (i32.and (local.get $user_shell_zsh) (local.get $has_zsh_path))
                     (i32.and (local.get $has_wrapper_path) (local.get $paths_absolute))))
        (then i32.const 1)
        (else i32.const 0)))
    (func (export "codex_tool_gates")
      (param $model_supports_search i32) (param $tool_search i32)
      (param $apps i32) (param $plugins i32) (param $tool_suggest i32)
      (param $chatgpt_image_auth i32) (param $image_feature i32) (param $model_has_image_input i32)
      (result i32)
      ;; bit0 search, bit1 suggest, bit2 image_generation.
      (i32.or
        (i32.or
          (select (i32.const 1) (i32.const 0) (i32.and (local.get $model_supports_search) (local.get $tool_search)))
          (select (i32.const 2) (i32.const 0) (i32.and (i32.and (local.get $apps) (local.get $plugins)) (local.get $tool_suggest))))
        (select (i32.const 4) (i32.const 0) (i32.and (i32.and (local.get $chatgpt_image_auth) (local.get $image_feature)) (local.get $model_has_image_input)))))
    (func (export "codex_apply_patch_tool_type") (param $model_tool i32) (param $freeform_feature i32) (result i32)
      ;; none=0 function=1 freeform=2; model setting wins, feature adds freeform fallback.
      (if (i32.ne (local.get $model_tool) (i32.const 0)) (then (return (local.get $model_tool))))
      (if (result i32) (local.get $freeform_feature) (then i32.const 2) (else i32.const 0)))
    (func (export "codex_request_user_input_mode_available")
      (param $mode_allows i32) (param $default_mode i32) (param $default_feature i32) (result i32)
      (i32.or (local.get $mode_allows) (i32.and (local.get $default_mode) (local.get $default_feature))))
    (func (export "codex_request_body_result")
      (param $body_kind i32) (param $compression i32) (param $has_content_type i32) (param $has_content_encoding i32)
      (result i32)
      ;; none=0 ok, 1 raw+compression, 2 content-encoding conflict, 3 zstd disabled, 4 sets json content-type.
      (if (i32.eqz (local.get $body_kind)) (then (return (i32.const 0))))
      (if (i32.eq (local.get $body_kind) (i32.const 2))
        (then
          (if (local.get $compression) (then (return (i32.const 1))))
          (return (i32.const 0))))
      (if (local.get $compression)
        (then
          (if (local.get $has_content_encoding) (then (return (i32.const 2))))
          (return (i32.const 3))))
      (if (result i32) (local.get $has_content_type) (then i32.const 0) (else i32.const 4)))
    (func (export "codex_retry_should_retry")
      (param $retry_429 i32) (param $retry_5xx i32) (param $retry_transport i32)
      (param $attempt i32) (param $max_attempts i32) (param $error_kind i32) (param $status i32)
      (result i32)
      ;; error_kind: 1 http, 2 timeout, 3 network, other no.
      (if (i32.ge_u (local.get $attempt) (local.get $max_attempts)) (then (return (i32.const 0))))
      (if (i32.eq (local.get $error_kind) (i32.const 1))
        (then
          (if (i32.and (local.get $retry_429) (i32.eq (local.get $status) (i32.const 429))) (then (return (i32.const 1))))
          (return (i32.and (local.get $retry_5xx) (i32.and (i32.ge_u (local.get $status) (i32.const 500)) (i32.lt_u (local.get $status) (i32.const 600)))))))
      (if (i32.or (i32.eq (local.get $error_kind) (i32.const 2)) (i32.eq (local.get $error_kind) (i32.const 3)))
        (then (return (local.get $retry_transport))))
      i32.const 0)
    (func (export "codex_retry_backoff_nominal_ms") (param $base_ms i32) (param $attempt i32) (result i32)
      ;; nominal center of jittered backoff: attempt 0 base, attempt n base*2^(n-1).
      (if (i32.eqz (local.get $attempt)) (then (return (local.get $base_ms))))
      (i32.shl (local.get $base_ms) (i32.sub (local.get $attempt) (i32.const 1))))
    (func (export "codex_sse_event_result") (param $state i32) (result i32)
      ;; event=0, stream error=1, closed before completion=2, timeout=3.
      (if (i32.eq (local.get $state) (i32.const 1)) (then (return (i32.const 0))))
      (if (i32.eq (local.get $state) (i32.const 2)) (then (return (i32.const 1))))
      (if (i32.eq (local.get $state) (i32.const 3)) (then (return (i32.const 2))))
      (if (i32.eq (local.get $state) (i32.const 4)) (then (return (i32.const 3))))
      i32.const 1)
    (func (export "codex_provider_validate_result")
      (param $has_aws i32) (param $supports_websockets i32) (param $has_env_key i32)
      (param $has_bearer i32) (param $has_auth i32) (param $requires_openai_auth i32)
      (param $auth_command_empty i32)
      (result i32)
      ;; 0 ok, 1 aws websocket conflict, 2 aws auth conflict, 3 empty command, 4 command auth conflict.
      (if (local.get $has_aws)
        (then
          (if (local.get $supports_websockets) (then (return (i32.const 1))))
          (if (i32.or (i32.or (local.get $has_env_key) (local.get $has_bearer)) (i32.or (local.get $has_auth) (local.get $requires_openai_auth)))
            (then (return (i32.const 2))))
          (return (i32.const 0))))
      (if (local.get $has_auth)
        (then
          (if (local.get $auth_command_empty) (then (return (i32.const 3))))
          (if (i32.or (i32.or (local.get $has_env_key) (local.get $has_bearer)) (local.get $requires_openai_auth))
            (then (return (i32.const 4))))))
      i32.const 0)
    (func (export "codex_provider_retry_cap") (param $configured i32) (param $is_stream i32) (result i32)
      ;; default request=4, stream=5; both cap at 100. configured -1 means unset.
      (local $value i32)
      (local.set $value
        (if (result i32) (i32.lt_s (local.get $configured) (i32.const 0))
          (then (if (result i32) (local.get $is_stream) (then i32.const 5) (else i32.const 4)))
          (else local.get $configured)))
      (if (result i32) (i32.gt_u (local.get $value) (i32.const 100)) (then i32.const 100) (else local.get $value)))
    (func (export "codex_provider_timeout_ms") (param $configured i32) (param $is_websocket i32) (result i32)
      ;; default stream idle 300000ms; websocket connect 15000ms.
      (if (i32.ge_s (local.get $configured) (i32.const 0))
        (then (return (local.get $configured))))
      (if (result i32) (local.get $is_websocket) (then i32.const 15000) (else i32.const 300000)))
    (func (export "codex_model_cache_ttl_seconds") (result i32)
      i32.const 300)
    (func (export "codex_refresh_strategy_allows_network") (param $strategy i32) (param $cache_fresh i32) (result i32)
      ;; online=1 offline=2 online_if_uncached=3.
      (if (i32.eq (local.get $strategy) (i32.const 1)) (then (return (i32.const 1))))
      (if (i32.eq (local.get $strategy) (i32.const 2)) (then (return (i32.const 0))))
      (if (i32.eq (local.get $strategy) (i32.const 3)) (then (return (i32.eqz (local.get $cache_fresh)))))
      i32.const 0)
    (func (export "codex_pipeline_stage_count") (result i32)
      i32.const 7)
    (func (export "codex_pipeline_stage_kind") (param $index i32) (result i32)
      ;; Router=1 Codebase=2 Architect=3 Toolsmith=4 Executor=5 Reviewer=6 Summarizer=7.
      (if (result i32) (i32.le_u (local.get $index) (i32.const 6))
        (then (i32.add (local.get $index) (i32.const 1)))
        (else i32.const 0)))
    (func (export "codex_pipeline_route_mask") (param $task_kind i32) (result i32)
      ;; bit index follows stage index. explain=1 build/debug=2 edit=3 architecture=4.
      ;; Router and Summarizer always present.
      (if (i32.eq (local.get $task_kind) (i32.const 1)) (then (return (i32.const 0x43))))
      (if (i32.eq (local.get $task_kind) (i32.const 2)) (then (return (i32.const 0x77))))
      (if (i32.eq (local.get $task_kind) (i32.const 3)) (then (return (i32.const 0x7f))))
      (if (i32.eq (local.get $task_kind) (i32.const 4)) (then (return (i32.const 0x67))))
      i32.const 0x7f)
    (func (export "codex_pipeline_limit") (param $which i32) (result i32)
      ;; 1 history, 2 stage output, 3 previous output, 4 repo context, 5 revealed context,
      ;; 6 reveal rounds, 7 reveals per round, 8 repo edits per stage.
      (if (i32.eq (local.get $which) (i32.const 1)) (then (return (i32.const 2400))))
      (if (i32.eq (local.get $which) (i32.const 2)) (then (return (i32.const 2400))))
      (if (i32.eq (local.get $which) (i32.const 3)) (then (return (i32.const 9000))))
      (if (i32.eq (local.get $which) (i32.const 4)) (then (return (i32.const 12000))))
      (if (i32.eq (local.get $which) (i32.const 5)) (then (return (i32.const 18000))))
      (if (i32.eq (local.get $which) (i32.const 6)) (then (return (i32.const 2))))
      (if (i32.eq (local.get $which) (i32.const 7)) (then (return (i32.const 8))))
      (if (i32.eq (local.get $which) (i32.const 8)) (then (return (i32.const 4))))
      i32.const 0)
    (func (export "codex_code_mode_parse_result")
      (param $trim_empty i32) (param $has_pragma i32) (param $rest_empty i32)
      (param $pragma_json_object i32) (param $unsupported_field i32) (param $safe_integer i32)
      (result i32)
      ;; 0 ok, 1 empty source, 2 pragma without source, 3 bad pragma object, 4 unsupported field, 5 unsafe integer.
      (if (local.get $trim_empty) (then (return (i32.const 1))))
      (if (i32.eqz (local.get $has_pragma)) (then (return (i32.const 0))))
      (if (local.get $rest_empty) (then (return (i32.const 2))))
      (if (i32.eqz (local.get $pragma_json_object)) (then (return (i32.const 3))))
      (if (local.get $unsupported_field) (then (return (i32.const 4))))
      (if (i32.eqz (local.get $safe_integer)) (then (return (i32.const 5))))
      i32.const 0)
    (func (export "codex_code_mode_identifier_char") (param $ch i32) (param $index i32) (result i32)
      (local $alpha i32) (local $digit i32)
      (local.set $alpha (i32.or (i32.and (i32.ge_u (local.get $ch) (i32.const 65)) (i32.le_u (local.get $ch) (i32.const 90)))
                                (i32.and (i32.ge_u (local.get $ch) (i32.const 97)) (i32.le_u (local.get $ch) (i32.const 122)))))
      (local.set $digit (i32.and (i32.ge_u (local.get $ch) (i32.const 48)) (i32.le_u (local.get $ch) (i32.const 57))))
      (if (i32.eqz (local.get $index))
        (then (return (i32.or (i32.or (i32.eq (local.get $ch) (i32.const 95)) (i32.eq (local.get $ch) (i32.const 36))) (local.get $alpha)))))
      (i32.or (i32.or (i32.or (i32.eq (local.get $ch) (i32.const 95)) (i32.eq (local.get $ch) (i32.const 36))) (local.get $alpha)) (local.get $digit)))
    (func (export "codex_ui_patch_kind") (param $kind i32) (result i32)
      ;; ui_stream PatchKind valid range 0..50.
      (if (result i32) (i32.le_u (local.get $kind) (i32.const 50)) (then local.get $kind) (else i32.const -1)))
    (func (export "codex_ui_agent_component_id") (param $component i32) (result i32)
      ;; AssistantDraft=1 Status=2 ToolCall=3 Stdout=4 Stderr=5 DiffPreview=6 Input=7 RunButton=8.
      (if (result i32) (i32.and (i32.ge_u (local.get $component) (i32.const 1)) (i32.le_u (local.get $component) (i32.const 8)))
        (then local.get $component)
