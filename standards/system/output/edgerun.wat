                        (block $fr_res_lp
                          (loop $fr_res_cont
                            (if (i32.lt_s (local.get $i) (i32.const 0)) (then (br $fr_res_lp)))
                            (local.set $err (call $itp_stack_pop))
                            (if (local.get $err) (then (return (local.get $err))))
                            (i64.store
                              (i32.add (global.get $itp_OFF_EXEC_RESULT) (i32.shl (local.get $i) (i32.const 3)))
                              (i64.extend_i32_s (i32.load (global.get $itp_OFF_SCRATCH0)))
                            )
                            (local.set $i (i32.sub (local.get $i) (i32.const 1)))
                            (br $fr_res_cont)
                          )
                        )
                      )
                    )
                    (i32.store (global.get $itp_OFF_EXEC_RES_COUNT) (local.get $result_count))
                    (i32.store (global.get $itp_OFF_EXEC_CTRL_LEN) (i32.const 0))  ;; reset control stack
                    (i32.store (global.get $itp_OFF_EXEC_STACK_LEN) (global.get $itp_FAST_STACK_LEN))
                    (br $dispatch_end)
                  )
