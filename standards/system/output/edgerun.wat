    ;;       pkce_challenge_prehashed(sha256_out32, out_ptr, out_cap).
    (func (export "pkce_challenge_prehashed") (param $hash i32) (param $out i32) (param $ocap i32) (result i32)
      (local $src_i i32)
      (local $dst_i i32)
