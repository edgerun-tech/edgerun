    (func (export "argb_to_hex") (param $a i32) (param $r i32) (param $g i32) (param $b i32) (param $out i32) (result i32)
      local.get $out i32.const 35 i32.store8  ;; '#'
      local.get $a i32.const 4 i32.shr_u local.get $out i32.const 1 i32.add call $hex_digit_char
      local.get $a i32.const 0xf i32.and local.get $out i32.const 2 i32.add call $hex_digit_char
      local.get $r i32.const 4 i32.shr_u local.get $out i32.const 3 i32.add call $hex_digit_char
      local.get $r i32.const 0xf i32.and local.get $out i32.const 4 i32.add call $hex_digit_char
      local.get $g i32.const 4 i32.shr_u local.get $out i32.const 5 i32.add call $hex_digit_char
      local.get $g i32.const 0xf i32.and local.get $out i32.const 6 i32.add call $hex_digit_char
      local.get $b i32.const 4 i32.shr_u local.get $out i32.const 7 i32.add call $hex_digit_char
      local.get $b i32.const 0xf i32.and local.get $out i32.const 8 i32.add i32.store8
      local.get $out i32.const 9 i32.add
