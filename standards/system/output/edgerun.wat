(module
  (import "edgerun.io" "tor_relay_connect" (func $host_relay_connect (param i32 i32 i32 i32) (result i32)))
  (import "edgerun.io" "tor_relay_send_cell" (func $host_send_cell (param i32 i32 i32) (result i32)))
  (import "sock" "close" (func $sock_close (param $fd i32) (result i32)))
  (import "sock" "open" (func $sock_open (param $type i32) (param $cfg i32) (param $cfg_len i32) (result i32)))
  (import "sock" "poll" (func $sock_poll (param $fd i32) (param $timeout i32) (result i32)))
  (import "sock" "recv" (func $sock_recv (param $fd i32) (param $buf i32) (param $cap i32) (result i32)))
  (import "sock" "send" (func $sock_send (param $fd i32) (param $buf i32) (param $len i32) (result i32)))
  (import "tor.crypto" "tor_aes_ctr_crypt" (func $host_aes_ctr_crypt (param i32 i32 i32 i32 i32) (result i32)))
  (import "tor.crypto" "tor_ntor_server_handshake_seeded" (func $host_ntor_server_handshake_seeded (param i32 i32 i32 i32 i32 i32 i32) (result i32)))
  (import "tor.crypto" "tor_ntor_v3_server_handshake_seeded" (func $host_ntor_v3_server_handshake_seeded (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32) (result i32)))
  (import "tor.crypto" "tor_relay_digest_update20_sha1" (func $host_relay_digest_update20_sha1 (param i32 i32 i32 i32) (result i32)))

  (memory (export "memory") 256)

  ;; Shared runtime core for edgerun unified system.
  ;; Provides character classification LUTs, SIMD stubs, and common helpers.
  ;; All functions use unfolded (flat) WAT style.
  ;; Character classification LUT at 0x1000 (256 bytes)
  ;; bit 0: digit, bit 1: uppercase, bit 2: lowercase, bit 3: tchar,
  ;; bit 4: hex, bit 5: ws, bit 6: scheme, bit 7: dns-label
  (data (i32.const 0x1000) "\00\00\00\00\00\00\00\00\00\20\20\00\00\20\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\20\08\00\08\08\08\08\08\00\00\08\48\00\c8\48\00\d9\d9\d9\d9\d9\d9\d9\d9\d9\d9\00\00\00\00\00\00\00\da\da\da\da\da\da\ca\ca\ca\ca\ca\ca\ca\ca\ca\ca\ca\ca\ca\ca\ca\ca\ca\ca\ca\ca\00\00\00\08\08\08\dc\dc\dc\dc\dc\dc\cc\cc\cc\cc\cc\cc\cc\cc\cc\cc\cc\cc\cc\cc\cc\cc\cc\cc\cc\cc\00\08\00\08\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00")
  ;; Lowercase mapping LUT at 0x2000 (256 bytes)
  (data (i32.const 0x2000) "\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\61\62\63\64\65\66\67\68\69\6a\6b\6c\6d\6e\6f\70\71\72\73\74\75\76\77\78\79\7a\00\00\00\00\00\00\61\62\63\64\65\66\67\68\69\6a\6b\6c\6d\6e\6f\70\71\72\73\74\75\76\77\78\79\7a\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00")
  ;; Character classification helpers
  (func $char_class (param $b i32) (result i32)
    (i32.load8_u offset=0x1000 (local.get $b)))
  (func $is_digit (param $b i32) (result i32)
    (i32.and (call $char_class (local.get $b)) (i32.const 1)))
  (func $is_upper (param $b i32) (result i32)
    (i32.and (call $char_class (local.get $b)) (i32.const 2)))
  (func $is_lower (param $b i32) (result i32)
    (i32.and (call $char_class (local.get $b)) (i32.const 4)))
  (func $is_alpha (param $b i32) (result i32)
    (i32.and (call $char_class (local.get $b)) (i32.const 6)))
  (func $is_tchar (param $b i32) (result i32)
    (i32.and (call $char_class (local.get $b)) (i32.const 8)))
  (func $is_hex (param $b i32) (result i32)
    (i32.and (call $char_class (local.get $b)) (i32.const 16)))
  (func $is_ws (param $b i32) (result i32)
    (i32.and (call $char_class (local.get $b)) (i32.const 32)))
  (func $is_scheme_byte (param $b i32) (result i32)
    (i32.and (call $char_class (local.get $b)) (i32.const 64)))
  (func $is_label_byte (param $b i32) (result i32)
    (i32.and (call $char_class (local.get $b)) (i32.const 128)))
  (func $to_lower (param $b i32) (result i32)
    (local $cl i32)
    (local.set $cl (call $char_class (local.get $b)))
    (if (i32.and (local.get $cl) (i32.const 2))
      (then (return (i32.or (local.get $b) (i32.const 32))))
      (else (if (i32.and (local.get $cl) (i32.const 4))
        (then (return (local.get $b)))
        (else (return (i32.const 0)))))))
  ;; Pack/unpack helpers
  (func $pack (param $a i32) (param $b i32) (param $c i32) (param $d i32) (result i32)
    (i32.or
      (i32.or
        (i32.or
          (local.get $d)
          (i32.shl (local.get $c) (i32.const 8)))
        (i32.shl (local.get $b) (i32.const 16)))
      (i32.shl (local.get $a) (i32.const 24))))
  (func $pack_u16 (param $a i32) (param $b i32) (result i32)
    (i32.or
      (local.get $b)
      (i32.shl (local.get $a) (i32.const 8))))
  (func $byte (param $v i32) (param $i i32) (result i32)
    (i32.and
      (i32.shr_u (local.get $v) (i32.shl (local.get $i) (i32.const 3)))
      (i32.const 0xFF)))
  (func $has (param $v i32) (param $mask i32) (result i32)
    (i32.ne (i32.and (local.get $v) (local.get $mask)) (i32.const 0)))
  (func $is_cont (param $b i32) (result i32)
    (i32.eq (i32.and (local.get $b) (i32.const 0xC0)) (i32.const 0x80)))
  ;; Emit helpers (for compiler code emission)
  (func $emit_byte (param $addr i32) (param $b i32)
    (i32.store8 (local.get $addr) (local.get $b)))
  (func $emit_dword (param $addr i32) (param $v i32)
    (i32.store (local.get $addr) (local.get $v)))
  (func $emit_modrm (param $addr i32) (param $mod i32) (param $reg i32) (param $rm i32)
    (i32.store8 (local.get $addr)
      (i32.or
        (i32.or
          (i32.shl (local.get $mod) (i32.const 6))
          (i32.shl (local.get $reg) (i32.const 3)))
        (local.get $rm))))
  ;; SIMD stubs
  (func $simd_memchr (param $ptr i32) (param $len i32) (param $byte i32) (result i32)
    (local $i i32) (local $vec v128) (local $cmp v128) (local $mask i32)
    (local.set $i (local.get $ptr))
    (block $done
      (loop $loop
        (br_if $done
          (i32.lt_u (local.get $len) (i32.const 16)))
        (local.set $vec (v128.load (local.get $i)))
        (local.set $cmp
          (i8x16.eq (local.get $vec)
            (i8x16.splat (i32.wrap_i64 (i64.extend_i32_u (local.get $byte))))))
        (local.set $mask (i32x4.bitmask (local.get $cmp)))
        (if (local.get $mask)
          (then
            (return (i32.add (local.get $i)
              (i32.ctz (local.get $mask))))))
        (local.set $i (i32.add (local.get $i) (i32.const 16)))
        (local.set $len (i32.sub (local.get $len) (i32.const 16)))
        (br $loop)))
    (block $r_done
      (loop $r_loop
        (br_if $r_done
          (i32.eqz (local.get $len)))
        (if (i32.eq (i32.load8_u (local.get $i)) (local.get $byte))
          (then (return (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (local.set $len (i32.sub (local.get $len) (i32.const 1)))
        (br $r_loop)))
    (i32.const -1))
  (func $simd_memrchr (param $ptr i32) (param $len i32) (param $byte i32) (result i32)
    (local $i i32) (local $end i32) (local $vec v128) (local $cmp v128) (local $mask i32)
    (local.set $end (i32.add (local.get $ptr) (local.get $len)))
    (local.set $i (i32.sub (local.get $end) (i32.const 16)))
    (block $done
      (loop $loop
        (br_if $done
          (i32.lt_u (local.get $i) (local.get $ptr)))
        (local.set $vec (v128.load (local.get $i)))
        (local.set $cmp
          (i8x16.eq (local.get $vec)
            (i8x16.splat (i32.wrap_i64 (i64.extend_i32_u (local.get $byte))))))
        (local.set $mask (i32x4.bitmask (local.get $cmp)))
        (if (local.get $mask)
          (then
            (return (i32.add (local.get $i)
              (i32.ctz (local.get $mask))))))
        (local.set $i (i32.sub (local.get $i) (i32.const 16)))
        (br $loop)))
    (local.set $i (i32.sub (local.get $end) (i32.const 1)))
    (block $r_done
      (loop $r_loop
        (br_if $r_done
          (i32.lt_u (local.get $i) (local.get $ptr)))
        (if (i32.eq (i32.load8_u (local.get $i)) (local.get $byte))
          (then (return (local.get $i))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $r_loop)))
    (i32.const -1))
  ;; ABI exports
  (func (export "proto_abi_version") (result i32)
    (i32.const 2))
  (func (export "proto_standard_id") (result i32)
    (i32.const 0))
  (func (export "simd_capabilities") (result i32)
    (i32.const 1))

  ;; ===================================================================
    ;; EdgeRun WASM Interpreter — ported to WAT
    ;;
    ;; Self-hosting WASM meta-circular interpreter: loads, validates, and
    ;; interprets WASM binary modules. Mirrors the x86_64 assembly runtime.
    ;;
    ;; Memory:
    ;;   0x00000 - 0x6FFFF: Interpreter state
    ;;   0x70000 - 0x7FFFF: Frame save area (64KB)
    ;;   0x80000 - 0x8FFFF: Scratch workspace
    ;;   0x90000 - 0x9FFFF: Names buffer (64KB)
    ;;   0xA0000 - 0xFFFFF: Decoded ops cache (384KB, 32768 * 32 = 1MB)
    ;;   0x100000+        : Guest WASM binary
    ;;
    ;; Exports:
    ;;   load(wasm_ptr, wasm_len) -> error_code
    ;;   call(func_idx, args_ptr, args_len) -> error_code
    ;;   get_result_value(idx) -> i64
    ;;   get_result_count() -> i32
    ;;   memory
    ;; ===================================================================
    ;; ── Memory offsets ──────────────────────────────────────────────────
    (global $itp_OFF_ERR         i32 (i32.const 0))
    (global $itp_OFF_SCRATCH0    i32 (i32.const 8))
    (global $itp_OFF_SCRATCH1    i32 (i32.const 16))
    (global $itp_OFF_SCRATCH2    i32 (i32.const 24))
    (global $itp_OFF_SCRATCH3    i32 (i32.const 32))
    (global $itp_FAST_STACK_LEN  (mut i32) (i32.const 0))
    (global $itp_OFF_WASM_PTR    i32 (i32.const 64))
    (global $itp_OFF_WASM_LEN    i32 (i32.const 72))
    ;; Type section
    (global $itp_OFF_TYPE_COUNT i32 (i32.const 256))
    (global $itp_OFF_TYPES_BUF  i32 (i32.const 264))
    ;; Import section
    (global $itp_OFF_IMPORT_COUNT i32 (i32.const 16648))
    (global $itp_OFF_IMPORTS_BUF  i32 (i32.const 16656))
    ;; Function section
    (global $itp_OFF_FUNCTION_COUNT i32 (i32.const 17680))
    (global $itp_OFF_FUNCTIONS_BUF  i32 (i32.const 17688))
    ;; Code section
    (global $itp_OFF_CODE_COUNT i32 (i32.const 21784))
    (global $itp_OFF_CODE_BUF   i32 (i32.const 21792))
    ;; Export section
    (global $itp_OFF_EXPORT_COUNT i32 (i32.const 38176))
    (global $itp_OFF_EXPORTS_BUF  i32 (i32.const 38184))
    ;; Global section
    (global $itp_OFF_GLOBAL_COUNT i32 (i32.const 40232))
    (global $itp_OFF_GLOBALS_BUF  i32 (i32.const 40240))
    ;; Table state
    (global $itp_OFF_TABLE_HAS i32 (i32.const 42288))
    (global $itp_OFF_TABLE_MIN i32 (i32.const 42292))
    (global $itp_OFF_TABLE_MAX i32 (i32.const 42300))
    (global $itp_OFF_TABLE_DATA i32 (i32.const 42308))
    ;; Memory state
    (global $itp_OFF_MEM_MIN i32 (i32.const 43300))
    (global $itp_OFF_MEM_MAX i32 (i32.const 43308))
    ;; Start function index
    (global $itp_OFF_START_FUNC i32 (i32.const 43316))
    ;; Data segments
    (global $itp_OFF_DATA_COUNT i32 (i32.const 43324))
    (global $itp_OFF_DATA_BUF   i32 (i32.const 43332))
    ;; Element segments
    (global $itp_OFF_ELEM_COUNT i32 (i32.const 45380))
    (global $itp_OFF_ELEM_BUF   i32 (i32.const 45388))
    (global $itp_OFF_DBG (export "dbg") i32 (i32.const 0x0F0000))
    ;; Execution state
    (global $itp_OFF_EXEC_LOCAL_COUNT i32 (i32.const 80000))
    (global $itp_OFF_EXEC_LOCALS      i32 (i32.const 80008))
    (global $itp_OFF_EXEC_STACK_LEN   i32 (i32.const 80520))
    (global $itp_OFF_EXEC_STACK       i32 (i32.const 80528))
    (global $itp_OFF_EXEC_CTRL_LEN    i32 (i32.const 88720))
    (global $itp_OFF_EXEC_CTRL        i32 (i32.const 88728))
    (global $itp_OFF_EXEC_DEC_IDX     i32 (i32.const 89752))
    (global $itp_OFF_EXEC_DEC_END     i32 (i32.const 89760))
    (global $itp_OFF_EXEC_RESULT      i32 (i32.const 89768))
    (global $itp_OFF_EXEC_RES_COUNT   i32 (i32.const 89800))
    (global $itp_OFF_EXEC_BODY_PTR    i32 (i32.const 89808))
    (global $itp_OFF_EXEC_BODY_LEN    i32 (i32.const 89816))
    (global $itp_OFF_EXEC_READER_OFF  i32 (i32.const 89824))
    (global $itp_OFF_EXEC_TYPE_IDX    i32 (i32.const 89832))
    (global $itp_OFF_EXEC_CALL_DEPTH  i32 (i32.const 89840))
    (global $itp_OFF_EXEC_FRAME_PTR   i32 (i32.const 89848))
    (global $itp_OFF_EXEC_MOD_VALID   i32 (i32.const 89856))
    (global $itp_OFF_GUEST_MEM_PAGES i32 (i32.const 89868))  ;; current guest memory pages (mutable)
    (global $itp_OFF_FRAME_SAVE i32 (i32.const 0x70000))
    (global $itp_FRAME_SAVE_SZ  i32 (i32.const 65536))
    (global $itp_OFF_DECODED_COUNT i32 (i32.const 89864))
    (global $itp_OFF_DECODED_OPS   i32 (i32.const 0xA0000))
    (global $itp_OFF_NAMES_BUF     i32 (i32.const 0x90000))
    (global $itp_OFF_NAMES_PTR    i32 (i32.const 0x8FFF0))
    (global $itp_OFF_GUEST_MEM_BASE i32 (i32.const 0x200000))
    (global $itp_OFF_CALL_ARGS    i32 (i32.const 0x8FE00))
    ;; Label stack for computing matching block/loop/if/else/end during decode
    (global $itp_OFF_LABEL_STACK     i32 (i32.const 0x8F000))
    (global $itp_OFF_LABEL_STACK_PTR i32 (i32.const 0x8EFFC))
    ;; Decoded op format (16 bytes): opcode(1) + flags(1) + pad(2) + imm0(4) + imm1(4) + next_idx(4)
    (global $itp_DEC_SZ  i32 (i32.const 16))
    ;; ── Resource limits ─────────────────────────────────────────────────
    (global $itp_MAX_FUNCTIONS i32 (i32.const 256))
    (global $itp_MAX_IMPORTS   i32 (i32.const 16))
    (global $itp_MAX_TYPES     i32 (i32.const 64))
    (global $itp_MAX_LOCALS    i32 (i32.const 64))
    (global $itp_MAX_STACK     i32 (i32.const 1024))
    (global $itp_MAX_CTRL      i32 (i32.const 64))
    (global $itp_MAX_GLOBALS   i32 (i32.const 64))
    (global $itp_MAX_EXPORTS   i32 (i32.const 64))
    (global $itp_MAX_TABLE     i32 (i32.const 256))
    (global $itp_MAX_DATAS     i32 (i32.const 64))
    (global $itp_MAX_ELEMS     i32 (i32.const 64))
    (global $itp_MAX_DECODED   i32 (i32.const 32768))
    (global $itp_DECODED_SZ    i32 (i32.const 32))
    ;; ── Struct sizes ────────────────────────────────────────────────────
    (global $itp_SZ_TYPE   i32 (i32.const 256))
    (global $itp_SZ_FUNC   i32 (i32.const 16))
    (global $itp_SZ_CODE   i32 (i32.const 64))
    (global $itp_SZ_EXPORT i32 (i32.const 32))
    (global $itp_SZ_GLOBAL i32 (i32.const 32))
    (global $itp_SZ_IMPORT i32 (i32.const 64))
    (global $itp_SZ_DATA   i32 (i32.const 32))
    (global $itp_SZ_ELEM   i32 (i32.const 512))
    (global $itp_SZ_CTRL   i32 (i32.const 16))
    ;; ── WASM format ─────────────────────────────────────────────────────
    (global $itp_TI32 i32 (i32.const 0x7f))
    (global $itp_TI64 i32 (i32.const 0x7e))
    (global $itp_TF32 i32 (i32.const 0x7d))
    (global $itp_TF64 i32 (i32.const 0x7c))
    (global $itp_SEC_TYPE i32 (i32.const 1))
    (global $itp_SEC_IMPORT i32 (i32.const 2))
    (global $itp_SEC_FUNCTION i32 (i32.const 3))
    (global $itp_SEC_TABLE i32 (i32.const 4))
    (global $itp_SEC_MEMORY i32 (i32.const 5))
    (global $itp_SEC_GLOBAL i32 (i32.const 6))
    (global $itp_SEC_EXPORT i32 (i32.const 7))
    (global $itp_SEC_START i32 (i32.const 8))
    (global $itp_SEC_ELEMENT i32 (i32.const 9))
    (global $itp_SEC_CODE i32 (i32.const 10))
    (global $itp_SEC_DATA i32 (i32.const 11))
    (global $itp_EXT_FUNC i32 (i32.const 0))
    (global $itp_EXT_TABLE i32 (i32.const 1))
    (global $itp_EXT_MEM i32 (i32.const 2))
    (global $itp_EXT_GLOBAL i32 (i32.const 3))
    ;; ── Error codes ─────────────────────────────────────────────────────
    (global $itp_OK           i32 (i32.const 0))
    (global $itp_ERR_UNSUP    i32 (i32.const 1))
    (global $itp_ERR_CORRUPT  i32 (i32.const 2))
    (global $itp_ERR_STK_UND  i32 (i32.const 3))
    (global $itp_ERR_STK_OV   i32 (i32.const 4))
    (global $itp_ERR_PARSE    i32 (i32.const 7))
    (global $itp_ERR_NOIMP    i32 (i32.const 8))
    (global $itp_ERR_TM       i32 (i32.const 9))
    (global $itp_ERR_UNK_OP   i32 (i32.const 10))
    (global $itp_ERR_NO_MEM   i32 (i32.const 12))
    (global $itp_ERR_IDX      i32 (i32.const 13))
    (global $itp_ERR_TRAP     i32 (i32.const 16))
    (global $itp_ERR_ARITH    i32 (i32.const 17))
    (global $itp_ERR_MISS_IMP i32 (i32.const 18))
    (global $itp_ERR_MISS_EXP i32 (i32.const 19))
    (global $itp_ERR_BAD_ARGUMENT i32 (i32.const 20))
    (global $itp_ERR_RECUR    i32 (i32.const 31))
    ;; ═════════════════════════════════════════════════════════════════════
    ;; LEB128 Decoding
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_leb_u32 (param $offset i32) (result i32)
      (local $r i32) (local $s i32) (local $b i32) (local $c i32) (local $p i32) (local $l i32)
      (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
      (local.set $l (i32.load (global.get $itp_OFF_WASM_LEN)))
      (local.set $c (local.get $offset))
      (block $end
        (loop $lp
          (if (i32.ge_u (local.get $c) (local.get $l)) (then (return (global.get $itp_ERR_PARSE))))
          (local.set $b (i32.load8_u (i32.add (local.get $p) (local.get $c))))
          (local.set $c (i32.add (local.get $c) (i32.const 1)))
          (local.set $r (i32.or (local.get $r) (i32.shl (i32.and (local.get $b) (i32.const 0x7f)) (local.get $s))))
          (local.set $s (i32.add (local.get $s) (i32.const 7)))
          (if (i32.gt_u (local.get $s) (i32.const 35)) (then (return (global.get $itp_ERR_PARSE))))
          (if (i32.eqz (i32.and (local.get $b) (i32.const 0x80))) (then (br $end)))
          (br $lp)
        )
      )
      (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $r))
      (i32.store (global.get $itp_OFF_SCRATCH1) (i32.sub (local.get $c) (local.get $offset)))
      (return (global.get $itp_OK))
    )
    (func $itp_leb_i32 (param $offset i32) (result i32)
      (local $r i32) (local $s i32) (local $b i32) (local $c i32) (local $p i32) (local $l i32)
      (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
      (local.set $l (i32.load (global.get $itp_OFF_WASM_LEN)))
      (local.set $c (local.get $offset))
      (block $end
        (loop $lp
          (if (i32.ge_u (local.get $c) (local.get $l)) (then (return (global.get $itp_ERR_PARSE))))
          (local.set $b (i32.load8_u (i32.add (local.get $p) (local.get $c))))
          (local.set $c (i32.add (local.get $c) (i32.const 1)))
          (local.set $r (i32.or (local.get $r) (i32.shl (i32.and (local.get $b) (i32.const 0x7f)) (local.get $s))))
          (local.set $s (i32.add (local.get $s) (i32.const 7)))
          (if (i32.gt_u (local.get $s) (i32.const 35)) (then (return (global.get $itp_ERR_PARSE))))
          (if (i32.eqz (i32.and (local.get $b) (i32.const 0x80))) (then (br $end)))
          (br $lp)
        )
      )
      (if (i32.and (local.get $b) (i32.const 0x40))
        (then (local.set $r (i32.or (local.get $r) (i32.shl (i32.const -1) (local.get $s)))))
      )
      (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $r))
      (i32.store (global.get $itp_OFF_SCRATCH1) (i32.sub (local.get $c) (local.get $offset)))
      (return (global.get $itp_OK))
    )
    (func $itp_leb_i64 (param $offset i32) (result i32)
      (local $r_lo i32) (local $r_hi i32) (local $s i32) (local $b i32) (local $c i32) (local $p i32) (local $l i32)
      (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
      (local.set $l (i32.load (global.get $itp_OFF_WASM_LEN)))
      (local.set $c (local.get $offset))
      (block $end
        (loop $lp
          (if (i32.ge_u (local.get $c) (local.get $l)) (then (return (global.get $itp_ERR_PARSE))))
          (local.set $b (i32.load8_u (i32.add (local.get $p) (local.get $c))))
          (local.set $c (i32.add (local.get $c) (i32.const 1)))
          (if (i32.lt_s (local.get $s) (i32.const 32))
            (then
              (local.set $r_lo (i32.or (local.get $r_lo) (i32.shl (i32.and (local.get $b) (i32.const 0x7f)) (local.get $s))))
            )
            (else
              (local.set $r_hi (i32.or (local.get $r_hi) (i32.shl (i32.and (local.get $b) (i32.const 0x7f)) (i32.sub (local.get $s) (i32.const 32)))))
            )
          )
          (local.set $s (i32.add (local.get $s) (i32.const 7)))
          (if (i32.gt_u (local.get $s) (i32.const 63)) (then (return (global.get $itp_ERR_PARSE))))
          (if (i32.eqz (i32.and (local.get $b) (i32.const 0x80))) (then (br $end)))
          (br $lp)
        )
      )
      (if (i32.and (local.get $b) (i32.const 0x40))
        (then
          (if (i32.lt_s (local.get $s) (i32.const 32))
            (then (local.set $r_lo (i32.or (local.get $r_lo) (i32.shl (i32.const -1) (local.get $s)))))
            (else (local.set $r_hi (i32.or (local.get $r_hi) (i32.shl (i32.const -1) (i32.sub (local.get $s) (i32.const 32))))))
          )
        )
      )
      (i64.store (global.get $itp_OFF_SCRATCH0)
        (i64.or (i64.extend_i32_u (local.get $r_lo)) (i64.shl (i64.extend_i32_u (local.get $r_hi)) (i64.const 32)))
      )
      (i32.store (global.get $itp_OFF_SCRATCH2) (i32.sub (local.get $c) (local.get $offset)))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; String / name reader (length-prefixed UTF-8 byte sequence)
    ;; stores name bytes to OFFSET_NAMES_BUF, returns (name_offset, bytes_consumed)
    ;; in scratch0/scratch1
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_read_name (param $offset i32) (result i32)
      (local $len i32) (local $adv i32) (local $dst i32) (local $p i32) (local $i i32)
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $len (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $adv (i32.load (global.get $itp_OFF_SCRATCH1)))
      (local.set $offset (i32.add (local.get $offset) (local.get $adv)))
      (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
      (local.set $dst (i32.load (global.get $itp_OFF_NAMES_PTR)))
      (local.set $i (i32.const 0))
      (block $copy_end
        (loop $copy_lp
          (if (i32.ge_u (local.get $i) (local.get $len)) (then (br $copy_end)))
          (i32.store8 (i32.add (local.get $dst) (local.get $i))
            (i32.load8_u (i32.add (local.get $p) (local.get $offset) (local.get $i)))
          )
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $copy_lp)
        )
      )
      (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $dst))
      (i32.store (global.get $itp_OFF_SCRATCH1) (i32.add (local.get $adv) (local.get $len)))
      ;; Advance names buffer
      (i32.store (global.get $itp_OFF_NAMES_PTR) (i32.add (local.get $dst) (local.get $len)))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Section header reader
    ;; Output: scratch0=sec_id, scratch1=sec_len, scratch2=content_offset, scratch3=end_offset
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_read_section_header (param $offset i32) (result i32)
      (local $id i32) (local $p i32) (local $l i32) (local $leb_adv i32)
      (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
      (local.set $l (i32.load (global.get $itp_OFF_WASM_LEN)))
      (if (i32.ge_u (local.get $offset) (local.get $l)) (then (return (global.get $itp_ERR_PARSE))))
      ;; Read section ID (1 byte)
      (local.set $id (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
      (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
      ;; Read section size (LEB128) - result in scratch0, advance in scratch1
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $leb_adv (i32.load (global.get $itp_OFF_SCRATCH1)))
      ;; Save section_size before overwriting scratch0
      (i32.store (global.get $itp_OFF_SCRATCH2) (i32.load (global.get $itp_OFF_SCRATCH0)))  ;; sec_size saved in scratch2 temporarily
      ;; Store results
      (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $id))                    ;; sec_id -> scratch0
      ;; scratch1 = sec_size (moved from scratch2 to scratch1)
      (i32.store (global.get $itp_OFF_SCRATCH1) (i32.load (global.get $itp_OFF_SCRATCH2)))  ;; sec_size -> scratch1
      ;; scratch2 = content_offset = offset + leb_adv
      (i32.store (global.get $itp_OFF_SCRATCH2) (i32.add (local.get $offset) (local.get $leb_adv)))
      ;; scratch3 = end_offset = content_offset + sec_size
      (i32.store (global.get $itp_OFF_SCRATCH3)
        (i32.add
          (i32.add (local.get $offset) (local.get $leb_adv))
          (i32.load (global.get $itp_OFF_SCRATCH1))
        )
      )
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Module header: magic + version
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_header (result i32)
      (local $p i32) (local $l i32)
      (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
      (local.set $l (i32.load (global.get $itp_OFF_WASM_LEN)))
      (if (i32.lt_u (local.get $l) (i32.const 8)) (then (return (global.get $itp_ERR_PARSE))))
      (if (i32.ne (i32.load (local.get $p)) (i32.const 0x6d736100)) (then (return (global.get $itp_ERR_PARSE))))
      (if (i32.ne (i32.load (i32.add (local.get $p) (i32.const 4))) (i32.const 1)) (then (return (global.get $itp_ERR_PARSE))))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Parse one type entry (functype)
    ;; Reads at offset, writes to scratch0 = new_offset after consuming type
    ;; Returns error
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_one_type (param $offset i32) (result i32)
      (local $tc i32) (local $rc i32) (local $base i32) (local $i i32) (local $wp i32)
      (local.set $tc (i32.load (global.get $itp_OFF_TYPE_COUNT)))
      (if (i32.ge_u (local.get $tc) (global.get $itp_MAX_TYPES)) (then (return (global.get $itp_ERR_PARSE))))
      ;; Type entry starts with 0x60 (functype)
      (local.set $wp (i32.load (global.get $itp_OFF_WASM_PTR)))
      (if (i32.ne (i32.load8_u (i32.add (local.get $wp) (local.get $offset))) (i32.const 0x60))
        (then (return (global.get $itp_ERR_PARSE)))
      )
      (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
      ;; Read param count
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $rc (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
      (if (i32.gt_u (local.get $rc) (i32.const 32)) (then (return (global.get $itp_ERR_PARSE))))
      ;; Compute type entry base
      (local.set $base (i32.add (global.get $itp_OFF_TYPES_BUF) (i32.mul (local.get $tc) (global.get $itp_SZ_TYPE))))
      ;; Write param types (up to 32 entries, each 1 byte)
      (local.set $i (i32.const 0))
      (block $pl
        (loop $pl_lp
          (if (i32.ge_u (local.get $i) (local.get $rc)) (then (br $pl)))
          (local.set $wp (i32.load (global.get $itp_OFF_WASM_PTR)))
          (i32.store8 (i32.add (local.get $base) (local.get $i))
            (i32.load8_u (i32.add (local.get $wp) (local.get $offset)))
          )
          (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $pl_lp)
        )
      )
      ;; Write param_count (16-bit at offset 128 within type entry)
      (i32.store16 (i32.add (local.get $base) (i32.const 128)) (local.get $rc))
      ;; Read result count
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $rc (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
      (if (i32.gt_u (local.get $rc) (i32.const 4)) (then (return (global.get $itp_ERR_PARSE))))
      ;; Write result types (start at offset 132 = 128 + 4)
      (local.set $i (i32.const 0))
      (block $rl
        (loop $rl_lp
          (if (i32.ge_u (local.get $i) (local.get $rc)) (then (br $rl)))
          (local.set $wp (i32.load (global.get $itp_OFF_WASM_PTR)))
          (i32.store8 (i32.add (local.get $base) (i32.const 132) (local.get $i))
            (i32.load8_u (i32.add (local.get $wp) (local.get $offset)))
          )
          (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $rl_lp)
        )
      )
      ;; Write result_count (16-bit at offset 132 + 4 = 136)
      (i32.store16 (i32.add (local.get $base) (i32.const 136)) (local.get $rc))
      ;; Increment type count
      (i32.store (global.get $itp_OFF_TYPE_COUNT) (i32.add (i32.load (global.get $itp_OFF_TYPE_COUNT)) (i32.const 1)))
      ;; Return new offset
      (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $offset))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Parse type section
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_type_section (param $offset i32) (param $size i32) (result i32)
      (local $count i32) (local $err i32) (local $end i32)
      (local.set $end (i32.add (local.get $offset) (local.get $size)))
      ;; Read type count
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $count (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
      (block $lp
        (loop $continue
          (if (i32.eqz (local.get $count)) (then (br $lp)))
          (local.set $err (call $itp_parse_one_type (local.get $offset)))
          (if (local.get $err) (then (return (local.get $err))))
          (local.set $offset (i32.load (global.get $itp_OFF_SCRATCH0)))
          (local.set $count (i32.sub (local.get $count) (i32.const 1)))
          (br $continue)
        )
      )
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Parse limits: reads either "min" or "min, max" pair
    ;; Input: offset, returns: scratch0=min, scratch1=max(-1=unset), scratch2=advance
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_limits (param $offset i32) (result i32)
      (local $flags i32) (local $min i32) (local $adv i32) (local $p i32)
      (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
      ;; Read flags byte: 0 = min only, 1 = min + max
      (local.set $flags (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
      (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
      ;; Read min
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $min (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $adv (i32.load (global.get $itp_OFF_SCRATCH1)))
      (local.set $offset (i32.add (local.get $offset) (local.get $adv)))
      (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $min))
      (if (local.get $flags)
        (then
          ;; Read max
          (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
          (i32.store (global.get $itp_OFF_SCRATCH1) (i32.load (global.get $itp_OFF_SCRATCH0)))
          (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
        )
        (else
          ;; max = -1 (unlimited)
          (i32.store (global.get $itp_OFF_SCRATCH1) (i32.const -1))
        )
      )
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Parse function section (list of type indices)
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_function_section (param $offset i32) (param $size i32) (result i32)
      (local $count i32) (local $i i32) (local $fc i32)
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $count (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
      (if (i32.gt_u (local.get $count) (global.get $itp_MAX_FUNCTIONS)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $i (i32.const 0))
      (local.set $fc (i32.load (global.get $itp_OFF_FUNCTION_COUNT)))
      (block $lp
        (loop $cont
          (if (i32.ge_u (local.get $i) (local.get $count)) (then (br $lp)))
          ;; Read type index
          (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
          ;; Store to functions_buf[fc + i] = type_index (first 8 bytes of 16-byte entry)
          (i32.store
            (i32.add (global.get $itp_OFF_FUNCTIONS_BUF) (i32.mul (i32.add (local.get $fc) (local.get $i)) (global.get $itp_SZ_FUNC)))
            (i32.load (global.get $itp_OFF_SCRATCH0))
          )
          (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $cont)
        )
      )
      (i32.store (global.get $itp_OFF_FUNCTION_COUNT) (i32.add (local.get $fc) (local.get $count)))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Parse import section
    ;; Each import: module_name(string) + field_name(string) + kind(1 byte) + kind_data
    ;; For function: kind_data = type_index(LEB128)
    ;; For table: kind_data = elem_type(1) + limits
    ;; For memory: kind_data = limits
    ;; For global: kind_data = val_type(1) + mutability(1)
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_import_section (param $offset i32) (param $size i32) (result i32)
      (local $count i32) (local $i i32)
      (local $kind i32) (local $p i32) (local $end i32) (local $flags i32)
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $count (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
      (if (i32.gt_u (local.get $count) (global.get $itp_MAX_IMPORTS)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $end (i32.add (local.get $offset) (local.get $size)))
      (local.set $i (i32.const 0))
      (block $lp
        (loop $cont
          (if (i32.ge_u (local.get $i) (local.get $count)) (then (br $lp)))
          (if (i32.ge_u (local.get $offset) (local.get $end)) (then (return (global.get $itp_ERR_PARSE))))
          ;; Skip module name
          (if (call $itp_read_name (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
          (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
          ;; Skip field name
          (if (call $itp_read_name (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
          (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
          ;; Read import kind
          (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
          (local.set $kind (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
          (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
          (if (i32.eq (local.get $kind) (global.get $itp_EXT_FUNC))
            (then
              ;; Function import: skip type index
              (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
              (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
            )
          )
          (if (i32.eq (local.get $kind) (global.get $itp_EXT_TABLE))
            (then
              ;; Table import: elem_type (1 byte) + limits
              (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
              ;; flags (1 byte)
              (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
              (local.set $flags (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
              (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
              ;; min
              (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
              (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
              ;; optional max
              (if (local.get $flags)
                (then
                  (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                  (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                )
              )
            )
          )
          (if (i32.eq (local.get $kind) (global.get $itp_EXT_MEM))
            (then
              ;; Memory import: limits
              (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
              (local.set $flags (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
              (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
              (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
              (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
              (if (local.get $flags)
                (then
                  (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                  (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                )
              )
            )
          )
          (if (i32.eq (local.get $kind) (global.get $itp_EXT_GLOBAL))
            (then
              ;; Global import: val_type (1 byte) + mutability (1 byte)
              (local.set $offset (i32.add (local.get $offset) (i32.const 2)))
            )
          )
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $cont)
        )
      )
      ;; Store import count
      (i32.store (global.get $itp_OFF_IMPORT_COUNT) (local.get $count))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Parse global section
    ;; Each global: val_type(1) + mutability(1) + init_expr(opcodes ending with end)
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_global_section (param $offset i32) (param $size i32) (result i32)
      (local $count i32) (local $i i32) (local $gc i32) (local $end i32)
      (local $op i32) (local $p i32)
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $count (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
      (if (i32.gt_u (local.get $count) (global.get $itp_MAX_GLOBALS)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $end (i32.add (local.get $offset) (local.get $size)))
      (local.set $gc (i32.load (global.get $itp_OFF_GLOBAL_COUNT)))
      (local.set $i (i32.const 0))
      (block $lp
        (loop $cont
          (if (i32.ge_u (local.get $i) (local.get $count)) (then (br $lp)))
          (if (i32.ge_u (local.get $offset) (local.get $end)) (then (return (global.get $itp_ERR_PARSE))))
          ;; Skip val_type (1 byte) + mutability (1 byte)
          (local.set $offset (i32.add (local.get $offset) (i32.const 2)))
          ;; Parse init expression: read opcodes until end (0x0B)
          (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
          (local.set $op (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
          (if (i32.eq (local.get $op) (i32.const 0x41))  ;; i32.const
            (then
              (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
              (if (call $itp_leb_i32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
              (i32.store
                (i32.add (global.get $itp_OFF_GLOBALS_BUF) (i32.shl (i32.add (local.get $gc) (local.get $i)) (i32.const 2)))
                (i32.load (global.get $itp_OFF_SCRATCH0))
              )
              (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
            )
            (else
              ;; Unsupported init expr: skip to end (0x0B) silently, value stays 0
              (block $skip_expr
                (loop $skip_cont
                  (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
                  (local.set $op (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
                  (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                  (if (i32.eq (local.get $op) (i32.const 0x0B)) (then (br $skip_expr)))
                  (br $skip_cont)
                )
              )
              ;; Default to 0
              (i32.store
                (i32.add (global.get $itp_OFF_GLOBALS_BUF) (i32.shl (i32.add (local.get $gc) (local.get $i)) (i32.const 2)))
                (i32.const 0)
              )
            )
          )
          ;; Skip end
          (if (i32.ne (local.get $op) (i32.const 0x0B))
            (then
              ;; Skip remaining opcodes until end (0x0B)
              (block $skip_end
                (loop $skip_end_cont
                  (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
                  (local.set $op (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
                  (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                  (if (i32.eq (local.get $op) (i32.const 0x0B)) (then (br $skip_end)))
                  (br $skip_end_cont)
                )
              )
            )
          )
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $cont)
        )
      )
      (i32.store (global.get $itp_OFF_GLOBAL_COUNT) (i32.add (local.get $gc) (local.get $count)))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Parse memory section (memory type + limits)
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_memory_section (param $offset i32) (param $size i32) (result i32)
      (local $count i32)
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $count (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
      (if (i32.ne (local.get $count) (i32.const 1)) (then (return (global.get $itp_ERR_UNSUP))))
      ;; Parse limits
      (if (call $itp_parse_limits (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (i32.store (global.get $itp_OFF_MEM_MIN) (i32.load (global.get $itp_OFF_SCRATCH0)))
      (i32.store (global.get $itp_OFF_MEM_MAX) (i32.load (global.get $itp_OFF_SCRATCH1)))
      (i32.store (global.get $itp_OFF_GUEST_MEM_PAGES) (i32.load (global.get $itp_OFF_SCRATCH0)))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Parse table section (elem_type + limits)
    ;; MVP: at most 1 table, elem_type must be 0x70 (funcref)
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_table_section (param $offset i32) (param $size i32) (result i32)
      (local $count i32) (local $elem_type i32) (local $flags i32)
      (local $min i32) (local $max i32) (local $p i32) (local $i i32)
      (i32.store (global.get $itp_OFF_DBG) (i32.const 50))  ;; dbg: entered parse_table_section
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (i32.store (global.get $itp_OFF_DBG) (i32.const 51))  ;; dbg: after leb count
      (local.set $count (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
      (if (i32.gt_u (local.get $count) (i32.const 1)) (then (return (global.get $itp_ERR_UNSUP))))
      (if (i32.eqz (local.get $count)) (then (return (global.get $itp_OK))))
      (i32.store (global.get $itp_OFF_DBG) (i32.const 52))  ;; dbg: count is 1, reading elem_type
      ;; elem_type (1 byte) must be 0x70 (funcref)
      (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
      (local.set $elem_type (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
      (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
      (if (i32.ne (local.get $elem_type) (i32.const 0x70)) (then (return (global.get $itp_ERR_UNSUP))))
      (i32.store (global.get $itp_OFF_DBG) (i32.const 53))  ;; dbg: elem_type is 0x70
      ;; Parse limits: flags (1 byte) + min (LEB128) + [max (LEB128)]
      (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
      (local.set $flags (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
      (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $min (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
      (local.set $max (i32.const 0))
      (if (i32.and (local.get $flags) (i32.const 1))
        (then
          (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
          (local.set $max (i32.load (global.get $itp_OFF_SCRATCH0)))
          (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
        )
      )
      (i32.store (global.get $itp_OFF_DBG) (i32.const 54))  ;; dbg: limits read, checking max
      (if (i32.gt_u (local.get $min) (global.get $itp_MAX_TABLE)) (then (return (global.get $itp_ERR_PARSE))))
      (if (i32.and (local.get $flags) (i32.const 1))
        (then (if (i32.gt_u (local.get $max) (global.get $itp_MAX_TABLE)) (then (return (global.get $itp_ERR_PARSE)))))
      )
      ;; Store table info
      (i32.store8 (global.get $itp_OFF_TABLE_HAS) (i32.const 1))
      (i32.store (global.get $itp_OFF_TABLE_MIN) (local.get $min))
      (i32.store (global.get $itp_OFF_TABLE_MAX) (local.get $max))
      ;; Initialize all table entries to -1 (null funcref)
      (local.set $i (i32.const 0))
      (block $init_lp
        (loop $init_cont
          (if (i32.ge_u (local.get $i) (local.get $min)) (then (br $init_lp)))
          (i32.store
            (i32.add (global.get $itp_OFF_TABLE_DATA) (i32.shl (local.get $i) (i32.const 2)))
            (i32.const -1)
          )
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $init_cont)
        )
      )
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Parse export section (list of exports)
    ;; Each export: name(string) + kind(1 byte) + index(LEB128)
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_export_section (param $offset i32) (param $size i32) (result i32)
      (local $count i32) (local $i i32) (local $ec i32) (local $base i32)
      (local $name_off i32) (local $name_len i32) (local $kind i32) (local $idx i32) (local $p i32)
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $count (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
      (if (i32.gt_u (local.get $count) (global.get $itp_MAX_EXPORTS)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $ec (i32.load (global.get $itp_OFF_EXPORT_COUNT)))
      (local.set $i (i32.const 0))
      (block $lp
        (loop $cont
          (if (i32.ge_u (local.get $i) (local.get $count)) (then (br $lp)))
          (local.set $base (i32.add (global.get $itp_OFF_EXPORTS_BUF) (i32.mul (i32.add (local.get $ec) (local.get $i)) (global.get $itp_SZ_EXPORT))))
          ;; Read name string
          (if (call $itp_read_name (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
          (local.set $name_off (i32.load (global.get $itp_OFF_SCRATCH0)))
          (local.set $name_len (i32.load (global.get $itp_OFF_SCRATCH1)))
          (local.set $offset (i32.add (local.get $offset) (local.get $name_len)))
          ;; Read kind (1 byte)
          (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
          (local.set $kind (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
          (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
          ;; Read index (LEB128)
          (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
          (local.set $idx (i32.load (global.get $itp_OFF_SCRATCH0)))
          (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
          ;; Store to export entry
          (i32.store (local.get $base) (local.get $name_off))           ;; name_ptr
          (i32.store (i32.add (local.get $base) (i32.const 8)) (local.get $name_len))  ;; name_len
          (i32.store8 (i32.add (local.get $base) (i32.const 16)) (local.get $kind))    ;; kind
          (i32.store (i32.add (local.get $base) (i32.const 24)) (local.get $idx))      ;; index
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $cont)
        )
      )
      (i32.store (global.get $itp_OFF_EXPORT_COUNT) (i32.add (local.get $ec) (local.get $count)))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Parse start section (single function index)
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_start_section (param $offset i32) (param $size i32) (result i32)
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (i32.store (global.get $itp_OFF_START_FUNC) (i32.load (global.get $itp_OFF_SCRATCH0)))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Parse code section (function bodies)
    ;; Each body: size(LEB128) + local_count(LEB128) + (locals: count + type)* + bytecode
    ;; We store: body_offset, body_len, local_count
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_code_section (param $offset i32) (param $size i32) (result i32)
      (local $count i32) (local $i i32) (local $cc i32) (local $base i32)
      (local $body_size i32) (local $body_end i32)
      (local $local_count i32) (local $lc i32)
      (local $num_locals i32) (local $type i32) (local $j i32)
      (local $p i32)
      (i32.store (global.get $itp_OFF_DBG) (i32.const 90))  ;; dbg: entered parse_code_section
      (local.set $cc (i32.load (global.get $itp_OFF_CODE_COUNT)))
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $count (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
      (if (i32.gt_u (local.get $count) (global.get $itp_MAX_FUNCTIONS)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $i (i32.const 0))
      (block $lp
        (loop $cont
          (if (i32.ge_u (local.get $i) (local.get $count)) (then (br $lp)))
          ;; Read body size
          (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
          (local.set $body_size (i32.load (global.get $itp_OFF_SCRATCH0)))
          (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
          ;; body_end = offset + body_size (offset is after the size LEB, body_size is the content size)
          (local.set $body_end (i32.add (local.get $offset) (local.get $body_size)))
          ;; Store body_offset (relative to wasm_base), body_len
          (local.set $base (i32.add (global.get $itp_OFF_CODE_BUF) (i32.mul (i32.add (local.get $cc) (local.get $i)) (global.get $itp_SZ_CODE))))
          (i32.store (i32.add (local.get $base) (i32.const 0)) (local.get $offset))     ;; body_offset
          (i32.store (i32.add (local.get $base) (i32.const 8)) (local.get $body_size))  ;; body_len
          ;; Read local count
          (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
          (local.set $local_count (i32.load (global.get $itp_OFF_SCRATCH0)))
          (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
          ;; Parse local declarations
          (local.set $lc (i32.const 0))
          (local.set $j (i32.const 0))
          (block $llp
            (loop $llcont
              (if (i32.ge_u (local.get $j) (local.get $local_count)) (then (br $llp)))
              (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
              (local.set $num_locals (i32.load (global.get $itp_OFF_SCRATCH0)))
              (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
              (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
              (local.set $type (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
              (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
              (local.set $lc (i32.add (local.get $lc) (local.get $num_locals)))
              (local.set $j (i32.add (local.get $j) (i32.const 1)))
              (br $llcont)
            )
          )
          (i32.store (i32.add (local.get $base) (i32.const 16)) (local.get $lc))  ;; local_count
          ;; Decode opcodes
          (i32.store (global.get $itp_OFF_DBG) (i32.const 80))  ;; dbg: before decode
          (if (call $itp_decode_opcodes (local.get $offset) (i32.sub (local.get $body_end) (local.get $offset)))
            (then (i32.store (global.get $itp_OFF_DBG) (i32.const 81)) (return (global.get $itp_ERR_PARSE)))  ;; dbg: decode fail
          )
          (i32.store (global.get $itp_OFF_DBG) (i32.const 82))  ;; dbg: after decode
          ;; Compute end targets for structured control flow
          (if (call $itp_compute_end_targets
                (i32.load (global.get $itp_OFF_SCRATCH0))
                (i32.load (global.get $itp_OFF_SCRATCH1))
              )
            (then (i32.store (global.get $itp_OFF_DBG) (i32.const 83)) (return (global.get $itp_ERR_PARSE)))  ;; dbg: compute fail
          )
          (i32.store (global.get $itp_OFF_DBG) (i32.const 84))  ;; dbg: after compute
          ;; Store decoded_start (scratch0) and decoded_count (scratch1) in code entry
          (i32.store (i32.add (local.get $base) (i32.const 24)) (i32.load (global.get $itp_OFF_SCRATCH0)))  ;; decoded_start
          (i32.store (i32.add (local.get $base) (i32.const 32)) (i32.load (global.get $itp_OFF_SCRATCH1)))  ;; decoded_count
          ;; Skip to body_end
          (local.set $offset (local.get $body_end))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $cont)
        )
      )
      (i32.store (global.get $itp_OFF_CODE_COUNT) (i32.add (local.get $cc) (local.get $count)))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Parse data section (list of data segments)
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_data_section (param $offset i32) (param $size i32) (result i32)
      (local $count i32) (local $i i32) (local $dc i32) (local $base i32)
      (local $mode i32) (local $seg_size i32) (local $p i32) (local $j i32)
      (local $dest_addr i32) (local $wasm_base i32)
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $count (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
      (if (i32.gt_u (local.get $count) (global.get $itp_MAX_DATAS)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $dc (i32.load (global.get $itp_OFF_DATA_COUNT)))
      (local.set $wasm_base (i32.load (global.get $itp_OFF_WASM_PTR)))
      (local.set $i (i32.const 0))
      (block $lp
        (loop $cont
          (if (i32.ge_u (local.get $i) (local.get $count)) (then (br $lp)))
          (local.set $base (i32.add (global.get $itp_OFF_DATA_BUF) (i32.mul (i32.add (local.get $dc) (local.get $i)) (global.get $itp_SZ_DATA))))
          ;; Read mode (0=active, 1=passive, 2=active with memory index)
          (local.set $mode (i32.load8_u (i32.add (local.get $wasm_base) (local.get $offset))))
          (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
          (local.set $dest_addr (i32.const 0))
          (if (i32.or (i32.eq (local.get $mode) (i32.const 2)) (i32.eq (local.get $mode) (i32.const 0)))
            (then
              ;; Active: parse i32.const <value> 0x0B
              (if (i32.eq (i32.load8_u (i32.add (local.get $wasm_base) (local.get $offset))) (i32.const 0x41))
                (then
                  (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                  (if (call $itp_leb_i32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                  (local.set $dest_addr (i32.load (global.get $itp_OFF_SCRATCH0)))
                  (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                )
              )
              ;; Skip remaining init expression until 0x0B
              (block $ie
                (loop $iel
                  (if (i32.eq (i32.load8_u (i32.add (local.get $wasm_base) (local.get $offset))) (i32.const 0x0B))
                    (then
                      (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                      (br $ie)
                    )
                  )
                  (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                  (br $iel)
                )
              )
            )
          )
          ;; Read segment data size
          (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
          (local.set $seg_size (i32.load (global.get $itp_OFF_SCRATCH0)))
          (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
          ;; Store data segment info
          (i32.store (local.get $base) (local.get $offset))      ;; data_offset (in guest wasm)
          (i32.store (i32.add (local.get $base) (i32.const 4)) (local.get $dest_addr))  ;; dest_addr (in guest memory)
          (i32.store (i32.add (local.get $base) (i32.const 8)) (local.get $seg_size))  ;; data_len
          ;; Copy data bytes to guest memory (only for active segments)
          (if (i32.eq (local.get $mode) (i32.const 1))
            (then)  ;; passive segment: skip copy to memory
            (else
              (if (i32.and (i32.eqz (local.get $dest_addr)) (i32.eqz (local.get $seg_size)))
                (then)
                (else
              ;; Copy seg_size bytes from wasm_base+data_offset to guest_mem_base+dest_addr
              (local.set $p (i32.const 0))
              (block $copy_lp
                (loop $copy_cont
                  (if (i32.ge_u (local.get $p) (local.get $seg_size)) (then (br $copy_lp)))
                  (i32.store8
                    (i32.add (global.get $itp_OFF_GUEST_MEM_BASE) (i32.add (local.get $dest_addr) (local.get $p)))
                    (i32.load8_u (i32.add (local.get $wasm_base) (i32.add (local.get $offset) (local.get $p))))
                  )
                  (local.set $p (i32.add (local.get $p) (i32.const 1)))
                  (br $copy_cont)
                )
              )
              )
            )
          )
        )
          ;; Skip data bytes (advance offset past the data)
          (local.set $offset (i32.add (local.get $offset) (local.get $seg_size)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $cont)
        )
      )
      (i32.store (global.get $itp_OFF_DATA_COUNT) (i32.add (local.get $dc) (local.get $count)))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Parse element section (segment data for table initialization)
    ;; Each element: mode + [table_idx] + offset_expr + count + func_indices
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_parse_element_section (param $offset i32) (param $size i32) (result i32)
      (local $count i32) (local $i i32) (local $mode i32) (local $table_idx i32)
      (local $dest_offset i32) (local $elem_count i32) (local $j i32)
      (local $func_idx i32) (local $p i32) (local $end i32)
      (local $elem_base i32) (local $dc i32)
      (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $count (i32.load (global.get $itp_OFF_SCRATCH0)))
      (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
      (if (i32.gt_u (local.get $count) (global.get $itp_MAX_ELEMS)) (then (return (global.get $itp_ERR_PARSE))))
      (local.set $end (i32.add (local.get $offset) (local.get $size)))
      (local.set $dc (i32.load (global.get $itp_OFF_ELEM_COUNT)))
      (local.set $i (i32.const 0))
      (block $lp
        (loop $cont
          (if (i32.ge_u (local.get $i) (local.get $count)) (then (br $lp)))
          (if (i32.ge_u (local.get $offset) (local.get $end)) (then (return (global.get $itp_ERR_PARSE))))
          (local.set $elem_base (i32.add (global.get $itp_OFF_ELEM_BUF) (i32.mul (i32.add (local.get $dc) (local.get $i)) (global.get $itp_SZ_ELEM))))
          ;; Read mode
          (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
          (local.set $mode (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
          (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
          (local.set $table_idx (i32.const 0))
          (local.set $dest_offset (i32.const 0))
          (if (i32.eq (local.get $mode) (i32.const 0))
            (then
              ;; Mode 0: active, implicit table 0. Parse init_expr (i32.const <value> 0x0B)
              (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
              (if (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $offset))) (i32.const 0x41))
                (then
                  (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                  (if (call $itp_leb_i32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                  (local.set $dest_offset (i32.load (global.get $itp_OFF_SCRATCH0)))
                  (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                )
              )
              ;; Skip to end (0x0B)
              (block $ie
                (loop $iel
                  (if (i32.ge_u (local.get $offset) (local.get $end)) (then (return (global.get $itp_ERR_PARSE))))
                  (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
                  (if (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $offset))) (i32.const 0x0B))
                    (then
                      (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                      (br $ie)
                    )
                  )
                  (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                  (br $iel)
                )
              )
            )
          )
          (if (i32.eq (local.get $mode) (i32.const 1))
            (then
              ;; Mode 1: passive segment - stored for table.init
            )
          )
          (if (i32.eq (local.get $mode) (i32.const 2))
            (then
              ;; Mode 2: active with explicit table index
              (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
              (local.set $table_idx (i32.load (global.get $itp_OFF_SCRATCH0)))
              (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
              (if (i32.ne (local.get $table_idx) (i32.const 0)) (then (return (global.get $itp_ERR_UNSUP))))
              ;; Parse init_expr
              (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
              (if (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $offset))) (i32.const 0x41))
                (then
                  (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                  (if (call $itp_leb_i32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                  (local.set $dest_offset (i32.load (global.get $itp_OFF_SCRATCH0)))
                  (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                )
              )
              (block $ie2
                (loop $iel2
                  (if (i32.ge_u (local.get $offset) (local.get $end)) (then (return (global.get $itp_ERR_PARSE))))
                  (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
                  (if (i32.eq (i32.load8_u (i32.add (local.get $p) (local.get $offset))) (i32.const 0x0B))
                    (then
                      (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                      (br $ie2)
                    )
                  )
                  (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                  (br $iel2)
                )
              )
            )
          )
          ;; Store mode to element buffer (0=dropped flag, then mode, dest_offset)
          (i32.store (local.get $elem_base) (i32.const 0))           ;; dropped = 0 (active)
          (i32.store (i32.add (local.get $elem_base) (i32.const 4)) (local.get $dest_offset))  ;; dest_offset
          ;; Read element count
          (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
          (local.set $elem_count (i32.load (global.get $itp_OFF_SCRATCH0)))
          (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
          ;; Store element count
          (i32.store (i32.add (local.get $elem_base) (i32.const 8)) (local.get $elem_count))
          ;; Read and store each func idx in the table and element buffer
          (local.set $j (i32.const 0))
          (block $elem_lp
            (loop $elem_cont
              (if (i32.ge_u (local.get $j) (local.get $elem_count)) (then (br $elem_lp)))
              (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
              (local.set $func_idx (i32.load (global.get $itp_OFF_SCRATCH0)))
              (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
              ;; Store func_idx in element buffer for table.init
              (i32.store
                (i32.add (local.get $elem_base) (i32.add (i32.const 12) (i32.shl (local.get $j) (i32.const 2))))
                (local.get $func_idx)
              )
              ;; For active segments (mode 0/2), also write to table immediately
              (if (i32.le_u (local.get $mode) (i32.const 2))
                (then
                  (if (i32.ne (local.get $mode) (i32.const 1))
                    (then
                      (i32.store
                        (i32.add (global.get $itp_OFF_TABLE_DATA) (i32.shl (i32.add (local.get $dest_offset) (local.get $j)) (i32.const 2)))
                        (local.get $func_idx)
                      )
                    )
                  )
                )
              )
              (local.set $j (i32.add (local.get $j) (i32.const 1)))
              (br $elem_cont)
            )
          )
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $cont)
        )
      )
      (i32.store (global.get $itp_OFF_ELEM_COUNT) (i32.add (local.get $dc) (local.get $count)))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Decode opcodes: translate raw bytecode to DecodedOp entries
    ;; Input: offset (in wasm bytes), len (bytecode length)
    ;; Output: decoded_start (index into decoded_ops cache), decoded_count
    ;; Stored to scratch0/scratch1
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_decode_opcodes (param $offset i32) (param $len i32) (result i32)
      (local $end i32) (local $start_idx i32) (local $dc i32)
      (local $op i32) (local $p i32) (local $imm0 i32) (local $imm1 i32)
      (local $adv i32) (local $base i32)
      (local.set $end (i32.add (local.get $offset) (local.get $len)))
      (local.set $start_idx (i32.load (global.get $itp_OFF_DECODED_COUNT)))  ;; running decoded op count
      (local.set $dc (local.get $start_idx))
      (block $lp
        (loop $cont
          (if (i32.ge_u (local.get $offset) (local.get $end)) (then (br $lp)))
          (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
          (local.set $op (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
          (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
          ;; Compute decoded op base in cache
          (local.set $base (i32.add (global.get $itp_OFF_DECODED_OPS) (i32.mul (local.get $dc) (global.get $itp_DEC_SZ))))
          ;; Store opcode
          (i32.store8 (local.get $base) (local.get $op))
          ;; Decode immediates based on opcode
          (block $op_handled
            ;; ── No immediate ops ──
            (if (i32.le_u (local.get $op) (i32.const 0x01))   ;; unreachable, nop
              (then (br $op_handled))
            )
            (if (i32.eq (local.get $op) (i32.const 0x0B))     ;; end
              (then (br $op_handled))
            )
            (if (i32.eq (local.get $op) (i32.const 0x0F))     ;; return
              (then (br $op_handled))
            )
            (if (i32.eq (local.get $op) (i32.const 0x1A))     ;; drop
              (then (br $op_handled))
            )
            (if (i32.eq (local.get $op) (i32.const 0x45))     ;; i32.eqz
              (then (br $op_handled))
            )
            ;; All comparison, arithmetic, conversion ops (0x46-0xC4 excl block/loop/if)
            (if (i32.and (i32.ge_u (local.get $op) (i32.const 0x46)) (i32.le_u (local.get $op) (i32.const 0xC4)))
              (then
                (if (i32.or (i32.eq (local.get $op) (i32.const 0x02)) (i32.eq (local.get $op) (i32.const 0x03)))
                  (then)  ;; block/loop handled below
                  (else (br $op_handled))
                )
              )
            )
            ;; ── LEB128 immediate ops ──
            (if (i32.or (i32.eq (local.get $op) (i32.const 0x0C)) (i32.eq (local.get $op) (i32.const 0x0D))) ;; br, br_if
              (then
                (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                (br $op_handled)
              )
            )
            (if (i32.eq (local.get $op) (i32.const 0x10))     ;; call
              (then
                (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                (br $op_handled)
              )
            )
            (if (i32.eq (local.get $op) (i32.const 0x11))     ;; call_indirect
              (then
                (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (i32.store (i32.add (local.get $base) (i32.const 8)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                (br $op_handled)
              )
            )
            (if (i32.and (i32.ge_u (local.get $op) (i32.const 0x20)) (i32.le_u (local.get $op) (i32.const 0x26))) ;; local.get/set/tee/global.get/set, table.get/set
              (then
                (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                (br $op_handled)
              )
            )
            (if (i32.eq (local.get $op) (i32.const 0x41))     ;; i32.const (signed LEB128)
              (then
                (if (call $itp_leb_i32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                (br $op_handled)
              )
            )
            (if (i32.eq (local.get $op) (i32.const 0x42))     ;; i64.const (signed LEB128)
              (then
                (if (call $itp_leb_i64 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (i64.store (i32.add (local.get $base) (i32.const 4)) (i64.load (global.get $itp_OFF_SCRATCH0)))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH2))))
                (br $op_handled)
              )
            )
            (if (i32.eq (local.get $op) (i32.const 0x43))     ;; f32.const
              (then
                (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
                (i32.store (i32.add (local.get $base) (i32.const 4))
                  (i32.load (i32.add (local.get $p) (local.get $offset)))
                )
                (local.set $offset (i32.add (local.get $offset) (i32.const 4)))
                (br $op_handled)
              )
            )
            (if (i32.eq (local.get $op) (i32.const 0x44))     ;; f64.const
              (then
                (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
                (i64.store (i32.add (local.get $base) (i32.const 4))
                  (i64.load (i32.add (local.get $p) (local.get $offset)))
                )
                (local.set $offset (i32.add (local.get $offset) (i32.const 8)))
                (br $op_handled)
              )
            )
            ;; ── Memory ops (load/store): align + offset ──
            (if (i32.and (i32.ge_u (local.get $op) (i32.const 0x28)) (i32.le_u (local.get $op) (i32.const 0x3E)))
              (then
                ;; align (LEB128)
                (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (local.set $imm0 (i32.load (global.get $itp_OFF_SCRATCH0)))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                ;; offset (LEB128)
                (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (local.set $imm1 (i32.load (global.get $itp_OFF_SCRATCH0)))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                (i32.store (i32.add (local.get $base) (i32.const 4)) (local.get $imm0))  ;; align
                (i32.store (i32.add (local.get $base) (i32.const 8)) (local.get $imm1))  ;; mem offset
                (br $op_handled)
              )
            )
            ;; ── Block/loop/if: block type ──
            (if (i32.or (i32.eq (local.get $op) (i32.const 0x02)) (i32.eq (local.get $op) (i32.const 0x03)))
              (then
                ;; Block type: either empty(0x40), a value type byte, or a signed LEB128 type index
                (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
                (local.set $imm0 (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
                (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                (i32.store (i32.add (local.get $base) (i32.const 4)) (local.get $imm0))
                (br $op_handled)
              )
            )
            (if (i32.eq (local.get $op) (i32.const 0x04))     ;; if
              (then
                ;; Same as block
                (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
                (local.set $imm0 (i32.load8_u (i32.add (local.get $p) (local.get $offset))))
                (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                (i32.store (i32.add (local.get $base) (i32.const 4)) (local.get $imm0))
                (br $op_handled)
              )
            )
            ;; ── br_table: count + labels + default ──
            (if (i32.eq (local.get $op) (i32.const 0x0E))
              (then
                ;; Read label count
                (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                ;; Skip labels + default
                (local.set $imm0 (i32.load (i32.add (local.get $base) (i32.const 4))))
                (local.set $imm1 (i32.const 0))
                (block $bt_lp
                  (loop $bt_cont
                    (if (i32.ge_u (local.get $imm1) (local.get $imm0)) (then (br $bt_lp)))
                    (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                    (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                    (local.set $imm1 (i32.add (local.get $imm1) (i32.const 1)))
                    (br $bt_cont)
                  )
                )
                ;; Read default label and store as imm1 (at base+8)
                (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (i32.store (i32.add (local.get $base) (i32.const 8)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                (br $op_handled)
              )
            )
            ;; ── else (0x05) ──
            (if (i32.eq (local.get $op) (i32.const 0x05))
              (then (br $op_handled))
            )
            ;; ── select (0x1B, 0x1C) ──
            (if (i32.eq (local.get $op) (i32.const 0x1B))
              (then (br $op_handled))
            )
            (if (i32.eq (local.get $op) (i32.const 0x1C))
              (then
                ;; typed select: skip result types
                (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                (br $op_handled)
              )
            )
            ;; ── memory.size (0x3F), memory.grow (0x40): 1 byte immediate (0x00) ──
            (if (i32.or (i32.eq (local.get $op) (i32.const 0x3F)) (i32.eq (local.get $op) (i32.const 0x40)))
              (then
                (local.set $offset (i32.add (local.get $offset) (i32.const 1)))  ;; skip 0x00 byte
                (br $op_handled)
              )
            )
            ;; ── ref.null (0xD0): 1 byte immediate (reftype) ──
            (if (i32.eq (local.get $op) (i32.const 0xD0))
              (then
                (local.set $p (i32.load (global.get $itp_OFF_WASM_PTR)))
                (i32.store (i32.add (local.get $base) (i32.const 4))
                  (i32.load8_u (i32.add (local.get $p) (local.get $offset)))
                )
                (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                (br $op_handled)
              )
            )
            (if (i32.eq (local.get $op) (i32.const 0xD1))     ;; ref.is_null
              (then (br $op_handled))
            )
            (if (i32.eq (local.get $op) (i32.const 0xD2))     ;; ref.func
              (then
                (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                (br $op_handled)
              )
            )
            ;; ── Extended prefix (0xFC) ──
            (if (i32.eq (local.get $op) (i32.const 0xFC))
              (then
                ;; Read sub-opcode
                (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                ;; Consume reserved immediates based on sub-opcode
                (local.set $imm0 (i32.load (i32.add (local.get $base) (i32.const 4))))
                (if (i32.eq (local.get $imm0) (i32.const 0x0A))     ;; memory.copy: 2 reserved bytes
                  (then (local.set $offset (i32.add (local.get $offset) (i32.const 2))))
                )
                (if (i32.eq (local.get $imm0) (i32.const 0x0B))     ;; memory.fill: 1 reserved byte
                  (then (local.set $offset (i32.add (local.get $offset) (i32.const 1))))
                )
                (if (i32.eq (local.get $imm0) (i32.const 0x08))     ;; memory.init: data_seg idx + 1 reserved byte
                  (then
                    (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                    (i32.store (i32.add (local.get $base) (i32.const 8)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                    (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                    (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
                  )
                )
                (if (i32.eq (local.get $imm0) (i32.const 0x09))     ;; data.drop: data_seg idx
                  (then
                    (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                    (i32.store (i32.add (local.get $base) (i32.const 8)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                    (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                  )
                )
                (if (i32.eq (local.get $imm0) (i32.const 0x0C))     ;; table.init: elem_idx + table_idx
                  (then
                    (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                    (i32.store (i32.add (local.get $base) (i32.const 8)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                    (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                    (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                    (i32.store (i32.add (local.get $base) (i32.const 12)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                    (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                  )
                )
                (if (i32.eq (local.get $imm0) (i32.const 0x0D))     ;; elem.drop: elem_idx
                  (then
                    (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                    (i32.store (i32.add (local.get $base) (i32.const 8)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                    (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                  )
                )
                (if (i32.eq (local.get $imm0) (i32.const 0x0E))     ;; table.copy: dst + src table idx
                  (then
                    (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                    (i32.store (i32.add (local.get $base) (i32.const 8)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                    (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                    (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                    (i32.store (i32.add (local.get $base) (i32.const 12)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                    (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                  )
                )
                (if (i32.eq (local.get $imm0) (i32.const 0x0F))     ;; table.grow: table_idx
                  (then
                    (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                    (i32.store (i32.add (local.get $base) (i32.const 8)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                    (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                  )
                )
                (if (i32.eq (local.get $imm0) (i32.const 0x10))     ;; table.size: table_idx
                  (then
                    (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                    (i32.store (i32.add (local.get $base) (i32.const 8)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                    (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                  )
                )
                (if (i32.eq (local.get $imm0) (i32.const 0x11))     ;; table.fill: table_idx
                  (then
                    (if (call $itp_leb_u32 (local.get $offset)) (then (return (global.get $itp_ERR_PARSE))))
                    (i32.store (i32.add (local.get $base) (i32.const 8)) (i32.load (global.get $itp_OFF_SCRATCH0)))
                    (local.set $offset (i32.add (local.get $offset) (i32.load (global.get $itp_OFF_SCRATCH1))))
                  )
                )
                (br $op_handled)
              )
            )
            ;; Unhandled opcode
            (return (global.get $itp_ERR_UNSUP))
          )
          ;; Store decoded op marker
          (local.set $dc (i32.add (local.get $dc) (i32.const 1)))
          (br $cont)
        )
      )
      ;; Store start index and count
      (i32.store (global.get $itp_OFF_SCRATCH0) (local.get $start_idx))
      (i32.store (global.get $itp_OFF_SCRATCH1) (i32.sub (local.get $dc) (local.get $start_idx)))
      (i32.store (global.get $itp_OFF_DECODED_COUNT) (local.get $dc))
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Post-decode pass: compute next_idx for block/loop/if/else
    ;; Scans decoded ops for a function and sets next_idx to point to
    ;; the matching end+1 (for block/if/else) or loop start (for loop)
    ;; Input: start_idx, count (decoded op indices)
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_compute_end_targets (param $start i32) (param $count i32) (result i32)
      (local $pos i32) (local $op_base i32) (local $op i32)
      (local $sp i32) (local $label_base i32) (local $label_pos i32)
      (i32.store (global.get $itp_OFF_LABEL_STACK_PTR) (i32.const 0))
      (local.set $label_base (global.get $itp_OFF_LABEL_STACK))
      (local.set $pos (i32.const 0))
      (block $lp
        (loop $cont
          (local.set $op_base
            (i32.add (global.get $itp_OFF_DECODED_OPS) (i32.mul (i32.add (local.get $start) (local.get $pos)) (global.get $itp_DEC_SZ)))
          )
          (local.set $op (i32.load8_u (local.get $op_base)))
          (block $skip
            ;; block (0x02), loop (0x03), if (0x04): push current position
            (if (i32.or (i32.eq (local.get $op) (i32.const 0x02))
                        (i32.or (i32.eq (local.get $op) (i32.const 0x03))
                                (i32.eq (local.get $op) (i32.const 0x04))))
              (then
                (local.set $sp (i32.load (global.get $itp_OFF_LABEL_STACK_PTR)))
                (i32.store
                  (i32.add (local.get $label_base) (i32.shl (local.get $sp) (i32.const 2)))
                  (local.get $pos)
                )
                (i32.store (global.get $itp_OFF_LABEL_STACK_PTR) (i32.add (local.get $sp) (i32.const 1)))
                (br $skip)
              )
            )
            ;; else (0x05): pop top (should be if), set its next_idx, push else
            (if (i32.eq (local.get $op) (i32.const 0x05))
              (then
                (local.set $sp (i32.load (global.get $itp_OFF_LABEL_STACK_PTR)))
                (if (i32.eqz (local.get $sp))
                  (then (br $skip))  ;; skip if stack empty (malformed but safe)
                )
                (local.set $sp (i32.sub (local.get $sp) (i32.const 1)))
                (i32.store (global.get $itp_OFF_LABEL_STACK_PTR) (local.get $sp))
                (local.set $label_pos (i32.load (i32.add (local.get $label_base) (i32.shl (local.get $sp) (i32.const 2)))))
                ;; Set next_idx of the matching if to current pos + 1 (skip to else/end)
                (i32.store
                  (i32.add (global.get $itp_OFF_DECODED_OPS)
                    (i32.add (i32.mul (local.get $label_pos) (global.get $itp_DEC_SZ)) (i32.const 12))
                  )
                  (i32.add (local.get $pos) (i32.const 1))
                )
                ;; Push current position as else label
                (i32.store
                  (i32.add (local.get $label_base) (i32.shl (local.get $sp) (i32.const 2)))
                  (local.get $pos)
                )
                (i32.store (global.get $itp_OFF_LABEL_STACK_PTR) (i32.add (local.get $sp) (i32.const 1)))
                (br $skip)
              )
            )
            ;; end (0x0B): pop top, set its next_idx
            (if (i32.eq (local.get $op) (i32.const 0x0B))
              (then
                (local.set $sp (i32.load (global.get $itp_OFF_LABEL_STACK_PTR)))
                (if (i32.eqz (local.get $sp))
                  (then (br $skip))  ;; function-level end: skip
                )
                (local.set $sp (i32.sub (local.get $sp) (i32.const 1)))
                (i32.store (global.get $itp_OFF_LABEL_STACK_PTR) (local.get $sp))
                (local.set $label_pos (i32.load (i32.add (local.get $label_base) (i32.shl (local.get $sp) (i32.const 2)))))
                ;; Check the opcode at the label position to determine if it's a loop
                (local.set $op_base
                  (i32.add (global.get $itp_OFF_DECODED_OPS) (i32.mul (i32.add (local.get $start) (local.get $label_pos)) (global.get $itp_DEC_SZ)))
                )
                (local.set $sp (i32.load8_u (local.get $op_base)))
                (i32.store
                  (i32.add (global.get $itp_OFF_DECODED_OPS)
                    (i32.add (i32.mul (local.get $label_pos) (global.get $itp_DEC_SZ)) (i32.const 12))
                  )
                  (if (result i32) (i32.eq (local.get $sp) (i32.const 0x03))
                    (then (local.get $label_pos))
                    (else (i32.add (local.get $pos) (i32.const 1)))
                  )
                )
                (br $skip)
              )
            )
          )
          (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
          (if (i32.lt_u (local.get $pos) (local.get $count))
            (then (br $cont))
            (else (br $lp))
          )
        )
      )
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Execution engine ── stack operations
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_stack_push (param $val i32) (result i32)
      (if (i32.ge_u (global.get $itp_FAST_STACK_LEN) (global.get $itp_MAX_STACK))
        (then (return (global.get $itp_ERR_STK_OV)))
      )
      (i32.store
        (i32.add (global.get $itp_OFF_EXEC_STACK) (i32.shl (global.get $itp_FAST_STACK_LEN) (i32.const 2)))
        (local.get $val)
      )
      (global.set $itp_FAST_STACK_LEN (i32.add (global.get $itp_FAST_STACK_LEN) (i32.const 1)))
      (return (global.get $itp_OK))
    )
    (func $itp_stack_pop (result i32)
      (if (i32.eqz (global.get $itp_FAST_STACK_LEN))
        (then (return (global.get $itp_ERR_STK_UND)))
      )
      (global.set $itp_FAST_STACK_LEN (i32.sub (global.get $itp_FAST_STACK_LEN) (i32.const 1)))
      (i32.store (global.get $itp_OFF_SCRATCH0)
        (i32.load (i32.add (global.get $itp_OFF_EXEC_STACK) (i32.shl (global.get $itp_FAST_STACK_LEN) (i32.const 2))))
      )
      (return (global.get $itp_OK))
    )
    (func $itp_stack_peek (result i32)
      (if (i32.eqz (global.get $itp_FAST_STACK_LEN))
        (then (return (global.get $itp_ERR_STK_UND)))
      )
      (i32.store (global.get $itp_OFF_SCRATCH0)
        (i32.load (i32.add (global.get $itp_OFF_EXEC_STACK) (i32.shl (i32.sub (global.get $itp_FAST_STACK_LEN) (i32.const 1)) (i32.const 2))))
      )
      (return (global.get $itp_OK))
    )
    ;; ── Fast unchecked stack operations (no scratch0, no error checks) ──
    (func $itp_stack_push_val (param $val i32)
      (i32.store
        (i32.add (global.get $itp_OFF_EXEC_STACK) (i32.shl (global.get $itp_FAST_STACK_LEN) (i32.const 2)))
        (local.get $val)
      )
      (global.set $itp_FAST_STACK_LEN (i32.add (global.get $itp_FAST_STACK_LEN) (i32.const 1)))
    )
    (func $itp_stack_pop_val (result i32)
      (global.set $itp_FAST_STACK_LEN (i32.sub (global.get $itp_FAST_STACK_LEN) (i32.const 1)))
      (return (i32.load (i32.add (global.get $itp_OFF_EXEC_STACK) (i32.shl (global.get $itp_FAST_STACK_LEN) (i32.const 2)))))
    )
    (func $itp_stack_peek_val (result i32)
      (return (i32.load (i32.add (global.get $itp_OFF_EXEC_STACK) (i32.shl (i32.sub (global.get $itp_FAST_STACK_LEN) (i32.const 1)) (i32.const 2)))))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; i64 stack operations — each i64 value occupies two 4-byte slots
    ;; (low 32 bits at lower address, high 32 bits at higher address)
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_stack_push_i64 (param $lo i32) (param $hi i32) (result i32)
      (if (i32.ge_u (i32.add (global.get $itp_FAST_STACK_LEN) (i32.const 2)) (global.get $itp_MAX_STACK))
        (then (return (global.get $itp_ERR_STK_OV)))
      )
      (i32.store
        (i32.add (global.get $itp_OFF_EXEC_STACK) (i32.shl (global.get $itp_FAST_STACK_LEN) (i32.const 2)))
        (local.get $lo)
      )
      (i32.store
        (i32.add (global.get $itp_OFF_EXEC_STACK) (i32.shl (i32.add (global.get $itp_FAST_STACK_LEN) (i32.const 1)) (i32.const 2)))
        (local.get $hi)
      )
      (global.set $itp_FAST_STACK_LEN (i32.add (global.get $itp_FAST_STACK_LEN) (i32.const 2)))
      (return (global.get $itp_OK))
    )
    (func $itp_stack_pop_i64 (result i32)
      (if (i32.lt_u (global.get $itp_FAST_STACK_LEN) (i32.const 2))
        (then (return (global.get $itp_ERR_STK_UND)))
      )
      (global.set $itp_FAST_STACK_LEN (i32.sub (global.get $itp_FAST_STACK_LEN) (i32.const 2)))
      (i32.store (global.get $itp_OFF_SCRATCH1)  ;; hi
        (i32.load (i32.add (global.get $itp_OFF_EXEC_STACK) (i32.shl (i32.add (global.get $itp_FAST_STACK_LEN) (i32.const 1)) (i32.const 2))))
      )
      (i32.store (global.get $itp_OFF_SCRATCH0)  ;; lo
        (i32.load (i32.add (global.get $itp_OFF_EXEC_STACK) (i32.shl (global.get $itp_FAST_STACK_LEN) (i32.const 2))))
      )
      (return (global.get $itp_OK))
    )
    (func $itp_stack_peek_i64 (result i32)
      (if (i32.lt_u (global.get $itp_FAST_STACK_LEN) (i32.const 2))
        (then (return (global.get $itp_ERR_STK_UND)))
      )
      (i32.store (global.get $itp_OFF_SCRATCH1)  ;; hi
        (i32.load (i32.add (global.get $itp_OFF_EXEC_STACK) (i32.shl (i32.add (global.get $itp_FAST_STACK_LEN) (i32.const 1)) (i32.const 2))))
      )
      (i32.store (global.get $itp_OFF_SCRATCH0)  ;; lo
        (i32.load (i32.add (global.get $itp_OFF_EXEC_STACK) (i32.shl (i32.sub (global.get $itp_FAST_STACK_LEN) (i32.const 1)) (i32.const 2))))
      )
      (return (global.get $itp_OK))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Control frame stack operations
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_ctrl_push (param $kind i32) (param $target i32) (result i32)
      (local $len i32) (local $base i32)
      (local.set $len (i32.load (global.get $itp_OFF_EXEC_CTRL_LEN)))
      (if (i32.ge_u (local.get $len) (global.get $itp_MAX_CTRL))
        (then (return (global.get $itp_ERR_STK_OV)))
      )
      (local.set $base (i32.add (global.get $itp_OFF_EXEC_CTRL) (i32.mul (local.get $len) (global.get $itp_SZ_CTRL))))
      (i32.store (local.get $base) (local.get $kind))
      (i32.store (i32.add (local.get $base) (i32.const 4)) (local.get $target))
      (i32.store (global.get $itp_OFF_EXEC_CTRL_LEN) (i32.add (local.get $len) (i32.const 1)))
      (return (global.get $itp_OK))
    )
    (func $itp_ctrl_pop (result i32)
      (local $len i32) (local $base i32)
      (local.set $len (i32.load (global.get $itp_OFF_EXEC_CTRL_LEN)))
      (if (i32.eqz (local.get $len))
        (then (return (global.get $itp_ERR_STK_UND)))
      )
      (local.set $len (i32.sub (local.get $len) (i32.const 1)))
      (i32.store (global.get $itp_OFF_EXEC_CTRL_LEN) (local.get $len))
      (local.set $base (i32.add (global.get $itp_OFF_EXEC_CTRL) (i32.mul (local.get $len) (global.get $itp_SZ_CTRL))))
      (i32.store (global.get $itp_OFF_SCRATCH0) (i32.load (local.get $base)))       ;; kind
      (i32.store (global.get $itp_OFF_SCRATCH1) (i32.load (i32.add (local.get $base) (i32.const 4))))  ;; target
      (return (global.get $itp_OK))
    )
    (func $itp_ctrl_peek (param $depth i32) (result i32)
      ;; Returns kind of the Nth ancestor frame (0 = innermost)
      ;; Stores target in scratch1
      (local $len i32) (local $base i32)
      (local.set $len (i32.load (global.get $itp_OFF_EXEC_CTRL_LEN)))
      (local.set $len (i32.sub (local.get $len) (i32.const 1)))
      (if (i32.lt_u (local.get $len) (local.get $depth))
        (then (return (global.get $itp_ERR_STK_UND)))
      )
      (local.set $base (i32.add (global.get $itp_OFF_EXEC_CTRL) (i32.mul (i32.sub (local.get $len) (local.get $depth)) (global.get $itp_SZ_CTRL))))
      (i32.store (global.get $itp_OFF_SCRATCH0) (i32.load (local.get $base)))
      (i32.store (global.get $itp_OFF_SCRATCH1) (i32.load (i32.add (local.get $base) (i32.const 4))))
      (return (global.get $itp_OK))
    )
    (func $itp_ctrl_depth (result i32)
      (return (i32.load (global.get $itp_OFF_EXEC_CTRL_LEN)))
    )
    ;; ═════════════════════════════════════════════════════════════════════
    ;; Execute a decoded function by its function index
    ;; Sets up locals from args if provided, runs dispatch on decoded ops
    ;; ═════════════════════════════════════════════════════════════════════
    (func $itp_exec_fn (param $func_idx i32) (param $args_ptr i32) (param $args_len i32) (result i32)
      (local $code_idx i32) (local $code_base i32)
      (local $local_count i32) (local $i i32) (local $val i32)
      (local $dec_start i32) (local $dec_count i32) (local $dec_idx i32)
      (local $op i32) (local $op_base i32)
      (local $p i32) (local $err i32)
      (local $imm0 i32) (local $imm1 i32) (local $imm2 i32) (local $imm3 i32)
      (local $ctrl_len i32) (local $target i32) (local $kind i32)
      (local $tmp64 i64) (local $tmp64b i64)
      (local $tmp_f32 f32) (local $tmp_f32b f32) (local $tmp_f64 f64) (local $tmp_f64b f64)
      (local $type_idx i32) (local $result_count i32)
      ;; Find code index for this function (adjusting for imports)
      (if (i32.lt_u (local.get $func_idx) (i32.load (global.get $itp_OFF_IMPORT_COUNT)))
        (then (return (global.get $itp_ERR_MISS_IMP)))
      )
      (local.set $code_idx (i32.sub (local.get $func_idx) (i32.load (global.get $itp_OFF_IMPORT_COUNT))))
      (local.set $code_base (i32.add (global.get $itp_OFF_CODE_BUF) (i32.mul (local.get $code_idx) (global.get $itp_SZ_CODE))))
      ;; Look up result count from function type
      (local.set $type_idx (i32.load (i32.add (global.get $itp_OFF_FUNCTIONS_BUF) (i32.mul (local.get $code_idx) (global.get $itp_SZ_FUNC)))))
      (local.set $result_count (i32.load16_u (i32.add (global.get $itp_OFF_TYPES_BUF) (i32.add (i32.mul (local.get $type_idx) (global.get $itp_SZ_TYPE)) (i32.const 136)))))
      ;; Read decoded op range
      (local.set $dec_start (i32.load (i32.add (local.get $code_base) (i32.const 24))))
      (local.set $dec_count (i32.load (i32.add (local.get $code_base) (i32.const 32))))
      (local.set $dec_idx (local.get $dec_start))
      ;; Read local count
      (local.set $local_count (i32.load (i32.add (local.get $code_base) (i32.const 16))))
      (i32.store (global.get $itp_OFF_EXEC_LOCAL_COUNT) (local.get $local_count))
      ;; Cache stack length in global for fast access
      (global.set $itp_FAST_STACK_LEN (i32.load (global.get $itp_OFF_EXEC_STACK_LEN)))
      ;; Initialize locals
      (local.set $i (i32.const 0))
      (block $init_lp
        (loop $init_cont
          (if (i32.ge_u (local.get $i) (local.get $local_count)) (then (br $init_lp)))
          (i32.store
            (i32.add (global.get $itp_OFF_EXEC_LOCALS) (i32.shl (local.get $i) (i32.const 2)))
            (i32.const 0)
          )
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $init_cont)
        )
      )
      ;; Copy args into first N locals
      (local.set $i (i32.const 0))
      (block $args_lp
        (loop $args_cont
          (if (i32.ge_u (local.get $i) (local.get $args_len)) (then (br $args_lp)))
          (i32.store
            (i32.add (global.get $itp_OFF_EXEC_LOCALS) (i32.shl (local.get $i) (i32.const 2)))
            (i32.load (i32.add (local.get $args_ptr) (i32.shl (local.get $i) (i32.const 2))))
          )
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $args_cont)
        )
      )
      ;; ── Main dispatch loop ──
      (block $dispatch_end
        (loop $dispatch_loop
          ;; Check if we've exhausted decoded ops
          (if (i32.ge_u (local.get $dec_idx) (i32.add (local.get $dec_start) (local.get $dec_count)))
            (then
              (i32.store (global.get $itp_OFF_EXEC_STACK_LEN) (global.get $itp_FAST_STACK_LEN))
              (br $dispatch_end)
            )
          )
          ;; Read decoded op
          (local.set $op_base (i32.add (global.get $itp_OFF_DECODED_OPS) (i32.mul (local.get $dec_idx) (global.get $itp_DEC_SZ))))
          (local.set $op (i32.load8_u (local.get $op_base)))
          (local.set $imm0 (i32.load (i32.add (local.get $op_base) (i32.const 4))))
          (local.set $imm1 (i32.load (i32.add (local.get $op_base) (i32.const 8))))
          (block $op_done
          (block $unsup
            (block $h255
            (block $h254
            (block $h253
            (block $h252
            (block $h251
            (block $h250
            (block $h249
            (block $h248
