    (func $device_quectel_state_after_at (param $command_code i32) (result i32)
      ;; unknown=0 off=1 on=2 registered=5, otherwise unchanged=99.
      local.get $command_code
      i32.const 1
      i32.eq
      if (result i32)
        i32.const 2
      else
        local.get $command_code
        i32.const 2
        i32.eq
        local.get $command_code
        i32.const 7
        i32.eq
        i32.or
        if (result i32)
