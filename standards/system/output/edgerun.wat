            local.get $b
            i32.const 48
            i32.sub
            local.set $digit
            local.get $port
            i32.const 6553
            i32.gt_u
            if
              i32.const 3
              return
            end
            local.get $port
            i32.const 6553
            i32.eq
            local.get $digit
            i32.const 5
            i32.gt_u
            i32.and
            if
              i32.const 3
              return
