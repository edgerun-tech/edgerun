      (call $cmp_emit_byte (i32.const 0x66))
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x6E))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
    )
    ;; movd xmm1, ecx
    (func $cmp_emit_movd_xmm1_ecx
      (call $cmp_emit_byte (i32.const 0x66))
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x6E))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 1) (i32.const 1))
    )
    ;; movd eax, xmm0 (3 bytes: 66 0F 7E C0)
    (func $cmp_emit_movd_eax_xmm0
      (call $cmp_emit_byte (i32.const 0x66))
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x7E))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
    )
    ;; movq xmm0, rax (REX.W + 66 0F 6E C0)
    (func $cmp_emit_movq_xmm0_rax
      (call $cmp_emit_rex_w)
      (call $cmp_emit_byte (i32.const 0x66))
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (i32.const 0x6E))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 0))
    )
    ;; movq xmm1, rcx
