        (local.get $content_start)
        (i32.sub (local.get $content_end) (local.get $content_start))
        (local.get $content_start)
        (i32.sub (local.get $content_end) (local.get $content_start)))
      (i32.const 2109440))
    (func (export "yaml_scan_document") (param $ptr i32) (param $len i32) (param $out i32) (result i32)
      (local $p i32)
      (local $status i32)
      (local $kind i32)
