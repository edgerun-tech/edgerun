    ;; prefix = 0xF3 for f32 or 0xF2 for f64
    ;; ch = opcode byte (e.g., 0x58=add, 0x5C=sub, 0x59=mul, 0x5E=div)
    (func $cmp_emit_sse_op (param $prefix i32) (param $opcode i32)
      (call $cmp_emit_byte (local.get $prefix))
      (call $cmp_emit_byte (i32.const 0x0F))
      (call $cmp_emit_byte (local.get $opcode))
      (call $cmp_emit_modrm (i32.const 3) (i32.const 0) (i32.const 1))  ;; xmm0, xmm1
