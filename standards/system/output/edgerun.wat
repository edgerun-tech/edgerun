          (if (i32.lt_s (local.get $p) (i32.const 2109440)) (then (return (i32.const 5))))
          (if (i32.ne (local.get $p) (local.get $end)) (then (return (i32.const 3))))
          (call $write4 (local.get $out) (i32.const 6) (local.get $start) (i32.sub (local.get $end) (local.get $start)) (i32.const 2109440))
          (return (i32.const 2109440))))
      (if (i32.eq (local.get $c) (i32.const 123))
        (then
          (local.set $p (call $scan_balanced (local.get $ptr) (local.get $end) (local.get $start) (i32.const 123) (i32.const 125)))
          (if (i32.lt_s (local.get $p) (i32.const 2109440)) (then (return (i32.const 5))))
          (if (i32.ne (local.get $p) (local.get $end)) (then (return (i32.const 3))))
          (call $write4 (local.get $out) (i32.const 7) (local.get $start) (i32.sub (local.get $end) (local.get $start)) (i32.const 2109440))
          (return (i32.const 2109440))))
      (call $write4 (local.get $out) (i32.const 8) (local.get $start) (i32.sub (local.get $end) (local.get $start)) (i32.const 2109440))
      (i32.const 2109440))
    (func (export "yaml_scan_scalar") (param $ptr i32) (param $len i32) (param $out i32) (result i32)
      (local $start i32)
      (local $end i32)
      (local.set $start (call $skip_ws (local.get $ptr) (local.get $len) (i32.const 2109440)))
      (local.set $end (call $trim_right (local.get $ptr) (local.get $start) (local.get $len)))
      (call $scalar_kind (local.get $ptr) (local.get $start) (local.get $end) (local.get $out)))
    (func $yaml_scan_line (export "yaml_scan_line") (param $ptr i32) (param $len i32) (param $offset i32) (param $out i32) (result i32)
      (local $line_start i32)
      (local $line_end i32)
      (local $content_start i32)
      (local $content_end i32)
      (local $indent i32)
      (local $colon i32)
      (local $value_start i32)
      (if (i32.gt_u (local.get $offset) (local.get $len)) (then (return (i32.const 1))))
      (local.set $line_start (local.get $offset))
      (local.set $line_end (call $line_end (local.get $ptr) (local.get $len) (local.get $offset)))
      (local.set $content_start (local.get $line_start))
      (loop $indent_loop
        (if (i32.and (i32.lt_u (local.get $content_start) (local.get $line_end)) (i32.eq (call $byte (local.get $ptr) (local.get $content_start)) (i32.const 32)))
          (then
            (local.set $content_start (i32.add (local.get $content_start) (i32.const 1)))
            (br $indent_loop))))
      (if (i32.and (i32.lt_u (local.get $content_start) (local.get $line_end)) (i32.eq (call $byte (local.get $ptr) (local.get $content_start)) (i32.const 9)))
        (then (return (i32.const 3))))
      (local.set $indent (i32.sub (local.get $content_start) (local.get $line_start)))
      (local.set $content_end (call $content_end (local.get $ptr) (local.get $content_start) (local.get $line_end)))
      (if (i32.ge_u (local.get $content_start) (local.get $content_end))
        (then
          (if (i32.and (i32.lt_u (local.get $content_start) (local.get $line_end)) (i32.eq (call $byte (local.get $ptr) (local.get $content_start)) (i32.const 35)))
            (then
              (call $write8 (local.get $out) (i32.const 1) (local.get $indent) (local.get $line_start) (i32.sub (local.get $line_end) (local.get $line_start)) (i32.const 2109440) (i32.const 2109440) (i32.const 2109440) (i32.const 2109440))
              (return (i32.const 2109440))))
          (call $write8 (local.get $out) (i32.const 2109440) (local.get $indent) (local.get $line_start) (i32.sub (local.get $line_end) (local.get $line_start)) (i32.const 2109440) (i32.const 2109440) (i32.const 2109440) (i32.const 2109440))
          (return (i32.const 2109440))))
      (if (call $match_lit (local.get $ptr) (local.get $content_start) (local.get $content_end) (i32.const 24) (i32.const 3))
        (then
          (call $write8 (local.get $out) (i32.const 5) (local.get $indent) (local.get $line_start) (i32.sub (local.get $line_end) (local.get $line_start)) (i32.const 2109440) (i32.const 2109440) (i32.const 2109440) (i32.const 2109440))
          (return (i32.const 2109440))))
      (if (call $match_lit (local.get $ptr) (local.get $content_start) (local.get $content_end) (i32.const 27) (i32.const 3))
        (then
          (call $write8 (local.get $out) (i32.const 6) (local.get $indent) (local.get $line_start) (i32.sub (local.get $line_end) (local.get $line_start)) (i32.const 2109440) (i32.const 2109440) (i32.const 2109440) (i32.const 2109440))
          (return (i32.const 2109440))))
      (if (i32.eq (call $byte (local.get $ptr) (local.get $content_start)) (i32.const 45))
        (then
          (if (i32.or
                (i32.eq (i32.add (local.get $content_start) (i32.const 1)) (local.get $content_end))
                (call $is_ws (call $byte (local.get $ptr) (i32.add (local.get $content_start) (i32.const 1)))))
            (then
              (local.set $value_start (call $skip_ws (local.get $ptr) (local.get $content_end) (i32.add (local.get $content_start) (i32.const 1))))
              (call $write8
                (local.get $out)
                (i32.const 3)
                (local.get $indent)
                (local.get $line_start)
                (i32.sub (local.get $line_end) (local.get $line_start))
                (local.get $content_start)
                (i32.const 1)
                (local.get $value_start)
                (i32.sub (local.get $content_end) (local.get $value_start)))
              (return (i32.const 2109440))))))
      (local.set $colon (call $find_colon (local.get $ptr) (local.get $content_start) (local.get $content_end)))
      (if (i32.ge_s (local.get $colon) (i32.const 2109440))
        (then
          (local.set $value_start (call $skip_ws (local.get $ptr) (local.get $content_end) (i32.add (local.get $colon) (i32.const 1))))
          (call $write8
            (local.get $out)
            (i32.const 2)
            (local.get $indent)
            (local.get $line_start)
            (i32.sub (local.get $line_end) (local.get $line_start))
            (local.get $content_start)
            (i32.sub (call $trim_right (local.get $ptr) (local.get $content_start) (local.get $colon)) (local.get $content_start))
            (local.get $value_start)
            (i32.sub (local.get $content_end) (local.get $value_start)))
