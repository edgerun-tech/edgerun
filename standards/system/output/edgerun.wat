      (drop (local.get $slot))
      (drop (local.get $out_fwd_key16))
      (drop (local.get $out_bwd_key16))
      (drop (local.get $out_fwd_iv16))
      (drop (local.get $out_bwd_iv16))
      (global.get $ERR_UNSUPPORTED))
  ;; -- app-primitives/tor-wat/tor-library --
