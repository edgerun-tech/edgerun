{
  "files.associations": {
    "*.wat": "wat"
  },
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.rulers": [100, 120],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "search.exclude": {
    "edgerun.wat": true,
    "edgerun.wasm": true,
    "edgerun-stripped.wasm": true,
    "edgerun-full.wat": true,
    "node_modules": true
  },
  "files.watcherExclude": {
    "edgerun.wat": true,
    "edgerun.wasm": true,
    "edgerun-stripped.wasm": true,
    "node_modules": true,
    "tor/": true
  },
  "npm.runSilent": false
}
