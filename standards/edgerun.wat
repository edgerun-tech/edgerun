  (func (export "deflate_stored_encode")
    (param $src_ptr i32)
    (param $src_len i32)
    (param $out_ptr i32)
    (param $out_cap i32)
    (result i64)
    (local $src_off i32)
    (local $written i32)
    (local $chunk i32)
    (local $remaining i32)
    (local $is_final i32)
    (local $nlen i32)

