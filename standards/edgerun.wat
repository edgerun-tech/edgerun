  ;; 7 unsupported. Packed encode return: low32=status, high32=written.

  ;; Output record, little-endian u32:
  ;; 0: block_count
  ;; 4: payload_total
  ;; 8: consumed
  ;; 12: final_seen
  (func $write_scan_record
    (param $out i32)
    (param $block_count i32)
    (param $payload_total i32)
    (param $consumed i32)
    (param $final_seen i32)
