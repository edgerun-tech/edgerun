  (func $pow_u32_capped (param $val i32) (param $pow i32) (result i32)
    (local $r i32)
    i32.const 1 local.set $r
    (block $done
      (loop $loop
        local.get $pow i32.eqz br_if $done
        local.get $r local.get $val i32.mul local.tee $r
        i32.const 0 i32.lt_s
        if
