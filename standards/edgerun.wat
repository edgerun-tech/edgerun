    (local $p i32) (local $len i32)
    (local.set $p (i32.load (i32.const 172)))
    (local.set $len (i32.load (i32.const 180)))
    (block $bad
      (if (i32.lt_u (local.get $len) (i32.const 6)) (then (br $bad)))
      (if (i32.ne (i32.load8_u (local.get $p)) (i32.const 0x31)) (then (br $bad)))
      (if (i32.ne (i32.load8_u (i32.add (local.get $p) (i32.const 1))) (i32.const 0x41)) (then (br $bad)))
      (if (i32.ne (i32.load8_u (i32.add (local.get $p) (i32.const 2))) (i32.const 0x59)) (then (br $bad)))
      (if (i32.ne (i32.load8_u (i32.add (local.get $p) (i32.const 3))) (i32.const 0x26)) (then (br $bad)))
      (if (i32.ne (i32.load8_u (i32.add (local.get $p) (i32.const 4))) (i32.const 0x53)) (then (br $bad)))
      (if (i32.ne (i32.load8_u (i32.add (local.get $p) (i32.const 5))) (i32.const 0x59)) (then (br $bad)))
      (i32.store (i32.const 148) (global.get $ERR_TODO))
      (return (global.get $ERR_TODO))
    )
