  (func $whiteout_kind_name (param $ptr i32) (param $start i32) (param $end i32) (result i32)
    (local $n i32)
    (local $ok i32)
    (local.set $n (i32.sub (local.get $end) (local.get $start)))
    (if (i32.eq (local.get $n) (i32.const 12))
