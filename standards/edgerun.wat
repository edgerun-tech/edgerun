  (func (export "deflate_stored_scan")
    (param $ptr i32)
    (param $len i32)
    (param $out i32)
    (result i32)
    (local $off i32)
    (local $header i32)
    (local $bfinal i32)
    (local $btype i32)
    (local $block_len i32)
    (local $nlen i32)
    (local $payload_off i32)
    (local $payload_end i32)
