    (if (i32.eq (local.get $id) (i32.const 21)) (then (return (i32.const 2))))
    (if (i32.eq (local.get $id) (i32.const 22)) (then (return (i32.const 3))))
    (if (i32.eq (local.get $id) (i32.const 23)) (then (return (i32.const 4))))
