  ;; === gzip_dispatch ===
  (func $gzip_dispatch (export "js5_cache_gzip_dispatch") (result i32)
    (local $p i32) (local $end i32) (local $payload_ptr i32) (local $payload_len i32)
    (local $flags i32) (local $v i32) (local $xlen i32)
    (local.set $payload_ptr (i32.load (i32.const 172)))
    (local.set $payload_len (i32.load (i32.const 180)))
    (block $bad
      (if (i32.lt_u (local.get $payload_len) (i32.const 18)) (then (br $bad)))
      (if (i32.ne (i32.load8_u (local.get $payload_ptr)) (i32.const 0x1f)) (then (br $bad)))
      (if (i32.ne (i32.load8_u (i32.add (local.get $payload_ptr) (i32.const 1))) (i32.const 0x8b)) (then (br $bad)))
      (if (i32.ne (i32.load8_u (i32.add (local.get $payload_ptr) (i32.const 2))) (i32.const 8)) (then (br $bad)))
      (local.set $flags (i32.load8_u (i32.add (local.get $payload_ptr) (i32.const 3))))
      (if (i32.and (local.get $flags) (i32.const 0xe0)) (then (br $bad)))
      (local.set $p (i32.add (local.get $payload_ptr) (i32.const 10)))
      (local.set $end (i32.sub (i32.add (local.get $payload_ptr) (local.get $payload_len)) (i32.const 8)))
      (if (i32.gt_u (local.get $p) (local.get $end)) (then (br $bad)))
      ;; extra
      (if (i32.and (local.get $flags) (i32.const 4))
        (then
          (if (i32.gt_u (i32.add (local.get $p) (i32.const 2)) (local.get $end)) (then (br $bad)))
          (local.set $xlen
            (i32.or
              (i32.load8_u (local.get $p))
              (i32.shl (i32.load8_u (i32.add (local.get $p) (i32.const 1))) (i32.const 8))
            )
          )
          (local.set $p (i32.add (i32.add (local.get $p) (i32.const 2)) (local.get $xlen)))
          (if (i32.gt_u (local.get $p) (local.get $end)) (then (br $bad)))
        )
      )
      ;; name
      (if (i32.and (local.get $flags) (i32.const 8))
        (then
          (block $name_done
            (loop $name_loop
              (if (i32.ge_u (local.get $p) (local.get $end)) (then (br $bad)))
              (br_if $name_done (i32.eqz (i32.load8_u (local.get $p))))
              (local.set $p (i32.add (local.get $p) (i32.const 1)))
              (br $name_loop)
            )
          )
          (local.set $p (i32.add (local.get $p) (i32.const 1)))
        )
      )
      ;; comment
      (if (i32.and (local.get $flags) (i32.const 16))
        (then
          (block $comm_done
            (loop $comm_loop
              (if (i32.ge_u (local.get $p) (local.get $end)) (then (br $bad)))
              (br_if $comm_done (i32.eqz (i32.load8_u (local.get $p))))
              (local.set $p (i32.add (local.get $p) (i32.const 1)))
              (br $comm_loop)
            )
          )
          (local.set $p (i32.add (local.get $p) (i32.const 1)))
        )
      )
      ;; hcrc
      (if (i32.and (local.get $flags) (i32.const 2))
        (then
          (local.set $p (i32.add (local.get $p) (i32.const 2)))
          (if (i32.gt_u (local.get $p) (local.get $end)) (then (br $bad)))
        )
      )
      (i64.store (i32.const 220) (i64.extend_i32_s (local.get $p)))
      (i64.store (i32.const 228) (i64.extend_i32_s (i32.sub (local.get $end) (local.get $p))))
      (i64.store (i32.const 236) (i64.extend_i32_s (local.get $end)))
      (i64.store (i32.const 212) (i64.extend_i32_s (i32.sub (local.get $p) (local.get $payload_ptr))))
      (i32.store (i32.const 244) (i32.load (local.get $end)))
      (i32.store (i32.const 248) (i32.load (i32.add (local.get $end) (i32.const 4))))
      (if (i32.gt_u (i32.load (i32.const 168)) (global.get $DEFAULT_BYTES)) (then (br $bad)))
      (if (i32.ne (i32.load (i32.const 248)) (i32.load (i32.const 168))) (then (br $bad)))
      (local.set $v (call $deflate_decode_stored))
      (if (i32.lt_s (local.get $v) (i32.const 0)) (then (return (local.get $v))))
      (i32.store (i32.const 172) (local.get $payload_ptr))
      (i32.store (i32.const 180) (local.get $payload_len))
      (i32.store (i32.const 188) (i32.const 1048888))
      (i32.store (i32.const 168) (i32.load (i32.const 248)))
      (i64.store (i32.const 56) (i64.extend_i32_s (local.get $payload_ptr)))
      (i64.store (i32.const 64) (i64.extend_i32_s (local.get $payload_len)))
      (i64.store (i32.const 72) (i64.extend_i32_s (i32.const 1048888)))
      (i64.store (i32.const 80) (i64.extend_i32_s (i32.load (i32.const 248))))
      (i32.store (i32.const 8) (global.get $STATE_DONE))
      (i32.store (i32.const 144) (global.get $STATE_DONE))
      (i32.const 0)
      return
    )
    (i32.store (i32.const 148) (global.get $ERR_DECOMP))
    (global.get $ERR_DECOMP)
  )

  ;; === deflate_decode_stored ===
  (func $deflate_decode_stored (result i32)
    (local $in_ptr i32) (local $in_end i32) (local $out_ptr i32) (local $out_start i32) (local $out_end i32)
    (local $len i32) (local $nlen i32) (local $v i32) (local $i i32)
    (local.set $in_ptr (i32.load (i32.const 220)))
    (i32.store (i32.const 252) (local.get $in_ptr))
    (local.set $in_end (i32.add (local.get $in_ptr) (i32.load (i32.const 228))))
    (i32.store (i32.const 260) (local.get $in_end))
    (local.set $out_start (i32.const 1048888))
    (i32.store (i32.const 276) (local.get $out_start))
    (i32.store (i32.const 268) (local.get $out_start))
    (local.set $out_end (i32.add (local.get $out_start) (i32.load (i32.const 168))))
    (i32.store (i32.const 284) (local.get $out_end))
    (i64.store (i32.const 292) (i64.const 0))
    (i32.store (i32.const 300) (i32.const 0))
    (i32.store (i32.const 304) (i32.const 0))
    (block $block_loop
      (loop $block_loop_l
        (local.set $v (call $deflate_read_bits (i32.const 1)))
        (if (i32.lt_s (local.get $v) (i32.const 0)) (then (return (local.get $v))))
        (i32.store (i32.const 304) (local.get $v))
        (local.set $v (call $deflate_read_bits (i32.const 2)))
        (if (i32.lt_s (local.get $v) (i32.const 0)) (then (return (local.get $v))))
        (i32.store (i32.const 308) (local.get $v))
        (block $stored
          (if (i32.eqz (local.get $v))
            (then
              (i64.store (i32.const 292) (i64.const 0))
              (i32.store (i32.const 300) (i32.const 0))
              (local.set $in_ptr (i32.load (i32.const 252)))
              (local.set $in_end (i32.load (i32.const 260)))
              (block $bad
                (if (i32.gt_u (i32.add (local.get $in_ptr) (i32.const 4)) (local.get $in_end)) (then (br $bad)))
                (local.set $len
                  (i32.or
                    (i32.load8_u (local.get $in_ptr))
                    (i32.shl (i32.load8_u (i32.add (local.get $in_ptr) (i32.const 1))) (i32.const 8))
                  )
                )
                (local.set $nlen
                  (i32.or
                    (i32.load8_u (i32.add (local.get $in_ptr) (i32.const 2)))
                    (i32.shl (i32.load8_u (i32.add (local.get $in_ptr) (i32.const 3))) (i32.const 8))
                  )
                )
                (if (i32.ne (i32.xor (local.get $len) (local.get $nlen)) (i32.const 0xffff)) (then (br $bad)))
                (local.set $in_ptr (i32.add (local.get $in_ptr) (i32.const 4)))
                (if (i32.gt_u (i32.add (local.get $in_ptr) (local.get $len)) (i32.load (i32.const 260))) (then (br $bad)))
                (local.set $out_ptr (i32.load (i32.const 268)))
                (if (i32.gt_u (i32.add (local.get $out_ptr) (local.get $len)) (i32.load (i32.const 284))) (then (br $bad)))
                (local.set $i (i32.const 0))
                (block $cpy_done
                  (loop $cpy_loop
                    (if (i32.eq (local.get $i) (local.get $len)) (then (br $cpy_done)))
                    (i32.store8
                      (i32.add (local.get $out_ptr) (local.get $i))
                      (i32.load8_u (i32.add (local.get $in_ptr) (local.get $i)))
                    )
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $cpy_loop)
                  )
                )
                (i32.store (i32.const 252) (i32.add (local.get $in_ptr) (local.get $len)))
                (i32.store (i32.const 268) (i32.add (local.get $out_ptr) (local.get $len)))
                (br $stored)
              )
              (i32.store (i32.const 148) (global.get $ERR_DECOMP))
              (return (global.get $ERR_DECOMP))
            )
          )
        )
        (if (i32.eq (local.get $v) (i32.const 1))
          (then
            (i32.store (i32.const 148) (global.get $ERR_TODO))
            (return (global.get $ERR_TODO))
          )
        )
        (if (i32.eq (local.get $v) (i32.const 2))
          (then
            (i32.store (i32.const 148) (global.get $ERR_TODO))
            (return (global.get $ERR_TODO))
          )
        )
        (if (i32.eqz (i32.load (i32.const 304)))
          (then (br $block_loop_l))
        )
        (local.set $v
          (i32.sub
            (i32.load (i32.const 268))
            (i32.load (i32.const 276))
          )
        )
        (if (i32.ne (local.get $v) (i32.load (i32.const 168)))
          (then
            (i32.store (i32.const 148) (global.get $ERR_DECOMP))
            (return (global.get $ERR_DECOMP))
          )
        )
        (i32.const 0)
        return
      )
    )
    (i32.store (i32.const 148) (global.get $ERR_DECOMP))
    (global.get $ERR_DECOMP)
  )

  ;; === deflate_read_bits ===
  (func $deflate_read_bits (param $count i32) (result i32)
    (local $r9 i32) (local $bitbuf i64) (local $bitcount i32) (local $in_ptr i32) (local $in_end i32)
    (local $v i32)
    (local.set $r9 (local.get $count))
    (if (i32.eqz (local.get $r9))
      (then (return (i32.const 0)))
    )
    (block $bad
      (if (i32.gt_u (local.get $r9) (i32.const 16)) (then (br $bad)))
      (local.set $bitbuf (i64.load (i32.const 292)))
      (local.set $bitcount (i32.load (i32.const 300)))
      (local.set $in_ptr (i32.load (i32.const 252)))
      (local.set $in_end (i32.load (i32.const 260)))
      (block $fill
        (loop $fill_loop
          (if (i32.ge_u (local.get $bitcount) (local.get $r9)) (then (br $fill)))
          (if (i32.ge_u (local.get $in_ptr) (local.get $in_end))
            (then (br $bad))
          )
          (local.set $v (i32.load8_u (local.get $in_ptr)))
          (local.set $in_ptr (i32.add (local.get $in_ptr) (i32.const 1)))
          (local.set $bitbuf
            (i64.or
              (local.get $bitbuf)
              (i64.shl (i64.extend_i32_s (local.get $v)) (i64.extend_i32_s (local.get $bitcount)))
            )
          )
          (local.set $bitcount (i32.add (local.get $bitcount) (i32.const 8)))
          (br $fill_loop)
        )
      )
      (i64.store (i32.const 292)
        (i64.shr_u (local.get $bitbuf) (i64.extend_i32_s (local.get $r9)))
      )
      (i32.store (i32.const 300) (i32.sub (local.get $bitcount) (local.get $r9)))
      (i32.store (i32.const 252) (local.get $in_ptr))
      (return
        (i32.and (i32.wrap_i64 (local.get $bitbuf))
          (i32.sub (i32.shl (i32.const 1) (local.get $r9)) (i32.const 1))
        )
      )
    )
    (i32.store (i32.const 148) (global.get $ERR_DECOMP))
    (global.get $ERR_DECOMP)
  )

