          (i32.or
            (i32.load8_u (i32.add (local.get $ptr) (i32.add (local.get $off) (i32.const 3))))
            (i32.shl
              (i32.load8_u (i32.add (local.get $ptr) (i32.add (local.get $off) (i32.const 4))))
              (i32.const 8))))

