  ;; i64.load32_s: REX.W movsxd rax, dword [rdx+rcx]  (48 63 04 0A)
  (func $emit_x86_mem_load32_s
    (call $emit_x86_load_r15_to_rdx (i32.const 8))
    (call $emit_x86_rex_w)
    (call $emit_x86_byte (i32.const 0x63))
    (call $emit_x86_byte (i32.const 0x04))
