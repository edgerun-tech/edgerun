    (i32.store (i32.add (local.get $out) (i32.const 4)) (local.get $payload_total))
    (i32.store (i32.add (local.get $out) (i32.const 8)) (local.get $consumed))
    (i32.store (i32.add (local.get $out) (i32.const 12)) (local.get $final_seen)))

