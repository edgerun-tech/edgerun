    (if (i32.eqz (local.get $proto_len))
      (then (return (i32.const 3))))
    (if (i32.gt_u (local.get $proto_len) (i32.sub (local.get $len) (i32.add (local.get $pos) (i32.const 1))))
      (then (return (i32.const 5))))
