    (call $emit_x86_byte (i32.const 0x0F))
    (call $emit_x86_byte (i32.const 0xBF))
    (call $emit_x86_byte (i32.const 0x04))
    (call $emit_x86_sib (i32.const 0) (i32.const 1) (i32.const 2))
