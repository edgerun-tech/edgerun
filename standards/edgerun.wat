                (i64.extend_i32_u (i32.sub (local.get $b) (i32.const 48))))))
          (else
            (if (i32.and (i32.ne (local.get $b) (i32.const 0)) (i32.ne (local.get $b) (i32.const 32)))
              (then (return (i32.const 3))))))
