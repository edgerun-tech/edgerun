  (func (export "oci_rootfs_relative_path_valid") (param $ptr i32) (param $len i32) (result i32)
    (local $i i32)
    (local $seg_start i32)
    (local $seg_len i32)
    (block $done
      (loop $scan
        (if (i32.ge_u (local.get $i) (local.get $len)) (then (br $done)))
