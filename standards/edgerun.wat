            (return (global.get $ERR_HEADER))
          )
        )
        (i32.store (i32.const 172) (local.get $p))
        (i32.store (i32.const 180) (local.get $clen))
        (i32.store (i32.const 188) (local.get $p))
        (i32.store (i32.const 168) (local.get $clen))
        (i64.store (i32.const 56) (i64.extend_i32_s (local.get $p)))
        (i64.store (i32.const 64) (i64.extend_i32_s (local.get $clen)))
        (i64.store (i32.const 72) (i64.extend_i32_s (local.get $p)))
        (i64.store (i32.const 80) (i64.extend_i32_s (local.get $clen)))
        (return (i32.const 0))
      )
    )
    (if (i32.lt_u (local.get $len) (i32.const 9))
      (then
        (i32.store (i32.const 148) (global.get $ERR_HEADER))
        (return (global.get $ERR_HEADER))
      )
    )
    (local.set $dlen
      (i32.or
        (i32.or
          (i32.or
            (i32.shl (i32.load8_u (i32.add (local.get $ptr) (i32.const 5))) (i32.const 24))
            (i32.shl (i32.load8_u (i32.add (local.get $ptr) (i32.const 6))) (i32.const 16))
          )
          (i32.shl (i32.load8_u (i32.add (local.get $ptr) (i32.const 7))) (i32.const 8))
        )
        (i32.load8_u (i32.add (local.get $ptr) (i32.const 8)))
      )
    )
    (i32.store (i32.const 168) (local.get $dlen))
    (local.set $p (i32.add (local.get $ptr) (i32.const 9)))
    (if (i32.lt_u (local.get $len) (i32.add (local.get $clen) (i32.const 9)))
      (then
        (i32.store (i32.const 148) (global.get $ERR_HEADER))
        (return (global.get $ERR_HEADER))
      )
    )
    (i32.store (i32.const 172) (local.get $p))
    (i32.store (i32.const 180) (local.get $clen))
    (i64.store (i32.const 188) (i64.const 0))
    (i64.store (i32.const 56) (i64.extend_i32_s (local.get $p)))
    (i64.store (i32.const 64) (i64.extend_i32_s (local.get $clen)))
    (i64.store (i32.const 72) (i64.const 0))
    (i64.store (i32.const 80) (i64.extend_i32_s (local.get $dlen)))
    (if (i32.eq (local.get $type) (global.get $CONTAINER_BZIP))
