        local.get $i
        i32.const 1
        i32.add
        local.set $i
        br $scan))

    local.get $out
    i32.const 0
    local.get $len
    local.get $len
    call $m38write_record
    i32.const 4)

  ;; Scan the next entry in a NUL-separated multi-string. Empty entries terminate
