    (i32.store (i32.add (local.get $out) (i32.const 12)) (local.get $mtime))
    (i32.store (i32.add (local.get $out) (i32.const 16)) (local.get $xfl))
    (i32.store (i32.add (local.get $out) (i32.const 20)) (local.get $os))
