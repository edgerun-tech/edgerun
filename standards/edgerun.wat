    i32.store8
    local.get $out_ptr
    i32.const 31
    i32.add
    local.get $out_ptr
    i32.const 31
    i32.add
    i32.load8_u
    i32.const 127
    i32.and
    i32.const 64
    i32.or
    i32.store8
    i32.const 0
    i32.const 32
