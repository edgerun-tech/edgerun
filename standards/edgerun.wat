      i32.const 0
      i32.const 0
      call $m38write_record
      i32.const 5
      local.get $len
      call $pack
      return
    end

    local.get $ptr
    local.get $offset
    i32.add
    local.set $start
    local.get $start
    local.set $i
    local.get $ptr
