    local.get $padded_len
    i32.const 8
    i32.sub
    i32.ge_u
    if
      local.get $len
      i64.extend_i32_u
      i64.const 3
      i64.shl
      local.set $bit_len
      local.get $index
      local.get $padded_len
      i32.const 8
      i32.sub
      i32.sub
      local.set $tail_index
      local.get $bit_len
      i64.const 7
      local.get $tail_index
      i64.extend_i32_u
      i64.sub
      i64.const 8
      i64.mul
      i64.shr_u
      i32.wrap_i64
      i32.const 0xff
      i32.and
