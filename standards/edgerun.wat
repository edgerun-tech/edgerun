    (if (i32.eqz (local.get $len)) (then (return (i32.const 0))))
    (block $scan_done
      (loop $scan
        (if (i32.ge_u (local.get $i) (local.get $len)) (then (br $scan_done)))
        (local.set $b (i32.load8_u (i32.add (local.get $ptr) (local.get $i))))
