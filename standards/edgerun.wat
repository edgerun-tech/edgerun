      (i32.and (i32.eq (local.get $len) (i32.const 1)) (i32.eq (i32.load8_u (local.get $ptr)) (i32.const 42)))
      (then (return (i32.const 3))))
    (if (i32.eq (i32.load8_u (local.get $ptr)) (i32.const 47)) (then (return (i32.const 1))))
    (if
