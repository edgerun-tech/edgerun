        i32.ge_u
        br_if $done
        local.get $ptr
        local.get $i
        call $load8_u
        local.get $needle
        i32.eq
        if
          local.get $i
          return
        end
        local.get $i
        i32.const 1
        i32.add
        local.set $i
        br $scan))
    i32.const -1)

