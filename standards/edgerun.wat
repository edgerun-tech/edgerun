  ;; Return status 0 when a NUL terminator is found and status 4 when the input
  ;; ends before a terminator. Offsets are relative to ptr.
  (func (export "c_string_scan")
    (param $ptr i32) (param $len i32) (param $out i32)
    (result i32)
    (local $i i32)
    (local $end i32)
    (local $consumed i32)

    local.get $ptr
    local.get $len
    i32.add
    local.set $end
    local.get $ptr
