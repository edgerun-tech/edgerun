    (i32.store (i32.const 180) (local.get $payload_len))
    (i32.store (i32.const 188) (local.get $decomp_ptr))
    (i32.store (i32.const 168) (local.get $decomp_len))
    (i64.store (i32.const 56) (i64.extend_i32_s (local.get $payload_ptr)))
    (i64.store (i32.const 64) (i64.extend_i32_s (local.get $payload_len)))
