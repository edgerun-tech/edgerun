        local.get $i
        i32.const 1
        i32.add
        local.set $i
        br $scan))

    local.get $len
    local.get $offset
    i32.sub
    local.set $str_len
    local.get $out
    local.get $offset
    local.get $str_len
    local.get $str_len
    call $m38write_record
