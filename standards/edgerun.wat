    (i32.store (local.get $out_ptr) (i32.wrap_i64 (local.get $value)))
    (i32.store (i32.add (local.get $out_ptr) (i32.const 4)) (i32.wrap_i64 (i64.shr_u (local.get $value) (i64.const 32))))
    i32.const 0)

