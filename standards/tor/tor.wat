  (func (export "tor_hs_intro_relay_record_size") (result i32) (global.get $INTRO_RELAY_REC_SIZE))

  (func $tor_hs_intro_relay_init (export "tor_hs_intro_relay_init") (result i32)
    (local $i i32) (local $r i32)
    (local.set $i (i32.const 0))
    (block $done (loop $loop
      (br_if $done (i32.ge_u (local.get $i) (global.get $INTRO_RELAY_MAX_INTROS)))
      (local.set $r (call $intro_rec_ptr (local.get $i)))
      (i32.store (local.get $r) (i32.const 0))
      (i32.store offset=4 (local.get $r) (i32.const 0))
      (i32.store offset=8 (local.get $r) (i32.const 0))
      (i32.store offset=12 (local.get $r) (i32.const 0))
      (i32.store offset=48 (local.get $r) (i32.const 0))
      (i32.store offset=52 (local.get $r) (i32.const 0))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $loop)))
    (global.get $INTRO_RELAY_OK))

  (func $tor_hs_intro_relay_parse_establish_intro_auth (export "tor_hs_intro_relay_parse_establish_intro_auth")
    (param $body i32) (param $body_len i32) (param $out_auth32 i32) (result i32)
    (local $ext_end i32) (local $sig_len_off i32)
    (if (i32.lt_u (local.get $body_len) (global.get $INTRO_RELAY_ESTABLISH_MIN)) (then (return (global.get $INTRO_RELAY_ERR_BOUNDS))))
    (if (i32.or (i32.ne (i32.load8_u (local.get $body)) (i32.const 2))
                (i32.ne (call $load_u16_be (i32.add (local.get $body) (i32.const 1))) (i32.const 32)))
      (then (return (global.get $INTRO_RELAY_ERR_INVALID))))
    (local.set $ext_end (call $intro_extensions_end (local.get $body) (local.get $body_len) (i32.const 35)))
    (if (i32.lt_s (local.get $ext_end) (i32.const 0)) (then (return (global.get $INTRO_RELAY_ERR_INVALID))))
    (local.set $sig_len_off (i32.add (local.get $ext_end) (i32.const 32)))
    (if (i32.gt_u (i32.add (local.get $sig_len_off) (i32.const 2)) (local.get $body_len)) (then (return (global.get $INTRO_RELAY_ERR_INVALID))))
    (if (i32.ne (i32.add (i32.add (local.get $sig_len_off) (i32.const 2))
               (call $load_u16_be (i32.add (local.get $body) (local.get $sig_len_off)))) (local.get $body_len))
      (then (return (global.get $INTRO_RELAY_ERR_INVALID))))
    (call $memcpy (local.get $out_auth32) (i32.add (local.get $body) (i32.const 3)) (i32.const 32))
    (global.get $INTRO_RELAY_OK))

  (func (export "tor_hs_intro_relay_register")
    (param $intro_circ_id i32) (param $service_circ_id i32) (param $establish_body i32) (param $body_len i32) (result i32)
    (local $r i32)
    (if (i32.eqz (local.get $intro_circ_id)) (then (return (global.get $INTRO_RELAY_ERR_INVALID))))
    (local.set $r (call $intro_find_by_intro_circ (local.get $intro_circ_id)))
    (if (i32.eqz (local.get $r)) (then (local.set $r (call $intro_alloc_record))))
    (if (i32.eqz (local.get $r)) (then (return (global.get $INTRO_RELAY_ERR_BOUNDS))))
    (if (i32.ne (call $tor_hs_intro_relay_parse_establish_intro_auth (local.get $establish_body) (local.get $body_len) (i32.add (local.get $r) (i32.const 16))) (global.get $INTRO_RELAY_OK))
      (then (return (global.get $INTRO_RELAY_ERR_INVALID))))
    (i32.store (local.get $r) (i32.const 1))
    (i32.store offset=4 (local.get $r) (local.get $intro_circ_id))
    (i32.store offset=8 (local.get $r) (local.get $service_circ_id))
    (i32.store offset=48 (local.get $r) (local.get $body_len))
    (i32.store offset=52 (local.get $r) (global.get $INTRO_RELAY_OK))
    (global.get $INTRO_RELAY_OK))

  (func (export "tor_hs_intro_relay_validate_introduce1")
    (param $body i32) (param $body_len i32) (param $out_service_circ i32) (result i32)
    (local $i i32) (local $ext_end i32) (local $r i32)
    (if (i32.or (i32.lt_u (local.get $body_len) (global.get $INTRO_RELAY_INTRO_PREFIX_MIN))
                (i32.gt_u (local.get $body_len) (global.get $INTRO_RELAY_INTRODUCE1_MAX)))
      (then (return (global.get $INTRO_RELAY_ERR_BOUNDS))))
    (local.set $i (i32.const 0))
    (block $zeros_done (loop $zeros
      (br_if $zeros_done (i32.ge_u (local.get $i) (i32.const 20)))
      (if (i32.ne (i32.load8_u (i32.add (local.get $body) (local.get $i))) (i32.const 0))
        (then (return (global.get $INTRO_RELAY_ERR_INVALID))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $zeros)))
    (if (i32.or (i32.ne (i32.load8_u (i32.add (local.get $body) (i32.const 20))) (i32.const 2))
                (i32.ne (call $load_u16_be (i32.add (local.get $body) (i32.const 21))) (i32.const 32)))
      (then (return (global.get $INTRO_RELAY_ERR_INVALID))))
    (local.set $ext_end (call $intro_extensions_end (local.get $body) (local.get $body_len) (i32.const 55)))
    (if (i32.lt_s (local.get $ext_end) (i32.const 0)) (then (return (global.get $INTRO_RELAY_ERR_INVALID))))
    (if (i32.ge_u (local.get $ext_end) (local.get $body_len)) (then (return (global.get $INTRO_RELAY_ERR_INVALID))))
    (local.set $r (call $intro_find_by_auth (i32.add (local.get $body) (i32.const 23))))
    (if (i32.eqz (local.get $r)) (then (return (global.get $ERR_AUTH))))
    (i32.store (local.get $out_service_circ) (i32.load offset=8 (local.get $r)))
    (i32.store offset=12 (local.get $r) (i32.add (i32.load offset=12 (local.get $r)) (i32.const 1)))
    (i32.store offset=48 (local.get $r) (local.get $body_len))
    (i32.store offset=52 (local.get $r) (global.get $INTRO_RELAY_OK))
    (global.get $INTRO_RELAY_OK))

  (func (export "tor_hs_intro_relay_build_introduce2")
    (param $out i32) (param $introduce1_body i32) (param $body_len i32) (result i32)
    (if (i32.gt_u (local.get $body_len) (global.get $INTRO_RELAY_INTRODUCE1_MAX)) (then (return (global.get $INTRO_RELAY_ERR_BOUNDS))))
    (call $memcpy (local.get $out) (local.get $introduce1_body) (local.get $body_len))
    (local.get $body_len))

  (func (export "tor_hs_intro_relay_build_introduce_ack")
    (param $out i32) (param $status i32) (result i32)
    (call $store_u16_be (local.get $out) (local.get $status))
    (i32.store8 (i32.add (local.get $out) (i32.const 2)) (i32.const 0))
    (i32.const 3))

  (func (export "tor_hs_intro_relay_build_relay_header")
    (param $out i32) (param $cmd i32) (param $stream i32) (param $body_len i32) (result i32)
    (i32.store8 (local.get $out) (local.get $cmd))
    (call $store_u16_be (i32.add (local.get $out) (i32.const 1)) (local.get $stream))
    (i32.store (i32.add (local.get $out) (i32.const 3)) (i32.const 0))
    (call $store_u16_be (i32.add (local.get $out) (i32.const 9)) (local.get $body_len))
    (i32.const 11))

  (func (export "tor_hs_intro_relay_record_ptr") (param $intro_circ_id i32) (result i32)
    (return (call $intro_find_by_intro_circ (local.get $intro_circ_id))))
  ;; ── Relay functions ──
  (func $circ_ptr (param $circ_id i32) (result i32)
    (local $idx i32)
    (if (i32.eqz (local.get $circ_id)) (then (return (i32.const 0))))
    (local.set $idx (i32.rem_u (local.get $circ_id) (global.get $MAX_CIRCUITS)))
    (i32.add (global.get $m23CIRCUITS_BASE) (i32.mul (local.get $idx) (global.get $CIRC_SIZE))))

  (func $is_relay_role (param $role i32) (result i32)
    (i32.or
      (i32.or (i32.or (i32.eq (local.get $role) (global.get $ROLE_GUARD)) (i32.eq (local.get $role) (global.get $ROLE_MIDDLE)))
        (i32.or (i32.eq (local.get $role) (global.get $ROLE_EXIT)) (i32.eq (local.get $role) (global.get $ROLE_DIRECTORY))))
      (i32.or (i32.eq (local.get $role) (global.get $ROLE_HS_INTRO)) (i32.eq (local.get $role) (global.get $ROLE_HS_RENDEZVOUS)))))

  (func $record_action (param $cp i32) (param $action i32) (param $cmd i32) (param $stream i32) (param $len i32) (result i32)
    (i32.store offset=240 (local.get $cp) (local.get $action))
    (i32.store offset=244 (local.get $cp) (local.get $cmd))
    (i32.store offset=248 (local.get $cp) (local.get $stream))
    (i32.store offset=252 (local.get $cp) (local.get $len))
    (local.get $action))

  (func $relay_payload_len (param $payload i32) (result i32)
    (call $load_u16_be (i32.add (local.get $payload) (i32.const 9))))

  (func $relay_stream_id (param $payload i32) (result i32)
