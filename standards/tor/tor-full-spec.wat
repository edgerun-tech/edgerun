;; Local Tor specification coverage index for the WAT port.
  (global $m10STANDARD_ID i32 (i32.const 300208))
  (global $m10ABI_VERSION i32 (i32.const 2))
  (data (i32.const 1024) "00-os-mapping.md\00")
  (data (i32.const 1056) "02-tor-protocol.md\00")
  (data (i32.const 1088) "03-directory-protocol.md\00")
  (data (i32.const 1120) "04-path-spec.md\00")
  (data (i32.const 1152) "05-guard-spec.md\00")
  (data (i32.const 1184) "06-vanguards-spec.md\00")
  (data (i32.const 1216) "07-padding-spec.md\00")
  (data (i32.const 1248) "08-dos-prevention.md\00")
  (data (i32.const 1280) "09-socks-extensions.md\00")
  (data (i32.const 1312) "10-http-connect.md\00")
  (data (i32.const 1344) "11-address-spec.md\00")
  (data (i32.const 1376) "12-haproxy-proxy.md\00")
  (data (i32.const 1408) "13-onion-services.md\00")
  (data (i32.const 1440) "14-proof-of-work.md\00")
  (data (i32.const 1472) "15-ext-orport.md\00")
  (data (i32.const 1504) "16-pluggable-transport.md\00")
  (data (i32.const 1536) "17-control-protocol.md\00")
  (data (i32.const 1568) "18-version-spec.md\00")
  (data (i32.const 1600) "19-bandwidth-file.md\00")
  (data (i32.const 1632) "20-dir-list.md\00")
  (data (i32.const 1664) "21-parameters.md\00")
  (data (i32.const 1696) "22-ssh-protocols.md\00")
  (data (i32.const 1728) "29-cert-spec.md\00")
  (data (i32.const 1760) "30-device-beacon.md\00")

  (func (export "proto_standard_id") (result i32) (global.get $m10STANDARD_ID))
  (func (export "simd_capabilities") (result i32) (i32.const 1))
  (func (export "tor_spec_document_count") (result i32) (i32.const 24))
  (func (export "tor_spec_document_name_ptr") (param $index i32) (result i32)
    (if (i32.ge_u (local.get $index) (i32.const 24)) (then (return (i32.const 0))))
    (i32.add (i32.const 1024) (i32.mul (local.get $index) (i32.const 32))))
  (func (export "tor_spec_document_required_for_standard_relay") (param $index i32) (result i32)
    (select
      (i32.const 1)
      (i32.const 0)
      (i32.or
        (i32.or
          (i32.or (i32.eq (local.get $index) (i32.const 1)) (i32.eq (local.get $index) (i32.const 2)))
          (i32.or (i32.eq (local.get $index) (i32.const 3)) (i32.eq (local.get $index) (i32.const 4))))
        (i32.or
          (i32.or (i32.eq (local.get $index) (i32.const 12)) (i32.eq (local.get $index) (i32.const 22)))
          (i32.eq (local.get $index) (i32.const 20))))))
  (func (export "tor_spec_has_relay_protocol") (param $version i32) (result i32)
    (i32.and (i32.ge_u (local.get $version) (i32.const 2)) (i32.le_u (local.get $version) (i32.const 6))))
  (func (export "tor_spec_has_hsintro_protocol") (param $version i32) (result i32)
    (i32.and (i32.ge_u (local.get $version) (i32.const 3)) (i32.le_u (local.get $version) (i32.const 5))))
  (func (export "tor_spec_has_hsrend_protocol") (param $version i32) (result i32)
    (i32.and (i32.ge_u (local.get $version) (i32.const 1)) (i32.le_u (local.get $version) (i32.const 2))))
  (func (export "tor_spec_cell_command_supported") (param $cmd i32) (result i32)
    (select
      (i32.const 1)
      (i32.const 0)
      (i32.or
        (i32.or
          (i32.or (i32.eq (local.get $cmd) (i32.const 3)) (i32.eq (local.get $cmd) (i32.const 4)))
          (i32.or (i32.eq (local.get $cmd) (i32.const 7)) (i32.eq (local.get $cmd) (i32.const 8))))
        (i32.or
          (i32.or (i32.eq (local.get $cmd) (i32.const 10)) (i32.eq (local.get $cmd) (i32.const 11)))
          (i32.or (i32.eq (local.get $cmd) (i32.const 9)) (i32.eq (local.get $cmd) (i32.const 12)))))))
  (func (export "tor_spec_relay_command_supported") (param $cmd i32) (result i32)
    (select
      (i32.const 1)
      (i32.const 0)
      (i32.or
        (i32.and (i32.ge_u (local.get $cmd) (i32.const 1)) (i32.le_u (local.get $cmd) (i32.const 15)))
        (i32.and (i32.ge_u (local.get $cmd) (i32.const 32)) (i32.le_u (local.get $cmd) (i32.const 40))))))
