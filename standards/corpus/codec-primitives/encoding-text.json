{
  "schema": "edgerun.codec-primitives.corpus.v1",
  "family": "encoding-text",
  "module": "encoding-text.wat",
  "cases": [
    {
      "id": "hex-decode-deadbeef",
      "function": "hex_decode",
      "input": { "ascii": "deadBEEF" },
      "expect": { "status": 0, "bytes_written": 4, "hex": "deadbeef" },
      "notes": "Hex decode accepts upper and lower case digits."
    },
    {
      "id": "hex-odd-length",
      "function": "hex_decode",
      "input": { "ascii": "abc" },
      "expect": { "status": 3 },
      "notes": "Strict hex requires an even number of digits."
    },
    {
      "id": "base64url-canonical-short-tail",
      "function": "base64url_nopad_decode",
      "input": { "ascii": "AA" },
      "expect": { "status": 0, "bytes_written": 1, "hex": "00" },
      "notes": "Two-character canonical no-pad tail with zero unused bits."
    },
    {
      "id": "base64url-noncanonical-tail",
      "function": "base64url_nopad_decode",
      "input": { "ascii": "AB" },
      "expect": { "status": 3 },
      "notes": "Second sextet has nonzero unused low bits."
    },
    {
      "id": "base64url-invalid-length",
      "function": "base64url_nopad_decode",
      "input": { "ascii": "A" },
      "expect": { "status": 3 },
      "notes": "A single base64url character cannot encode a byte."
    }
  ]
}
