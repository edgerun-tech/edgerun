{
  "schema": "edgerun.codec-primitives.corpus.v1",
  "family": "http1-lines",
  "module": "http1-lines.wat",
  "cases": [
    {
      "id": "request-line-get",
      "function": "http_parse_request_line",
      "input": { "ascii": "GET /x?q=1 HTTP/1.1\r\n" },
      "expect": { "status": 0, "method": "GET", "target": "/x?q=1", "version": "HTTP/1.1" },
      "notes": "Simple HTTP/1.1 request line."
    },
    {
      "id": "request-line-missing-space",
      "function": "http_parse_request_line",
      "input": { "ascii": "GET/x HTTP/1.1\r\n" },
      "expect": { "status": 3 },
      "notes": "Method and target must be separated by SP."
    },
    {
      "id": "status-line-ok",
      "function": "http_parse_status_line",
      "input": { "ascii": "HTTP/1.1 200 OK\r\n" },
      "expect": { "status": 0, "code": 200, "reason": "OK" },
      "notes": "Simple response status line."
    },
    {
      "id": "header-line-host",
      "function": "http_next_header",
      "input": { "ascii": "Host: example.com\r\n" },
      "expect": { "status": 0, "name": "Host", "value": "example.com" },
      "notes": "Header-line scanner trims the separator and line ending."
    },
    {
      "id": "header-line-invalid-name",
      "function": "http_next_header",
      "input": { "ascii": "bad/name: value\r\n" },
      "expect": { "status": 3 },
      "notes": "Delegates to strict HTTP token validation."
    }
  ]
}
