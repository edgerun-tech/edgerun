{
  "schema": "edgerun.codec-primitives.corpus.v1",
  "family": "hpack-huffman",
  "module": "hpack-huffman.wat",
  "cases": [
    {
      "id": "single-o",
      "function": "hpack_huffman_decode",
      "input": { "hex": "3f" },
      "expect": { "status": 0, "ascii": "o", "bytes_written": 1 },
      "notes": "Rust huffman.rs short-padding accepted vector."
    },
    {
      "id": "two-symbols",
      "function": "hpack_huffman_decode",
      "input": { "hex": "fe01" },
      "expect": { "status": 0, "ascii": "!0", "bytes_written": 2 },
      "notes": "Two HPACK Huffman symbols from local Rust tests."
    },
    {
      "id": "eos-in-string",
      "function": "hpack_huffman_validate",
      "input": { "hex": "ffffffff" },
      "expect": { "status": 3 },
      "notes": "EOS symbol inside string is invalid."
    },
    {
      "id": "invalid-padding",
      "function": "hpack_huffman_validate",
      "input": { "hex": "3e" },
      "expect": { "status": 3 },
      "notes": "Padding must be all one bits, matching EOS prefix padding."
    }
  ]
}
