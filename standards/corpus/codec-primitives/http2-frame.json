{
  "schema": "edgerun.codec-primitives.corpus.v1",
  "family": "http2-frame",
  "module": "http2-frame.wat",
  "cases": [
    {
      "id": "headers-stream-one",
      "function": "http2_frame_header_decode",
      "input": { "hex": "000000010000000001" },
      "expect": { "status": 0, "payload_len": 0, "frame_type": 1, "stream_id": 1, "classification": "HEADERS" },
      "notes": "Minimal HTTP/2 HEADERS frame header."
    },
    {
      "id": "settings-stream-zero",
      "function": "http2_frame_header_decode",
      "input": { "hex": "000000040000000000" },
      "expect": { "status": 0, "payload_len": 0, "frame_type": 4, "stream_id": 0, "classification": "SETTINGS" },
      "notes": "SETTINGS frames use stream id zero."
    },
    {
      "id": "reserved-stream-bit-reported",
      "function": "http2_frame_header_decode",
      "input": { "hex": "000000000080000001" },
      "expect": { "status": 0, "stream_id": 1, "reserved_stream_bit": true },
      "notes": "Decoder reports and clears the reserved stream-id bit."
    },
    {
      "id": "short-header",
      "function": "http2_frame_header_decode",
      "input": { "hex": "00000000" },
      "expect": { "status": 1 },
      "notes": "HTTP/2 frame headers are exactly nine octets."
    },
    {
      "id": "oversize-frame",
      "function": "http2_frame_header_decode",
      "input": { "hex": "004001000000000001" },
      "params": { "max_frame_size": 16384 },
      "expect": { "status": 4 },
      "notes": "Payload length over the caller max is rejected."
    }
  ]
}
