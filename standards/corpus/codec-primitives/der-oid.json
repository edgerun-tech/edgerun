{
  "schema": "edgerun.codec-primitives.corpus.v1",
  "family": "der-oid",
  "module": "der-oid.wat",
  "cases": [
    {
      "id": "pkcs-root-and-arcs",
      "function": "der_oid_value_validate",
      "input": { "hex": "2a864886f70d" },
      "expect": { "status": 0, "arcs": [1, 2, 840, 113549] },
      "notes": "OID prefix 1.2.840.113549 using local const_oid arc limits."
    },
    {
      "id": "pkix-access-description",
      "function": "der_oid_value_validate",
      "input": { "hex": "2b0601050507" },
      "expect": { "status": 0, "arcs": [1, 3, 6, 1, 5, 5, 7] },
      "notes": "OID prefix 1.3.6.1.5.5.7."
    },
    {
      "id": "root-octet-over-local-limit",
      "function": "der_oid_root_decode",
      "input": { "hex": "78" },
      "expect": { "status": 3 },
      "notes": "Local const_oid restricts the compact first and second arcs to first <= 2 and second <= 39."
    },
    {
      "id": "base128-truncated",
      "function": "der_oid_next_arc",
      "input": { "hex": "2a80", "offset": 1 },
      "expect": { "status": 1 },
      "notes": "Continuation arc without a terminating octet."
    },
    {
      "id": "base128-nonminimal-zero",
      "function": "der_oid_next_arc",
      "input": { "hex": "2a8000", "offset": 1 },
      "expect": { "status": 3 },
      "notes": "Arc zero must use short base-128 form."
    }
  ]
}

