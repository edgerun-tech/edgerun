{
  "schema": "edgerun.codec-primitives.corpus.v1",
  "family": "toml-scan",
  "module": "toml-scan.wat",
  "cases": [
    {
      "id": "line-comment",
      "function": "toml_scan_line",
      "input": { "ascii": "# comment" },
      "expect": { "status": 0, "kind": "comment" },
      "notes": "Comment-only line."
    },
    {
      "id": "key-value-string",
      "function": "toml_scan_key_value",
      "input": { "ascii": "name = \"edgerun\"" },
      "expect": { "status": 0, "key": "name", "scalar_kind": "basic-string" },
      "notes": "Simple key/value assignment."
    },
    {
      "id": "table-header",
      "function": "toml_scan_table_header",
      "input": { "ascii": "[server.tls]" },
      "expect": { "status": 0, "table": "server.tls", "array": false },
      "notes": "Standard TOML table header."
    },
    {
      "id": "array-table-header",
      "function": "toml_scan_table_header",
      "input": { "ascii": "[[routes]]" },
      "expect": { "status": 0, "table": "routes", "array": true },
      "notes": "Array table header."
    },
    {
      "id": "scalar-hex-int",
      "function": "toml_scan_scalar",
      "input": { "ascii": "0x2a" },
      "expect": { "status": 0, "kind": "integer-hex" },
      "notes": "Hexadecimal integer scalar."
    },
    {
      "id": "malformed-table",
      "function": "toml_scan_table_header",
      "input": { "ascii": "[server" },
      "expect": { "status": 3 },
      "notes": "Missing closing bracket."
    }
  ]
}
