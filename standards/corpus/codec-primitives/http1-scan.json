{
  "schema": "edgerun.codec-primitives.corpus.v1",
  "family": "http1-scan",
  "module": "http1-scan.wat",
  "cases": [
    {
      "id": "find-crlf",
      "function": "http_find_crlf",
      "input": { "ascii": "GET / HTTP/1.1\r\nHost: example\r\n" },
      "expect": { "status": 0, "offset": 14 },
      "notes": "Finds the first CRLF in an HTTP/1 buffer."
    },
    {
      "id": "valid-header-name",
      "function": "http_validate_header_name",
      "input": { "ascii": "Content-Length" },
      "expect": { "status": 0 },
      "notes": "RFC token characters are accepted."
    },
    {
      "id": "invalid-header-name-slash",
      "function": "http_validate_header_name",
      "input": { "ascii": "bad/name" },
      "expect": { "status": 3 },
      "notes": "Slash is not an HTTP token character."
    },
    {
      "id": "invalid-header-value-nonascii",
      "function": "http_validate_header_value",
      "input": { "hex": "80" },
      "expect": { "status": 3 },
      "notes": "The scanner accepts HTAB, SP, and visible ASCII only."
    },
    {
      "id": "chunk-size-with-extension",
      "function": "http_chunk_step",
      "input": { "ascii": "a;foo=bar\r\n0123456789\r\n" },
      "expect": { "status": 0, "chunk_len": 10 },
      "notes": "Chunk extensions are skipped before CRLF."
    }
  ]
}
