{
  "schema": "edgerun.codec-primitives.corpus.v1",
  "family": "qpack-string",
  "module": "qpack-string.wat",
  "cases": [
    {
      "id": "raw-size6-bar",
      "function": "qpack_string_decode",
      "params": { "size": 6 },
      "input": { "hex": "43626172" },
      "expect": { "status": 0, "ascii": "bar", "bytes_written": 3, "flags": 2, "huffman": 0 },
      "notes": "QPACK prefix string raw payload from local Rust prefix_string tests."
    },
    {
      "id": "huffman-size8-name-with-ref",
      "function": "qpack_string_decode",
      "params": { "size": 8 },
      "input": { "hex": "8aa874954f064cea58597f" },
      "expect": { "status": 0, "ascii": "name with ref", "bytes_written": 13, "flags": 1, "huffman": 1 },
      "notes": "QPACK Huffman prefix-string vector from local Rust tests."
    },
    {
      "id": "bad-size",
      "function": "qpack_string_scan",
      "params": { "size": 1 },
      "input": { "hex": "80" },
      "expect": { "status": 3 },
      "notes": "QPACK prefix string needs at least two field bits so one flag bit remains."
    }
  ]
}
