{
  "schema": "edgerun.codec-primitives.corpus.v1",
  "family": "der-tlv",
  "module": "der-tlv.wat",
  "cases": [
    {
      "id": "integer-one",
      "function": "der_header_decode",
      "input": { "hex": "020101" },
      "expect": { "status": 0, "tag": 2, "length": 1, "header_len": 2 },
      "notes": "DER INTEGER with one content octet."
    },
    {
      "id": "sequence-long-length-128",
      "function": "der_header_decode",
      "input": { "hex": "308180" },
      "expect": { "status": 0, "tag": 48, "length": 128, "header_len": 3 },
      "notes": "Minimal long-form DER length at 128."
    },
    {
      "id": "indefinite-length-rejected",
      "function": "der_header_decode",
      "input": { "hex": "3080" },
      "expect": { "status": 3 },
      "notes": "DER forbids BER indefinite length form."
    },
    {
      "id": "nonminimal-long-length",
      "function": "der_header_decode",
      "input": { "hex": "30817f" },
      "expect": { "status": 3 },
      "notes": "Length 127 must use short form."
    },
    {
      "id": "length-over-compact-record",
      "function": "der_header_decode",
      "input": { "hex": "048401000000" },
      "expect": { "status": 4 },
      "notes": "Current compact output record rejects lengths above 24 bits."
    }
  ]
}
