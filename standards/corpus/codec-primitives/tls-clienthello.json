{
  "schema": "edgerun.codec-primitives.corpus.v1",
  "family": "tls-clienthello",
  "module": "tls-clienthello.wat",
  "cases": [
    {
      "id": "minimal-clienthello-sni-alpn",
      "function": "tls_clienthello_scan",
      "input": {
        "hex": "0303000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f000004130113020100002400000010000e00000b6578616d706c652e636f6d0010000c000a0268330a61636d652d746c732f31"
      },
      "expect": {
        "status": 0,
        "legacy_version": 771,
        "cipher_suite_count": 2,
        "extensions_len": 36
      },
      "notes": "ClientHello body with empty session id, two cipher suites, SNI example.com, and ALPN h3/acme-tls/1."
    },
    {
      "id": "find-sni-extension",
      "function": "tls_clienthello_find_extension",
      "input": {
        "hex": "00000010000e00000b6578616d706c652e636f6d0010000c000a0268330a61636d652d746c732f31"
      },
      "expect": {
        "status": 0,
        "extension_type": 0,
        "extension_len": 16
      },
      "notes": "Find the SNI extension inside the ClientHello extension list."
    },
    {
      "id": "sni-host-example",
      "function": "tls_clienthello_sni_host",
      "input": { "hex": "000e00000b6578616d706c652e636f6d" },
      "expect": { "status": 0, "host": "example.com", "host_len": 11 },
      "notes": "Extract the first host_name entry from an SNI extension payload."
    },
    {
      "id": "bad-cipher-suite-length",
      "function": "tls_clienthello_scan",
      "input": {
        "hex": "0303000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f000001130100"
      },
      "expect": { "status": 3 },
      "notes": "Cipher suite vector length must be even and non-empty."
    },
    {
      "id": "malformed-extension-length",
      "function": "tls_clienthello_find_extension",
      "input": { "hex": "0000ffff00" },
      "expect": { "status": 5 },
      "notes": "Declared extension data exceeds available extension-list bytes."
    }
  ]
}

