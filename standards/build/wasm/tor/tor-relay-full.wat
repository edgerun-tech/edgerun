;; Full Tor relay state machine and cell-routing surface in WAT.
  ;; Crypto and network I/O stay explicit module imports so this relay can be
  ;; linked to the WAT crypto primitives without relying on app-local TLS/ports.
  (global $m23STANDARD_ID i32 (i32.const 300205))
  (global $m23ABI_VERSION i32 (i32.const 2))
  (global $m23OK i32 (i32.const 0))
  (global $m23ERR_INVALID i32 (i32.const -1))
  (global $ERR_PROTOCOL i32 (i32.const -44))
  (global $m23ERR_UNSUPPORTED i32 (i32.const -47))
  (global $ERR_NO_ROUTE i32 (i32.const -48))
  (global $ERR_CRYPTO i32 (i32.const -49))

  (global $CELL_LEN i32 (i32.const 514))
  (global $CELL_PAYLOAD i32 (i32.const 5))
  (global $CELL_PAYLOAD_LEN i32 (i32.const 509))
  (global $RELAY_HEADER_LEN i32 (i32.const 11))
  (global $RELAY_DATA_MAX i32 (i32.const 498))
  (global $NTOR_CLIENT_HANDSHAKE_LEN i32 (i32.const 84))
  (global $NTOR_SERVER_REPLY_LEN i32 (i32.const 64))
  (global $NTOR_V3_MIN_HANDSHAKE_LEN i32 (i32.const 128))
  (global $DEFAULT_WINDOW i32 (i32.const 1000))
  (global $WINDOW_INCREMENT i32 (i32.const 100))

  (global $CELL_CREATE2 i32 (i32.const 10))
  (global $CELL_CREATED2 i32 (i32.const 11))
  (global $CELL_RELAY i32 (i32.const 3))
  (global $CELL_DESTROY i32 (i32.const 4))
  (global $CELL_RELAY_EARLY i32 (i32.const 9))

  (global $RELAY_BEGIN i32 (i32.const 1))
  (global $RELAY_DATA i32 (i32.const 2))
  (global $RELAY_END i32 (i32.const 3))
  (global $RELAY_CONNECTED i32 (i32.const 4))
  (global $RELAY_SENDME i32 (i32.const 5))
  (global $RELAY_EXTEND2 i32 (i32.const 14))
  (global $RELAY_EXTENDED2 i32 (i32.const 15))
  (global $RELAY_TRUNCATE i32 (i32.const 8))
  (global $RELAY_TRUNCATED i32 (i32.const 9))
  (global $RELAY_DROP i32 (i32.const 10))
  (global $RELAY_BEGIN_DIR i32 (i32.const 13))
  (global $m23RELAY_ESTABLISH_INTRO i32 (i32.const 32))
  (global $m23RELAY_ESTABLISH_RENDEZVOUS i32 (i32.const 33))
  (global $m23RELAY_INTRODUCE1 i32 (i32.const 34))
  (global $m23RELAY_INTRODUCE2 i32 (i32.const 35))
  (global $m23RELAY_RENDEZVOUS1 i32 (i32.const 36))
  (global $m23RELAY_RENDEZVOUS2 i32 (i32.const 37))

  (global $ROLE_GUARD i32 (i32.const 1))
  (global $ROLE_MIDDLE i32 (i32.const 2))
  (global $ROLE_EXIT i32 (i32.const 3))
  (global $ROLE_DIRECTORY i32 (i32.const 4))
  (global $ROLE_HS_INTRO i32 (i32.const 7))
  (global $ROLE_HS_RENDEZVOUS i32 (i32.const 8))

  (global $CIRC_CLOSED i32 (i32.const 0))
  (global $CIRC_OPENING i32 (i32.const 1))
  (global $CIRC_OPEN i32 (i32.const 2))
  (global $CIRC_EXTENDING i32 (i32.const 3))
  (global $CIRC_CLOSING i32 (i32.const 4))

  (global $ACTION_DROP i32 (i32.const 0))
  (global $ACTION_LOCAL i32 (i32.const 1))
  (global $ACTION_FORWARD_PREV i32 (i32.const 2))
  (global $ACTION_FORWARD_NEXT i32 (i32.const 3))
  (global $ACTION_DESTROY i32 (i32.const 4))
  (global $ACTION_EXTEND i32 (i32.const 5))
  (global $ACTION_EXIT_STREAM i32 (i32.const 6))
  (global $ACTION_SENDME i32 (i32.const 7))
  (global $ACTION_HS_INTRO i32 (i32.const 8))
  (global $ACTION_HS_REND i32 (i32.const 9))

  (global $MAX_CIRCUITS i32 (i32.const 64))
  (global $CIRC_SIZE i32 (i32.const 384))
  (global $m23CIRCUITS_BASE i32 (i32.const 65536))
  (global $TMP_CELL i32 (i32.const 32768))
  (global $TMP_BODY i32 (i32.const 33792))

  ;; Circuit layout:
  ;; 0 state, 4 role, 8 circ_id, 12 prev_conn, 16 next_conn,
  ;; 20 package_window, 24 deliver_window, 28 early_count, 32 flags,
  ;; 36 reserved, 40 reserved, 44 in_cells, 48 out_cells, 52 stream_count,
  ;; 64 f_key16, 80 b_key16, 96 f_iv16, 112 b_iv16,
  ;; 128 pending_ip, 132 pending_port, 136 pending_node20, 156 pending_hs84,
  ;; 240 last_action, 244 last_cmd, 248 last_stream, 252 last_len,
  ;; 256 forward_digest20, 288 backward_digest20.

  (func $m23u16be (param $p i32) (result i32)
    (i32.or
      (i32.shl (i32.load8_u (local.get $p)) (i32.const 8))
      (i32.load8_u (i32.add (local.get $p) (i32.const 1)))))

  (func $m23put_u16be (param $p i32) (param $v i32)
    (i32.store8 (local.get $p) (i32.shr_u (local.get $v) (i32.const 8)))
    (i32.store8 (i32.add (local.get $p) (i32.const 1)) (local.get $v)))

  (func $put_u32be (param $p i32) (param $v i32)
    (i32.store8 (local.get $p) (i32.shr_u (local.get $v) (i32.const 24)))
    (i32.store8 (i32.add (local.get $p) (i32.const 1)) (i32.shr_u (local.get $v) (i32.const 16)))
    (i32.store8 (i32.add (local.get $p) (i32.const 2)) (i32.shr_u (local.get $v) (i32.const 8)))
    (i32.store8 (i32.add (local.get $p) (i32.const 3)) (local.get $v)))

  (func $circ_ptr (param $circ_id i32) (result i32)
    (local $idx i32)
    (if (i32.eqz (local.get $circ_id)) (then (return (i32.const 0))))
    (local.set $idx (i32.rem_u (local.get $circ_id) (global.get $MAX_CIRCUITS)))
    (i32.add (global.get $m23CIRCUITS_BASE) (i32.mul (local.get $idx) (global.get $CIRC_SIZE))))

  (func $is_relay_role (param $role i32) (result i32)
    (i32.or
      (i32.or
        (i32.or (i32.eq (local.get $role) (global.get $ROLE_GUARD)) (i32.eq (local.get $role) (global.get $ROLE_MIDDLE)))
        (i32.or (i32.eq (local.get $role) (global.get $ROLE_EXIT)) (i32.eq (local.get $role) (global.get $ROLE_DIRECTORY))))
      (i32.or (i32.eq (local.get $role) (global.get $ROLE_HS_INTRO)) (i32.eq (local.get $role) (global.get $ROLE_HS_RENDEZVOUS)))))

  (func $record_action (param $cp i32) (param $action i32) (param $cmd i32) (param $stream i32) (param $len i32) (result i32)
    (i32.store offset=240 (local.get $cp) (local.get $action))
    (i32.store offset=244 (local.get $cp) (local.get $cmd))
    (i32.store offset=248 (local.get $cp) (local.get $stream))
    (i32.store offset=252 (local.get $cp) (local.get $len))
    (local.get $action))

  (func $relay_payload_len (param $payload i32) (result i32)
    (call $m23u16be (i32.add (local.get $payload) (i32.const 9))))

  (func $relay_stream_id (param $payload i32) (result i32)
    (call $m23u16be (i32.add (local.get $payload) (i32.const 3))))

  (func $m23build_fixed_cell (param $out i32) (param $circ_id i32) (param $cmd i32)
    (memory.fill (local.get $out) (i32.const 0) (global.get $CELL_LEN))
    (i32.store (local.get $out) (local.get $circ_id))
    (i32.store8 offset=4 (local.get $out) (local.get $cmd)))

  (func $m23build_relay_cell
    (param $out i32) (param $circ_id i32) (param $cell_cmd i32) (param $relay_cmd i32)
    (param $stream_id i32) (param $data i32) (param $data_len i32) (result i32)
    (local $payload i32)
    (if (i32.gt_u (local.get $data_len) (global.get $RELAY_DATA_MAX)) (then (return (global.get $ERR_PROTOCOL))))
    (call $m23build_fixed_cell (local.get $out) (local.get $circ_id) (local.get $cell_cmd))
    (local.set $payload (i32.add (local.get $out) (global.get $CELL_PAYLOAD)))
    (i32.store8 (local.get $payload) (local.get $relay_cmd))
    (call $m23put_u16be (i32.add (local.get $payload) (i32.const 1)) (i32.const 0))
    (call $m23put_u16be (i32.add (local.get $payload) (i32.const 3)) (local.get $stream_id))
    (i32.store offset=5 (local.get $payload) (i32.const 0))
    (call $m23put_u16be (i32.add (local.get $payload) (i32.const 9)) (local.get $data_len))
    (if (local.get $data_len)
      (then (memory.copy (i32.add (local.get $payload) (global.get $RELAY_HEADER_LEN)) (local.get $data) (local.get $data_len))))
    (global.get $m23OK))

  (func $apply_digest (param $cp i32) (param $payload i32) (param $direction i32) (result i32)
    (local $slot i32)
    (local $rc i32)
    (local.set $slot (select (i32.add (local.get $cp) (i32.const 288)) (i32.add (local.get $cp) (i32.const 256)) (local.get $direction)))
    (i32.store offset=5 (local.get $payload) (i32.const 0))
    (local.set $rc
      (call $host_relay_digest_update20_sha1
        (local.get $slot)
        (local.get $payload)
        (global.get $CELL_PAYLOAD_LEN)
        (global.get $TMP_BODY)))
    (if (local.get $rc) (then (return (global.get $ERR_CRYPTO))))
    (i32.store offset=5 (local.get $payload) (i32.load (global.get $TMP_BODY)))
    (memory.copy (local.get $slot) (global.get $TMP_BODY) (i32.const 20))
    (global.get $m23OK))

  (func $crypt_payload (param $cp i32) (param $payload i32) (param $direction i32) (result i32)
    (local $key i32)
    (local $iv i32)
    (local.set $key (select (i32.add (local.get $cp) (i32.const 80)) (i32.add (local.get $cp) (i32.const 64)) (local.get $direction)))
    (local.set $iv (select (i32.add (local.get $cp) (i32.const 112)) (i32.add (local.get $cp) (i32.const 96)) (local.get $direction)))
    (call $host_aes_ctr_crypt (local.get $key) (local.get $iv) (local.get $payload) (global.get $CELL_PAYLOAD_LEN) (local.get $payload)))

  (func $recognized (param $payload i32) (result i32)
    (i32.and
      (i32.eqz (call $m23u16be (i32.add (local.get $payload) (i32.const 1))))
      (i32.le_u (call $relay_payload_len (local.get $payload)) (global.get $RELAY_DATA_MAX))))

  (func $parse_extend2 (param $body i32) (param $body_len i32) (param $out i32) (result i32)
    (local $n i32) (local $pos i32) (local $end i32) (local $kind i32) (local $len i32) (local $hs_type i32) (local $hs_len i32)
    (if (i32.lt_u (local.get $body_len) (i32.const 5)) (then (return (global.get $ERR_PROTOCOL))))
    (local.set $n (i32.load8_u (local.get $body)))
    (local.set $pos (i32.add (local.get $body) (i32.const 1)))
    (local.set $end (i32.add (local.get $body) (local.get $body_len)))
    (memory.fill (local.get $out) (i32.const 0) (i32.const 32))
    (block $links_done
      (loop $links
        (if (i32.eqz (local.get $n)) (then (br $links_done)))
        (if (i32.gt_u (i32.add (local.get $pos) (i32.const 2)) (local.get $end)) (then (return (global.get $ERR_PROTOCOL))))
        (local.set $kind (i32.load8_u (local.get $pos)))
        (local.set $len (i32.load8_u (i32.add (local.get $pos) (i32.const 1))))
        (local.set $pos (i32.add (local.get $pos) (i32.const 2)))
        (if (i32.gt_u (i32.add (local.get $pos) (local.get $len)) (local.get $end)) (then (return (global.get $ERR_PROTOCOL))))
        (if (i32.and (i32.eqz (local.get $kind)) (i32.eq (local.get $len) (i32.const 6)))
          (then
            (i32.store (local.get $out) (i32.load (local.get $pos)))
            (i32.store offset=4 (local.get $out) (call $m23u16be (i32.add (local.get $pos) (i32.const 4))))))
        (if (i32.and (i32.eq (local.get $kind) (i32.const 2)) (i32.eq (local.get $len) (i32.const 20)))
          (then
            (i32.store offset=8 (local.get $out) (local.get $pos))
            (i32.store offset=12 (local.get $out) (i32.const 20))))
        (local.set $pos (i32.add (local.get $pos) (local.get $len)))
        (local.set $n (i32.sub (local.get $n) (i32.const 1)))
        (br $links)))
    (if (i32.gt_u (i32.add (local.get $pos) (i32.const 4)) (local.get $end)) (then (return (global.get $ERR_PROTOCOL))))
    (local.set $hs_type (call $m23u16be (local.get $pos)))
    (local.set $hs_len (call $m23u16be (i32.add (local.get $pos) (i32.const 2))))
    (if (i32.ne (local.get $hs_type) (i32.const 2)) (then (return (global.get $m23ERR_UNSUPPORTED))))
    (if (i32.ne (local.get $hs_len) (global.get $NTOR_CLIENT_HANDSHAKE_LEN)) (then (return (global.get $ERR_PROTOCOL))))
    (if (i32.gt_u (i32.add (i32.add (local.get $pos) (i32.const 4)) (local.get $hs_len)) (local.get $end)) (then (return (global.get $ERR_PROTOCOL))))
    (i32.store offset=16 (local.get $out) (i32.add (local.get $pos) (i32.const 4)))
    (i32.store offset=20 (local.get $out) (local.get $hs_len))
    (global.get $m23OK))

  (func (export "proto_standard_id") (result i32) (global.get $m23STANDARD_ID))
  (func (export "proto_abi_version") (result i32) (global.get $m23ABI_VERSION))
  (func (export "simd_capabilities") (result i32) (i32.const 1))
  (func (export "tor_relay_full_cell_len") (result i32) (global.get $CELL_LEN))
  (func (export "tor_relay_full_data_max") (result i32) (global.get $RELAY_DATA_MAX))
  (func (export "tor_relay_full_circuit_size") (result i32) (global.get $CIRC_SIZE))
  (func (export "tor_relay_full_circuits_base") (result i32) (global.get $m23CIRCUITS_BASE))

  (func $er_tor_relay_init (export "er_tor_relay_init") (result i32)
    (memory.fill (global.get $m23CIRCUITS_BASE) (i32.const 0) (i32.mul (global.get $MAX_CIRCUITS) (global.get $CIRC_SIZE)))
    (global.get $m23OK))

  (func $er_tor_relay_alloc_circuit (export "er_tor_relay_alloc_circuit")
    (param $circ_id i32) (param $prev_conn i32) (param $next_conn i32) (param $role i32) (result i32)
    (local $cp i32)
    (if (i32.eqz (call $is_relay_role (local.get $role))) (then (return (global.get $m23ERR_INVALID))))
    (local.set $cp (call $circ_ptr (local.get $circ_id)))
    (if (i32.eqz (local.get $cp)) (then (return (global.get $m23ERR_INVALID))))
    (memory.fill (local.get $cp) (i32.const 0) (global.get $CIRC_SIZE))
    (i32.store offset=0 (local.get $cp) (global.get $CIRC_OPEN))
    (i32.store offset=4 (local.get $cp) (local.get $role))
    (i32.store offset=8 (local.get $cp) (local.get $circ_id))
    (i32.store offset=12 (local.get $cp) (local.get $prev_conn))
    (i32.store offset=16 (local.get $cp) (local.get $next_conn))
    (i32.store offset=20 (local.get $cp) (global.get $DEFAULT_WINDOW))
    (i32.store offset=24 (local.get $cp) (global.get $DEFAULT_WINDOW))
    (i32.store offset=28 (local.get $cp) (i32.const 8))
    (global.get $m23OK))

  (func $er_tor_relay_set_keys (export "er_tor_relay_set_keys")
    (param $circ_id i32) (param $f_key16 i32) (param $b_key16 i32) (param $f_iv16 i32) (param $b_iv16 i32) (result i32)
    (local $cp i32)
    (local.set $cp (call $circ_ptr (local.get $circ_id)))
    (if (i32.eqz (local.get $cp)) (then (return (global.get $m23ERR_INVALID))))
    (memory.copy (i32.add (local.get $cp) (i32.const 64)) (local.get $f_key16) (i32.const 16))
    (memory.copy (i32.add (local.get $cp) (i32.const 80)) (local.get $b_key16) (i32.const 16))
    (memory.copy (i32.add (local.get $cp) (i32.const 96)) (local.get $f_iv16) (i32.const 16))
    (memory.copy (i32.add (local.get $cp) (i32.const 112)) (local.get $b_iv16) (i32.const 16))
    (global.get $m23OK))

  (func $er_tor_relay_get_state (export "er_tor_relay_get_state") (param $circ_id i32) (result i32)
    (local $cp i32)
    (local.set $cp (call $circ_ptr (local.get $circ_id)))
    (if (i32.eqz (local.get $cp)) (then (return (global.get $m23ERR_INVALID))))
    (i32.load offset=0 (local.get $cp)))

  (func $er_tor_relay_get_last_action (export "er_tor_relay_get_last_action") (param $circ_id i32) (result i32)
    (local $cp i32)
    (local.set $cp (call $circ_ptr (local.get $circ_id)))
    (if (i32.eqz (local.get $cp)) (then (return (global.get $m23ERR_INVALID))))
    (i32.load offset=240 (local.get $cp)))

  (func $er_tor_relay_build_created2 (export "er_tor_relay_build_created2")
    (param $out_cell i32) (param $circ_id i32) (param $reply64 i32) (result i32)
    (if (i32.eqz (local.get $reply64)) (then (return (global.get $m23ERR_INVALID))))
    (call $m23build_fixed_cell (local.get $out_cell) (local.get $circ_id) (global.get $CELL_CREATED2))
    (call $m23put_u16be (i32.add (local.get $out_cell) (global.get $CELL_PAYLOAD)) (i32.const 2))
    (call $m23put_u16be (i32.add (i32.add (local.get $out_cell) (global.get $CELL_PAYLOAD)) (i32.const 2)) (global.get $NTOR_SERVER_REPLY_LEN))
    (memory.copy (i32.add (i32.add (local.get $out_cell) (global.get $CELL_PAYLOAD)) (i32.const 4)) (local.get $reply64) (global.get $NTOR_SERVER_REPLY_LEN))
    (global.get $m23OK))

  (func $er_tor_relay_build_created2_len (export "er_tor_relay_build_created2_len")
    (param $out_cell i32) (param $circ_id i32) (param $handshake_type i32) (param $reply i32) (param $reply_len i32) (result i32)
    (if (i32.eqz (local.get $reply)) (then (return (global.get $m23ERR_INVALID))))
    (if (i32.gt_u (local.get $reply_len) (i32.const 505)) (then (return (global.get $ERR_PROTOCOL))))
    (call $m23build_fixed_cell (local.get $out_cell) (local.get $circ_id) (global.get $CELL_CREATED2))
    (call $m23put_u16be (i32.add (local.get $out_cell) (global.get $CELL_PAYLOAD)) (local.get $handshake_type))
    (call $m23put_u16be (i32.add (i32.add (local.get $out_cell) (global.get $CELL_PAYLOAD)) (i32.const 2)) (local.get $reply_len))
    (memory.copy (i32.add (i32.add (local.get $out_cell) (global.get $CELL_PAYLOAD)) (i32.const 4)) (local.get $reply) (local.get $reply_len))
    (global.get $m23OK))

  (func $er_tor_relay_handle_create2 (export "er_tor_relay_handle_create2")
    (param $in_cell i32) (param $len i32) (param $node_id20 i32) (param $onion_pub32 i32) (param $onion_secret32 i32) (param $y_secret32 i32) (param $out_cell i32) (result i32)
    (local $circ_id i32) (local $hs_len i32) (local $rc i32)
    (if (i32.lt_u (local.get $len) (global.get $CELL_LEN)) (then (return (global.get $ERR_PROTOCOL))))
    (if (i32.ne (i32.load8_u offset=4 (local.get $in_cell)) (global.get $CELL_CREATE2)) (then (return (global.get $ERR_PROTOCOL))))
    (if (i32.ne (call $m23u16be (i32.add (local.get $in_cell) (global.get $CELL_PAYLOAD))) (i32.const 2)) (then (return (global.get $m23ERR_UNSUPPORTED))))
    (local.set $hs_len (call $m23u16be (i32.add (i32.add (local.get $in_cell) (global.get $CELL_PAYLOAD)) (i32.const 2))))
    (if (i32.ne (local.get $hs_len) (global.get $NTOR_CLIENT_HANDSHAKE_LEN)) (then (return (global.get $ERR_PROTOCOL))))
    (local.set $circ_id (i32.load (local.get $in_cell)))
    (local.set $rc
      (call $host_ntor_server_handshake_seeded
        (i32.add (i32.add (local.get $in_cell) (global.get $CELL_PAYLOAD)) (i32.const 4))
        (local.get $node_id20)
        (local.get $onion_pub32)
        (local.get $onion_secret32)
        (local.get $y_secret32)
        (global.get $TMP_BODY)
        (i32.add (global.get $TMP_BODY) (global.get $NTOR_SERVER_REPLY_LEN))))
    (if (local.get $rc) (then (return (global.get $ERR_CRYPTO))))
    (drop (call $er_tor_relay_alloc_circuit (local.get $circ_id) (i32.const 0) (i32.const 0) (global.get $ROLE_MIDDLE)))
    (call $er_tor_relay_build_created2 (local.get $out_cell) (local.get $circ_id) (global.get $TMP_BODY)))

  (func $er_tor_relay_handle_create2_v3 (export "er_tor_relay_handle_create2_v3")
    (param $in_cell i32) (param $len i32) (param $node_id32 i32) (param $onion_pub32 i32) (param $onion_secret32 i32) (param $y_secret32 i32) (param $server_msg i32) (param $server_msg_len i32) (param $out_cell i32) (result i32)
    (local $circ_id i32) (local $hs_len i32) (local $rc i32) (local $reply_len i32)
    (if (i32.lt_u (local.get $len) (global.get $CELL_LEN)) (then (return (global.get $ERR_PROTOCOL))))
    (if (i32.ne (i32.load8_u offset=4 (local.get $in_cell)) (global.get $CELL_CREATE2)) (then (return (global.get $ERR_PROTOCOL))))
    (if (i32.ne (call $m23u16be (i32.add (local.get $in_cell) (global.get $CELL_PAYLOAD))) (i32.const 3)) (then (return (global.get $m23ERR_UNSUPPORTED))))
