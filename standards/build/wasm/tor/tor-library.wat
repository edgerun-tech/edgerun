(module
  (import "edgerun-core" "memory" (memory 1))
  ;; Memory layout for module-owned Tor state.
  (global $TOR_STATE i32 (i32.const 0))
  (global $TOR_GUARD_FINGERPRINT i32 (i32.const 64))
  (global $TOR_GUARD_ONION_KEY i32 (i32.const 96))
  (global $TOR_CIRCUITS i32 (i32.const 4096))
  (global $TOR_STREAMS i32 (i32.const 8192))
  (global $TOR_TMP i32 (i32.const 12288))
  (global $HS_APP_CONTACTS i32 (i32.const 32768))
  (global $HS_APP_MESSAGES i32 (i32.const 33856))
  (global $HS_APP_CONTACT_COUNT i32 (i32.const 47296))
  (global $HS_APP_MESSAGE_COUNT i32 (i32.const 47300))

  ;; Tor protocol constants.
  (global $m26TOR_CELL_CREATE2 (export "TOR_CELL_CREATE2") i32 (i32.const 10))
  (global $m26TOR_CELL_RELAY (export "TOR_CELL_RELAY") i32 (i32.const 3))
  (global $m26TOR_CELL_LEN (export "TOR_CELL_LEN") i32 (i32.const 514))
  (global $m26TOR_CELL_PAYLOAD_LEN (export "TOR_CELL_PAYLOAD_LEN") i32 (i32.const 509))
  (global $m26TOR_CELL_CIRC_ID (export "TOR_CELL_CIRC_ID") i32 (i32.const 0))
  (global $m26TOR_CELL_CMD (export "TOR_CELL_CMD") i32 (i32.const 4))
  (global $m26TOR_CELL_PAYLOAD (export "TOR_CELL_PAYLOAD") i32 (i32.const 5))
  (global $m26TOR_RELAY_BEGIN (export "TOR_RELAY_BEGIN") i32 (i32.const 1))
  (global $m26TOR_RELAY_DATA (export "TOR_RELAY_DATA") i32 (i32.const 2))
  (global $m26TOR_RELAY_CMD (export "TOR_RELAY_CMD") i32 (i32.const 0))
  (global $m26TOR_RELAY_RECOGNIZED (export "TOR_RELAY_RECOGNIZED") i32 (i32.const 1))
  (global $m26TOR_RELAY_STREAM_ID (export "TOR_RELAY_STREAM_ID") i32 (i32.const 3))
  (global $m26TOR_RELAY_DIGEST (export "TOR_RELAY_DIGEST") i32 (i32.const 5))
  (global $m26TOR_RELAY_LEN (export "TOR_RELAY_LEN") i32 (i32.const 9))
  (global $m26TOR_RELAY_DATA_OFFSET (export "TOR_RELAY_DATA_OFFSET") i32 (i32.const 11))

  ;; Roles and capabilities.
  (global $TOR_ROLE_CLIENT (export "TOR_ROLE_CLIENT") i32 (i32.const 0))
  (global $TOR_ROLE_GUARD (export "TOR_ROLE_GUARD") i32 (i32.const 1))
  (global $TOR_ROLE_MIDDLE (export "TOR_ROLE_MIDDLE") i32 (i32.const 2))
  (global $TOR_ROLE_EXIT (export "TOR_ROLE_EXIT") i32 (i32.const 3))
  (global $TOR_ROLE_DIRECTORY (export "TOR_ROLE_DIRECTORY") i32 (i32.const 4))
  (global $TOR_ROLE_BRIDGE (export "TOR_ROLE_BRIDGE") i32 (i32.const 5))
  (global $TOR_ROLE_HS_SERVICE (export "TOR_ROLE_HS_SERVICE") i32 (i32.const 6))
  (global $TOR_ROLE_HS_INTRO (export "TOR_ROLE_HS_INTRO") i32 (i32.const 7))
  (global $TOR_ROLE_HS_RENDEZVOUS (export "TOR_ROLE_HS_RENDEZVOUS") i32 (i32.const 8))
  (global $TOR_ROLE_HS_PEER (export "TOR_ROLE_HS_PEER") i32 (i32.const 9))
  (global $TOR_ROLE_HS_FULL (export "TOR_ROLE_HS_FULL") i32 (i32.const 10))
  (global $TOR_CAP_CLIENT (export "TOR_CAP_CLIENT") i32 (i32.const 1))
  (global $TOR_CAP_OR_RELAY (export "TOR_CAP_OR_RELAY") i32 (i32.const 2))
  (global $TOR_CAP_EXIT (export "TOR_CAP_EXIT") i32 (i32.const 4))
  (global $TOR_CAP_DIRECTORY (export "TOR_CAP_DIRECTORY") i32 (i32.const 8))
  (global $TOR_CAP_BRIDGE (export "TOR_CAP_BRIDGE") i32 (i32.const 16))
  (global $TOR_CAP_HS_SERVICE (export "TOR_CAP_HS_SERVICE") i32 (i32.const 32))
  (global $TOR_CAP_HS_INTRO (export "TOR_CAP_HS_INTRO") i32 (i32.const 64))
  (global $TOR_CAP_HS_RENDEZVOUS (export "TOR_CAP_HS_RENDEZVOUS") i32 (i32.const 128))
  (global $TOR_CAP_KNOWN_MASK i32 (i32.const 255))
  (global $m26TOR_HS_RELAY_DATA_MAX (export "TOR_HS_RELAY_DATA_MAX") i32 (i32.const 498))
  (global $ER_HS_APP_MAGIC i32 (i32.const 1397248581))
  (global $ER_HS_CONTACT_MAX i32 (i32.const 16))
  (global $ER_HS_CONTACT_SIZE i32 (i32.const 68))
  (global $ER_HS_CONTACT_NLEN i32 (i32.const 32))
  (global $ER_HS_CONTACT_ID i32 (i32.const 36))
  (global $ER_HS_INBOX_MAX i32 (i32.const 32))
  (global $ER_HS_MSG_SIZE i32 (i32.const 420))
  (global $ER_HS_MSG_BODY i32 (i32.const 32))
  (global $ER_HS_MSG_BLEN i32 (i32.const 416))

  ;; Stored state offsets.
  (global $STATE_LINK_ESTABLISHED i32 (i32.const 0))
  (global $STATE_LINK_VERSION i32 (i32.const 4))
  (global $STATE_GUARD_IP i32 (i32.const 8))
  (global $STATE_GUARD_PORT i32 (i32.const 12))
  (global $STATE_N_CIRCUITS i32 (i32.const 34))
  (global $STATE_ROLE i32 (i32.const 38))
  (global $STATE_ROLE_CAPS i32 (i32.const 42))

  (func $m26memcpy (param $dst i32) (param $src i32) (param $len i32) (result i32)
    (local $i i32)
    (local.set $i (i32.const 0))
    (block $done
      (loop $copy
        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
        (i32.store8
          (i32.add (local.get $dst) (local.get $i))
          (i32.load8_u (i32.add (local.get $src) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)))
    (local.get $dst))

  (func $m26memset (param $dst i32) (param $value i32) (param $len i32) (result i32)
    (local $i i32)
    (local.set $i (i32.const 0))
    (block $done
      (loop $fill
        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
        (i32.store8 (i32.add (local.get $dst) (local.get $i)) (local.get $value))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
    (local.get $dst))

  (func $store_u16_be (param $ptr i32) (param $value i32)
    (i32.store8 (local.get $ptr) (i32.shr_u (local.get $value) (i32.const 8)))
    (i32.store8 (i32.add (local.get $ptr) (i32.const 1)) (local.get $value)))

  (func $load_u16_be (param $ptr i32) (result i32)
    (i32.or
      (i32.shl (i32.load8_u (local.get $ptr)) (i32.const 8))
      (i32.load8_u (i32.add (local.get $ptr) (i32.const 1)))))

  (func $store_u32_be (param $ptr i32) (param $value i32)
    (i32.store8 (local.get $ptr) (i32.shr_u (local.get $value) (i32.const 24)))
    (i32.store8 (i32.add (local.get $ptr) (i32.const 1)) (i32.shr_u (local.get $value) (i32.const 16)))
    (i32.store8 (i32.add (local.get $ptr) (i32.const 2)) (i32.shr_u (local.get $value) (i32.const 8)))
    (i32.store8 (i32.add (local.get $ptr) (i32.const 3)) (local.get $value)))

  (func $caps_from_role (param $role i32) (result i32)
    (block $invalid
      (block $full
        (block $peer
          (block $rend
            (block $intro
              (block $service
                (block $bridge
                  (block $dir
                    (block $exit
                      (block $relay
                        (block $client
                          (br_table $client $relay $relay $exit $dir $bridge $service $intro $rend $peer $full $invalid
                            (local.get $role)))
                        (return (i32.const 1)))
                      (return (i32.const 2)))
                    (return (i32.const 6)))
                  (return (i32.const 8)))
                (return (i32.const 18)))
              (return (i32.const 32)))
            (return (i32.const 64)))
          (return (i32.const 128)))
        (return (i32.const 33)))
      (return (i32.const 227)))
    (i32.const -1))

  (func $state_ptr (param $off i32) (result i32)
    (i32.add (global.get $TOR_STATE) (local.get $off)))

  (func (export "er_memcpy") (param $dst i32) (param $src i32) (param $len i32) (result i32)
    (call $m26memcpy (local.get $dst) (local.get $src) (local.get $len)))

  (func (export "er_memset") (param $dst i32) (param $value i32) (param $len i32) (result i32)
    (call $m26memset (local.get $dst) (local.get $value) (local.get $len)))

  (func (export "er_tor_get_role") (result i32)
    (i32.load (call $state_ptr (global.get $STATE_ROLE))))

  (func (export "er_tor_get_role_caps") (result i32)
    (i32.load (call $state_ptr (global.get $STATE_ROLE_CAPS))))

  (func (export "er_tor_set_role") (param $role i32) (result i32)
    (local $caps i32)
    (local.set $caps (call $caps_from_role (local.get $role)))
    (if (i32.lt_s (local.get $caps) (i32.const 0))
      (then (return (i32.const -1))))
    (i32.store (call $state_ptr (global.get $STATE_ROLE)) (local.get $role))
    (i32.store (call $state_ptr (global.get $STATE_ROLE_CAPS)) (local.get $caps))
    (i32.const 0))

  (func (export "er_tor_set_role_caps") (param $caps i32) (result i32)
    (if (i32.ne
          (i32.and (local.get $caps) (i32.xor (global.get $TOR_CAP_KNOWN_MASK) (i32.const -1)))
          (i32.const 0))
      (then (return (i32.const -1))))
    (i32.store (call $state_ptr (global.get $STATE_ROLE)) (i32.const -1))
    (i32.store (call $state_ptr (global.get $STATE_ROLE_CAPS)) (local.get $caps))
    (i32.const 0))

  (func (export "er_tor_enable_role") (param $role i32) (result i32)
    (local $caps i32)
    (local.set $caps (call $caps_from_role (local.get $role)))
    (if (i32.lt_s (local.get $caps) (i32.const 0))
      (then (return (i32.const -1))))
    (i32.store
      (call $state_ptr (global.get $STATE_ROLE_CAPS))
      (i32.or (i32.load (call $state_ptr (global.get $STATE_ROLE_CAPS))) (local.get $caps)))
    (i32.const 0))

  (func (export "er_tor_set_guard_material")
    (param $ip i32) (param $port i32) (param $fingerprint i32) (param $onion_key i32) (result i32)
    (if (i32.or (i32.eqz (local.get $fingerprint)) (i32.eqz (local.get $onion_key)))
      (then (return (i32.const -1))))
    (i32.store (call $state_ptr (global.get $STATE_GUARD_IP)) (local.get $ip))
    (i32.store16 (call $state_ptr (global.get $STATE_GUARD_PORT)) (local.get $port))
    (call $m26memcpy (global.get $TOR_GUARD_FINGERPRINT) (local.get $fingerprint) (i32.const 20))
    (drop)
    (call $m26memcpy (global.get $TOR_GUARD_ONION_KEY) (local.get $onion_key) (i32.const 32))
    (drop)
    (i32.const 0))

  (func (export "er_tor_cell_get_circ_id") (param $cell i32) (result i32)
    (i32.load (i32.add (local.get $cell) (global.get $m26TOR_CELL_CIRC_ID))))

  (func (export "er_tor_cell_set_circ_id") (param $cell i32) (param $circ_id i32)
    (i32.store (i32.add (local.get $cell) (global.get $m26TOR_CELL_CIRC_ID)) (local.get $circ_id)))

  (func (export "er_tor_cell_get_cmd") (param $cell i32) (result i32)
    (i32.load8_u (i32.add (local.get $cell) (global.get $m26TOR_CELL_CMD))))

  (func (export "er_tor_cell_set_cmd") (param $cell i32) (param $cmd i32)
    (i32.store8 (i32.add (local.get $cell) (global.get $m26TOR_CELL_CMD)) (local.get $cmd)))

  (func (export "er_tor_build_extend2_body")
    (param $out i32) (param $ip_be i32) (param $port i32) (param $node_id i32) (param $handshake i32) (result i32)
    ;; EXTEND2: 2 linkspecs: IPv4(0,6,addr,port), legacy identity(2,20,node_id),
    ;; then handshake type 2 and 84-byte client handshake.
    (i32.store8 (local.get $out) (i32.const 2))
    (i32.store8 (i32.add (local.get $out) (i32.const 1)) (i32.const 0))
    (i32.store8 (i32.add (local.get $out) (i32.const 2)) (i32.const 6))
    (i32.store (i32.add (local.get $out) (i32.const 3)) (local.get $ip_be))
    (call $store_u16_be (i32.add (local.get $out) (i32.const 7)) (local.get $port))
    (i32.store8 (i32.add (local.get $out) (i32.const 9)) (i32.const 2))
    (i32.store8 (i32.add (local.get $out) (i32.const 10)) (i32.const 20))
    (call $m26memcpy (i32.add (local.get $out) (i32.const 11)) (local.get $node_id) (i32.const 20))
    (drop)
    (call $store_u16_be (i32.add (local.get $out) (i32.const 31)) (i32.const 2))
    (call $store_u16_be (i32.add (local.get $out) (i32.const 33)) (i32.const 84))
    (call $m26memcpy (i32.add (local.get $out) (i32.const 35)) (local.get $handshake) (i32.const 84))
    (drop)
    (i32.const 119))

  (func (export "er_tor_build_relay_begin_ipv4")
    (param $cell i32) (param $circ_id i32) (param $stream_id i32)
    (param $a i32) (param $b i32) (param $c i32) (param $d i32) (param $port i32) (result i32)
    (local $p i32)
    (call $m26memset (local.get $cell) (i32.const 0) (global.get $m26TOR_CELL_LEN))
    (drop)
    (i32.store (i32.add (local.get $cell) (global.get $m26TOR_CELL_CIRC_ID)) (local.get $circ_id))
    (i32.store8 (i32.add (local.get $cell) (global.get $m26TOR_CELL_CMD)) (global.get $m26TOR_CELL_RELAY))
    (local.set $p (i32.add (local.get $cell) (global.get $m26TOR_CELL_PAYLOAD)))
    (i32.store8 (i32.add (local.get $p) (global.get $m26TOR_RELAY_CMD)) (global.get $m26TOR_RELAY_BEGIN))
    (call $store_u16_be (i32.add (local.get $p) (global.get $m26TOR_RELAY_STREAM_ID)) (local.get $stream_id))
    (call $store_u16_be (i32.add (local.get $p) (global.get $m26TOR_RELAY_LEN)) (i32.const 0))
    (local.set $p (i32.add (local.get $p) (global.get $m26TOR_RELAY_DATA_OFFSET)))
    (local.set $p (call $append_dec_u8 (local.get $p) (local.get $a)))
    (i32.store8 (local.get $p) (i32.const 46))
    (local.set $p (i32.add (local.get $p) (i32.const 1)))
    (local.set $p (call $append_dec_u8 (local.get $p) (local.get $b)))
    (i32.store8 (local.get $p) (i32.const 46))
    (local.set $p (i32.add (local.get $p) (i32.const 1)))
    (local.set $p (call $append_dec_u8 (local.get $p) (local.get $c)))
    (i32.store8 (local.get $p) (i32.const 46))
    (local.set $p (i32.add (local.get $p) (i32.const 1)))
    (local.set $p (call $append_dec_u8 (local.get $p) (local.get $d)))
    (i32.store8 (local.get $p) (i32.const 58))
    (local.set $p (i32.add (local.get $p) (i32.const 1)))
    (local.set $p (call $append_dec_u16 (local.get $p) (local.get $port)))
    (i32.store8 (local.get $p) (i32.const 0))
    (local.set $p (i32.add (local.get $p) (i32.const 1)))
    (call $store_u16_be
      (i32.add (i32.add (local.get $cell) (global.get $m26TOR_CELL_PAYLOAD)) (global.get $m26TOR_RELAY_LEN))
      (i32.sub (local.get $p) (i32.add (i32.add (local.get $cell) (global.get $m26TOR_CELL_PAYLOAD)) (global.get $m26TOR_RELAY_DATA_OFFSET))))
    (i32.const 0))

  (func $append_dec_u8 (param $ptr i32) (param $value i32) (result i32)
    (call $append_dec_u16 (local.get $ptr) (i32.and (local.get $value) (i32.const 255))))

  (func $append_dec_u16 (param $ptr i32) (param $value i32) (result i32)
    (local $started i32)
    (local $digit i32)
    (local.set $digit (i32.div_u (local.get $value) (i32.const 10000)))
    (if (local.get $digit)
      (then
        (i32.store8 (local.get $ptr) (i32.add (local.get $digit) (i32.const 48)))
        (local.set $ptr (i32.add (local.get $ptr) (i32.const 1)))
        (local.set $started (i32.const 1))))
    (local.set $value (i32.rem_u (local.get $value) (i32.const 10000)))
    (local.set $digit (i32.div_u (local.get $value) (i32.const 1000)))
    (if (i32.or (local.get $started) (local.get $digit))
      (then
        (i32.store8 (local.get $ptr) (i32.add (local.get $digit) (i32.const 48)))
        (local.set $ptr (i32.add (local.get $ptr) (i32.const 1)))
        (local.set $started (i32.const 1))))
    (local.set $value (i32.rem_u (local.get $value) (i32.const 1000)))
    (local.set $digit (i32.div_u (local.get $value) (i32.const 100)))
    (if (i32.or (local.get $started) (local.get $digit))
      (then
        (i32.store8 (local.get $ptr) (i32.add (local.get $digit) (i32.const 48)))
        (local.set $ptr (i32.add (local.get $ptr) (i32.const 1)))
        (local.set $started (i32.const 1))))
    (local.set $value (i32.rem_u (local.get $value) (i32.const 100)))
    (local.set $digit (i32.div_u (local.get $value) (i32.const 10)))
    (if (i32.or (local.get $started) (local.get $digit))
      (then
        (i32.store8 (local.get $ptr) (i32.add (local.get $digit) (i32.const 48)))
        (local.set $ptr (i32.add (local.get $ptr) (i32.const 1)))))
    (i32.store8 (local.get $ptr) (i32.add (i32.rem_u (local.get $value) (i32.const 10)) (i32.const 48)))
    (i32.add (local.get $ptr) (i32.const 1)))

  (func $append_bytes (param $dst i32) (param $src i32) (param $len i32) (result i32)
    (call $m26memcpy (local.get $dst) (local.get $src) (local.get $len))
    (drop)
    (i32.add (local.get $dst) (local.get $len)))

  (func (export "er_tor_hsdir_build_fetch_request") (param $out i32) (param $onion_ptr i32) (param $onion_len i32) (result i32)
    (local $p i32)
    (local.set $p (local.get $out))
    (local.set $p (call $append_literal (local.get $p) (i32.const 0)))
    (local.set $p (call $append_bytes (local.get $p) (local.get $onion_ptr) (local.get $onion_len)))
    (local.set $p (call $append_literal (local.get $p) (i32.const 1)))
    (i32.sub (local.get $p) (local.get $out)))

  (func (export "er_tor_hsdir_build_publish_header") (param $out i32) (param $content_len i32) (result i32)
    (local $p i32)
    (local.set $p (local.get $out))
    (local.set $p (call $append_literal (local.get $p) (i32.const 2)))
    (local.set $p (call $append_dec_u16 (local.get $p) (local.get $content_len)))
    (local.set $p (call $append_literal (local.get $p) (i32.const 3)))
    (i32.sub (local.get $p) (local.get $out)))

  (func $append_literal (param $dst i32) (param $id i32) (result i32)
    (local $src i32)
    (local $len i32)
    (if (i32.eq (local.get $id) (i32.const 0))
      (then (local.set $src (i32.const 20000)) (local.set $len (i32.const 14))))
    (if (i32.eq (local.get $id) (i32.const 1))
      (then (local.set $src (i32.const 20014)) (local.set $len (i32.const 41))))
    (if (i32.eq (local.get $id) (i32.const 2))
      (then (local.set $src (i32.const 20055)) (local.set $len (i32.const 55))))
    (if (i32.eq (local.get $id) (i32.const 3))
      (then (local.set $src (i32.const 20110)) (local.set $len (i32.const 17))))
    (call $append_bytes (local.get $dst) (local.get $src) (local.get $len)))

  (func $m26b64_char (param $v i32) (result i32)
    (i32.load8_u (i32.add (i32.const 20128) (i32.and (local.get $v) (i32.const 63)))))

  (func $m26b64_value (param $c i32) (result i32)
    (if (i32.and (i32.ge_u (local.get $c) (i32.const 65)) (i32.le_u (local.get $c) (i32.const 90)))
      (then (return (i32.sub (local.get $c) (i32.const 65)))))
    (if (i32.and (i32.ge_u (local.get $c) (i32.const 97)) (i32.le_u (local.get $c) (i32.const 122)))
      (then (return (i32.add (i32.sub (local.get $c) (i32.const 97)) (i32.const 26)))))
    (if (i32.and (i32.ge_u (local.get $c) (i32.const 48)) (i32.le_u (local.get $c) (i32.const 57)))
      (then (return (i32.add (i32.sub (local.get $c) (i32.const 48)) (i32.const 52)))))
    (if (i32.eq (local.get $c) (i32.const 43)) (then (return (i32.const 62))))
    (if (i32.eq (local.get $c) (i32.const 47)) (then (return (i32.const 63))))
    (if (i32.eq (local.get $c) (i32.const 61)) (then (return (i32.const -2))))
    (i32.const -1))

  (func $hs_b64_encode (export "er_tor_hs_b64_encode") (param $out i32) (param $data i32) (param $len i32) (result i32)
    (local $i i32) (local $p i32) (local $b0 i32) (local $b1 i32) (local $b2 i32) (local $rem i32)
    (local.set $p (local.get $out))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
        (local.set $rem (i32.sub (local.get $len) (local.get $i)))
