(module
  (memory (export "memory") 1)

  (global $last_r_len (mut i32) (i32.const 0))
  (global $last_s_len (mut i32) (i32.const 0))

  (func (export "proto_abi_version") (result i32)
    i32.const 2)

  (func (export "proto_standard_id") (result i32)
    i32.const 300082)

  (func (export "ecdsa_der_last_r_len") (result i32)
    global.get $last_r_len)

  (func (export "ecdsa_der_last_s_len") (result i32)
    global.get $last_s_len)

  (func $pack (param $status i32) (param $high i32) (result i64)
    (i64.or
      (i64.extend_i32_u (local.get $status))
      (i64.shl (i64.extend_i32_u (local.get $high)) (i64.const 32))))

  (func $copy (param $src i32) (param $dst i32) (param $len i32)
    (local $i i32)
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
        (i32.store8
          (i32.add (local.get $dst) (local.get $i))
          (i32.load8_u (i32.add (local.get $src) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop))))

  ;; Decode DER definite length. Return low16=status, next16=consumed, high32=value.
  ;; status: 0 ok, 1 too_large/unsupported, 3 invalid.
  (func $len_decode (param $ptr i32) (param $end i32) (result i64)
    (local $first i32)
    (local $llen i32)
    (local $i i32)
    (local $value i32)
    (if (i32.ge_u (local.get $ptr) (local.get $end))
      (then (return (i64.const 3))))
    (local.set $first (i32.load8_u (local.get $ptr)))
    (if (i32.lt_u (local.get $first) (i32.const 128))
      (then
        (return
          (i64.or
            (i64.shl (i64.extend_i32_u (local.get $first)) (i64.const 32))
            (i64.const 65536)))))
    (if (i32.eq (local.get $first) (i32.const 128))
      (then (return (i64.const 3))))
    (local.set $llen (i32.and (local.get $first) (i32.const 127)))
    (if (i32.or (i32.eqz (local.get $llen)) (i32.gt_u (local.get $llen) (i32.const 2)))
      (then (return (i64.const 1))))
    (if (i32.gt_u (i32.add (i32.add (local.get $ptr) (i32.const 1)) (local.get $llen)) (local.get $end))
      (then (return (i64.const 3))))
    (if (i32.eqz (i32.load8_u (i32.add (local.get $ptr) (i32.const 1))))
      (then (return (i64.const 3))))
    (local.set $i (i32.const 0))
    (local.set $value (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $llen)))
        (local.set $value
          (i32.or
            (i32.shl (local.get $value) (i32.const 8))
            (i32.load8_u
              (i32.add
                (i32.add (local.get $ptr) (i32.const 1))
                (local.get $i)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
    (if (i32.lt_u (local.get $value) (i32.const 128))
      (then (return (i64.const 3))))
    (i64.or
      (i64.shl (i64.extend_i32_u (local.get $value)) (i64.const 32))
      (i64.shl
        (i64.extend_i32_u (i32.add (local.get $llen) (i32.const 1)))
        (i64.const 16))))

  (func $len_size (param $value i32) (result i32)
    (if (i32.lt_u (local.get $value) (i32.const 128))
      (then (return (i32.const 1))))
    (if (i32.le_u (local.get $value) (i32.const 255))
      (then (return (i32.const 2))))
    i32.const 3)

  (func $len_emit (param $value i32) (param $out i32) (result i32)
    (if (i32.lt_u (local.get $value) (i32.const 128))
      (then
        (i32.store8 (local.get $out) (local.get $value))
        (return (i32.const 1))))
    (if (i32.le_u (local.get $value) (i32.const 255))
      (then
        (i32.store8 (local.get $out) (i32.const 129))
        (i32.store8 (i32.add (local.get $out) (i32.const 1)) (local.get $value))
        (return (i32.const 2))))
    (i32.store8 (local.get $out) (i32.const 130))
    (i32.store8 (i32.add (local.get $out) (i32.const 1)) (i32.shr_u (local.get $value) (i32.const 8)))
    (i32.store8 (i32.add (local.get $out) (i32.const 2)) (i32.and (local.get $value) (i32.const 255)))
    i32.const 3)

  ;; Parse ECDSA-Sig-Value ::= SEQUENCE { r INTEGER, s INTEGER }.
  ;; Return low32=status, high32=(r_len << 16) | s_len.
  ;; Status: 0 ok, 1 unsupported/too large, 2 output short, 3 invalid DER.
  (func (export "ecdsa_der_parse")
    (param $sig i32) (param $sig_len i32)
    (param $r_out i32) (param $r_cap i32)
    (param $s_out i32) (param $s_cap i32)
    (result i64)
    (local $end i32)
    (local $p i32)
    (local $ld i64)
    (local $st i32)
    (local $seq_len i32)
    (local $seq_len_bytes i32)
    (local $seq_end i32)
    (local $int_len i32)
    (local $first i32)
    (local $second i32)
    (local $payload i32)
    (local $out_len i32)
    (local $r_len i32)
    (local $s_len i32)
    (global.set $last_r_len (i32.const 0))
    (global.set $last_s_len (i32.const 0))
    (if (i32.gt_u (local.get $sig_len) (i32.const 160))
      (then (return (call $pack (i32.const 1) (i32.const 0)))))
    (local.set $end (i32.add (local.get $sig) (local.get $sig_len)))
    (if (i32.lt_u (local.get $sig_len) (i32.const 8))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (if (i32.ne (i32.load8_u (local.get $sig)) (i32.const 48))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (local.set $ld (call $len_decode (i32.add (local.get $sig) (i32.const 1)) (local.get $end)))
    (local.set $st (i32.wrap_i64 (i64.and (local.get $ld) (i64.const 65535))))
    (if (local.get $st)
      (then (return (call $pack (local.get $st) (i32.const 0)))))
    (local.set $seq_len_bytes (i32.wrap_i64 (i64.and (i64.shr_u (local.get $ld) (i64.const 16)) (i64.const 65535))))
    (local.set $seq_len (i32.wrap_i64 (i64.shr_u (local.get $ld) (i64.const 32))))
    (local.set $p (i32.add (i32.add (local.get $sig) (i32.const 1)) (local.get $seq_len_bytes)))
    (if (i32.ne (i32.add (local.get $p) (local.get $seq_len)) (local.get $end))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (local.set $seq_end (local.get $end))

    ;; r INTEGER
    (if (i32.ge_u (local.get $p) (local.get $seq_end))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (if (i32.ne (i32.load8_u (local.get $p)) (i32.const 2))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (local.set $p (i32.add (local.get $p) (i32.const 1)))
    (local.set $ld (call $len_decode (local.get $p) (local.get $seq_end)))
    (local.set $st (i32.wrap_i64 (i64.and (local.get $ld) (i64.const 65535))))
    (if (local.get $st)
      (then (return (call $pack (local.get $st) (i32.const 0)))))
    (local.set $p (i32.add (local.get $p) (i32.wrap_i64 (i64.and (i64.shr_u (local.get $ld) (i64.const 16)) (i64.const 65535)))))
    (local.set $int_len (i32.wrap_i64 (i64.shr_u (local.get $ld) (i64.const 32))))
    (if (i32.or (i32.eqz (local.get $int_len)) (i32.gt_u (local.get $int_len) (i32.const 72)))
      (then (return (call $pack (i32.const 1) (i32.const 0)))))
    (if (i32.gt_u (i32.add (local.get $p) (local.get $int_len)) (local.get $seq_end))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (local.set $first (i32.load8_u (local.get $p)))
    (if (i32.and (local.get $first) (i32.const 128))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (local.set $payload (local.get $p))
    (local.set $out_len (local.get $int_len))
    (if (i32.and (i32.eq (local.get $first) (i32.const 0)) (i32.gt_u (local.get $int_len) (i32.const 1)))
      (then
        (local.set $second (i32.load8_u (i32.add (local.get $p) (i32.const 1))))
        (if (i32.eqz (i32.and (local.get $second) (i32.const 128)))
          (then (return (call $pack (i32.const 3) (i32.const 0)))))
        (local.set $payload (i32.add (local.get $p) (i32.const 1)))
        (local.set $out_len (i32.sub (local.get $int_len) (i32.const 1)))))
    (if (i32.gt_u (local.get $out_len) (local.get $r_cap))
      (then (return (call $pack (i32.const 2) (i32.const 0)))))
    (call $copy (local.get $payload) (local.get $r_out) (local.get $out_len))
    (local.set $r_len (local.get $out_len))
    (local.set $p (i32.add (local.get $p) (local.get $int_len)))

    ;; s INTEGER
    (if (i32.ge_u (local.get $p) (local.get $seq_end))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (if (i32.ne (i32.load8_u (local.get $p)) (i32.const 2))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (local.set $p (i32.add (local.get $p) (i32.const 1)))
    (local.set $ld (call $len_decode (local.get $p) (local.get $seq_end)))
    (local.set $st (i32.wrap_i64 (i64.and (local.get $ld) (i64.const 65535))))
    (if (local.get $st)
      (then (return (call $pack (local.get $st) (i32.const 0)))))
    (local.set $p (i32.add (local.get $p) (i32.wrap_i64 (i64.and (i64.shr_u (local.get $ld) (i64.const 16)) (i64.const 65535)))))
    (local.set $int_len (i32.wrap_i64 (i64.shr_u (local.get $ld) (i64.const 32))))
    (if (i32.or (i32.eqz (local.get $int_len)) (i32.gt_u (local.get $int_len) (i32.const 72)))
      (then (return (call $pack (i32.const 1) (i32.const 0)))))
    (if (i32.gt_u (i32.add (local.get $p) (local.get $int_len)) (local.get $seq_end))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (local.set $first (i32.load8_u (local.get $p)))
    (if (i32.and (local.get $first) (i32.const 128))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (local.set $payload (local.get $p))
    (local.set $out_len (local.get $int_len))
    (if (i32.and (i32.eq (local.get $first) (i32.const 0)) (i32.gt_u (local.get $int_len) (i32.const 1)))
      (then
        (local.set $second (i32.load8_u (i32.add (local.get $p) (i32.const 1))))
        (if (i32.eqz (i32.and (local.get $second) (i32.const 128)))
          (then (return (call $pack (i32.const 3) (i32.const 0)))))
        (local.set $payload (i32.add (local.get $p) (i32.const 1)))
        (local.set $out_len (i32.sub (local.get $int_len) (i32.const 1)))))
    (if (i32.gt_u (local.get $out_len) (local.get $s_cap))
      (then (return (call $pack (i32.const 2) (i32.const 0)))))
    (call $copy (local.get $payload) (local.get $s_out) (local.get $out_len))
    (local.set $s_len (local.get $out_len))
    (local.set $p (i32.add (local.get $p) (local.get $int_len)))
    (if (i32.ne (local.get $p) (local.get $seq_end))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (global.set $last_r_len (local.get $r_len))
    (global.set $last_s_len (local.get $s_len))
    (call $pack
      (i32.const 0)
      (i32.or (i32.shl (local.get $r_len) (i32.const 16)) (local.get $s_len))))

  ;; Emit minimal positive DER ECDSA signature from unsigned big-endian r and s.
  ;; Return low32=status, high32=written.
  (func (export "ecdsa_der_emit")
    (param $r i32) (param $r_len i32)
    (param $s i32) (param $s_len i32)
    (param $out i32) (param $out_cap i32)
    (result i64)
    (local $r_pad i32)
    (local $s_pad i32)
    (local $r_enc i32)
    (local $s_enc i32)
    (local $body_len i32)
    (local $seq_len_size i32)
    (local $written i32)
    (local $p i32)
    (if (i32.or
          (i32.or (i32.eqz (local.get $r_len)) (i32.eqz (local.get $s_len)))
          (i32.or (i32.gt_u (local.get $r_len) (i32.const 72)) (i32.gt_u (local.get $s_len) (i32.const 72))))
      (then (return (call $pack (i32.const 1) (i32.const 0)))))
    (if (i32.and
          (i32.gt_u (local.get $r_len) (i32.const 1))
          (i32.eqz (i32.load8_u (local.get $r))))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (if (i32.and
          (i32.gt_u (local.get $s_len) (i32.const 1))
          (i32.eqz (i32.load8_u (local.get $s))))
      (then (return (call $pack (i32.const 3) (i32.const 0)))))
    (local.set $r_pad (select (i32.const 1) (i32.const 0) (i32.and (i32.load8_u (local.get $r)) (i32.const 128))))
    (local.set $s_pad (select (i32.const 1) (i32.const 0) (i32.and (i32.load8_u (local.get $s)) (i32.const 128))))
    (local.set $r_enc (i32.add (local.get $r_len) (local.get $r_pad)))
    (local.set $s_enc (i32.add (local.get $s_len) (local.get $s_pad)))
    (if (i32.or (i32.gt_u (local.get $r_enc) (i32.const 72)) (i32.gt_u (local.get $s_enc) (i32.const 72)))
      (then (return (call $pack (i32.const 1) (i32.const 0)))))
    (local.set $body_len
      (i32.add
        (i32.add (i32.add (i32.const 1) (call $len_size (local.get $r_enc))) (local.get $r_enc))
        (i32.add (i32.add (i32.const 1) (call $len_size (local.get $s_enc))) (local.get $s_enc))))
    (local.set $seq_len_size (call $len_size (local.get $body_len)))
    (local.set $written (i32.add (i32.add (i32.const 1) (local.get $seq_len_size)) (local.get $body_len)))
    (if (i32.gt_u (local.get $written) (local.get $out_cap))
      (then (return (call $pack (i32.const 2) (i32.const 0)))))
    (i32.store8 (local.get $out) (i32.const 48))
    (drop (call $len_emit (local.get $body_len) (i32.add (local.get $out) (i32.const 1))))
    (local.set $p (i32.add (i32.add (local.get $out) (i32.const 1)) (local.get $seq_len_size)))
    (i32.store8 (local.get $p) (i32.const 2))
    (local.set $p (i32.add (local.get $p) (i32.const 1)))
    (local.set $p (i32.add (local.get $p) (call $len_emit (local.get $r_enc) (local.get $p))))
    (if (local.get $r_pad)
      (then
        (i32.store8 (local.get $p) (i32.const 0))
        (local.set $p (i32.add (local.get $p) (i32.const 1)))))
    (call $copy (local.get $r) (local.get $p) (local.get $r_len))
    (local.set $p (i32.add (local.get $p) (local.get $r_len)))
    (i32.store8 (local.get $p) (i32.const 2))
    (local.set $p (i32.add (local.get $p) (i32.const 1)))
    (local.set $p (i32.add (local.get $p) (call $len_emit (local.get $s_enc) (local.get $p))))
    (if (local.get $s_pad)
      (then
        (i32.store8 (local.get $p) (i32.const 0))
        (local.set $p (i32.add (local.get $p) (i32.const 1)))))
    (call $copy (local.get $s) (local.get $p) (local.get $s_len))
    (call $pack (i32.const 0) (local.get $written))))
