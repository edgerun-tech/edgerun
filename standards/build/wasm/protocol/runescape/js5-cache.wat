        (local.set $v (call $deflate_read_bits (i32.const 1)))
        (if (i32.lt_s (local.get $v) (i32.const 0)) (then (return (local.get $v))))
        (i32.store (i32.const 304) (local.get $v))
        (local.set $v (call $deflate_read_bits (i32.const 2)))
        (if (i32.lt_s (local.get $v) (i32.const 0)) (then (return (local.get $v))))
