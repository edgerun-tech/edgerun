    (local.set $in_ptr (i32.load (i32.const 220)))
    (i32.store (i32.const 252) (local.get $in_ptr))
    (local.set $in_end (i32.add (local.get $in_ptr) (i32.load (i32.const 228))))
    (i32.store (i32.const 260) (local.get $in_end))
    (local.set $out_start (i32.const 1048888))
    (i32.store (i32.const 276) (local.get $out_start))
    (i32.store (i32.const 268) (local.get $out_start))
    (local.set $out_end (i32.add (local.get $out_start) (i32.load (i32.const 168))))
    (i32.store (i32.const 284) (local.get $out_end))
    (i64.store (i32.const 292) (i64.const 0))
    (i32.store (i32.const 300) (i32.const 0))
    (i32.store (i32.const 304) (i32.const 0))
    (block $block_loop
