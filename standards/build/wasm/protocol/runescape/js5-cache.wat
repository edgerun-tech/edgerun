      (if (i32.ne (i32.load (i32.const 248)) (i32.load (i32.const 168))) (then (br $bad)))
      (local.set $v (call $deflate_decode_stored))
      (if (i32.lt_s (local.get $v) (i32.const 0)) (then (return (local.get $v))))
      (i32.store (i32.const 172) (local.get $payload_ptr))
