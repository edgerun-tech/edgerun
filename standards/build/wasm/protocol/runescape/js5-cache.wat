      (i32.store (i32.const 188) (i32.const 1048888))
      (i32.store (i32.const 168) (i32.load (i32.const 248)))
      (i64.store (i32.const 56) (i64.extend_i32_s (local.get $payload_ptr)))
      (i64.store (i32.const 64) (i64.extend_i32_s (local.get $payload_len)))
