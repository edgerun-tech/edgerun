                (local.set $in_ptr (i32.add (local.get $in_ptr) (i32.const 4)))
                (if (i32.gt_u (i32.add (local.get $in_ptr) (local.get $len)) (i32.load (i32.const 260))) (then (br $bad)))
                (local.set $out_ptr (i32.load (i32.const 268)))
                (if (i32.gt_u (i32.add (local.get $out_ptr) (local.get $len)) (i32.load (i32.const 284))) (then (br $bad)))
                (local.set $i (i32.const 0))
                (block $cpy_done
                  (loop $cpy_loop
                    (if (i32.eq (local.get $i) (local.get $len)) (then (br $cpy_done)))
                    (i32.store8
                      (i32.add (local.get $out_ptr) (local.get $i))
                      (i32.load8_u (i32.add (local.get $in_ptr) (local.get $i)))
                    )
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
