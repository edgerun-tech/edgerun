      (i64.store (i32.const 236) (i64.extend_i32_s (local.get $end)))
      (i64.store (i32.const 212) (i64.extend_i32_s (i32.sub (local.get $p) (local.get $payload_ptr))))
      (i32.store (i32.const 244) (i32.load (local.get $end)))
