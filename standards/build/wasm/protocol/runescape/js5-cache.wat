    (local.set $payload_ptr (i32.load (i32.const 172)))
    (local.set $payload_len (i32.load (i32.const 180)))
    (block $bad
      (if (i32.lt_u (local.get $payload_len) (i32.const 18)) (then (br $bad)))
      (if (i32.ne (i32.load8_u (local.get $payload_ptr)) (i32.const 0x1f)) (then (br $bad)))
      (if (i32.ne (i32.load8_u (i32.add (local.get $payload_ptr) (i32.const 1))) (i32.const 0x8b)) (then (br $bad)))
      (if (i32.ne (i32.load8_u (i32.add (local.get $payload_ptr) (i32.const 2))) (i32.const 8)) (then (br $bad)))
      (local.set $flags (i32.load8_u (i32.add (local.get $payload_ptr) (i32.const 3))))
