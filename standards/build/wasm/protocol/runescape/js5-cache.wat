          (if (i32.eqz (local.get $v))
            (then
              (i64.store (i32.const 292) (i64.const 0))
              (i32.store (i32.const 300) (i32.const 0))
              (local.set $in_ptr (i32.load (i32.const 252)))
              (local.set $in_end (i32.load (i32.const 260)))
              (block $bad
                (if (i32.gt_u (i32.add (local.get $in_ptr) (i32.const 4)) (local.get $in_end)) (then (br $bad)))
                (local.set $len
                  (i32.or
                    (i32.load8_u (local.get $in_ptr))
                    (i32.shl (i32.load8_u (i32.add (local.get $in_ptr) (i32.const 1))) (i32.const 8))
                  )
                )
                (local.set $nlen
                  (i32.or
                    (i32.load8_u (i32.add (local.get $in_ptr) (i32.const 2)))
                    (i32.shl (i32.load8_u (i32.add (local.get $in_ptr) (i32.const 3))) (i32.const 8))
                  )
                )
