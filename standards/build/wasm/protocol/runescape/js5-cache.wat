    (block $bad
      (if (i32.gt_u (local.get $r9) (i32.const 16)) (then (br $bad)))
      (local.set $bitbuf (i64.load (i32.const 292)))
      (local.set $bitcount (i32.load (i32.const 300)))
      (local.set $in_ptr (i32.load (i32.const 252)))
      (local.set $in_end (i32.load (i32.const 260)))
      (block $fill
        (loop $fill_loop
          (if (i32.ge_u (local.get $bitcount) (local.get $r9)) (then (br $fill)))
          (if (i32.ge_u (local.get $in_ptr) (local.get $in_end))
            (then (br $bad))
          )
          (local.set $v (i32.load8_u (local.get $in_ptr)))
          (local.set $in_ptr (i32.add (local.get $in_ptr) (i32.const 1)))
          (local.set $bitbuf
            (i64.or
              (local.get $bitbuf)
              (i64.shl (i64.extend_i32_s (local.get $v)) (i64.extend_i32_s (local.get $bitcount)))
            )
          )
          (local.set $bitcount (i32.add (local.get $bitcount) (i32.const 8)))
