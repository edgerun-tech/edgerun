  ;; === deflate_read_bits ===
  (func $deflate_read_bits (param $count i32) (result i32)
    (local $r9 i32) (local $bitbuf i64) (local $bitcount i32) (local $in_ptr i32) (local $in_end i32)
    (local $v i32)
    (local.set $r9 (local.get $count))
    (if (i32.eqz (local.get $r9))
      (then (return (i32.const 0)))
