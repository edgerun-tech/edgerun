      (if (i32.ne (i32.load8_u (i32.add (local.get $p) (i32.const 2))) (i32.const 0x59)) (then (br $bad)))
      (if (i32.ne (i32.load8_u (i32.add (local.get $p) (i32.const 3))) (i32.const 0x26)) (then (br $bad)))
