      (i64.store (i32.const 292)
        (i64.shr_u (local.get $bitbuf) (i64.extend_i32_s (local.get $r9)))
      )
      (i32.store (i32.const 300) (i32.sub (local.get $bitcount) (local.get $r9)))
      (i32.store (i32.const 252) (local.get $in_ptr))
      (return
        (i32.and (i32.wrap_i64 (local.get $bitbuf))
          (i32.sub (i32.shl (i32.const 1) (local.get $r9)) (i32.const 1))
