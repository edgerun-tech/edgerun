(module
  ;; Tor protocol slice ported from the pre-erobj x86_64 ASM snapshot at
  ;; 1b243c8d6a843585bc54b4366f814cf5f56615b1.
  ;;
  ;; Scope: constants, fixed and variable cell helpers, relay-cell parsing and
  ;; serialization, circuit/stream table helpers, and ntor/handshake state
  ;; layouts. Crypto and transport are deliberately external to this slice.

  (memory (export "memory") 8)

  ;; Error values.
  (global $OK i32 (i32.const 0))
  (global $ERR_INVALID_PARAM i32 (i32.const -1))
  (global $ERR_TOR_PROTOCOL i32 (i32.const -44))
  (global $ERR_BUSY i32 (i32.const -16))
  (global $ERR_UNSUPPORTED i32 (i32.const -47))

  ;; Cell constants.
  (global $TOR_CELL_PADDING i32 (i32.const 0))
  (global $TOR_CELL_CREATE i32 (i32.const 1))
  (global $TOR_CELL_CREATED i32 (i32.const 2))
  (global $TOR_CELL_RELAY i32 (i32.const 3))
  (global $TOR_CELL_DESTROY i32 (i32.const 4))
  (global $TOR_CELL_CREATE_FAST i32 (i32.const 5))
  (global $TOR_CELL_CREATED_FAST i32 (i32.const 6))
  (global $TOR_CELL_VERSIONS i32 (i32.const 7))
  (global $TOR_CELL_NETINFO i32 (i32.const 8))
  (global $TOR_CELL_RELAY_EARLY i32 (i32.const 9))
  (global $TOR_CELL_CREATE2 i32 (i32.const 10))
  (global $TOR_CELL_CREATED2 i32 (i32.const 11))
  (global $TOR_CELL_VPADDING i32 (i32.const 128))
  (global $TOR_CELL_CERTS i32 (i32.const 129))
  (global $TOR_CELL_AUTH_CHALLENGE i32 (i32.const 130))
  (global $TOR_CELL_AUTHENTICATE i32 (i32.const 131))
  (global $TOR_CELL_RESOLVE i32 (i32.const 132))
  (global $TOR_CELL_RESOLVED i32 (i32.const 133))

  (global $TOR_CELL_LEN i32 (i32.const 514))
  (global $TOR_CELL_HEADER_LEN i32 (i32.const 5))
  (global $TOR_CELL_PAYLOAD_LEN i32 (i32.const 509))
  (global $TOR_VERSIONS_HEADER i32 (i32.const 5))
  (global $TOR_CELL_VAR_HEADER i32 (i32.const 7))
  (global $TOR_CELL_VAR_MAX i32 (i32.const 65535))
  (global $TOR_CIRC_ID_LEN_V3 i32 (i32.const 2))
  (global $TOR_CIRC_ID_LEN_V4 i32 (i32.const 4))
  (global $TOR_LINK_V3 i32 (i32.const 3))
  (global $TOR_LINK_V4 i32 (i32.const 4))
  (global $TOR_LINK_V5 i32 (i32.const 5))
  (global $TOR_CELL_CIRC_ID i32 (i32.const 0))
  (global $TOR_CELL_CMD i32 (i32.const 4))
  (global $TOR_CELL_PAYLOAD i32 (i32.const 5))
  (global $TOR_VAR_CIRC_ID i32 (i32.const 0))
  (global $TOR_VAR_CMD i32 (i32.const 4))
  (global $TOR_VAR_LEN i32 (i32.const 5))
  (global $TOR_VAR_PAYLOAD i32 (i32.const 7))

  ;; Relay constants.
  (global $TOR_RELAY_BEGIN i32 (i32.const 1))
  (global $TOR_RELAY_DATA i32 (i32.const 2))
  (global $TOR_RELAY_END i32 (i32.const 3))
  (global $TOR_RELAY_CONNECTED i32 (i32.const 4))
  (global $TOR_RELAY_SENDME i32 (i32.const 5))
  (global $TOR_RELAY_EXTEND i32 (i32.const 6))
  (global $TOR_RELAY_EXTENDED i32 (i32.const 7))
  (global $TOR_RELAY_TRUNCATE i32 (i32.const 8))
  (global $TOR_RELAY_TRUNCATED i32 (i32.const 9))
  (global $TOR_RELAY_DROP i32 (i32.const 10))
  (global $TOR_RELAY_RESOLVE i32 (i32.const 11))
  (global $TOR_RELAY_RESOLVED i32 (i32.const 12))
  (global $TOR_RELAY_BEGIN_DIR i32 (i32.const 13))
  (global $TOR_RELAY_EXTEND2 i32 (i32.const 14))
  (global $TOR_RELAY_EXTENDED2 i32 (i32.const 15))
  (global $TOR_RELAY_ESTABLISH_INTRO i32 (i32.const 32))
  (global $TOR_RELAY_ESTABLISH_RENDEZVOUS i32 (i32.const 33))
  (global $TOR_RELAY_INTRODUCE1 i32 (i32.const 34))
  (global $TOR_RELAY_INTRODUCE2 i32 (i32.const 35))
  (global $TOR_RELAY_RENDEZVOUS1 i32 (i32.const 36))
  (global $TOR_RELAY_RENDEZVOUS2 i32 (i32.const 37))
  (global $TOR_RELAY_INTRO_ESTABLISHED i32 (i32.const 38))
  (global $TOR_RELAY_RENDEZVOUS_ESTABLISHED i32 (i32.const 39))
  (global $TOR_RELAY_INTRODUCE_ACK i32 (i32.const 40))
  (global $TOR_RELAY_CMD i32 (i32.const 0))
  (global $TOR_RELAY_RECOGNIZED i32 (i32.const 1))
  (global $TOR_RELAY_STREAM_ID i32 (i32.const 3))
  (global $TOR_RELAY_DIGEST i32 (i32.const 5))
  (global $TOR_RELAY_LEN i32 (i32.const 9))
  (global $TOR_RELAY_DATA_OFFSET i32 (i32.const 11))
  (global $TOR_HS_RELAY_DATA_MAX i32 (i32.const 498))

  ;; ntor and onion-service layout constants.
  (global $TOR_CURVE25519_KEY_LEN i32 (i32.const 32))
  (global $TOR_NTOR_ID_LEN i32 (i32.const 20))
  (global $TOR_NTOR_T_LEN i32 (i32.const 32))
  (global $TOR_NTOR_MAC_LEN i32 (i32.const 32))
  (global $TOR_NTOR_PROTOID_LEN i32 (i32.const 24))
  (global $TOR_NTOR_M_EXPAND_LEN i32 (i32.const 6))
  (global $TOR_NTOR_T_MAC_LEN i32 (i32.const 5))
  (global $TOR_NTOR_T_KEY_LEN i32 (i32.const 5))
  (global $TOR_NTOR_M_KEY_VERIFY_LEN i32 (i32.const 10))
  (global $TOR_NTOR_CLIENT_HANDSHAKE_LEN i32 (i32.const 84))
  (global $TOR_NTOR_SERVER_REPLY_LEN i32 (i32.const 64))
  (global $TOR_NTOR_AUTH_INPUT_LEN i32 (i32.const 178))
  (global $TOR_HS_RENDEZVOUS_COOKIE_LEN i32 (i32.const 20))
  (global $TOR_HS_AUTH_KEY_TYPE_ED25519 i32 (i32.const 2))
  (global $TOR_HS_ONION_KEY_TYPE_NTOR i32 (i32.const 1))
  (global $TOR_HS_ONION_KEY_LEN_NTOR i32 (i32.const 32))
  (global $TOR_HS_CLIENT_PK_LEN i32 (i32.const 32))
  (global $TOR_HS_INTRODUCE1_MAX_LEN i32 (i32.const 490))
  (global $TOR_HS_DESCRIPTOR_MAX_LEN i32 (i32.const 50000))

  ;; Table constants and in-module table locations.
  (global $TOR_MAX_CIRCUITS i32 (i32.const 4))
  (global $TOR_MAX_STREAMS i32 (i32.const 8))
  (global $TOR_MAX_RELAYS i32 (i32.const 8))
  (global $TOR_CIRC_CLOSED i32 (i32.const 0))
  (global $TOR_CIRC_OPENING i32 (i32.const 1))
  (global $TOR_CIRC_OPEN i32 (i32.const 2))
  (global $TOR_CIRC_EXTENDING i32 (i32.const 3))
  (global $TOR_CIRC_CLOSING i32 (i32.const 4))
  (global $TOR_STREAM_CLOSED i32 (i32.const 0))
  (global $TOR_STREAM_RESOLVING i32 (i32.const 1))
  (global $TOR_STREAM_CONNECTING i32 (i32.const 2))
  (global $TOR_STREAM_OPEN i32 (i32.const 3))
  (global $TOR_STREAM_CLOSING i32 (i32.const 4))
  (global $TOR_CIRC_STATE i32 (i32.const 0))
  (global $TOR_CIRC_CONN_ID i32 (i32.const 4))
  (global $TOR_CIRC_N_HOPS i32 (i32.const 8))
  (global $TOR_CIRC_RX_BUF_LEN i32 (i32.const 12))
  (global $TOR_CIRC_RX_BUF i32 (i32.const 16))
  (global $TOR_CIRC_FORWARD_KEY i32 (i32.const 65552))
  (global $TOR_CIRC_FORWARD_IV i32 (i32.const 65568))
  (global $TOR_CIRC_BACKWARD_KEY i32 (i32.const 65584))
  (global $TOR_CIRC_BACKWARD_IV i32 (i32.const 65600))
  (global $TOR_CIRC_FORWARD_DIGEST i32 (i32.const 65616))
  (global $TOR_CIRC_BACKWARD_DIGEST i32 (i32.const 65648))
  (global $TOR_CIRC_NTOR_KEYS i32 (i32.const 65680))
  (global $TOR_CIRC_SIZE i32 (i32.const 66208))
  (global $TOR_CIRC_MAX_HOPS i32 (i32.const 4))
  (global $TOR_CIRC_HOP_FWD_KEY i32 (i32.const 0))
  (global $TOR_CIRC_HOP_BWD_KEY i32 (i32.const 16))
  (global $TOR_CIRC_HOP_FWD_IV i32 (i32.const 32))
  (global $TOR_CIRC_HOP_BWD_IV i32 (i32.const 48))
  (global $TOR_CIRC_HOP_FWD_DIGEST i32 (i32.const 64))
  (global $TOR_CIRC_HOP_BWD_DIGEST i32 (i32.const 96))
  (global $TOR_CIRC_HOP_SIZE i32 (i32.const 128))
  (global $TOR_STREAM_STATE i32 (i32.const 0))
  (global $TOR_STREAM_CIRC_ID i32 (i32.const 4))
  (global $TOR_STREAM_ID i32 (i32.const 8))
  (global $TOR_STREAM_DST_IP i32 (i32.const 10))
  (global $TOR_STREAM_DST_PORT i32 (i32.const 14))
  (global $TOR_STREAM_RX_LEN i32 (i32.const 16))
  (global $TOR_STREAM_RX_BUF i32 (i32.const 20))
  (global $TOR_STREAM_SIZE i32 (i32.const 4116))
  (global $CIRCUITS_BASE i32 (i32.const 4096))
  (global $STREAMS_BASE i32 (i32.const 270336))
  (global $HANDSHAKES_BASE i32 (i32.const 303616))
  (global $HANDSHAKE_STATE_SIZE i32 (i32.const 256))

  (global $circ_next_id (mut i32) (i32.const 1))
  (global $stream_next_id (mut i32) (i32.const 1))

  (data (i32.const 1024) "ntor-curve25519-sha256-1")
  (data (i32.const 1056) "expand")
  (data (i32.const 1072) "t_mac")
  (data (i32.const 1088) "t_key")
  (data (i32.const 1104) "key_verify")
  (data (i32.const 1120) "Server")
  (data (i32.const 1136) "tor-ntor-kdf-1")
  (data (i32.const 1152) "tor-ntor-kdf-2")
  (data (i32.const 1168) "tor-ntor-auth-1")

  (func $u16be (param $p i32) (result i32)
    (i32.or
      (i32.shl (i32.load8_u (local.get $p)) (i32.const 8))
      (i32.load8_u offset=1 (local.get $p))))

  (func $put_u16be (param $p i32) (param $v i32)
    (i32.store8 (local.get $p) (i32.shr_u (local.get $v) (i32.const 8)))
    (i32.store8 offset=1 (local.get $p) (local.get $v)))

  (func $addr_add (param $base i32) (param $off i32) (result i32)
    (i32.add (local.get $base) (local.get $off)))

  (func $tor_init (export "tor_init") (result i32)
    (global.set $circ_next_id (i32.const 1))
    (global.set $stream_next_id (i32.const 1))
    (memory.fill
      (global.get $CIRCUITS_BASE)
      (i32.const 0)
      (i32.mul (global.get $TOR_CIRC_SIZE) (global.get $TOR_MAX_CIRCUITS)))
    (memory.fill
      (global.get $STREAMS_BASE)
      (i32.const 0)
      (i32.mul (global.get $TOR_STREAM_SIZE) (global.get $TOR_MAX_STREAMS)))
    (memory.fill
      (global.get $HANDSHAKES_BASE)
      (i32.const 0)
      (i32.mul (global.get $HANDSHAKE_STATE_SIZE) (global.get $TOR_MAX_CIRCUITS)))
    (global.get $OK))

  (func $constant (export "constant") (param $id i32) (result i32)
    (block $default
      (block $c133
      (block $c132
      (block $c131
      (block $c130
      (block $c129
      (block $c128
      (block $c40
      (block $c39
      (block $c38
      (block $c37
      (block $c36
      (block $c35
      (block $c34
      (block $c33
      (block $c32
      (block $c15
      (block $c14
      (block $c13
      (block $c12
      (block $c11
      (block $c10
      (block $c9
      (block $c8
      (block $c7
      (block $c6
      (block $c5
      (block $c4
      (block $c3
      (block $c2
      (block $c1
        (br_table $c1 $c2 $c3 $c4 $c5 $c6 $c7 $c8 $c9 $c10
                  $c11 $c12 $c13 $c14 $c15 $c32 $c33 $c34 $c35 $c36
                  $c37 $c38 $c39 $c40 $c128 $c129 $c130 $c131 $c132
                  $c133 $default
                  (local.get $id)))
      (return (global.get $TOR_CELL_CREATE)))
      (return (global.get $TOR_CELL_CREATED)))
      (return (global.get $TOR_CELL_RELAY)))
      (return (global.get $TOR_CELL_DESTROY)))
      (return (global.get $TOR_CELL_CREATE_FAST)))
      (return (global.get $TOR_CELL_CREATED_FAST)))
      (return (global.get $TOR_CELL_VERSIONS)))
      (return (global.get $TOR_CELL_NETINFO)))
      (return (global.get $TOR_CELL_RELAY_EARLY)))
      (return (global.get $TOR_CELL_CREATE2)))
      (return (global.get $TOR_CELL_CREATED2)))
      (return (global.get $TOR_RELAY_BEGIN)))
      (return (global.get $TOR_RELAY_DATA)))
      (return (global.get $TOR_RELAY_END)))
      (return (global.get $TOR_RELAY_CONNECTED)))
      (return (global.get $TOR_RELAY_ESTABLISH_INTRO)))
      (return (global.get $TOR_RELAY_ESTABLISH_RENDEZVOUS)))
      (return (global.get $TOR_RELAY_INTRODUCE1)))
      (return (global.get $TOR_RELAY_INTRODUCE2)))
      (return (global.get $TOR_RELAY_RENDEZVOUS1)))
      (return (global.get $TOR_RELAY_RENDEZVOUS2)))
      (return (global.get $TOR_RELAY_INTRO_ESTABLISHED)))
      (return (global.get $TOR_RELAY_RENDEZVOUS_ESTABLISHED)))
      (return (global.get $TOR_RELAY_INTRODUCE_ACK)))
      (return (global.get $TOR_CELL_VPADDING)))
      (return (global.get $TOR_CELL_CERTS)))
      (return (global.get $TOR_CELL_AUTH_CHALLENGE)))
      (return (global.get $TOR_CELL_AUTHENTICATE)))
      (return (global.get $TOR_CELL_RESOLVE)))
      (return (global.get $TOR_CELL_RESOLVED)))
    (i32.const 0))

  (func $cell_len (export "cell_len") (result i32) (global.get $TOR_CELL_LEN))
  (func $cell_payload_len (export "cell_payload_len") (result i32) (global.get $TOR_CELL_PAYLOAD_LEN))
  (func $relay_data_max (export "relay_data_max") (result i32) (global.get $TOR_HS_RELAY_DATA_MAX))
  (func $circuit_entry_size (export "circuit_entry_size") (result i32) (global.get $TOR_CIRC_SIZE))
  (func $stream_entry_size (export "stream_entry_size") (result i32) (global.get $TOR_STREAM_SIZE))
  (func $circuits_base (export "circuits_base") (result i32) (global.get $CIRCUITS_BASE))
  (func $streams_base (export "streams_base") (result i32) (global.get $STREAMS_BASE))
  (func $handshakes_base (export "handshakes_base") (result i32) (global.get $HANDSHAKES_BASE))
  (func $ntor_protoid_ptr (export "ntor_protoid_ptr") (result i32) (i32.const 1024))
  (func $ntor_protoid_len (export "ntor_protoid_len") (result i32) (global.get $TOR_NTOR_PROTOID_LEN))

  (func $circuit_ptr (export "circuit_ptr") (param $circ_id i32) (result i32)
    (if (i32.ge_u (local.get $circ_id) (global.get $TOR_MAX_CIRCUITS))
      (then (return (i32.const 0))))
    (i32.add
      (global.get $CIRCUITS_BASE)
      (i32.mul (local.get $circ_id) (global.get $TOR_CIRC_SIZE))))

  (func $stream_ptr (export "stream_ptr") (param $stream_index i32) (result i32)
    (if (i32.ge_u (local.get $stream_index) (global.get $TOR_MAX_STREAMS))
      (then (return (i32.const 0))))
    (i32.add
      (global.get $STREAMS_BASE)
      (i32.mul (local.get $stream_index) (global.get $TOR_STREAM_SIZE))))

  (func $hop_ptr (export "hop_ptr") (param $circ_ptr i32) (param $hop_index i32) (result i32)
    (if (i32.eqz (local.get $circ_ptr)) (then (return (i32.const 0))))
    (if (i32.ge_u (local.get $hop_index) (global.get $TOR_CIRC_MAX_HOPS))
      (then (return (i32.const 0))))
    (i32.add
      (i32.add (local.get $circ_ptr) (global.get $TOR_CIRC_NTOR_KEYS))
      (i32.mul (local.get $hop_index) (global.get $TOR_CIRC_HOP_SIZE))))

  (func $endpoint_hop_ptr (export "endpoint_hop_ptr") (param $circ_ptr i32) (result i32)
    (local $n_hops i32)
    (if (i32.eqz (local.get $circ_ptr)) (then (return (i32.const 0))))
    (local.set $n_hops (i32.load offset=8 (local.get $circ_ptr)))
    (if (i32.eqz (local.get $n_hops)) (then (return (i32.const 0))))
    (call $hop_ptr (local.get $circ_ptr) (i32.sub (local.get $n_hops) (i32.const 1))))

  (func $alloc_circuit (export "alloc_circuit") (result i32)
    (local $id i32)
    (local $p i32)
    (local.set $id (global.get $circ_next_id))
    (if (i32.ge_u (local.get $id) (global.get $TOR_MAX_CIRCUITS))
      (then (return (i32.const 0))))
    (global.set $circ_next_id (i32.add (local.get $id) (i32.const 1)))
    (local.set $p (call $circuit_ptr (local.get $id)))
    (i32.store offset=0 (local.get $p) (global.get $TOR_CIRC_OPENING))
    (i32.store offset=4 (local.get $p) (local.get $id))
    (i32.store offset=8 (local.get $p) (i32.const 0))
    (i32.store offset=12 (local.get $p) (i32.const 0))
    (local.get $id))

  (func $set_circuit_state (export "set_circuit_state") (param $circ_id i32) (param $state i32) (result i32)
    (local $p i32)
    (local.set $p (call $circuit_ptr (local.get $circ_id)))
    (if (i32.eqz (local.get $p)) (then (return (global.get $ERR_INVALID_PARAM))))
    (i32.store offset=0 (local.get $p) (local.get $state))
    (global.get $OK))

  (func $set_circuit_hops (export "set_circuit_hops") (param $circ_id i32) (param $n_hops i32) (result i32)
    (local $p i32)
    (local.set $p (call $circuit_ptr (local.get $circ_id)))
    (if (i32.eqz (local.get $p)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.gt_u (local.get $n_hops) (global.get $TOR_CIRC_MAX_HOPS))
      (then (return (global.get $ERR_INVALID_PARAM))))
    (i32.store offset=8 (local.get $p) (local.get $n_hops))
    (global.get $OK))

  (func $alloc_stream (export "alloc_stream") (param $circ_id i32) (param $dst_ip i32) (param $dst_port i32) (result i32)
    (local $id i32)
    (local $p i32)
    (local.set $id (global.get $stream_next_id))
    (if (i32.ge_u (local.get $id) (global.get $TOR_MAX_STREAMS))
      (then (return (i32.const 0))))
    (global.set $stream_next_id (i32.add (local.get $id) (i32.const 1)))
    (local.set $p (call $stream_ptr (local.get $id)))
    (i32.store offset=0 (local.get $p) (global.get $TOR_STREAM_CONNECTING))
    (i32.store offset=4 (local.get $p) (local.get $circ_id))
    (i32.store16 offset=8 (local.get $p) (local.get $id))
    (i32.store offset=10 (local.get $p) (local.get $dst_ip))
    (i32.store16 offset=14 (local.get $p) (local.get $dst_port))
    (i32.store offset=16 (local.get $p) (i32.const 0))
    (local.get $id))

  ;; out_view layout: circ_id:u32, cmd:u32, payload_ptr:u32, payload_len:u32.
  (func $parse_fixed_cell (export "parse_fixed_cell") (param $cell i32) (param $len i32) (param $out_view i32) (result i32)
    (if (i32.eqz (local.get $cell)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.eqz (local.get $out_view)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.lt_u (local.get $len) (global.get $TOR_CELL_LEN))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (i32.store (local.get $out_view) (i32.load (local.get $cell)))
    (i32.store offset=4 (local.get $out_view) (i32.load8_u offset=4 (local.get $cell)))
    (i32.store offset=8 (local.get $out_view) (i32.add (local.get $cell) (i32.const 5)))
    (i32.store offset=12 (local.get $out_view) (global.get $TOR_CELL_PAYLOAD_LEN))
    (global.get $OK))

  (func $build_fixed_cell (export "build_fixed_cell") (param $out_cell i32) (param $circ_id i32) (param $cmd i32) (result i32)
    (if (i32.eqz (local.get $out_cell)) (then (return (global.get $ERR_INVALID_PARAM))))
    (memory.fill (local.get $out_cell) (i32.const 0) (global.get $TOR_CELL_LEN))
    (i32.store (local.get $out_cell) (local.get $circ_id))
    (i32.store8 offset=4 (local.get $out_cell) (local.get $cmd))
    (global.get $OK))

  (func $build_versions_cell (export "build_versions_cell") (param $out_cell i32) (result i32)
    (if (i32.eqz (local.get $out_cell)) (then (return (global.get $ERR_INVALID_PARAM))))
    (memory.fill (local.get $out_cell) (i32.const 0) (i32.const 9))
    (i32.store8 offset=2 (local.get $out_cell) (global.get $TOR_CELL_VERSIONS))
    (call $put_u16be (i32.add (local.get $out_cell) (i32.const 3)) (i32.const 4))
    (call $put_u16be (i32.add (local.get $out_cell) (i32.const 5)) (global.get $TOR_LINK_V4))
    (call $put_u16be (i32.add (local.get $out_cell) (i32.const 7)) (global.get $TOR_LINK_V5))
    (i32.const 9))

  (func $parse_versions (export "parse_versions") (param $cell i32) (param $len i32) (result i32)
    (local $payload_len i32)
    (local $pos i32)
    (local $end i32)
    (local $ver i32)
    (local $best i32)
    (if (i32.lt_u (local.get $len) (global.get $TOR_VERSIONS_HEADER))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.ne (i32.load8_u offset=2 (local.get $cell)) (global.get $TOR_CELL_VERSIONS))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (local.set $payload_len (call $u16be (i32.add (local.get $cell) (i32.const 3))))
    (if (i32.ne (i32.and (local.get $payload_len) (i32.const 1)) (i32.const 0))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.lt_u (local.get $len) (i32.add (global.get $TOR_VERSIONS_HEADER) (local.get $payload_len)))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (local.set $pos (i32.add (local.get $cell) (global.get $TOR_VERSIONS_HEADER)))
    (local.set $end (i32.add (local.get $pos) (local.get $payload_len)))
    (local.set $best (i32.const 0))
    (loop $scan
      (if (i32.ge_u (local.get $pos) (local.get $end)) (then (return (local.get $best))))
      (local.set $ver (call $u16be (local.get $pos)))
      (if
        (i32.and
          (i32.or
            (i32.eq (local.get $ver) (global.get $TOR_LINK_V4))
            (i32.eq (local.get $ver) (global.get $TOR_LINK_V5)))
          (i32.gt_u (local.get $ver) (local.get $best)))
        (then (local.set $best (local.get $ver))))
      (local.set $pos (i32.add (local.get $pos) (i32.const 2)))
      (br $scan))
    (unreachable))

  ;; out_view layout: circ_id:u32, cmd:u32, payload_ptr:u32, payload_len:u32.
  (func $parse_var_cell (export "parse_var_cell") (param $cell i32) (param $len i32) (param $out_view i32) (result i32)
    (local $payload_len i32)
    (if (i32.eqz (local.get $cell)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.eqz (local.get $out_view)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.lt_u (local.get $len) (global.get $TOR_CELL_VAR_HEADER))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (local.set $payload_len (call $u16be (i32.add (local.get $cell) (global.get $TOR_VAR_LEN))))
    (if (i32.lt_u (local.get $len) (i32.add (global.get $TOR_CELL_VAR_HEADER) (local.get $payload_len)))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (i32.store (local.get $out_view) (i32.load (local.get $cell)))
    (i32.store offset=4 (local.get $out_view) (i32.load8_u offset=4 (local.get $cell)))
    (i32.store offset=8 (local.get $out_view) (i32.add (local.get $cell) (global.get $TOR_VAR_PAYLOAD)))
    (i32.store offset=12 (local.get $out_view) (local.get $payload_len))
    (global.get $OK))

  (func $build_var_cell (export "build_var_cell") (param $out_cell i32) (param $circ_id i32) (param $cmd i32) (param $data i32) (param $data_len i32) (result i32)
    (if (i32.eqz (local.get $out_cell)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.gt_u (local.get $data_len) (global.get $TOR_CELL_VAR_MAX))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.and (i32.ne (local.get $data_len) (i32.const 0)) (i32.eqz (local.get $data)))
      (then (return (global.get $ERR_INVALID_PARAM))))
    (i32.store (local.get $out_cell) (local.get $circ_id))
    (i32.store8 offset=4 (local.get $out_cell) (local.get $cmd))
    (call $put_u16be (i32.add (local.get $out_cell) (i32.const 5)) (local.get $data_len))
    (if (local.get $data_len)
      (then (memory.copy (i32.add (local.get $out_cell) (i32.const 7)) (local.get $data) (local.get $data_len))))
    (i32.add (global.get $TOR_CELL_VAR_HEADER) (local.get $data_len)))

  (func $build_netinfo_cell (export "build_netinfo_cell") (param $out_cell i32) (result i32)
    (if (i32.eqz (local.get $out_cell)) (then (return (global.get $ERR_INVALID_PARAM))))
    (memory.fill (local.get $out_cell) (i32.const 0) (global.get $TOR_CELL_LEN))
    (i32.store offset=0 (local.get $out_cell) (i32.const 0))
    (i32.store8 offset=4 (local.get $out_cell) (global.get $TOR_CELL_NETINFO))
    (i32.store8 offset=9 (local.get $out_cell) (i32.const 4))
    (i32.store8 offset=10 (local.get $out_cell) (i32.const 4))
    (i32.store8 offset=15 (local.get $out_cell) (i32.const 0))
    (global.get $OK))

  (func $validate_netinfo_cell (export "validate_netinfo_cell") (param $cell i32) (param $len i32) (result i32)
    (local $pos i32)
    (local $atype i32)
    (local $alen i32)
    (local $nmy i32)
    (if (i32.lt_u (local.get $len) (global.get $TOR_CELL_LEN))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.ne (i32.load8_u offset=4 (local.get $cell)) (global.get $TOR_CELL_NETINFO))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.ne (i32.load offset=0 (local.get $cell)) (i32.const 0))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (local.set $atype (i32.load8_u offset=9 (local.get $cell)))
    (local.set $alen (i32.load8_u offset=10 (local.get $cell)))
    (if (i32.and (i32.eq (local.get $atype) (i32.const 4)) (i32.ne (local.get $alen) (i32.const 4)))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.and (i32.eq (local.get $atype) (i32.const 6)) (i32.ne (local.get $alen) (i32.const 16)))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (local.set $pos (i32.add (i32.const 11) (local.get $alen)))
    (if (i32.ge_u (local.get $pos) (global.get $TOR_CELL_LEN))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (local.set $nmy (i32.load8_u (i32.add (local.get $cell) (local.get $pos))))
    (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
    (loop $addr_loop
      (if (i32.eqz (local.get $nmy)) (then (return (global.get $OK))))
      (if (i32.gt_u (i32.add (local.get $pos) (i32.const 2)) (global.get $TOR_CELL_LEN))
        (then (return (global.get $ERR_TOR_PROTOCOL))))
      (local.set $atype (i32.load8_u (i32.add (local.get $cell) (local.get $pos))))
      (local.set $alen (i32.load8_u (i32.add (i32.add (local.get $cell) (local.get $pos)) (i32.const 1))))
      (if (i32.and (i32.eq (local.get $atype) (i32.const 4)) (i32.ne (local.get $alen) (i32.const 4)))
        (then (return (global.get $ERR_TOR_PROTOCOL))))
      (if (i32.and (i32.eq (local.get $atype) (i32.const 6)) (i32.ne (local.get $alen) (i32.const 16)))
        (then (return (global.get $ERR_TOR_PROTOCOL))))
      (local.set $pos (i32.add (i32.add (local.get $pos) (i32.const 2)) (local.get $alen)))
      (if (i32.gt_u (local.get $pos) (global.get $TOR_CELL_LEN))
        (then (return (global.get $ERR_TOR_PROTOCOL))))
      (local.set $nmy (i32.sub (local.get $nmy) (i32.const 1)))
      (br $addr_loop))
    (unreachable))

  ;; out_view layout: cmd:u32, recognized:u32, stream_id:u32, digest:u32,
  ;; data_ptr:u32, data_len:u32.
  (func $parse_relay_payload (export "parse_relay_payload") (param $payload i32) (param $payload_len i32) (param $out_view i32) (result i32)
    (local $data_len i32)
    (if (i32.eqz (local.get $payload)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.eqz (local.get $out_view)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.lt_u (local.get $payload_len) (global.get $TOR_RELAY_DATA_OFFSET))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (local.set $data_len (call $u16be (i32.add (local.get $payload) (global.get $TOR_RELAY_LEN))))
    (if (i32.gt_u (local.get $data_len) (global.get $TOR_HS_RELAY_DATA_MAX))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.gt_u (i32.add (global.get $TOR_RELAY_DATA_OFFSET) (local.get $data_len)) (local.get $payload_len))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (i32.store (local.get $out_view) (i32.load8_u (local.get $payload)))
    (i32.store offset=4 (local.get $out_view) (i32.load16_u offset=1 (local.get $payload)))
    (i32.store offset=8 (local.get $out_view) (i32.load16_u offset=3 (local.get $payload)))
    (i32.store offset=12 (local.get $out_view) (i32.load offset=5 (local.get $payload)))
    (i32.store offset=16 (local.get $out_view) (i32.add (local.get $payload) (global.get $TOR_RELAY_DATA_OFFSET)))
    (i32.store offset=20 (local.get $out_view) (local.get $data_len))
    (global.get $OK))

  (func $build_relay_payload (export "build_relay_payload") (param $out_payload i32) (param $relay_cmd i32) (param $stream_id i32) (param $data i32) (param $data_len i32) (result i32)
    (if (i32.eqz (local.get $out_payload)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.gt_u (local.get $data_len) (global.get $TOR_HS_RELAY_DATA_MAX))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.and (i32.ne (local.get $data_len) (i32.const 0)) (i32.eqz (local.get $data)))
      (then (return (global.get $ERR_INVALID_PARAM))))
    (memory.fill (local.get $out_payload) (i32.const 0) (global.get $TOR_CELL_PAYLOAD_LEN))
    (i32.store8 (local.get $out_payload) (local.get $relay_cmd))
    (i32.store16 offset=1 (local.get $out_payload) (i32.const 0))
    (i32.store16 offset=3 (local.get $out_payload) (local.get $stream_id))
    (i32.store offset=5 (local.get $out_payload) (i32.const 0))
    (call $put_u16be (i32.add (local.get $out_payload) (global.get $TOR_RELAY_LEN)) (local.get $data_len))
    (if (local.get $data_len)
      (then
        (memory.copy
          (i32.add (local.get $out_payload) (global.get $TOR_RELAY_DATA_OFFSET))
          (local.get $data)
          (local.get $data_len))))
    (global.get $OK))

  (func $build_relay_cell (export "build_relay_cell") (param $out_cell i32) (param $circ_id i32) (param $cell_cmd i32) (param $relay_cmd i32) (param $stream_id i32) (param $data i32) (param $data_len i32) (result i32)
    (local $rc i32)
    (if (i32.and
          (i32.ne (local.get $cell_cmd) (global.get $TOR_CELL_RELAY))
          (i32.ne (local.get $cell_cmd) (global.get $TOR_CELL_RELAY_EARLY)))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (local.set $rc (call $build_fixed_cell (local.get $out_cell) (local.get $circ_id) (local.get $cell_cmd)))
    (if (local.get $rc) (then (return (local.get $rc))))
    (call $build_relay_payload
      (i32.add (local.get $out_cell) (global.get $TOR_CELL_PAYLOAD))
      (local.get $relay_cmd)
      (local.get $stream_id)
      (local.get $data)
      (local.get $data_len)))

  (func $parse_relay_cell (export "parse_relay_cell") (param $cell i32) (param $len i32) (param $expected_circ_id i32) (param $out_view i32) (result i32)
    (local $cmd i32)
    (if (i32.lt_u (local.get $len) (global.get $TOR_CELL_LEN))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.ne (i32.load (local.get $cell)) (local.get $expected_circ_id))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (local.set $cmd (i32.load8_u offset=4 (local.get $cell)))
    (if (i32.and
          (i32.ne (local.get $cmd) (global.get $TOR_CELL_RELAY))
          (i32.ne (local.get $cmd) (global.get $TOR_CELL_RELAY_EARLY)))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (call $parse_relay_payload
      (i32.add (local.get $cell) (global.get $TOR_CELL_PAYLOAD))
      (global.get $TOR_CELL_PAYLOAD_LEN)
      (local.get $out_view)))

  (func $build_create2_cell (export "build_create2_cell") (param $out_cell i32) (param $circ_id i32) (param $handshake i32) (param $handshake_len i32) (result i32)
    (if (i32.ne (local.get $handshake_len) (global.get $TOR_NTOR_CLIENT_HANDSHAKE_LEN))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.eqz (local.get $handshake)) (then (return (global.get $ERR_INVALID_PARAM))))
    (drop (call $build_fixed_cell (local.get $out_cell) (local.get $circ_id) (global.get $TOR_CELL_CREATE2)))
    (call $put_u16be (i32.add (local.get $out_cell) (global.get $TOR_CELL_PAYLOAD)) (i32.const 2))
    (call $put_u16be (i32.add (i32.add (local.get $out_cell) (global.get $TOR_CELL_PAYLOAD)) (i32.const 2)) (local.get $handshake_len))
    (memory.copy
      (i32.add (i32.add (local.get $out_cell) (global.get $TOR_CELL_PAYLOAD)) (i32.const 4))
      (local.get $handshake)
      (local.get $handshake_len))
    (global.get $OK))

  (func $parse_created2_cell (export "parse_created2_cell") (param $cell i32) (param $len i32) (param $circ_id i32) (param $out_reply i32) (param $out_len i32) (result i32)
    (local $hlen i32)
    (if (i32.lt_u (local.get $len) (global.get $TOR_CELL_LEN))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.ne (i32.load (local.get $cell)) (local.get $circ_id))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.ne (i32.load8_u offset=4 (local.get $cell)) (global.get $TOR_CELL_CREATED2))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.ne (call $u16be (i32.add (local.get $cell) (global.get $TOR_CELL_PAYLOAD))) (i32.const 2))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (local.set $hlen (call $u16be (i32.add (i32.add (local.get $cell) (global.get $TOR_CELL_PAYLOAD)) (i32.const 2))))
    (if (i32.ne (local.get $hlen) (global.get $TOR_NTOR_SERVER_REPLY_LEN))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.eqz (local.get $out_len)) (then (return (global.get $ERR_INVALID_PARAM))))
    (i32.store (local.get $out_len) (local.get $hlen))
    (if (local.get $out_reply)
      (then
        (memory.copy
          (local.get $out_reply)
          (i32.add (i32.add (local.get $cell) (global.get $TOR_CELL_PAYLOAD)) (i32.const 4))
          (local.get $hlen))))
    (global.get $OK))

  (func $build_extend2_body (export "build_extend2_body") (param $out_body i32) (param $node_id20 i32) (param $ipv4 i32) (param $port i32) (param $handshake84 i32) (result i32)
    (if (i32.eqz (local.get $out_body)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.eqz (local.get $node_id20)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.eqz (local.get $handshake84)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.gt_u (local.get $port) (i32.const 65535)) (then (return (global.get $ERR_INVALID_PARAM))))
    (i32.store8 (local.get $out_body) (i32.const 2))
    (i32.store8 offset=1 (local.get $out_body) (i32.const 0))
    (i32.store8 offset=2 (local.get $out_body) (i32.const 6))
    (i32.store offset=3 (local.get $out_body) (local.get $ipv4))
    (i32.store8 offset=7 (local.get $out_body) (i32.shr_u (local.get $port) (i32.const 8)))
    (i32.store8 offset=8 (local.get $out_body) (local.get $port))
    (i32.store8 offset=9 (local.get $out_body) (i32.const 2))
    (i32.store8 offset=10 (local.get $out_body) (i32.const 20))
    (memory.copy (i32.add (local.get $out_body) (i32.const 11)) (local.get $node_id20) (i32.const 20))
    (call $put_u16be (i32.add (local.get $out_body) (i32.const 31)) (i32.const 2))
    (call $put_u16be (i32.add (local.get $out_body) (i32.const 33)) (global.get $TOR_NTOR_CLIENT_HANDSHAKE_LEN))
    (memory.copy (i32.add (local.get $out_body) (i32.const 35)) (local.get $handshake84) (global.get $TOR_NTOR_CLIENT_HANDSHAKE_LEN))
    (i32.const 119))

  (func $parse_extended2_body (export "parse_extended2_body") (param $body i32) (param $body_len i32) (param $out_reply64 i32) (result i32)
    (local $hlen i32)
    (if (i32.lt_u (local.get $body_len) (i32.const 4))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.ne (call $u16be (local.get $body)) (i32.const 2))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (local.set $hlen (call $u16be (i32.add (local.get $body) (i32.const 2))))
    (if (i32.ne (local.get $hlen) (global.get $TOR_NTOR_SERVER_REPLY_LEN))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (i32.lt_u (local.get $body_len) (i32.add (i32.const 4) (local.get $hlen)))
      (then (return (global.get $ERR_TOR_PROTOCOL))))
    (if (local.get $out_reply64)
      (then (memory.copy (local.get $out_reply64) (i32.add (local.get $body) (i32.const 4)) (local.get $hlen))))
    (global.get $OK))

  ;; Handshake state layout per entry:
  ;; 0 state, 4 circ_id, 8 node_id[20], 28 onion_key[32], 60 client_priv[32],
  ;; 92 client_pub[32], 124 handshake[84], 208 reply[64].
  (func $handshake_state_ptr (export "handshake_state_ptr") (param $slot i32) (result i32)
    (if (i32.ge_u (local.get $slot) (global.get $TOR_MAX_CIRCUITS))
      (then (return (i32.const 0))))
    (i32.add
      (global.get $HANDSHAKES_BASE)
      (i32.mul (local.get $slot) (global.get $HANDSHAKE_STATE_SIZE))))

  (func $ntor_state_init (export "ntor_state_init") (param $slot i32) (param $circ_id i32) (param $node_id20 i32) (param $onion_key32 i32) (result i32)
    (local $p i32)
    (local.set $p (call $handshake_state_ptr (local.get $slot)))
    (if (i32.eqz (local.get $p)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.eqz (local.get $node_id20)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.eqz (local.get $onion_key32)) (then (return (global.get $ERR_INVALID_PARAM))))
    (memory.fill (local.get $p) (i32.const 0) (global.get $HANDSHAKE_STATE_SIZE))
    (i32.store (local.get $p) (i32.const 1))
    (i32.store offset=4 (local.get $p) (local.get $circ_id))
    (memory.copy (i32.add (local.get $p) (i32.const 8)) (local.get $node_id20) (i32.const 20))
    (memory.copy (i32.add (local.get $p) (i32.const 28)) (local.get $onion_key32) (i32.const 32))
    (global.get $OK))

  (func $ntor_state_set_client_keys (export "ntor_state_set_client_keys") (param $slot i32) (param $priv32 i32) (param $pub32 i32) (result i32)
    (local $p i32)
    (local.set $p (call $handshake_state_ptr (local.get $slot)))
    (if (i32.eqz (local.get $p)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.eqz (local.get $priv32)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.eqz (local.get $pub32)) (then (return (global.get $ERR_INVALID_PARAM))))
    (memory.copy (i32.add (local.get $p) (i32.const 60)) (local.get $priv32) (i32.const 32))
    (memory.copy (i32.add (local.get $p) (i32.const 92)) (local.get $pub32) (i32.const 32))
    (i32.store (local.get $p) (i32.const 2))
    (global.get $OK))

  (func $ntor_state_build_handshake (export "ntor_state_build_handshake") (param $slot i32) (param $out_handshake84 i32) (result i32)
    (local $p i32)
    (local.set $p (call $handshake_state_ptr (local.get $slot)))
    (if (i32.eqz (local.get $p)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.eqz (local.get $out_handshake84)) (then (return (global.get $ERR_INVALID_PARAM))))
    ;; Full ntor requires SHA256(onion_key) for KEY_ID and X25519 for X.
    (global.get $ERR_UNSUPPORTED))

  (func $ntor_state_store_handshake (export "ntor_state_store_handshake") (param $slot i32) (param $handshake84 i32) (result i32)
    (local $p i32)
    (local.set $p (call $handshake_state_ptr (local.get $slot)))
    (if (i32.eqz (local.get $p)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.eqz (local.get $handshake84)) (then (return (global.get $ERR_INVALID_PARAM))))
    (memory.copy (i32.add (local.get $p) (i32.const 124)) (local.get $handshake84) (global.get $TOR_NTOR_CLIENT_HANDSHAKE_LEN))
    (i32.store (local.get $p) (i32.const 3))
    (global.get $OK))

  (func $ntor_state_store_reply (export "ntor_state_store_reply") (param $slot i32) (param $reply64 i32) (result i32)
    (local $p i32)
    (local.set $p (call $handshake_state_ptr (local.get $slot)))
    (if (i32.eqz (local.get $p)) (then (return (global.get $ERR_INVALID_PARAM))))
    (if (i32.eqz (local.get $reply64)) (then (return (global.get $ERR_INVALID_PARAM))))
    (memory.copy (i32.add (local.get $p) (i32.const 208)) (local.get $reply64) (global.get $TOR_NTOR_SERVER_REPLY_LEN))
    (i32.store (local.get $p) (i32.const 4))
    (global.get $OK))

