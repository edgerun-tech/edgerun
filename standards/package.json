{
  "name": "edgerun-standards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build":         "bun tools/build_wat.mjs --arch=x86-64",
    "build:x86-64": "bun tools/build_wat.mjs --arch=x86-64",
    "build:arm32": "bun tools/build_wat.mjs --arch=arm32",
    "build:aarch64": "bun tools/build_wat.mjs --arch=aarch64",
    "build:watch": "bun tools/build_wat.mjs --watch --arch=x86-64",
    "validate":  "bun tools/validate.mjs",
    "test":      "bun tools/test.mjs",
    "lint":      "make lint-wat",
    "ci":        "bun run build && bun run validate && bun run test",
    "stats":     "make stats",
    "clean":     "make clean"
  }
}
