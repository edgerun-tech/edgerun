                        else
                          local.get $code
                          i32.const 43
                          i32.eq
                          if (result i32)
                            i32.const 11
                          else
                            local.get $code
                            i32.const 61
                            i32.eq
                            if (result i32)
                              i32.const 12
                            else
                              i32.const 255
                            end
                          end
