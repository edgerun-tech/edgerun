;; ═════════════════════════════════════════════════════════════════════
  ;; EdgeRun WASM → Native JIT Compiler — unified core
  ;;
  ;; GENERATOR TEMPLATE — per-arch KV templates expand into dispatch tables.
  ;;
  ;; Usage:
  ;;   python tools/gen_compiler.py templates/x86_64.json > gen/jit-dispatch-x86-64.wat
  ;; ═════════════════════════════════════════════════════════════════════


  ;; ═════════════════════════════════════════════════════════════════════
  ;; JIT State — per-architecture globals (suffixed by arch)
  ;; ═════════════════════════════════════════════════════════════════════

  (global $JIT_SLOT_SIZE_arm32  i32 (i32.const 0x40000))  ;; 256KB per function
  (global $JIT_STATE_arm32      i32 (i32.const 0x300000))

  ;; JIT state field offsets (relative to JIT_STATE)
  (global $JS_CODE_PTR_arm32       i32 (i32.const 0))
  (global $JS_CACHE_BASE_arm32     i32 (i32.const 4))
  (global $JS_CACHE_END_arm32      i32 (i32.const 8))
  (global $JS_FUNC_IDX_arm32       i32 (i32.const 12))
  (global $JS_RESULT_COUNT_arm32   i32 (i32.const 16))
  (global $JS_STACK_DEPTH_arm32    i32 (i32.const 20))
  (global $JS_MAX_STACK_arm32      i32 (i32.const 24))
  (global $JS_LABEL_DEPTH_arm32    i32 (i32.const 28))
  (global $JS_RETURN_EMITTED_arm32 i32 (i32.const 32))
  (global $JS_LABEL_OFFSETS_arm32  i32 (i32.const 64))    ;; 256*i32 = 1024 bytes
  (global $JS_LABEL_KINDS_arm32    i32 (i32.const 1088))   ;; 256*byte = 256 bytes
  (global $JS_LABEL_IF_JZ_arm32    i32 (i32.const 1344))   ;; 256*i32 = 1024 bytes
  (global $JS_FIXUP_COUNT_arm32    i32 (i32.const 2368))
  (global $JS_FIXUP_LABEL_arm32    i32 (i32.const 2372))   ;; 256*i32 = 1024 bytes
  (global $JS_FIXUP_OFFSET_arm32   i32 (i32.const 3396))   ;; 256*i32 = 1024 bytes
  (global $JS_INITIALIZED_arm32    i32 (i32.const 4420))

  ;; Label kinds
  (global $JIT_LABEL_BLOCK_arm32   i32 (i32.const 0))
  (global $JIT_LABEL_LOOP_arm32    i32 (i32.const 1))
  (global $JIT_LABEL_IF_arm32      i32 (i32.const 2))
  (global $JIT_LABEL_ELSE    i32 (i32.const 3))

  ;; Peephole optimization flag
  (global $RESULT_IN_X0_arm32 (mut i32) (i32.const 0))

  ;; Current decoded op pointer
  (global $CURRENT_DEC_PTR_arm32   (mut i32) (i32.const 0))

  ;; Peephole lookahead
  (global $NEXT_OP_arm32 (mut i32) (i32.const 0))

  ;; JIT error code
  (global $JIT_ERROR_arm32 (mut i32) (i32.const 0))

  ;; ELF/binary buffer globals are defined in per-arch emit-*.wat files


  ;; ═════════════════════════════════════════════════════════════════════
  ;; Label Management — shared across all architectures
  ;; ═════════════════════════════════════════════════════════════════════

  ;; Push a label kind onto the label stack
  (func $push_label_arm32 (param $kind i32) (result i32)
    (local $depth i32)
    (local.set $depth (i32.load (global.get $JS_LABEL_DEPTH_arm32)))
    (i32.store8
      (i32.add (global.get $JS_LABEL_KINDS_arm32) (local.get $depth))
      (local.get $kind))
    (i32.store (global.get $JS_LABEL_DEPTH_arm32) (i32.add (local.get $depth) (i32.const 1)))
    (local.get $depth)
  )

  ;; Pop a label kind from the label stack
  (func $pop_label_arm32 (result i32)
    (local $depth i32)
    (local.set $depth (i32.sub (i32.load (global.get $JS_LABEL_DEPTH_arm32)) (i32.const 1)))
    (i32.store (global.get $JS_LABEL_DEPTH_arm32) (local.get $depth))
    (local.get $depth)
  )

  ;; Get label kind at depth
  (func $get_label_kind_arm32 (param $depth i32) (result i32)
    (i32.load8_u (i32.add (global.get $JS_LABEL_KINDS_arm32) (local.get $depth)))
  )

  ;; Set label offset
  (func $set_label_offset_arm32 (param $depth i32) (param $offset i32)
    (i32.store
      (i32.add (global.get $JS_LABEL_OFFSETS_arm32) (i32.shl (local.get $depth) (i32.const 2)))
      (local.get $offset))
  )

  ;; Get label offset
  (func $get_label_offset_arm32 (param $depth i32) (result i32)
    (i32.load
      (i32.add (global.get $JS_LABEL_OFFSETS_arm32) (i32.shl (local.get $depth) (i32.const 2))))
  )

  ;; Set label if-jz offset
  (func $set_label_if_jz_arm32 (param $depth i32) (param $offset i32)
    (i32.store
      (i32.add (global.get $JS_LABEL_IF_JZ_arm32) (i32.shl (local.get $depth) (i32.const 2)))
      (local.get $offset))
  )

  ;; Get label if-jz offset
  (func $get_label_if_jz_arm32 (param $depth i32) (result i32)
    (i32.load
      (i32.add (global.get $JS_LABEL_IF_JZ_arm32) (i32.shl (local.get $depth) (i32.const 2))))
  )

  ;; Push a fixup
  (func $push_fixup_arm32 (param $target_depth i32)
    (local $count i32)
    (local.set $count (i32.load (global.get $JS_FIXUP_COUNT_arm32)))
    (i32.store
      (i32.add (global.get $JS_FIXUP_LABEL_arm32) (i32.shl (local.get $count) (i32.const 2)))
      (local.get $target_depth))
    (i32.store
      (i32.add (global.get $JS_FIXUP_OFFSET_arm32) (i32.shl (local.get $count) (i32.const 2)))
      (i32.load (global.get $JS_CODE_PTR_arm32)))
    (i32.store (global.get $JS_FIXUP_COUNT_arm32) (i32.add (local.get $count) (i32.const 1)))
  )

  ;; Patch fixups for a given depth
  (func $patch_fixups_arm32 (param $depth i32)
    (local $count i32) (local $i i32) (local $target i32) (local $off i32)
    (local $code_ptr i32) (local $disp i32) (local $label_off i32)
    (local.set $count (i32.load (global.get $JS_FIXUP_COUNT_arm32)))
    (local.set $code_ptr (i32.load (global.get $JS_CODE_PTR_arm32)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $lp
        (if (i32.ge_u (local.get $i) (local.get $count)) (then (br $done)))
        (local.set $target (i32.load
          (i32.add (global.get $JS_FIXUP_LABEL_arm32) (i32.shl (local.get $i) (i32.const 2)))))
        (if (i32.eq (local.get $target) (local.get $depth))
          (then
            (local.set $off (i32.load
              (i32.add (global.get $JS_FIXUP_OFFSET_arm32) (i32.shl (local.get $i) (i32.const 2)))))
            (local.set $label_off (call $get_label_offset_arm32 (local.get $depth)))
            (local.set $disp (i32.sub (local.get $label_off) (i32.add (local.get $off) (i32.const 4))))
            (i32.store (i32.add (global.get $JIT_CACHE) (local.get $off)) (local.get $disp))
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lp)
      )
    )
  )


  ;; ═════════════════════════════════════════════════════════════════════
  ;; JIT Compile Dispatch — opcode dispatch tables expanded from per-arch KV template.
  ;; ═════════════════════════════════════════════════════════════════════

  (func $jit_compile_arm32 (export "jit_compile_arm32") (param $func_idx i32) (result i32)
    (local $dec_ptr i32) (local $opcode i32) (local $imm0 i32)
    (local $code_start i32) (local $label_level i32)
    (local $loop_top_offset i32)
    (local $decoded_ops_base i32) (local $decoded_ops_count i32)

    ;; Reset label depth
    (i32.store (global.get $JS_LABEL_DEPTH_arm32) (i32.const 0))

    ;; Get decoded_ops base from imported global
    (local.set $decoded_ops_base (global.get $OFF_DECODED_OPS))

    ;; ── Record this function's offset in func_off_table ────────────
    (i32.store
      (i32.add (global.get $FUNC_OFF_TABLE_arm32) (i32.shl (local.get $func_idx) (i32.const 2)))
      (i32.load (global.get $JS_CODE_PTR_arm32))
    )

    ;; ── Emit prologue ─────────────────────────────────────────────
    (call $emit_arm32_prologue)

    ;; ── Read next op for peephole ─────────────────────────────────
    (if (i32.load (i32.add (local.get $dec_ptr) (global.get $DEC_SZ)))
      (then (global.set $NEXT_OP_arm32 (i32.load (i32.add (local.get $dec_ptr) (global.get $DEC_SZ)))))
      (else (global.set $NEXT_OP_arm32 (i32.const 0)))
    )

    ;; ── Main compile loop ─────────────────────────────────────────
    (local.set $dec_ptr (local.get $decoded_ops_base))
    (block $compile_done
      (loop $compile_loop
        (local.set $opcode (i32.load (local.get $dec_ptr)))

        ;; Read next opcode for peephole (at dec_ptr + DEC_SZ)
        (if (i32.load (i32.add (local.get $dec_ptr) (global.get $DEC_SZ)))
          (then (global.set $NEXT_OP_arm32 (i32.load (i32.add (local.get $dec_ptr) (global.get $DEC_SZ)))))
          (else (global.set $NEXT_OP_arm32 (i32.const 0)))
        )

        ;; ── Dispatch by opcode ─────────────────────────────────────
        (block $dispatch_done
          (if (i32.eqz (local.get $opcode))
            (then (call $template_unreachable_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x01))
            (then (call $template_nop_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x02))
            (then (call $template_block_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x03))
            (then (call $template_loop_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x04))
            (then (call $template_if_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x05))
            (then (call $template_else_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x0B))
            (then (call $template_end_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x0C))
            (then (call $template_br_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x0D))
            (then (call $template_br_if_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x0E))
            (then (call $template_br_table_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x0F))
            (then (call $template_return_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x10))
            (then (call $template_call_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x12))
            (then (call $template_return_call_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x1A))
            (then (call $template_drop_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x1B))
            (then (call $template_select_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x20))
            (then (call $template_local_get_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x21))
            (then (call $template_local_set_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x22))
            (then (call $template_local_tee_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x23))
            (then (call $template_global_get_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x24))
            (then (call $template_global_set_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x25))
            (then (call $template_table_get_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x26))
            (then (call $template_table_set_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x28))
            (then (call $template_i32_load_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x29))
            (then (call $template_i64_load_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x2A))
            (then (call $template_f32_load_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x2B))
            (then (call $template_f64_load_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x2C))
            (then (call $template_i32_load8_s_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x2D))
            (then (call $template_i32_load8_u_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x2E))
            (then (call $template_i32_load16_s_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x2F))
            (then (call $template_i32_load16_u_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x30))
            (then (call $template_i64_load8_s_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x31))
            (then (call $template_i64_load16_s_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x32))
            (then (call $template_i64_load32_s_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x33))
            (then (call $template_i64_load32_u_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x36))
            (then (call $template_i32_store_arm32 (local.get $dec_ptr)) (br $dispatch_done)))
