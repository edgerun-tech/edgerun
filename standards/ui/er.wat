  (func $crc32_update_byte (export "crc32_update_byte") (param $crc i32) (param $byte i32) (result i32)
    (local $c i32) (local $i i32)
    (local.set $c (i32.xor (local.get $crc) (local.get $byte)))
    (local.set $i (i32.const 0))
