    (local $hdr i32)
    local.get $index call $vorbis_codebook_get_header
    local.tee $hdr i32.eqz
    if
      i32.const 0 return
    end
    global.get $BSS_CODEBOOK_LENGTHS
    local.get $hdr global.get $CB_LENGTH_OFFSET i32.add i32.load offset=0
    i32.const 2 i32.shl i32.add
