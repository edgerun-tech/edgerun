  (func $deflate_stored_encode (export "deflate_stored_encode")
    (param $src_ptr i32)
    (param $src_len i32)
    (param $out_ptr i32)
    (param $out_cap i32)
    (result i64)
    (local $src_off i32)
    (local $written i32)
    (local $chunk i32)
    (local $remaining i32)
    (local $is_final i32)
    (local $nlen i32)

    (local.set $src_off (i32.const 0))
    (local.set $written (i32.const 0))

    (block $done
      (loop $blocks
        (local.set $remaining (i32.sub (local.get $src_len) (local.get $src_off)))
        (if (i32.gt_u (local.get $remaining) (i32.const 65535))
          (then
