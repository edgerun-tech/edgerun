                (if (i32.eq (local.get $imm0) (i32.const 0x63))
                  (then (call $template_simd_i32x4_sub (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x68))
                  (then (call $template_simd_i32x4_neg (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x69))
