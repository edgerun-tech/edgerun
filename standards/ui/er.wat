    (call $emit_x86_byte (i32.const 0x0F))
    (call $emit_x86_byte (i32.const 0x58))
    (call $emit_x86_modrm (i32.const 3) (i32.const 0) (i32.const 1))  ;; addsd xmm0, xmm1
    (call $emit_x86_movq_rax_xmm0)
    (call $emit_x86_maybe_push_rax)
