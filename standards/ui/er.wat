          i32.const 3
          i32.eq
          local.get $code
          i32.const 6
          i32.eq
          i32.or
          if (result i32)
            i32.const 3
          else
            local.get $code
            i32.const 51
            i32.eq
            local.get $code
            i32.const 58
            i32.eq
            i32.or
            local.get $code
            i32.const 59
            i32.eq
            i32.or
            if (result i32)
              i32.const 4
            else
              local.get $code
              i32.const 53
              i32.eq
              if (result i32)
                i32.const 5
              else
                local.get $code
                i32.const 55
                i32.eq
                if (result i32)
                  i32.const 6
                else
