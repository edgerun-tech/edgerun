  (export "rkyv_field_bound_kind" (func $rkyv_field_bound_kind))
  (func $rkyv_field_bound_kind
    (param $omit_bounds i32)
    (param $with_attr i32)
    (param $phase i32)
    (result i32)
    ;; phase archive/serialize/deserialize = 0/1/2.
    ;; no bound=0, native bound=1..3, with bound=4..6.
    local.get $omit_bounds
    call $bool
    if (result i32)
      i32.const 0
    else
      local.get $with_attr
      call $bool
      if (result i32)
        local.get $phase
        i32.const 4
        i32.add
      else
        local.get $phase
        i32.const 1
        i32.add
      end
    end)

  (export "rkyv_archive_impl_bits" (func $rkyv_archive_impl_bits))
  (func $rkyv_archive_impl_bits
    (param $remote i32)
    (param $serialize i32)
    (result i32)
    (local $bits i32)
    local.get $remote
    call $bool
    if (result i32)
      i32.const 2
    else
      i32.const 1
    end
    local.set $bits
    local.get $serialize
    call $bool
    if
      local.get $bits
      local.get $remote
      call $bool
      if (result i32)
        i32.const 8
      else
        i32.const 4
      end
      i32.or
      local.set $bits
    end
    local.get $bits)

