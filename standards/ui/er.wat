(func (export "sfx_tables_init")
  (local $i i32)
  (local $s0 i32) (local $s1 i32)
  (local $val i32) (local $step i32)
  (local $base i32)
  i32.const 17825792
  local.set $base
  i32.const 0
  local.set $i
  ;; Interpolate quarter-wave
  (block $qw_done
    (loop $qw_loop
      local.get $i
      i32.const 2047
      i32.ge_u
      br_if $qw_done
      ;; s0 = seed[i], s1 = seed[i+1]
      local.get $base
      local.get $i
      i32.const 3
      i32.shl
      i32.add
      i32.load16_s
      local.set $s0
      local.get $base
      i32.const 8
      i32.add
      local.get $i
      i32.const 3
      i32.shl
      i32.add
      i32.load16_s
      local.set $s1
      local.get $s1
      local.get $s0
      i32.sub
      local.set $step
      ;; k=1: i*8+2
      local.get $base
      local.get $i
      i32.const 3
      i32.shl
      i32.const 2
      i32.add
      i32.add
      local.get $s0
      local.get $step
      i32.const 2
      i32.shr_s
      i32.add
      i32.store16
      ;; k=2: i*8+4
      local.get $base
      local.get $i
      i32.const 3
      i32.shl
      i32.const 4
      i32.add
      i32.add
      local.get $s0
      local.get $step
      i32.const 1
      i32.shr_s
      i32.add
      i32.store16
      ;; k=3: i*8+6
      local.get $base
      local.get $i
      i32.const 3
      i32.shl
      i32.const 6
      i32.add
      i32.add
      local.get $s0
      local.get $step
      i32.const 3
      i32.mul
      i32.const 2
      i32.shr_s
      i32.add
      i32.store16
      local.get $i
      i32.const 1
      i32.add
      local.set $i
      br $qw_loop
    )
  )
  ;; Fill last 3 quarter entries with seed[2047]
  local.get $base
  i32.const 16382
  i32.add
  i32.load16_s
  local.set $val
  local.get $base
  i32.const 16378
  i32.add
  local.get $val
  i32.store16
  local.get $base
  i32.const 16380
  i32.add
  local.get $val
  i32.store16
  local.get $base
  i32.const 16382
  i32.add
  local.get $val
  i32.store16
  ;; Mirror second quarter
  i32.const 0 local.set $i
  (block $m1_done
    (loop $m1_loop
      local.get $i
      i32.const 8192 i32.ge_u br_if $m1_done
      local.get $base i32.const 16384 i32.add
      local.get $i i32.const 1 i32.shl i32.add
      local.get $base i32.const 16382 i32.add
      local.get $i i32.const 1 i32.shl i32.sub
      i32.load16_s
      i32.store16
      local.get $i i32.const 1 i32.add local.set $i
      br $m1_loop
    )
  )
  ;; Negate third quarter
  i32.const 0 local.set $i
  (block $m2_done
    (loop $m2_loop
      local.get $i
      i32.const 8192 i32.ge_u br_if $m2_done
      local.get $base i32.const 32768 i32.add
      local.get $i i32.const 1 i32.shl i32.add
      i32.const 0
      local.get $base
      local.get $i i32.const 1 i32.shl i32.add
      i32.load16_s
      i32.sub
      i32.store16
      local.get $i i32.const 1 i32.add local.set $i
      br $m2_loop
    )
  )
  ;; Negate mirror fourth quarter
  i32.const 0 local.set $i
  (block $m3_done
    (loop $m3_loop
      local.get $i
      i32.const 8192 i32.ge_u br_if $m3_done
      local.get $base i32.const 49152 i32.add
      local.get $i i32.const 1 i32.shl i32.add
      i32.const 0
      local.get $base i32.const 16382 i32.add
      local.get $i i32.const 1 i32.shl i32.sub
      i32.load16_s
      i32.sub
      i32.store16
      local.get $i i32.const 1 i32.add local.set $i
      br $m3_loop
    )
  )
  ;; Generate noise table via xorshift32
  i32.const 17891328
  local.set $base
  i32.const 0xDEADBEEF
  local.set $val
  i32.const 0
  local.set $i
  (block $noise_done
    (loop $noise_loop
      local.get $i
      i32.const 32768
      i32.ge_u
      br_if $noise_done
      local.get $val
      i32.const 13
      i32.shl
      local.get $val
      i32.xor
      local.set $val
      local.get $val
      i32.const 17
      i32.shr_u
      local.get $val
      i32.xor
      local.set $val
      local.get $val
      i32.const 5
      i32.shl
      local.get $val
      i32.xor
      local.set $val
      local.get $base
      local.get $i i32.const 1 i32.shl i32.add
      local.get $val
      i32.store16
      local.get $i i32.const 1 i32.add local.set $i
      br $noise_loop
    )
  )
)
(func (export "sfx_tables_get_sine") (param $i i32) (result i32)
  (i32.load16_s (i32.add (i32.const 17825792) (i32.shl (local.get $i) (i32.const 1))))
)
(func (export "sfx_tables_get_noise") (param $i i32) (result i32)
  (i32.load16_s (i32.add (i32.const 17891328) (i32.shl (local.get $i) (i32.const 1))))
)
(func $m147hex_nibble (param $c i32) (result i32)
    local.get $c
    i32.const 48
    i32.ge_u
    local.get $c
    i32.const 57
    i32.le_u
