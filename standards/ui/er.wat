                (if (i32.eq (local.get $imm0) (i32.const 0x41))
                  (then (call $template_aarch64_i8x16_sub (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x43))
