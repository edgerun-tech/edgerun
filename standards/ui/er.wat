    i32.eqz
    local.get $hlen
    i32.eqz
    i32.or
    local.get $hlen
    i32.const 16
    i32.gt_u
    i32.or
    if (result i32)
      i32.const 0
    else
      local.get $htype
      i32.const 1
      i32.eq
      local.get $hlen
      i32.const 6
      i32.eq
      i32.and
      if (result i32)
        i32.const 1
      else
        i32.const 2
      end
    end)

  ;; Message type mapping: 1 discover, 2 offer, 3 request, 4 decline,
  ;; 5 ack, 6 nak, 7 release, 8 inform, 0 invalid.
  (func (export "dhcp_message_type_classify") (param $value i32) (result i32)
