  (func (export "pocketbase_pack_status") (param $code i32) (result i32)
    (local $status i32)
    local.get $code
    i32.const 100
    i32.lt_u
    local.get $code
    i32.const 999
    i32.gt_u
    i32.or
    if
      i32.const 500
      local.set $status
    else
      local.get $code
      local.set $status
