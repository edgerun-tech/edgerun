      (loop $loop
        (br_if $done (i32.ge_u (local.get $ptr) (local.get $end)))
        (local.set $c (i32.load8_u (local.get $ptr)))
        (if (i32.or (i32.lt_u (local.get $c) (i32.const 1)) (i32.gt_u (local.get $c) (i32.const 127)))
          (then (return (i32.const 0))))
