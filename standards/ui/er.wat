                  i32.const 12
                  i32.eq
                  local.get $code
                  i32.const 66
                  i32.eq
                  i32.or
                  local.get $code
                  i32.const 67
                  i32.eq
                  i32.or
                  if (result i32)
                    i32.const 7
                  else
                    local.get $code
                    i32.const 93
                    i32.eq
                    if (result i32)
                      i32.const 8
                    else
                      local.get $code
                      i32.const 94
                      i32.eq
                      if (result i32)
                        i32.const 9
                      else
                        local.get $code
                        i32.const 97
                        i32.eq
                        if (result i32)
