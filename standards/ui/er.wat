    (if (i32.eq (local.get $h) (i32.const 0x0fb40705)) (then (return (i32.const 3))))
    (if (i32.eq (local.get $h) (i32.const 0x5864ed98)) (then (return (i32.const 4))))
    (if (i32.eq (local.get $h) (i32.const 0x813d75ae)) (then (return (i32.const 5))))
    (i32.const -1))

