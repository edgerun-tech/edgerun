  (func (param $frame_type i32) (result i32)
    (if (result i32) (i32.le_u (local.get $frame_type) (i32.const 9))
      (then (local.get $frame_type))
      (else (i32.const 255))))

  (func (export "http2_error_classify") (param $code i32) (result i32)
