                (if (i32.eq (local.get $imm0) (i32.const 0x3F))
                  (then (call $template_aarch64_f64x2_replace_lane (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x40))
