    i32.eq
    if (result i32)
      i32.const 1
    else
      local.get $field
      i32.const 1
      i32.eq
      if (result i32)
        i32.const 1500
      else
        local.get $field
        i32.const 2
        i32.eq
        if (result i32)
          i32.const 1
        else
          local.get $field
          i32.const 3
          i32.eq
          if (result i32)
            i32.const 0
