      (then
        (if (i32.gt_u (i32.add (local.get $pos) (i32.const 2)) (local.get $limit))
          (then (return (i32.const 1))))
        (local.set $xlen
          (i32.or
            (i32.load8_u (i32.add (local.get $ptr) (local.get $pos)))
            (i32.shl
