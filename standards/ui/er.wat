  ;; negation mask in xmm0 (implicit): if xmm0[i] bit 7 set, select from
  ;; xmm2, else from xmm1.
  ;; Stack: pop if_false, pop if_true, pop mask
  ;; PBLENDVB: mask in xmm0 (implicit), if_false in xmm1, if_true in xmm2
