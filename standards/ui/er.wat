    local.get $decision
    i32.const 1
    i32.ge_s
    local.get $decision
    i32.const 3
    i32.le_s
    i32.and)

  (export "browser_runtime_first_run_result" (func $browser_runtime_first_run_result))
  (func $browser_runtime_first_run_result
    (param $decision_matches i32)
    (param $decision i32)
    (param $cache_present i32)
    (param $cache_matches i32)
    (result i32)
    ;; ok=0 bad-decision=1 missing-cache=2 unexpected-cache=3 bad-cache=4.
    local.get $decision_matches
    call $bool
    i32.eqz
    if (result i32)
      i32.const 1
    else
      local.get $decision
      i32.const 2
      i32.eq
      if (result i32)
        local.get $cache_present
        call $bool
        i32.eqz
        if (result i32)
          i32.const 2
        else
          local.get $cache_matches
          call $bool
          if (result i32)
            i32.const 0
          else
            i32.const 4
          end
        end
      else
        local.get $cache_present
        call $bool
        if (result i32)
          i32.const 3
        else
          i32.const 0
        end
      end
    end)

