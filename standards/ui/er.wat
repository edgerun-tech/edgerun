                  local.get $cur_len local.get $hdr global.get $CB_MAX_LENGTH i32.add i32.load offset=0 i32.gt_u if local.get $hdr global.get $CB_MAX_LENGTH i32.add local.get $cur_len i32.store offset=0 end
