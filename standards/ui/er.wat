    (local $tag i32)
    (local $first i32)
    (local $len_len i32)
    (local $i i32)
    (local $value i64)
    (local $consumed i32)
    (if (i32.lt_u (local.get $in_len) (i32.const 2))
      (then (return (i64.const 1))))
    (local.set $tag (i32.load8_u (local.get $in_ptr)))
