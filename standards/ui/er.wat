    (if (i32.eq (local.get $kind) (i32.const 3)) (then (return (i32.const 10))))
    (if (i32.eq (local.get $kind) (i32.const 4)) (then (return (i32.const 6))))
    (i32.const 0))

  (func (export "otel_metric_unit_valid") (param $ptr i32) (param $len i32) (result i32)
