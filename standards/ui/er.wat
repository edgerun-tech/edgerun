                  (then (call $template_arm32_i8x16_lt_s (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x4C))
                  (then (call $template_arm32_i8x16_gt_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x4D))
                  (then (call $template_arm32_i8x16_gt_s (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x4E))
                  (then (call $template_arm32_i8x16_le_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x4F))
                  (then (call $template_arm32_i8x16_le_s (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x50))
                  (then (call $template_arm32_i8x16_mul (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x51))
                  (then (call $template_arm32_i16x8_add (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x52))
                  (then (call $template_arm32_i16x8_sub (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x57))
                  (then (call $template_arm32_i16x8_neg (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x58))
                  (then (call $template_arm32_i16x8_eq (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x59))
                  (then (call $template_arm32_i16x8_ne (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x5A))
                  (then (call $template_arm32_i16x8_ge_s (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x5B))
                  (then (call $template_arm32_i16x8_lt_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x5C))
                  (then (call $template_arm32_i16x8_lt_s (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x5D))
                  (then (call $template_arm32_i16x8_gt_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x5E))
                  (then (call $template_arm32_i16x8_gt_s (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x5F))
                  (then (call $template_arm32_i16x8_le_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x60))
                  (then (call $template_arm32_i16x8_le_s (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x61))
                  (then (call $template_arm32_i16x8_mul (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x62))
                  (then (call $template_arm32_i32x4_add (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x63))
                  (then (call $template_arm32_i32x4_sub (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x68))
                  (then (call $template_arm32_i32x4_neg (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x69))
                  (then (call $template_arm32_i32x4_eq (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x6A))
                  (then (call $template_arm32_i32x4_ne (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x6B))
                  (then (call $template_arm32_i32x4_ge_s (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x6C))
                  (then (call $template_arm32_i32x4_lt_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x6D))
                  (then (call $template_arm32_i32x4_lt_s (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x6E))
                  (then (call $template_arm32_i32x4_gt_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x6F))
                  (then (call $template_arm32_i32x4_gt_s (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x70))
                  (then (call $template_arm32_i32x4_le_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x71))
                  (then (call $template_arm32_i32x4_le_s (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x72))
                  (then (call $template_arm32_i32x4_mul (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x73))
                  (then (call $template_arm32_i64x2_add (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x74))
                  (then (call $template_arm32_i64x2_sub (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x79))
                  (then (call $template_arm32_i64x2_neg (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x84))
                  (then (call $template_arm32_f32x4_add (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x85))
                  (then (call $template_arm32_f32x4_sub (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x87))
                  (then (call $template_arm32_f32x4_mul (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x8A))
                  (then (call $template_arm32_f32x4_neg (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x8B))
                  (then (call $template_arm32_f32x4_ne (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x8C))
                  (then (call $template_arm32_f32x4_eq (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x8E))
                  (then (call $template_arm32_f32x4_lt (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x90))
                  (then (call $template_arm32_f32x4_gt (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x92))
                  (then (call $template_arm32_f32x4_le (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x94))
                  (then (call $template_arm32_f32x4_ge (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x95))
                  (then (call $template_arm32_f64x2_add (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x96))
                  (then (call $template_arm32_f64x2_sub (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x98))
                  (then (call $template_arm32_f64x2_mul (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x9B))
                  (then (call $template_arm32_f64x2_neg (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x9C))
                  (then (call $template_arm32_f64x2_ne (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x9D))
                  (then (call $template_arm32_f64x2_eq (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x9F))
                  (then (call $template_arm32_f64x2_lt (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xA1))
                  (then (call $template_arm32_f64x2_gt (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xA3))
                  (then (call $template_arm32_f64x2_le (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xA5))
                  (then (call $template_arm32_f64x2_ge (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xA6))
                  (then (call $template_arm32_v128_load8_splat (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xA7))
                  (then (call $template_arm32_v128_load16_splat (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xA8))
                  (then (call $template_arm32_v128_load32_splat (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xA9))
                  (then (call $template_arm32_v128_load64_splat (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xAA))
                  (then (call $template_arm32_i8x16_swizzle (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xAB))
                  (then (call $template_arm32_i64x2_replace_lane (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xAC))
                  (then (call $template_arm32_v128_not (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xAD))
                  (then (call $template_arm32_v128_bitselect (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xAE))
                  (then (call $template_arm32_i8x16_ge_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xAF))
                  (then (call $template_arm32_i16x8_ge_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xB0))
                  (then (call $template_arm32_i32x4_ge_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xB8))
                  (then (call $template_arm32_i8x16_min_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xBA))
                  (then (call $template_arm32_i8x16_max_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xBB))
                  (then (call $template_arm32_i8x16_avgr_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xBC))
                  (then (call $template_arm32_i16x8_min_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xBE))
                  (then (call $template_arm32_i16x8_max_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xBF))
                  (then (call $template_arm32_i16x8_avgr_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xE1))
                  (then (call $template_arm32_f32x4_min (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xE2))
                  (then (call $template_arm32_f32x4_max (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xE3))
                  (then (call $template_arm32_f64x2_min (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xE4))
                  (then (call $template_arm32_f64x2_max (local.get $dec_ptr)) (br $fd_done)))
                ;; Unknown 0xFD sub-opcode
                (global.set $JIT_ERROR_arm32 (i32.const -4))
              )
              (br $dispatch_done)
            )
          )
          ;; Unknown opcode
          (global.set $JIT_ERROR_arm32 (i32.const -2))
        )
        ;; Advance to next decoded op
        (local.set $dec_ptr (i32.add (local.get $dec_ptr) (global.get $DEC_SZ)))
        (br_if $compile_done (i32.eq (local.get $opcode) (i32.const 0x0F)))  ;; return
        (br_if $compile_done (i32.lt_s (i32.load (global.get $JS_LABEL_DEPTH_arm32)) (i32.const 0)))
        (br $compile_loop)
      )
    )

    ;; ── Pop return value (unless return already did), then epilogue ──
    (if (i32.eqz (i32.load (global.get $JS_RETURN_EMITTED_arm32)))
      (then (call $emit_x86_pop_rax))
    )
    (call $emit_arm32_epilogue)
    (i32.store (global.get $JS_RETURN_EMITTED_arm32) (i32.const 0))

    ;; ── Return code size ──────────────────────────────────────────
    (i32.load (global.get $JS_CODE_PTR_arm32))
  )


  ;; ═════════════════════════════════════════════════════════════════════
  ;; ELF Output — compile all functions to ELF64 binary
  ;; ═════════════════════════════════════════════════════════════════════

  (func $compile_all_to_elf_arm32 (export "compile_all_to_elf_arm32") (result i32 i32)
    (local $import_count i32) (local $func_count i32) (local $i i32)
    (local $code_size i32) (local $total_size i32) (local $syscall_data_size i32)
    (local $saved i32) (local $bss_va i32) (local $data_va i32)

    (local.set $import_count (i32.load (i32.const 0x4108)))
    (local.set $func_count (i32.load (i32.const 0x4510)))

    (i32.store (global.get $JS_CODE_PTR_arm32) (i32.const 0))
    (i32.store (global.get $JS_FIXUP_COUNT_arm32) (i32.const 0))

    (local.set $i (local.get $import_count))
    (block $compile_done
      (loop $compile_loop
        (if (i32.ge_u (local.get $i) (local.get $func_count)) (then (br $compile_done)))
        (drop (call $jit_compile_arm32 (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $compile_loop)
      )
    )

    (call $fixup_calls_arm32)

    (local.set $code_size (i32.load (global.get $JS_CODE_PTR_arm32)))
    (local.set $syscall_data_size (i32.shl (local.get $import_count) (i32.const 2)))
    (local.set $total_size
      (i32.add
        (i32.add (global.get $ELF_CODE_OFF_arm32) (local.get $code_size))
        (local.get $syscall_data_size)))

    (local.set $bss_va
      (i32.add
        (i32.and (i32.add (local.get $total_size) (i32.const 0xFFF)) (i32.const -0x1000))
        (global.get $TEXT_VA_arm32)))

    (local.set $data_va
      (i32.add
        (global.get $TEXT_VA_arm32)
        (i32.add (global.get $ELF_CODE_OFF_arm32) (local.get $code_size))))

    (local.set $saved (i32.load (global.get $JS_CODE_PTR_arm32)))
    (i32.store (global.get $JS_CODE_PTR_arm32) (global.get $ELF_OUT_OFF_arm32))

    ;; ── Emit ELF64 header ──
    (call $emit_arm32_elf32_ehdr
      (i32.add (global.get $TEXT_VA_arm32) (global.get $ELF_STUB_OFF_arm32))
      (i32.const 64)
      (i32.const 1))

    ;; ── Emit program header ──
    (call $emit_arm32_elf32_phdr
      (i32.const 1) (i32.const 7) (i32.const 0)
      (global.get $TEXT_VA_arm32) (local.get $total_size)
      (i32.add
        (i32.and (i32.add (local.get $total_size) (i32.const 0xFFF)) (i32.const -0x1000))
        (global.get $BSS_SIZE_arm32)))

    ;; ── Emit runtime stub ──
    (call $emit_arm32_elf_stub (local.get $bss_va) (local.get $data_va) (local.get $import_count))

    ;; ── Pad to ELF_CODE_OFF ──
    (block $pad_done
      (loop $pad_loop
        (if (i32.ge_u (i32.load (global.get $JS_CODE_PTR_arm32))
                       (i32.add (global.get $ELF_OUT_OFF_arm32) (global.get $ELF_CODE_OFF_arm32)))
          (then (br $pad_done)))
        (call $emit_arm32_byte (i32.const 0))
        (br $pad_loop)))

    (call $copy_compiled_code_arm32 (global.get $JIT_CACHE) (local.get $code_size))

    (i32.store (global.get $JS_CODE_PTR_arm32)
      (i32.add (i32.load (global.get $JS_CODE_PTR_arm32)) (local.get $code_size)))

    (local.set $i (i32.const 0))
    (block $data_loop_done
      (loop $data_loop
        (if (i32.ge_u (local.get $i) (local.get $import_count)) (then (br $data_loop_done)))
        (call $emit_arm32_dword
          (i32.load (i32.add (i32.const 0x90000) (i32.shl (local.get $i) (i32.const 2)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $data_loop)))

    (i32.store (global.get $JS_CODE_PTR_arm32) (local.get $saved))
    (return (global.get $ELF_OUT_BUF_arm32) (local.get $total_size))
  )


  ;; ═════════════════════════════════════════════════════════════════════
  ;; Runtime Backend Dispatch — selects arch at runtime
  ;; ═════════════════════════════════════════════════════════════════════

  (global $JIT_BACKEND (export "JIT_BACKEND") (mut i32) (i32.const 0))

  (func $jit_compile (export "jit_compile") (param $func_idx i32) (param $backend i32) (result i32)
    (if (i32.eq (local.get $backend) (i32.const 0))
      (then (return (call $jit_compile_x86_64 (local.get $func_idx)))))
    (if (i32.eq (local.get $backend) (i32.const 1))
      (then (return (call $jit_compile_arm32 (local.get $func_idx)))))
    (if (i32.eq (local.get $backend) (i32.const 2))
      (then (return (call $jit_compile_aarch64 (local.get $func_idx)))))
    (i32.const -1)
  )

  (func $compile_to_elf (export "compile_to_elf") (param $func_idx i32) (param $backend i32) (result i32 i32)
    (if (i32.eq (local.get $backend) (i32.const 0))
      (then (return (call $compile_to_elf_x86_64 (local.get $func_idx)))))
    (if (i32.eq (local.get $backend) (i32.const 1))
      (then (return (call $compile_to_elf_arm32 (local.get $func_idx)))))
    (if (i32.eq (local.get $backend) (i32.const 2))
      (then (return (call $compile_to_elf_aarch64 (local.get $func_idx)))))
    (i32.const 0) (i32.const 0)
  )
;; ═════════════════════════════════════════════════════════════════════
  ;; EdgeRun WASM → Native JIT Compiler — unified core
  ;;
  ;; GENERATOR TEMPLATE — per-arch KV templates expand into dispatch tables.
  ;;
  ;; Usage:
  ;;   python tools/gen_compiler.py templates/x86_64.json > gen/jit-dispatch-x86-64.wat
  ;; ═════════════════════════════════════════════════════════════════════


  ;; ═════════════════════════════════════════════════════════════════════
  ;; JIT State — per-architecture globals (suffixed by arch)
  ;; ═════════════════════════════════════════════════════════════════════

  (global $JIT_SLOT_SIZE_x86_64  i32 (i32.const 0x40000))  ;; 256KB per function
  (global $JIT_STATE_x86_64      i32 (i32.const 0x300000))

  ;; JIT state field offsets (relative to JIT_STATE)
  (global $JS_CODE_PTR_x86_64       i32 (i32.const 0))
  (global $JS_CACHE_BASE_x86_64     i32 (i32.const 4))
  (global $JS_CACHE_END_x86_64      i32 (i32.const 8))
  (global $JS_FUNC_IDX_x86_64       i32 (i32.const 12))
  (global $JS_RESULT_COUNT_x86_64   i32 (i32.const 16))
  (global $JS_STACK_DEPTH_x86_64    i32 (i32.const 20))
  (global $JS_MAX_STACK_x86_64      i32 (i32.const 24))
  (global $JS_LABEL_DEPTH_x86_64    i32 (i32.const 28))
  (global $JS_RETURN_EMITTED_x86_64 i32 (i32.const 32))
  (global $JS_LABEL_OFFSETS_x86_64  i32 (i32.const 64))    ;; 256*i32 = 1024 bytes
  (global $JS_LABEL_KINDS_x86_64    i32 (i32.const 1088))   ;; 256*byte = 256 bytes
  (global $JS_LABEL_IF_JZ_x86_64    i32 (i32.const 1344))   ;; 256*i32 = 1024 bytes
  (global $JS_FIXUP_COUNT_x86_64    i32 (i32.const 2368))
  (global $JS_FIXUP_LABEL_x86_64    i32 (i32.const 2372))   ;; 256*i32 = 1024 bytes
  (global $JS_FIXUP_OFFSET_x86_64   i32 (i32.const 3396))   ;; 256*i32 = 1024 bytes
  (global $JS_INITIALIZED_x86_64    i32 (i32.const 4420))

  ;; Label kinds
  (global $JIT_LABEL_BLOCK_x86_64   i32 (i32.const 0))
  (global $JIT_LABEL_LOOP_x86_64    i32 (i32.const 1))
  (global $JIT_LABEL_IF_x86_64      i32 (i32.const 2))
  (global $JIT_LABEL_ELSE    i32 (i32.const 3))

  ;; Peephole optimization flag
  (global $RESULT_IN_EAX (mut i32) (i32.const 0))

  ;; Current decoded op pointer
  (global $CURRENT_DEC_PTR_x86_64   (mut i32) (i32.const 0))

  ;; Peephole lookahead
  (global $NEXT_OP_x86_64 (mut i32) (i32.const 0))

  ;; JIT error code
  (global $JIT_ERROR_x86_64 (mut i32) (i32.const 0))

  ;; ELF/binary buffer globals are defined in per-arch emit-*.wat files


  ;; ═════════════════════════════════════════════════════════════════════
  ;; Label Management — shared across all architectures
  ;; ═════════════════════════════════════════════════════════════════════

  ;; Push a label kind onto the label stack
  (func $push_label_x86_64 (param $kind i32) (result i32)
    (local $depth i32)
    (local.set $depth (i32.load (global.get $JS_LABEL_DEPTH_x86_64)))
    (i32.store8
      (i32.add (global.get $JS_LABEL_KINDS_x86_64) (local.get $depth))
      (local.get $kind))
    (i32.store (global.get $JS_LABEL_DEPTH_x86_64) (i32.add (local.get $depth) (i32.const 1)))
    (local.get $depth)
  )

  ;; Pop a label kind from the label stack
  (func $pop_label_x86_64 (result i32)
    (local $depth i32)
    (local.set $depth (i32.sub (i32.load (global.get $JS_LABEL_DEPTH_x86_64)) (i32.const 1)))
    (i32.store (global.get $JS_LABEL_DEPTH_x86_64) (local.get $depth))
    (local.get $depth)
  )

  ;; Get label kind at depth
  (func $get_label_kind_x86_64 (param $depth i32) (result i32)
    (i32.load8_u (i32.add (global.get $JS_LABEL_KINDS_x86_64) (local.get $depth)))
  )

  ;; Set label offset
  (func $set_label_offset_x86_64 (param $depth i32) (param $offset i32)
    (i32.store
      (i32.add (global.get $JS_LABEL_OFFSETS_x86_64) (i32.shl (local.get $depth) (i32.const 2)))
      (local.get $offset))
  )

  ;; Get label offset
  (func $get_label_offset_x86_64 (param $depth i32) (result i32)
    (i32.load
      (i32.add (global.get $JS_LABEL_OFFSETS_x86_64) (i32.shl (local.get $depth) (i32.const 2))))
  )

  ;; Set label if-jz offset
  (func $set_label_if_jz_x86_64 (param $depth i32) (param $offset i32)
    (i32.store
      (i32.add (global.get $JS_LABEL_IF_JZ_x86_64) (i32.shl (local.get $depth) (i32.const 2)))
      (local.get $offset))
  )

  ;; Get label if-jz offset
  (func $get_label_if_jz_x86_64 (param $depth i32) (result i32)
    (i32.load
      (i32.add (global.get $JS_LABEL_IF_JZ_x86_64) (i32.shl (local.get $depth) (i32.const 2))))
  )

  ;; Push a fixup
  (func $push_fixup_x86_64 (param $target_depth i32)
    (local $count i32)
    (local.set $count (i32.load (global.get $JS_FIXUP_COUNT_x86_64)))
    (i32.store
      (i32.add (global.get $JS_FIXUP_LABEL_x86_64) (i32.shl (local.get $count) (i32.const 2)))
      (local.get $target_depth))
    (i32.store
      (i32.add (global.get $JS_FIXUP_OFFSET_x86_64) (i32.shl (local.get $count) (i32.const 2)))
      (i32.load (global.get $JS_CODE_PTR_x86_64)))
    (i32.store (global.get $JS_FIXUP_COUNT_x86_64) (i32.add (local.get $count) (i32.const 1)))
  )

  ;; Patch fixups for a given depth
  (func $patch_fixups_x86_64 (param $depth i32)
    (local $count i32) (local $i i32) (local $target i32) (local $off i32)
    (local $code_ptr i32) (local $disp i32) (local $label_off i32)
    (local.set $count (i32.load (global.get $JS_FIXUP_COUNT_x86_64)))
    (local.set $code_ptr (i32.load (global.get $JS_CODE_PTR_x86_64)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $lp
        (if (i32.ge_u (local.get $i) (local.get $count)) (then (br $done)))
        (local.set $target (i32.load
          (i32.add (global.get $JS_FIXUP_LABEL_x86_64) (i32.shl (local.get $i) (i32.const 2)))))
        (if (i32.eq (local.get $target) (local.get $depth))
          (then
            (local.set $off (i32.load
              (i32.add (global.get $JS_FIXUP_OFFSET_x86_64) (i32.shl (local.get $i) (i32.const 2)))))
            (local.set $label_off (call $get_label_offset_x86_64 (local.get $depth)))
            (local.set $disp (i32.sub (local.get $label_off) (i32.add (local.get $off) (i32.const 4))))
            (i32.store (i32.add (global.get $JIT_CACHE) (local.get $off)) (local.get $disp))
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lp)
      )
    )
  )


  ;; ═════════════════════════════════════════════════════════════════════
  ;; JIT Compile Dispatch — opcode dispatch tables expanded from per-arch KV template.
  ;; ═════════════════════════════════════════════════════════════════════

  (func $jit_compile_x86_64 (export "jit_compile_x86_64") (param $func_idx i32) (result i32)
    (local $dec_ptr i32) (local $opcode i32) (local $imm0 i32)
    (local $code_start i32) (local $label_level i32)
    (local $loop_top_offset i32)
    (local $decoded_ops_base i32) (local $decoded_ops_count i32)

    ;; Reset label depth
    (i32.store (global.get $JS_LABEL_DEPTH_x86_64) (i32.const 0))

    ;; Get decoded_ops base from imported global
    (local.set $decoded_ops_base (global.get $OFF_DECODED_OPS))

    ;; ── Record this function's offset in func_off_table ────────────
    (i32.store
      (i32.add (global.get $FUNC_OFF_TABLE_x86_64) (i32.shl (local.get $func_idx) (i32.const 2)))
      (i32.load (global.get $JS_CODE_PTR_x86_64))
    )

    ;; ── Emit prologue ─────────────────────────────────────────────
    (call $emit_x86_prologue)

    ;; ── Read next op for peephole ─────────────────────────────────
    (if (i32.load (i32.add (local.get $dec_ptr) (global.get $DEC_SZ)))
      (then (global.set $NEXT_OP_x86_64 (i32.load (i32.add (local.get $dec_ptr) (global.get $DEC_SZ)))))
      (else (global.set $NEXT_OP_x86_64 (i32.const 0)))
    )

    ;; ── Main compile loop ─────────────────────────────────────────
    (local.set $dec_ptr (local.get $decoded_ops_base))
    (block $compile_done
      (loop $compile_loop
        (local.set $opcode (i32.load (local.get $dec_ptr)))

        ;; Read next opcode for peephole (at dec_ptr + DEC_SZ)
        (if (i32.load (i32.add (local.get $dec_ptr) (global.get $DEC_SZ)))
          (then (global.set $NEXT_OP_x86_64 (i32.load (i32.add (local.get $dec_ptr) (global.get $DEC_SZ)))))
          (else (global.set $NEXT_OP_x86_64 (i32.const 0)))
        )

        ;; ── Dispatch by opcode ─────────────────────────────────────
        (block $dispatch_done
          (if (i32.eqz (local.get $opcode))
            (then (call $template_unreachable_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x01))
            (then (call $template_nop_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x02))
            (then (call $template_block_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x03))
            (then (call $template_loop_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x04))
            (then (call $template_if_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x05))
            (then (call $template_else_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x0B))
            (then (call $template_end_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x0C))
            (then (call $template_br_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x0D))
            (then (call $template_br_if_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x0E))
            (then (call $template_br_table_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x0F))
            (then (call $template_return_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x10))
            (then (call $template_call_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x12))
            (then (call $template_return_call_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x1A))
            (then (call $template_drop_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x1B))
            (then (call $template_select_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x20))
            (then (call $template_local_get_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x21))
            (then (call $template_local_set_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x22))
            (then (call $template_local_tee_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x23))
            (then (call $template_global_get_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x24))
            (then (call $template_global_set_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x25))
            (then (call $template_table_get_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x26))
            (then (call $template_table_set_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x28))
            (then (call $template_i32_load_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x29))
            (then (call $template_i64_load_x86_64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x2A))
