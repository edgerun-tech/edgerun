                (if (i32.eq (local.get $imm0) (i32.const 0x95))
                  (then (call $template_simd_f64x2_add (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x96))
                  (then (call $template_simd_f64x2_sub (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x98))
                  (then (call $template_simd_f64x2_mul (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x9B))
                  (then (call $template_simd_f64x2_neg (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x9C))
                  (then (call $template_simd_f64x2_ne (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x9D))
                  (then (call $template_simd_f64x2_eq (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x9F))
                  (then (call $template_simd_f64x2_lt (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xA1))
                  (then (call $template_simd_f64x2_gt (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xA3))
                  (then (call $template_simd_f64x2_le (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xA5))
