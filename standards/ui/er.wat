  ;; Scan a DER X.509 Certificate.
  ;; out record:
  ;; cert_body_ptr, cert_body_len, cert_header_len, cert_total_len,
  ;; tbs_ptr, tbs_total_len, tbs_header_len, tbs_body_len,
