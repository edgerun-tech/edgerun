                (if (i32.eq (local.get $imm0) (i32.const 0x8B))
                  (then (call $template_simd_f32x4_ne (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x8C))
