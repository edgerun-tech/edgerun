  (func $device_quectel_model_code (param $model i32) (result i32)
    ;; CN=1 AU=2 EU=3 EL=4.
    local.get $model
    i32.const 1
    i32.ge_s
    local.get $model
    i32.const 4
    i32.le_s
    i32.and
