            (then (call $template_i32_le_u_aarch64 (local.get $dec_ptr)) (br $dispatch_done)))
          (if (i32.eq (local.get $opcode) (i32.const 0x50))
            (then (call $template_i64_eqz_aarch64 (local.get $dec_ptr)) (br $dispatch_done)))
