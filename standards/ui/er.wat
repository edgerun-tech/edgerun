  (func $emit_aarch64_bneon_3same (param $Q i32) (param $size i32) (param $U i32) (param $opcode i32) (param $Rd i32) (param $Rn i32) (param $Rm i32)
    (call $emit_aarch64_neon_3same (local.get $Q) (local.get $size) (local.get $U) (local.get $opcode) (local.get $Rd) (local.get $Rn) (local.get $Rm))
