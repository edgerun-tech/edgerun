    local.get $len
    i32.const 8
    i32.ge_u
    if
      local.get $ptr
      i32.load8_u
      i32.const 104
      i32.eq
      local.get $ptr
      i32.const 1
      i32.add
      i32.load8_u
      i32.const 116
      i32.eq
      i32.and
      local.get $ptr
      i32.const 2
      i32.add
      i32.load8_u
      i32.const 116
      i32.eq
      i32.and
      local.get $ptr
      i32.const 3
      i32.add
      i32.load8_u
      i32.const 112
      i32.eq
      i32.and
      local.get $ptr
      i32.const 4
      i32.add
      i32.load8_u
      i32.const 115
      i32.eq
      i32.and
      local.get $ptr
      i32.const 5
      i32.add
      i32.load8_u
      i32.const 58
      i32.eq
      i32.and
      local.get $ptr
      i32.const 6
      i32.add
      i32.load8_u
