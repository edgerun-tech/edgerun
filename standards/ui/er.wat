        (i32.or
          (i32.ne (i32.load8_u (local.get $ptr)) (i32.const 31))
          (i32.ne (i32.load8_u (i32.add (local.get $ptr) (i32.const 1))) (i32.const 139)))
        (i32.ne (i32.load8_u (i32.add (local.get $ptr) (i32.const 2))) (i32.const 8)))
      (then (return (i32.const 3))))

