                (if (i32.eq (local.get $imm0) (i32.const 0xA6))
                  (then (call $template_simd_v128_load8_splat (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xA7))
                  (then (call $template_simd_v128_load16_splat (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0xA8))
