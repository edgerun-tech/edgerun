        br $scan))
    i32.const -1)

  (func $gzip_member_scan (export "gzip_member_scan")
    (param $ptr i32)
    (param $len i32)
    (param $out i32)
    (result i32)
    (local $flags i32)
    (local $mtime i32)
    (local $xfl i32)
    (local $os i32)
    (local $pos i32)
    (local $limit i32)
    (local $xlen i32)
    (local $trailer_off i32)

