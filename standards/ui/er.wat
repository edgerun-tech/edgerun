                (if (i32.eq (local.get $imm0) (i32.const 0x6D))
                  (then (call $template_simd_i32x4_lt_s (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x6E))
                  (then (call $template_simd_i32x4_gt_u (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x6F))
                  (then (call $template_simd_i32x4_gt_s (local.get $dec_ptr)) (br $fd_done)))
                (if (i32.eq (local.get $imm0) (i32.const 0x70))
